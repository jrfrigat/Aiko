@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject WorkspaceState State
@inject NavigationManager Navigation
@inject IJSRuntime Js

@* The application shell, as the v2 frame draws it: a 56px top bar over the darkest plane, a 256px
   rail grouped by scope, and a telemetry card at the foot of the rail. Every screen is a page rendered
   into @Body; the shell owns what all of them share.

   Two things here are deliberately not the mock's. The runtime tag reports what the daemon actually
   does (the release workflow publishes with PublishAot=false, so "NATIVE AOT" would be a claim the
   binary cannot back), and the round-trip figure beside the endpoint is a measured stopwatch over the
   daemon's own identification call rather than the mock's "4ms".

   The rail's destinations are ordinary links (FlareNavLink Href=...) rather than click handlers, so
   Flare marks the current one active from the navigation string alone - the address bar, the back
   button and a deep link are all the same source of truth. The open project and the open card are
   route segments for the same reason. *@
<FlareLayout>
    <FlareLayoutAppBar DrawerToggle="true">
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" StretchFirst="true">
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
                @* Brand: the accent tile with the app's initial, the name, and what is running. *@
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                    <span class="aiko-brand" aria-hidden="true">A</span>
                    <FlareText Element="span" Typo="TypographyScale.HeadlineSmall" Weight="FontWeight.SemiBold">
                        Aiko
                    </FlareText>
                    @if (State.System is { } system)
                    {
                        @* Interpolated on purpose: "v@State.System.Version" is Razor's email-looking text,
                           so it renders literally instead of evaluating the expression. *@
                        <span class="aiko-tag aiko-tag--accent">@($"v{system.Version}")</span>
                        <span class="aiko-tag">@system.Runtime</span>
                    }
                </FlareStack>

                @* Daemon health: the live dot, the endpoint, the measured round-trip and the stream. *@
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Class="aiko-pill aiko-pill--live">
                    <FlareBadge Dot="true"
                                Standalone="true"
                                Color="@(State.EventsConnected ? FlareColor.Tertiary : FlareColor.Warning)" />
                    <FlareText Element="span" Mono="true"
                               Color="@(State.EventsConnected ? FlareColor.Tertiary : FlareColor.Warning)">
                        @(State.EventsConnected ? Loc.Get("SseLive") : Loc.Get("Online"))
                    </FlareText>
                    <span class="aiko-tag aiko-tag--quiet">@State.HostCaption</span>
                    <span class="aiko-tag aiko-tag--quiet" title="@Loc.Get("DaemonRoundTrip")">@LatencyCaption</span>
                </FlareStack>

                @* The open project, and the switch between projects. The rail lists the pages of one
                   project; which project that is belongs here, as the design has it. *@
                <FlarePopover Open="@_projectMenuOpen"
                              OpenChanged="SetProjectMenu"
                              Placement="Placement.BottomStart"
                              MinWidth="18rem"
                              MaxHeight="20rem">
                    <AnchorContent>
                        <button type="button"
                                class="aiko-project-switch"
                                aria-label="@Loc.Get("OpenProjectLabel")"
                                @onclick="ToggleProjectMenu">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.FolderOpen" Color="FlareColor.Secondary" />
                            <FlareText Element="span" Mono="true" Color="FlareColor.Secondary">@ProjectSwitchCaption</FlareText>
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.KeyboardArrowDown" Color="FlareColor.OnSurfaceVariant2" />
                        </button>
                    </AnchorContent>
                    <ChildContent>
                        @if (State.Projects.Count == 0)
                        {
                            <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("EmptyStateTitle")
                            </FlareText>
                        }
                        else
                        {
                            @foreach (var project in State.Projects)
                            {
                                var item = project;
                                <button type="button" class="aiko-menu-item" @onclick="() => OpenProject(item.Handle)">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareAvatar Text="@DisplayFormat.Initials(item.Name)"
                                                     Size="AvatarSize.Xs"
                                                     Shape="AvatarShape.Square" />
                                        <FlareText Element="span" Typo="TypographyScale.BodySmall">@item.Name</FlareText>
                                    </FlareStack>
                                    <span class="aiko-tag aiko-tag--clip" title="@item.RootPath">@DisplayFormat.ProjectTag(item.RootPath)</span>
                                </button>
                            }
                        }
                    </ChildContent>
                </FlarePopover>
            </FlareStack>

            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                @* Quick search: a real filter over the open board. Enter opens the first match, a click
                   opens the one under the pointer, and Ctrl+K reaches the field from anywhere. *@
                <FlarePopover Open="@_searchOpen"
                              OpenChanged="SetSearchOpen"
                              Placement="Placement.BottomStart"
                              MatchAnchorWidth="true"
                              MaxHeight="20rem">
                    <AnchorContent>
                        <FlareTextField Class="aiko-search"
                                        Size="FieldSize.Xs"
                                        Placeholder="@Loc.Get("QuickSearchPlaceholder")"
                                        AriaLabel="@Loc.Get("QuickSearchAriaLabel")"
                                        Value="@_query"
                                        ValueChanged="OnQueryChanged"
                                        OnKeyDown="OnSearchKeyDown"
                                        Clearable="true">
                            <LeadingIcon>
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Color="FlareColor.OnSurfaceVariant2" />
                            </LeadingIcon>
                            <AdornmentEnd>
                                @* A keycap is a hint, not a control: Flare has no keyboard-hint element. *@
                                <span class="aiko-kbd">Ctrl+K</span>
                            </AdornmentEnd>
                        </FlareTextField>
                    </AnchorContent>
                    <ChildContent>
                        @if (QuickMatches.Count == 0)
                        {
                            <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Format("QuickSearchNoMatch", _query ?? string.Empty)
                            </FlareText>
                        }
                        else
                        {
                            @foreach (var card in QuickMatches)
                            {
                                var item = card;
                                <button type="button" class="aiko-menu-item" @onclick="() => OpenCard(item)">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <span class="aiko-tag aiko-tag--accent">@item.Reference.CardId</span>
                                        <FlareText Element="span" Typo="TypographyScale.BodySmall">@item.Title</FlareText>
                                    </FlareStack>
                                    <span class="aiko-tag">@item.StageId</span>
                                </button>
                            }
                        }
                    </ChildContent>
                </FlarePopover>

                @if (State.SelectedProjectId is not null)
                {
                    <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm" OnClick="OpenNewCard">
                        <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                        <ChildContent>@Loc.Get("NewTask")</ChildContent>
                    </FlareButton>
                }

                @* The design's end slot holds an identity avatar; this is a local, single-user daemon with
                   no accounts to name, so the slot carries the actions the bar still needs - a reload for
                   when the live stream is down, and the repository mark in the far corner. *@
                <FlareIconButton Variant="ButtonVariant.Text"
                                 Icon="@MaterialDesign3Icons.Regular.Refresh"
                                 AriaLabel="@Loc.Get("Refresh")"
                                 Loading="@State.Loading"
                                 OnClick="State.ReloadAsync" />

                @* Where the product lives, in the corner of the bar. It is drawn with GitHub's own mark
                   rather than a code glyph - the Flare gallery uses the same brand path, because GitHub
                   publishes no Material symbol for it. *@
                <FlareIconButton Variant="ButtonVariant.Text"
                                 Href="@GitHubUrl"
                                 Target="_blank"
                                 AriaLabel="@Loc.Get("GitHubRepository")"
                                 AdditionalAttributes="@GitHubAttributes">
                    <FlareIconView Value="@(new FlareSvgIcon { Data = GitHubIcon })" Size="1.35rem" />
                </FlareIconButton>
            </FlareStack>
        </FlareStack>
    </FlareLayoutAppBar>

    <FlareLayoutDrawer @bind-Open="_railOpen"
                       Variant="DrawerVariant.Persistent"
                       Width="16rem"
                       AriaLabel="@Loc.Get("RailAriaLabel")">
        <FlareNavMenu>
            <ChildContent>
                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow aiko-rail__group">
                        @Loc.Get("OverviewGroup")
                    </FlareText>
                    <FlareNavLink Href="/" Match="NavMatchMode.Exact">
                        <ChildContent>@Loc.Get("Dashboard")</ChildContent>
                        <BadgeContent>
                            @if (State.EventsConnected)
                            {
                                <span class="aiko-tag aiko-tag--quiet"><span class="aiko-dot aiko-dot--pulse"></span></span>
                            }
                        </BadgeContent>
                    </FlareNavLink>

                    @* The installation's own screens sit with the dashboard, in the same group: they describe
                       the daemon, not the open project, and the project below them is what changes as you
                       move between projects. *@
                    <FlareNavLink Href="/daemon">
                        <ChildContent>@Loc.Get("DaemonMcpBridges")</ChildContent>
                        <BadgeContent>
                            @if (State.EventsConnected)
                            {
                                <span class="aiko-tag aiko-tag--live">
                                    <span class="aiko-dot aiko-dot--pulse"></span>@Loc.Get("LiveTag")
                                </span>
                            }
                        </BadgeContent>
                    </FlareNavLink>
                    @* Workflow is the last item of the overview: it is where the pipelines every project is
                       created from live, and it replaces a separate "global settings" screen - the same
                       editor, pointed at a template. *@
                    <FlareNavLink Href="/templates">
                        <ChildContent>@Loc.Get("TemplatesNav")</ChildContent>
                        <BadgeContent>
                            <span class="aiko-tag aiko-tag--quiet">@DisplayFormat.Number(State.Templates.Count)</span>
                        </BadgeContent>
                    </FlareNavLink>

                    @if (State.SelectedProject is { } open)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow aiko-rail__group">
                            @Loc.Format("CurrentProjectGroup", open.Name)
                        </FlareText>
                        @* The project's own page first, then the board: the overview answers "how are we
                           doing" before the board answers "what is next". *@
                        @* Exact match: the overview lives at /p/{id} itself, and its sub-pages (the board, the
                           backlog, the settings) have their own rail items. Prefix matching would light up
                           two of them at once. *@
                        <FlareNavLink Href="@ProjectHref" Match="NavMatchMode.Exact">
                            <ChildContent>@Loc.Get("ProjectOverviewNav")</ChildContent>
                        </FlareNavLink>
                        <FlareNavLink Href="@BoardHref(open.Handle)">
                            <ChildContent>@Loc.Get("KanbanBoard")</ChildContent>
                            <BadgeContent>
                                <span class="aiko-tag aiko-tag--accent">@DisplayFormat.Number(State.Board?.Cards.Count ?? 0)</span>
                            </BadgeContent>
                        </FlareNavLink>
                        @* The backlog is the list of cards nobody has taken into work yet, so it sits right
                           next to the board: it is the same cards, read as a queue instead of as columns. *@
                        <FlareNavLink Href="@SectionHref(open.Handle, "backlog")">
                            <ChildContent>@Loc.Get("BacklogNav")</ChildContent>
                            <BadgeContent>
                                <span class="aiko-tag">@DisplayFormat.Number(BoardMetrics.BacklogCount(State.Board))</span>
                            </BadgeContent>
                        </FlareNavLink>
                        <FlareNavLink Href="@SectionHref(open.Handle, "stories")">
                            <ChildContent>@Loc.Get("StoriesBacklog")</ChildContent>
                            <BadgeContent>
                                <span class="aiko-tag">@DisplayFormat.Number(BoardMetrics.CountKind(State.Board, CardKind.Story))</span>
                            </BadgeContent>
                        </FlareNavLink>
                        @* Workflow moved into Project Settings: the design's rail has no separate stage
                           editor, and one place to edit a pipeline is better than two. The /workflow route
                           stays for deep links. *@
                        <FlareNavLink Href="@SectionHref(open.Handle, "settings")">
                            <ChildContent>@Loc.Get("ProjectSettingsNav")</ChildContent>
                        </FlareNavLink>
                    }
                </FlareStack>
            </ChildContent>

            <FooterContent>
                @* What the daemon is doing right now: the share of cards an agent is working, whether the
                   event stream is up, and the component library the cockpit renders with. *@
                <FlareStack Class="aiko-rail__foot" Gap="FlareSpacing.XXSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("OrchestrationLoad")
                        </FlareText>
                        <FlareText Element="span" Mono="true" Weight="FontWeight.SemiBold">@($"{LoadPercent}%")</FlareText>
                    </FlareStack>
                    <FlareProgressLinear Value="LoadPercent" Size="TrackSize.Xs" Color="FlareColor.Secondary" />
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                            <FlareBadge Dot="true"
                                        Standalone="true"
                                        Color="@(State.EventsConnected ? FlareColor.Tertiary : FlareColor.Warning)" />
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                @Loc.Get("ContextEngine")
                            </FlareText>
                        </FlareStack>
                        <FlareText Element="span" Mono="true" Color="FlareColor.Secondary">
                            @(State.EventsConnected ? "SSE" : "online")
                        </FlareText>
                    </FlareStack>
                    <span class="aiko-rail__divider"></span>
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">Flare.Blazor</FlareText>
                        <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@($"v{FlareVersion}")</FlareText>
                    </FlareStack>
                </FlareStack>
            </FooterContent>
        </FlareNavMenu>
    </FlareLayoutDrawer>

    <FlareLayoutContent>
        <FlareStack Gap="FlareSpacing.Medium">
            @if (State.Error is { Length: > 0 } error)
            {
                <FlareAlert Severity="AlertSeverity.Error"
                            Variant="AlertVariant.Outlined"
                            Title="@Loc.Get("BoardUpdateFailed")">@error</FlareAlert>
            }

            @if (State.Loading)
            {
                <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <FlareProgressCircular />
                    <FlareText Element="span" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                        @Loc.Get("LoadingContext")
                    </FlareText>
                </FlareStack>
            }
            else
            {
                @Body
            }
        </FlareStack>
    </FlareLayoutContent>
</FlareLayout>

@code {
    private bool _railOpen = true;
    private bool _projectMenuOpen;
    private bool _searchOpen;
    private string? _query;

    /// <summary>Where the product lives. One constant, so the bar and a future About screen agree.</summary>
    private const string GitHubUrl = "https://github.com/jrfrigat/Aiko";

    /// <summary>
    /// GitHub's mark (24x24 path data) for the repository button, taken from the Flare gallery's app bar.
    /// GitHub is a third-party brand, so it is kept local to this layout rather than added to the icon pack.
    /// </summary>
    private const string GitHubIcon = "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";

    /// <summary>A native tooltip for the repository button: Flare components take no Tooltip parameter.</summary>
    private static IReadOnlyDictionary<string, object> GitHubAttributes =>
        new Dictionary<string, object>(StringComparer.Ordinal) { ["title"] = GitHubUrl };

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await State.EnsureInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("aikoHotkey", ".aiko-search input", "k");
        }
        catch (JSException)
        {
            // No JS runtime (prerender): the field is still reachable with the mouse.
        }
        catch (InvalidOperationException)
        {
        }
    }

    // The service raises the change from whatever context the SSE callback arrived on; the component
    // marshals it onto the renderer's.
    private Task OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        InvokeAsync(StateHasChanged);

    private static string BoardHref(string projectHandle) =>
        $"/p/{Uri.EscapeDataString(projectHandle)}/board";

    private static string SectionHref(string projectHandle, string section) =>
        $"/p/{Uri.EscapeDataString(projectHandle)}/{section}";

    /// <summary>
    /// The project's readable address. The handle is used rather than the id, so a link a user copies out
    /// of the address bar reads like the project's name.
    /// </summary>
    private string ProjectHref => State.SelectedProject is { } project
        ? $"/p/{Uri.EscapeDataString(project.Handle)}"
        : "/";

    /// <summary>"Project: name (active)", or the invitation to open one.</summary>
    private string ProjectSwitchCaption => State.SelectedProject is { } project
        ? $"{Loc.Get("ProjectLabel")}: {project.Name} {Loc.Get("ActiveProjectTag")}"
        : Loc.Get("OpenProjectLabel");

    /// <summary>The measured round-trip, or a dash before the daemon has answered once.</summary>
    private string LatencyCaption => State.DaemonLatencyMs is { } milliseconds
        ? $"{milliseconds}ms"
        : "—";

    /// <summary>The component library's version, read from the assembly the cockpit loaded.</summary>
    private static string FlareVersion => typeof(FlareText).Assembly.GetName().Version is { } version
        ? $"{version.Major}.{version.Minor}.{version.Build}"
        : "—";

    /// <summary>
    /// The rail's orchestration load: the share of cards an agent is working right now. A real
    /// measurement (cards between the first and the last stage), not a decorative number.
    /// </summary>
    private double LoadPercent
    {
        get
        {
            var total = State.Board?.Cards.Count ?? 0;
            if (total == 0)
            {
                return 0;
            }

            return Math.Round(
                BoardMetrics.InProgressCount(State.Board) * 100d / total,
                MidpointRounding.AwayFromZero);
        }
    }

    /// <summary>
    /// The cards matching the quick search: the id or the title, at most eight of them, so the panel
    /// stays a shortcut rather than a second board.
    /// </summary>
    private IReadOnlyList<Card> QuickMatches
    {
        get
        {
            var query = _query?.Trim();
            if (string.IsNullOrEmpty(query) || State.Board is not { } board)
            {
                return [];
            }

            return board.Cards
                .Where(card =>
                    card.Reference.CardId.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    card.Title.Contains(query, StringComparison.OrdinalIgnoreCase))
                .Take(8)
                .ToArray();
        }
    }

    private void OnQueryChanged(string? value)
    {
        _query = value;
        _searchOpen = !string.IsNullOrWhiteSpace(value);
    }

    private void SetSearchOpen(bool open)
    {
        _searchOpen = open;
        if (!open)
        {
            _query = null;
        }
    }

    /// <summary>Enter opens the first match; the arrow keys stay with the field.</summary>
    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            return;
        }

        var match = QuickMatches.FirstOrDefault();
        if (match is not null)
        {
            OpenCard(match);
        }
    }

    private void ToggleProjectMenu() => _projectMenuOpen = !_projectMenuOpen;

    private void SetProjectMenu(bool open) => _projectMenuOpen = open;

    private void OpenProject(string projectId)
    {
        _projectMenuOpen = false;
        Navigation.NavigateTo(BoardHref(projectId));
    }

    private void OpenNewCard() =>
        Navigation.NavigateTo($"{ProjectHref}/cards/new");

    private void OpenCard(Card card)
    {
        var target = $"{ProjectHref}/cards/{Uri.EscapeDataString(card.Reference.CardId)}";
        _query = null;
        _searchOpen = false;
        Navigation.NavigateTo(target);
    }

    public ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        return ValueTask.CompletedTask;
    }
}
