<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- The UI language follows the browser, so the client must be able to name any culture the
         visitor has - not just the one it was built with. The daemon serves this app over loopback,
         where the extra ICU data costs nothing that matters. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- Satellite resources are the languages we translate; the neutral Loc.resx is English. -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- The JSON contract specs assert that every type the client sends or reads is covered by the
         source-generated PwaJsonContext. -->
    <InternalsVisibleTo Include="Aiko.Pwa.Specs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Flare.Blazor" Version="0.37.0" />
    <!-- The cockpit's iconography is Material Symbols, which is what the design was drawn with. The
         core Flare.Icons set is the library's own chrome (about a hundred glyphs) and does not carry
         `view_kanban`, `account_tree`, `smart_toy` or the rest of the design's vocabulary. The catalog
         is self-contained inline SVG and trimmable, so a Release publish keeps only the icons
         referenced by their typed member. -->
    <PackageReference Include="Flare.Icons.MaterialDesign3.Svg" Version="0.37.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Aiko.Application/Aiko.Application.csproj" />
    <ProjectReference Include="../Aiko.Theme.StitchFlow/Aiko.Theme.StitchFlow.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
