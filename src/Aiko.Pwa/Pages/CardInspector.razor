@inject HttpClient Http
@inject WorkspaceState State
@inject IJSRuntime Js

@* Unsaved edits are not left behind by a click: a link inside the app asks first, and closing or reloading the
   tab gets the browser's own prompt. *@
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

@if (_changedWhileEditing && IsDirty)
{
    @* The card moved underneath the form - an agent wrote a revision, or a save was refused for a newer one.
       The fields the person changed kept their text; this says so, and offers the card's own values instead. *@
    <FlareAlert Severity="AlertSeverity.Warning" Variant="AlertVariant.Outlined">
        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
            <span>@Loc.Get("CardChangedWhileEditing")</span>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="DiscardEdits">@Loc.Get("DiscardMyEdits")</FlareButton>
        </FlareStack>
    </FlareAlert>
}

@* The card's own body, laid out the way the design lays a card out: two columns of panels - the work on
   the left (what the stage asks for, what the last run reported, where the diff will stand, the artifacts
   and the run history), and the card's state on the right (where it is, what it scores, what it is linked
   to, and what its own stage is still waiting for). One panel per block, the way the design draws them,
   instead of one surface split by dividers.

   The identity header is drawn only when a drawer hosts this component. On the card page the banner above
   already says what the card is and where it sits, and printing it twice is the screen talking to itself. *@
@if (OnClose.HasDelegate)
{
    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">@IdentityCaption</FlareText>
            <FlareText Element="h2" Mono="true" Typo="TypographyScale.TitleMedium">@Card.Reference.CardId</FlareText>
        </FlareStack>
        <FlareIconButton Variant="ButtonVariant.Text"
                         Icon="@FlareIcons.Close"
                         AriaLabel="@Loc.Get("Close")"
                         OnClick="() => OnClose.InvokeAsync()" />
    </FlareStack>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                Variant="AlertVariant.Outlined">@_message</FlareAlert>
}

<div class="aiko-settings">
    @* The work column is written first: the grid keeps the first item in the first row, so the aside lands
       beside it rather than pushing it to a second row, and a keyboard or screen reader meets the work
       before the state. *@
    @* The work column: the design's left side. *@
    <FlareStack Class="aiko-card__main" Gap="FlareSpacing.Medium">

        @* What the card declares and what it touched: its requirements and scope, the files, and the stage's
           acceptance criteria. What the stage asks the agent for belongs to the workflow and is edited
           there, so a card never repeats it. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        <span class="aiko-panel__icon aiko-panel__icon--primary">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Target" />
                        </span>
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("ScopeTitle")</FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("ScopePanelHint")
                            </FlareText>
                        </FlareStack>
                    </FlareStack>
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                        @* Where the card's current stage got to, derived from the runs the runs tab already loads,
                           so this chip and that tab cannot disagree. *@
                        <span class="aiko-tag @StageStateView.TagClass(CurrentStageState)"
                              title="@Loc.Get(StageStateView.LabelKey(CurrentStageState))">
                            @Loc.Get(StageStateView.LabelKey(CurrentStageState))
                        </span>
                        @if (FinishedStages > 0)
                        {
                            <span class="aiko-tag aiko-tag--quiet">@Loc.Format("StagesFinishedCount", DisplayFormat.Number(FinishedStages))</span>
                        }
                        @if (OutOfScopeCount > 0)
                        {
                            <span class="aiko-tag aiko-tag--warn">@Loc.Format("OutOfScopeCount", DisplayFormat.Number(OutOfScopeCount))</span>
                        }
                    </FlareStack>
                </FlareStack>

                @* The card's own long prose behind one tab bar: the request as it was asked, the requirements as
                   the work stands, and the scope the card declares. The editors write into the page's fields, so
                   switching tabs never loses what was typed, and the save row below belongs to the card rather
                   than to one tab. *@
                <FlareTabs ActiveIndex="_textTab" ActiveIndexChanged="OnTextTabChanged">
                    <FlareTab Label="@Loc.Get("Requirements")">
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.XSmall">
                                @* What the card must do, in the words of whoever wrote it. It wears the same
                                   prompt block as the other two texts, because all three are long prose about
                                   this one card. *@
                                <PromptField Name="@($"{Card.Reference.CardId}.requirements")"
                                             Title="@Loc.Get("Requirements")"
                                             Rows="20"
                                             Placeholder="@Loc.Get("RequirementsHelper")"
                                             Value="@_requirements"
                                             ValueChanged="value => _requirements = value" />
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("RequirementsHelper")
                                </FlareText>
                            </FlareStack>
                        </ChildContent>
                    </FlareTab>
                    <FlareTab Label="@Loc.Get("Request")">
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.XSmall">
                                @* What the user asked for, in their own words - the raw request rather than the
                                   reworked task. *@
                                <PromptField Name="@($"{Card.Reference.CardId}.request")"
                                             Title="@Loc.Get("Request")"
                                             Rows="20"
                                             Placeholder="@Loc.Get("RequestHelper")"
                                             Value="@_request"
                                             ValueChanged="value => _request = value" />
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("RequestHelper")
                                </FlareText>
                            </FlareStack>
                        </ChildContent>
                    </FlareTab>
                    <FlareTab Label="@Loc.Get("DeclaredScope")">
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <PromptField Name="@($"{Card.Reference.CardId}.scope")"
                                             Title="@Loc.Get("DeclaredScope")"
                                             Rows="20"
                                             ShowMetrics="false"
                                             Placeholder="@Loc.Get("ScopeHelper")"
                                             Value="@_scope"
                                             ValueChanged="value => _scope = value" />
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("ScopeHelper")
                                </FlareText>
                            </FlareStack>
                        </ChildContent>
                    </FlareTab>
                </FlareTabs>

                
                @* The card's files one level in, behind their own tab bar instead of three lists in a row:
                what it declared it would touch, what it actually touched, and the deviation - the files
                it changed without declaring them. The last one is what a reader checks a card by, and it
                is the same list the footer's DoD line counts. *@
                <FlareTabs ActiveIndex="_scopeTab" ActiveIndexChanged="OnScopeTabChanged">
                    <FlareTab Label="@Loc.Get("FilesDeclared")">
                        <ChildContent>
                            <FileGroup Title="@Loc.Get("FilesDeclared")" Files="Card.DeclaredScopeFiles" />
                        </ChildContent>
                    </FlareTab>
                    <FlareTab Label="@Loc.Get("FilesActual")">
                        <ChildContent>
                            <FileGroup Title="@Loc.Get("FilesActual")" Files="Card.ActualChangedFiles" />
                        </ChildContent>
                    </FlareTab>
                    <FlareTab Label="@Loc.Get("OutOfScope")">
                        <ChildContent>
                            <FileGroup Title="@Loc.Get("OutOfScope")"
                                       Files="BoardSection.FindOutOfScopeFiles(Card)"
                                       Warning="true" />
                        </ChildContent>
                    </FlareTab>
                </FlareTabs>

                @* Saving belongs to the card, not to the tab the reader happens to be on, so the button never
                   hides with a tab. *@
                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.End" Gap="FlareSpacing.Small" Wrap="true">
                    <FlareButton Variant="ButtonVariant.Tonal"
                                 Size="ButtonSize.Sm"
                                 Loading="@_saving"
                                 OnClick="SaveAsync">
                        <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" /></LeadingIcon>
                        <ChildContent>@Loc.Get("SaveCard")</ChildContent>
                    </FlareButton>
                </FlareStack>

                @* The stage's acceptance criteria: the artifacts it expects, marked by whether the card
                   carries them, and the commands that verify the result. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("DefinitionOfDone")
                    </FlareText>
                    @if (Stage is not { } required || required.RequiredArtifacts.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoRequiredArtifacts")
                        </FlareText>
                    }
                    else
                    {
                        @foreach (var requirement in required.RequiredArtifacts)
                        {
                            var item = requirement;
                            var present = HasArtifact(item.Path);
                            <FlareStack Gap="FlareSpacing.None" Class="aiko-tile">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                    <FlareIconView Value="@(present ? MaterialDesign3Icons.Regular.CheckCircle : MaterialDesign3Icons.Regular.RadioButtonUnchecked)"
                                                   Color="@(present ? FlareColor.Tertiary : FlareColor.OnSurfaceVariant2)" />
                                    <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@item.Path</FlareText>
                                    <span class="aiko-tag aiko-tag--quiet">@item.MissingPolicy</span>
                                </FlareStack>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @(present ? Loc.Get("ArtifactPresent") : Loc.Get("ArtifactMissing"))
                                    @if (item.Description is { Length: > 0 } description)
                                    {
                                        @($" · {description}")
                                    }
                                </FlareText>
                            </FlareStack>
                        }
                    }
                    @if (Stage is { Commands.Count: > 0 } verified)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("ValidationCommands")
                        </FlareText>
                        @foreach (var command in verified.Commands)
                        {
                            <span class="aiko-value aiko-value--clip" title="@command">@command</span>
                        }
                    }
                </FlareStack>
            </FlareStack>
        </FlarePaper>

        @* Everything the card has produced, in one block: what the last run reported, where the commit diff
           will stand, the artifacts themselves and the run history. The design keeps them behind one tab
           bar instead of stacking four panels, and a card is read one question at a time. The tabs are not
           lazy: a document half-written in the artifacts tab has to survive a look at the run history. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
            <FlareTabs ActiveIndex="_activeTab" ActiveIndexChanged="OnActiveTabChanged">
                <FlareTab Label="@Loc.Get("CompletedOutcomes")">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.CheckCircle" /></LeadingIcon>
                    <ChildContent>
                            <FlareStack Gap="FlareSpacing.Medium">
                            @if (LatestExecution is { } run)
                            {
                                @* The agent's own report, drawn as the design's synthesis block. *@
                                <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" Color="FlareColor.Primary" />
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                            @Loc.Get("AgentReport")
                                        </FlareText>
                                        <span class="aiko-tag @(IsRunning ? "aiko-tag--live" : null)">@RunStateCaption</span>
                                    </FlareStack>
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                        @(run.ProgressSummary is { Length: > 0 } summary ? summary : Loc.Get("NoRunSummary"))
                                    </FlareText>
                                </FlareStack>

                                @* The run's own numbers: what it took, what it carried, what it left outside the scope. *@
                                <div class="aiko-tiles aiko-tiles--three">
                                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                            @Loc.Get("AttemptsLabel")
                                        </FlareText>
                                        <span class="aiko-value">@DisplayFormat.Number(run.Attempts.Count)</span>
                                    </FlareStack>
                                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                            @Loc.Get("ArtifactsLabel")
                                        </FlareText>
                                        <span class="aiko-value">@DisplayFormat.Number(_artifacts.Count)</span>
                                    </FlareStack>
                                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                            @Loc.Get("OutOfScope")
                                        </FlareText>
                                        <span class="aiko-value @(OutOfScopeCount > 0 ? "aiko-value--warn" : null)">
                                            @DisplayFormat.Number(OutOfScopeCount)
                                        </span>
                                    </FlareStack>
                                </div>

                                @foreach (var step in run.CompletedSteps)
                                {
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.CheckCircle" Color="FlareColor.Tertiary" />
                                        <FlareText Element="span" Typo="TypographyScale.LabelMedium">@step</FlareText>
                                    </FlareStack>
                                }
                                @foreach (var step in run.RemainingSteps)
                                {
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.Pending" Color="FlareColor.OnSurfaceVariant2" />
                                        <FlareText Element="span" Typo="TypographyScale.LabelMedium">@step</FlareText>
                                    </FlareStack>
                                }
                                @if (run.Commits.Count > 0)
                                {
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                        @Loc.Get("ReportedCommits")
                                    </FlareText>
                                    @foreach (var commit in run.Commits)
                                    {
                                        var reported = commit;
                                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                            <span class="aiko-tag aiko-tag--accent">@(reported.Sha ?? Loc.Get("CommitPending"))</span>
                                            <FlareText Element="span" Typo="TypographyScale.LabelMedium">@reported.Message</FlareText>
                                        </FlareStack>
                                    }
                                }
                            }
                            else
                            {
                                <FlareEmptyState Compact="true" Title="@Loc.Get("NoExecutions")">
                                    <IconContent><FlareIconView Size="2rem" Value="@FlareIcons.PlayArrow" /></IconContent>
                                </FlareEmptyState>
                            }
                        </FlareStack>
                </ChildContent>
                </FlareTab>

                @* Where the design puts its code-diff viewer: the card's files, with the patch the git
                   client of this machine reports. Aiko does not reimplement git - the client is the
                   authority - so when there is none the block says exactly that. *@
                <FlareTab Label="@Loc.Get("CodeChanges")">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Difference" /></LeadingIcon>
                    <ChildContent>
                        @if (_loadingDiff)
                        {
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                <FlareProgressCircular Size="TrackSize.Xs" />
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    @Loc.Get("LoadingCodeChanges")
                                </FlareText>
                            </FlareStack>
                        }
                        else if (DiffIsReady)
                        {
                            @* One collapsible panel per file. A card's diff is read file by file, and a card that
                               touched a dozen files used to print every patch at once, so the one file the reader
                               came for was somewhere in a wall of text. Flare's accordion owns the toggle - a real
                               button carrying aria-expanded and aria-controls, reachable by keyboard like any other
                               button - and the panel draws its patch only while it is open, because a collapsed
                               file that still renders its lines would only move the wall of text into the DOM. *@
                            <FlareAccordion AllowMultiple="true" HeadingLevel="0">
                                @foreach (var file in _diff!.Files)
                                {
                                    var entry = file;
                                    var expanded = _expandedFiles.Contains(entry.Path);
                                    <FlareAccordionPanel Expanded="@expanded"
                                                         ExpandedChanged="@(value => SetFileExpanded(entry.Path, value))">
                                        @* The header is the file's own row: its path and what the patch does to it.
                                           Spans rather than a stack, because the accordion renders the header inside
                                           the toggle button, which takes phrasing content. *@
                                        <HeaderContent>
                                            <span class="aiko-diff__file">
                                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Description" Color="FlareColor.Secondary" />
                                                <span class="aiko-diff__path">@entry.Path</span>
                                                @if (entry.Added > 0)
                                                {
                                                    <span class="aiko-tag aiko-tag--live">@($"+{entry.Added}")</span>
                                                }
                                                @if (entry.Removed > 0)
                                                {
                                                    <span class="aiko-tag aiko-tag--warn">@($"-{entry.Removed}")</span>
                                                }
                                            </span>
                                        </HeaderContent>
                                        <ChildContent>
                                            @if (expanded && entry.Patch is { Length: > 0 } patch)
                                            {
                                                <div class="aiko-diff__lines">
                                                    @foreach (var line in PatchLines(patch))
                                                    {
                                                        var text = line;
                                                        <span class="aiko-diff__line aiko-diff__line--@DiffLineKind(text)">@text</span>
                                                    }
                                                </div>
                                            }
                                            else if (expanded)
                                            {
                                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                                    @Loc.Get("DiffBinaryOrEmpty")
                                                </FlareText>
                                            }
                                        </ChildContent>
                                    </FlareAccordionPanel>
                                }
                            </FlareAccordion>
                        }
                        else
                        {
                            <div class="aiko-placeholder">
                                <span>@DiffStatusCaption</span>
                                <span>@Loc.Get("CodeChangesPlan")</span>
                            </div>
                        }
                    </ChildContent>
                </FlareTab>

                @* The artifacts the card owns, edited in place. *@
                <FlareTab Label="@ArtifactsTabLabel">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Description" /></LeadingIcon>
                    <ChildContent>
                        <ArtifactEditor Card="Card" Board="Board" Executions="_executions" ShowHeading="false" />
                    </ChildContent>
                </FlareTab>

                @* The card's discussion: what people and agents said about this card, and the box to add to
                   it. A note is authored content, so it is stored in the card's own folder - see the
                   discussion store - and it survives anything happening to the daemon. *@
                <FlareTab Label="@DiscussionTabLabel">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Forum" /></LeadingIcon>
                    <ChildContent>
                        <FlareStack Gap="FlareSpacing.Medium">
                            @if (_loadingDiscussion)
                            {
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareProgressCircular Size="TrackSize.Xs" />
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                        @Loc.Get("LoadingDiscussion")
                                    </FlareText>
                                </FlareStack>
                            }
                            else if (_discussion.Count == 0)
                            {
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    @Loc.Get("DiscussionNone")
                                </FlareText>
                            }
                            else
                            {
                                @foreach (var comment in _discussion.OrderByDescending(entry => entry.CreatedAtUtc))
                                {
                                    var note = comment;
                                    <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                                        <FlareStack Gap="FlareSpacing.XSmall">
                                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                                <span class="aiko-panel__icon aiko-panel__icon--primary">
                                                    <FlareIconView Value="@(IsAgent(note.Author) ? MaterialDesign3Icons.Regular.SmartToy : MaterialDesign3Icons.Regular.Person)" />
                                                </span>
                                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Weight="FontWeight.SemiBold">
                                                    @note.Author
                                                </FlareText>
                                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                                    @RelativeTime(note.CreatedAtUtc)
                                                </FlareText>
                                            </FlareStack>
                                            <span class="aiko-tile">@note.Body</span>
                                        </FlareStack>
                                    </FlarePaper>
                                }
                            }

                            @* The console: a note, and the commands an agent understands. Nothing is launched
                               from here - the daemon records work and the agent runs in the user's terminal -
                               so the chips fill the box instead of pretending to run something. *@
                            <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareIconView Value="@MaterialDesign3Icons.Regular.Terminal" Color="FlareColor.Primary" />
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                        @Loc.Get("LeaveTaskNote")
                                    </FlareText>
                                </FlareStack>
                                <AikoField Label="@Loc.Get("TaskNote")"
                                           Value="@_commentBody"
                                           ValueChanged="value => _commentBody = value"
                                           Rows="3"
                                           Hint="@Loc.Get("TaskNoteHint")" />
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                        @foreach (var command in PromptShortcuts)
                                        {
                                            var shortcut = command;
                                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                                         OnClick="() => _commentBody = AppendPrompt(_commentBody, shortcut)">
                                                <ChildContent>@shortcut</ChildContent>
                                            </FlareButton>
                                        }
                                    </FlareStack>
                                    <FlareButton Variant="ButtonVariant.Filled"
                                                 Size="ButtonSize.Sm"
                                                 Disabled="@(string.IsNullOrWhiteSpace(_commentBody))"
                                                 Loading="@_postingComment"
                                                 OnClick="PostCommentAsync">
                                        <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Send" /></LeadingIcon>
                                        <ChildContent>@Loc.Get("Comment")</ChildContent>
                                    </FlareButton>
                                </FlareStack>
                            </FlareStack>
                        </FlareStack>
                    </ChildContent>
                </FlareTab>

                @* Every run of this card, newest first. *@
                <FlareTab Label="@RunsTabLabel">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.History" /></LeadingIcon>
                    <ChildContent>
                            @* Steering the work. Every action the daemon offers for a run has a control here, and
                               the caption above the buttons names the run they touch. The calls go to the
                               execution endpoints the coordinator backs, so a button cannot behave differently
                               from the agent's tool. *@
                            <FlarePaper Class="aiko-tile">
                                <FlareStack Gap="FlareSpacing.XSmall">
                                    <FlareText Element="span" Typo="TypographyScale.TitleSmall">
                                        @Loc.Get("ExecutionActions")
                                    </FlareText>
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                        @(LatestExecution is { } steering
                                            ? $"{steering.StageId} · {steering.State}"
                                            : Loc.Get("NoExecutions"))
                                    </FlareText>
                                    @* Putting the card away is neither a stage nor a run: it is a property of the
                                       card, so it stands on its own row rather than among the buttons that steer a
                                       run. The offer follows the rule the daemon enforces - the card reaches the
                                       end of its own pipeline first - so the button is never drawn where it would
                                       be refused, and where it is not offered the row says why. *@
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                        @if (Card.IsArchived)
                                        {
                                            <FlareButton Variant="ButtonVariant.Tonal"
                                                         Disabled="@_acting"
                                                         Title="@Loc.Get("RestoreCardHint")"
                                                         OnClick="RestoreCardAsync">
                                                <ChildContent>@Loc.Get("RestoreCard")</ChildContent>
                                            </FlareButton>
                                        }
                                        else if (IsFinished)
                                        {
                                            <FlareButton Variant="ButtonVariant.Outlined"
                                                         Disabled="@_acting"
                                                         Title="@Loc.Get("ArchiveCardHint")"
                                                         OnClick="ArchiveCardAsync">
                                                <ChildContent>@Loc.Get("ArchiveCard")</ChildContent>
                                            </FlareButton>
                                        }
                                        else
                                        {
                                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                                @Loc.Get("ArchiveNotFinished")
                                            </FlareText>
                                        }
                                    </FlareStack>
                                    @if (Agents.Count > 0)
                                    {
                                        <AikoSelectField Label="@Loc.Get("EstimateAgent")"
                                                         Value="@_stageAgent"
                                                         ValueChanged="value => _stageAgent = value">
                                            @foreach (var agent in Agents)
                                            {
                                                var option = agent;
                                                <option value="@option.Id">@option.DisplayName</option>
                                            }
                                        </AikoSelectField>
                                    }
                                    <FlareStack Row="true" Wrap="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareButton Variant="ButtonVariant.Tonal"
                                                     Disabled="@(string.IsNullOrWhiteSpace(_stageAgent) || _acting)"
                                                     Loading="@_acting"
                                                     OnClick="StartStageAsync">
                                            <ChildContent>@Loc.Get("StartStage")</ChildContent>
                                        </FlareButton>
                                        @if (LatestExecution is { } run)
                                        {
                                            @if (run.State is StageExecutionState.Running)
                                            {
                                                <FlareButton Variant="ButtonVariant.Outlined" Disabled="@_acting" OnClick="PauseRunAsync">
                                                    <ChildContent>@Loc.Get("PauseRun")</ChildContent>
                                                </FlareButton>
                                                <FlareButton Variant="ButtonVariant.Outlined" Disabled="@_acting" OnClick="CompleteRunAsync">
                                                    <ChildContent>@Loc.Get("CompleteRun")</ChildContent>
                                                </FlareButton>
                                            }
                                            else if (run.State is not (StageExecutionState.Completed or StageExecutionState.Cancelled))
                                            {
                                                <FlareButton Variant="ButtonVariant.Outlined"
                                                             Disabled="@(string.IsNullOrWhiteSpace(_stageAgent) || _acting)"
                                                             OnClick="ResumeRunAsync">
                                                    <ChildContent>@Loc.Get("ResumeRun")</ChildContent>
                                                </FlareButton>
                                            }
                                            <FlareButton Variant="ButtonVariant.Outlined"
                                                         Disabled="@(string.IsNullOrWhiteSpace(_stageAgent) || _acting)"
                                                         OnClick="HandoffRunAsync">
                                                <ChildContent>@Loc.Get("HandoffRun")</ChildContent>
                                            </FlareButton>
                                            @if (run.State is not (StageExecutionState.Completed or StageExecutionState.Cancelled))
                                            {
                                                <FlareButton Variant="ButtonVariant.Text" Disabled="@_acting" OnClick="CancelRunAsync">
                                                    <ChildContent>@Loc.Get("CancelRun")</ChildContent>
                                                </FlareButton>
                                            }
                                            @if (run.State is StageExecutionState.WaitingForUser)
                                            {
                                                @if (run.RequestedScopeFiles.Count > 0)
                                                {
                                                    <FlareButton Variant="ButtonVariant.Outlined"
                                                                 Disabled="@(string.IsNullOrWhiteSpace(_stageAgent) || _acting)"
                                                                 OnClick="ApproveScopeAsync">
                                                        <ChildContent>@Loc.Get("ApproveScope")</ChildContent>
                                                    </FlareButton>
                                                }
                                                <FlareButton Variant="ButtonVariant.Text" Disabled="@_acting" OnClick="RefuseScopeAsync">
                                                    <ChildContent>@Loc.Get("RefuseScope")</ChildContent>
                                                </FlareButton>
                                                <FlareButton Variant="ButtonVariant.Outlined" Disabled="@_acting" OnClick="ApproveCommitAsync">
                                                    <ChildContent>@Loc.Get("ApproveCommit")</ChildContent>
                                                </FlareButton>
                                                <FlareButton Variant="ButtonVariant.Text" Disabled="@_acting" OnClick="RejectCommitAsync">
                                                    <ChildContent>@Loc.Get("RejectCommit")</ChildContent>
                                                </FlareButton>
                                            }
                                        }
                                        @if (_executionMessage is { Length: > 0 } executionMessage)
                                        {
                                            <FlareText Element="span" Typo="TypographyScale.LabelSmall"
                                                       Color="@(_executionError ? FlareColor.Error : FlareColor.Tertiary)">
                                                @executionMessage
                                            </FlareText>
                                        }
                                    </FlareStack>
                                </FlareStack>
                            </FlarePaper>
                            <FlareStack Gap="FlareSpacing.Medium">
                            @if (_loadingExecutions)
                            {
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareProgressCircular Size="TrackSize.Xs" />
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                        @Loc.Get("LoadingHistory")
                                    </FlareText>
                                </FlareStack>
                            }
                            else if (_executions.Count == 0)
                            {
                                <FlareEmptyState Compact="true" Title="@Loc.Get("NoExecutions")">
                                    <IconContent><FlareIconView Size="2rem" Value="@FlareIcons.PlayArrow" /></IconContent>
                                </FlareEmptyState>
                            }
                            else
                            {
                                <FlareTimeline>
                                    @foreach (var execution in _executions.OrderByDescending(item => item.UpdatedAt))
                                    {
                                        <FlareTimelineItem Title="@execution.StageId" Color="@StateColor(execution.State)">
                                            <FlareStack Gap="FlareSpacing.XXSmall">
                                                <FlareBadge Standalone="true"
                                                            Text="@execution.State.ToString()"
                                                            Color="@StateColor(execution.State)" />
                                                @if (!string.IsNullOrWhiteSpace(execution.ProgressSummary))
                                                {
                                                    <FlareText Element="span" Typo="TypographyScale.BodySmall">@execution.ProgressSummary</FlareText>
                                                }
                                                @foreach (var attempt in execution.Attempts)
                                                {
                                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall">@attempt.AgentAdapterId</FlareText>
                                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                                                            @attempt.State
                                                        </FlareText>
                                                    </FlareStack>
                                                }
                                                @if (execution.Artifacts.Count > 0)
                                                {
                                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                                                        @Loc.Format("ArtifactsLabel", string.Join(", ", execution.Artifacts))
                                                    </FlareText>
                                                }
                                            </FlareStack>
                                        </FlareTimelineItem>
                                    }
                                </FlareTimeline>
                            }
                        </FlareStack>
                    </ChildContent>
                </FlareTab>
            </FlareTabs>
        </FlarePaper>

    </FlareStack>

    @* The state column: the design's inspector aside. *@
    <FlareStack Class="aiko-card__side" Gap="FlareSpacing.Medium">

        @* Where this card came in from. A card an agent filed into another project carries its origin, and
           without it the board of two projects read as one project's work. It stands first in the aside
           because it changes how everything below it is read. The link is built only when the source project
           is registered and the originating card is named: the route carries a handle, and a project nobody
           registered has none. *@
        @if (Card.Origin is { } origin)
        {
            <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("CardOriginTitle")
                        </FlareText>
                        <span class="aiko-tag aiko-tag--accent">@Loc.Get("CardOriginTag")</span>
                    </FlareStack>
                    @if (OriginCardHref is { Length: > 0 } originHref)
                    {
                        <FlareNavLink Href="@originHref" Class="aiko-card__row">
                            <IconContent>
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.AccountTree" Color="FlareColor.Secondary" />
                            </IconContent>
                            <ChildContent>
                                <FlareStack Row="true" Align="FlareAlignItems.Center"
                                            Justify="FlareJustifyContent.SpaceBetween"
                                            Gap="FlareSpacing.XSmall" Class="aiko-card__row-body">
                                    <FlareStack Gap="FlareSpacing.None">
                                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                            <span class="aiko-value">@OriginProjectCaption(origin)</span>
                                            @if (origin.CardId is { Length: > 0 } originCardId)
                                            {
                                                <span class="aiko-tag aiko-tag--quiet">@originCardId</span>
                                            }
                                        </FlareStack>
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                            @OriginDetail(origin)
                                        </FlareText>
                                    </FlareStack>
                                    <FlareIconView Value="@MaterialDesign3Icons.Regular.ChevronRight"
                                                   Color="FlareColor.OnSurfaceVariant2" />
                                </FlareStack>
                            </ChildContent>
                        </FlareNavLink>
                    }
                    else
                    {
                        <FlareStack Gap="FlareSpacing.None">
                            <span class="aiko-value">@OriginProjectCaption(origin)</span>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @OriginDetail(origin)
                            </FlareText>
                        </FlareStack>
                    }
                </FlareStack>
            </FlarePaper>
        }

        @* Where the card is and who has run it: the stage it sits in, the state of its latest run, and the
           agents that run passed through. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                    @Loc.Get("ExecutionState")
                </FlareText>

                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("WorkflowStatus")
                    </FlareText>
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween"
                                Gap="FlareSpacing.XSmall" Class="aiko-tile">
                        <span class="aiko-tag @(IsRunning ? "aiko-tag--live" : null)">
                            @if (IsRunning)
                            {
                                <span class="aiko-dot aiko-dot--pulse"></span>
                            }
                            @RunStateCaption
                        </span>
                        <span class="aiko-tag aiko-tag--quiet" style="@StageAppearance.TagStyle(Stage)">
                            @if (StageAppearance.Icon(Stage) is { } stageIcon)
                            {
                                <FlareIconView Value="stageIcon" Size="1em" />
                            }
                            @StageCaption
                        </span>
                    </FlareStack>
                </FlareStack>

                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("ActiveAssignees")
                    </FlareText>
                    @if (Assignees.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoActiveAssignees")
                        </FlareText>
                    }
                    else
                    {
                        @foreach (var assignee in Assignees)
                        {
                            var agent = assignee;
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween"
                                        Gap="FlareSpacing.XSmall" Class="aiko-tile">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareAvatar Text="@DisplayFormat.Initials(agent)"
                                                 Size="AvatarSize.Xs"
                                                 Shape="AvatarShape.Square" />
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall">@agent</FlareText>
                                </FlareStack>
                                <span class="aiko-tag aiko-tag--accent">@Loc.Get("RoleAgent")</span>
                            </FlareStack>
                        }
                    }
                </FlareStack>
            </FlareStack>
        </FlarePaper>

        <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                @* A command for an agent: what the estimate block in the panel below could not be. Aiko still does not run
                   an agent process, so this places the request in the project's own queue and shows what the
                   queue says about it - waiting, or taken by an agent that will report back. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("CommandsTitle")
                    </FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("CommandsHint")
                    </FlareText>
                    @if (Agents.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoAgentsDiscovered")
                        </FlareText>
                    }
                    else
                    {
                        <AikoSelectField Label="@Loc.Get("CommandAction")"
                                         Value="@_commandAction"
                                         ValueChanged="value => _commandAction = value ?? CommandStartValue">
                            <option value="@CommandStartValue">@Loc.Get("CommandStart")</option>
                            <option value="@CommandPauseValue">@Loc.Get("CommandPause")</option>
                            <option value="@CommandResumeValue">@Loc.Get("CommandResume")</option>
                            <option value="@CommandAnswerValue">@Loc.Get("CommandAnswer")</option>
                        </AikoSelectField>
                        <AikoSelectField Label="@Loc.Get("EstimateAgent")"
                                         Value="@_commandAgent"
                                         ValueChanged="value => _commandAgent = value">
                            @foreach (var agent in Agents)
                            {
                                var option = agent;
                                <option value="@option.Id">@option.DisplayName</option>
                            }
                        </AikoSelectField>
                        @if (CommandNeedsText)
                        {
                            <AikoField Label="@Loc.Get("CommandText")"
                                       Hint="@CommandTextHint"
                                       Rows="2"
                                       Value="@_commandText"
                                       ValueChanged="value => _commandText = value" />
                        }
                        <FlareButton Variant="ButtonVariant.Tonal"
                                     FullWidth="true"
                                     Disabled="@(!CanPlaceCommand)"
                                     Loading="@_placingCommand"
                                     OnClick="PlaceCommandAsync">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" /></LeadingIcon>
                            <ChildContent>@Loc.Get("PlaceCommand")</ChildContent>
                        </FlareButton>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @CommandTargetHint
                        </FlareText>
                    }
                    @if (_commandMessage is { Length: > 0 } commandMessage)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall"
                                   Color="@(_commandError ? FlareColor.Error : FlareColor.Tertiary)">
                            @commandMessage
                        </FlareText>
                    }
                    @* What was asked and what came of it: read from the queue itself, never from what this
                       screen remembers, so a command another tab placed, or one an agent has just taken,
                       shows here as it is. A closed command stays on the card with the message the agent
                       left - otherwise a request that failed disappears and reads like one never placed. *@
                    @foreach (var command in CardCommands)
                    {
                        var entry = command;
                        <FlareStack Gap="FlareSpacing.XXSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center"
                                        Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                    <FlareText Element="span" Mono="true" Typo="TypographyScale.BodySmall">@entry.Id</FlareText>
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant2">
                                        @CommandCaption(entry)
                                    </FlareText>
                                </FlareStack>
                                <span class="aiko-tag @CommandBadgeClass(entry)">@CommandStateCaption(entry)</span>
                            </FlareStack>
                            @if (entry.Message is { Length: > 0 } message)
                            {
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @message
                                </FlareText>
                            }
                        </FlareStack>
                    }
                    @* The same request, said as the thing a person types: the block above places it in the
                       queue, these two run the card themselves. They carry this card's number already, and
                       they copy like the number does - one copy control, not a third way of doing it. *@
                    <FlareStack Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("CommandExamples")
                        </FlareText>
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                            @foreach (var command in RunCommands)
                            {
                                var example = command;
                                <span class="aiko-copy">
                                    <FlareClipboard Text="@example"
                                                    Variant="ButtonVariant.Text"
                                                    Size="ButtonSize.Sm">
                                        <ChildContent>
                                            <FlareText Element="span" Mono="true" Typo="TypographyScale.BodySmall">
                                                @example
                                            </FlareText>
                                        </ChildContent>
                                    </FlareClipboard>
                                </span>
                            }
                        </FlareStack>
                    </FlareStack>
                </FlareStack>
            </FlareStack>
        </FlarePaper>

        @* What the daemon computed for this card, and what a person can change about it: the effective
           priority, the rank it earns among the board's cards, the size step from the project's grid and
           the values behind the score. The size and the criteria live here rather than in a panel of their
           own, because this is the block that reads the number they produce. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("TriageScore")
                    </FlareText>
                    @if (PriorityRank is { } rank)
                    {
                        <span class="aiko-tag aiko-tag--accent">@Loc.Format("RankOf", DisplayFormat.Number(rank))</span>
                    }
                </FlareStack>

                <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.End" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("EffectivePriority")
                        </FlareText>
                        <span class="aiko-value aiko-value--big">@PriorityCaption</span>
                    </FlareStack>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Format("PriorityOf", Number(Card.OwnPriority))
                    </FlareText>
                    <span class="aiko-value aiko-value--formula">@Loc.Get("PriorityFormulaExpression")</span>
                </FlareStack>

                <div class="aiko-tiles">
                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("CardKind")
                        </FlareText>
                        <span class="aiko-value">@Card.Kind</span>
                    </FlareStack>
                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("FilesActual")
                        </FlareText>
                        <span class="aiko-value">@DisplayFormat.Number(Card.ActualChangedFiles.Count)</span>
                    </FlareStack>
                </div>

                @* Which release this card went into, when one named it. A card no release named gets no line at
                   all: the answer is an absence, and an empty line would read as a value that went missing
                   rather than as "not in any release". *@
                @if (_release is { } release)
                {
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                        <span class="aiko-tag aiko-tag--accent">@Loc.Get("ReleaseCardTag")</span>
                        <FlareNavLink Href="@ProjectRoutes.ReleaseRecord(Board.Project.Handle, release.Version)">
                            <ChildContent>@Loc.Format("ReleaseCardLine", release.Version)</ChildContent>
                        </FlareNavLink>
                    </FlareStack>
                }

                @* The size step the agent assigns from the project's grid, and what it does to the score. *@
                <AikoSelectField Label="@Loc.Get("SizeIdLabel")"
                                 Value="@_size"
                                 ValueChanged="value => _size = value"
                                 Hint="@SizeHint">
                    <option value="">@Loc.Get("NoSize")</option>
                    @foreach (var step in SizeGrid)
                    {
                        var option = step;
                        <option value="@option.Id">@SizeOption(option)</option>
                    }
                </AikoSelectField>

                @* Every criterion the project scores by, in the project's order: a card with no value for one
                   is scored as if that criterion did not exist, so the person editing the card sees them all,
                   each with the band its value is read against. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("ScoringCriteria")
                        </FlareText>
                        <span class="aiko-tag aiko-tag--quiet">@DisplayFormat.Number(Criteria.Count)</span>
                    </FlareStack>
                    @if (Criteria.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoCriteria")
                        </FlareText>
                    }
                    else
                    {
                        @foreach (var criterion in Criteria)
                        {
                            var item = criterion;
                            <AikoNumberField Label="@item.Title"
                                             Hint="@CriterionRange(item)"
                                             Value="@CriterionValue(item.Id)"
                                             ValueChanged="value => SetCriterion(item.Id, value)" />
                        }
                    }
                </FlareStack>

                @* The estimate the person left to the machine: pick the agent, and Aiko records the request
                   and shows the command to run. Nothing is launched from here - the daemon cannot start an
                   agent yet - so the block says exactly what to run in that agent's terminal. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("EstimateTitle")
                    </FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("EstimateHint")
                    </FlareText>
                    @if (Agents.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoAgentsDiscovered")
                        </FlareText>
                    }
                    else
                    {
                        <AikoSelectField Label="@Loc.Get("EstimateAgent")"
                                         Value="@_estimateAgent"
                                         ValueChanged="value => _estimateAgent = value">
                            @foreach (var agent in Agents)
                            {
                                var option = agent;
                                <option value="@option.Id">@option.DisplayName</option>
                            }
                        </AikoSelectField>
                        <FlareButton Variant="ButtonVariant.Tonal"
                                     FullWidth="true"
                                     Disabled="@(string.IsNullOrWhiteSpace(_estimateAgent))"
                                     Loading="@_sendingEstimate"
                                     OnClick="RequestEstimateAsync">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" /></LeadingIcon>
                            <ChildContent>@Loc.Get("EstimateCard")</ChildContent>
                        </FlareButton>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Format("EstimateCommandHint", EstimateCommand)
                        </FlareText>
                    }
                    @if (_estimateMessage is { Length: > 0 } estimateMessage)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall"
                                   Color="@(_estimateError ? FlareColor.Error : FlareColor.Tertiary)">
                            @estimateMessage
                        </FlareText>
                    }
                </FlareStack>

                <FlareButton FullWidth="true"
                             Loading="@_saving"
                             OnClick="SaveAsync">@Loc.Get("SaveCard")</FlareButton>
            </FlareStack>
        </FlarePaper>

        @* What this card is linked to. A parent-child edge is written from the parent to the child, so the
           end this card sits on is what separates its parents from its children; everything else - a story
           a task implements, a card that blocks another, a plain relation - is one list. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Small">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("RelatedCards")
                    </FlareText>
                    <span class="aiko-tag aiko-tag--quiet">@DisplayFormat.Number(Relations.Count)</span>
                </FlareStack>
                @if (_relationMessage is { Length: > 0 } relationMessage)
                {
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.Error">
                        @relationMessage
                    </FlareText>
                }
                @if (Relations.Count == 0)
                {
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("NoRelations")
                    </FlareText>
                }
                else
                {
                    @foreach (var group in RelationGroups)
                    {
                        var bucket = group;
                        <FlareStack Gap="FlareSpacing.XXSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                <FlareIconView Value="@bucket.Icon" Color="@bucket.Color" />
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @bucket.Label
                                </FlareText>
                            </FlareStack>
                            @foreach (var relation in bucket.Relations)
                            {
                                var link = relation;
                                @* The link and the way to take it back, side by side: a button cannot sit inside
                                   the link, and a mistaken "blocks" used to be removable only by editing a file. *@
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall"
                                            Class="aiko-card__link-row">
                                <FlareNavLink Href="@CardHref(OtherCardId(link))" Class="aiko-card__row">
                                    <IconContent>
                                        <FlareIconView Value="@bucket.Icon" Color="@bucket.Color" />
                                    </IconContent>
                                    <ChildContent>
                                        <FlareStack Row="true" Align="FlareAlignItems.Center"
                                                    Justify="FlareJustifyContent.SpaceBetween"
                                                    Gap="FlareSpacing.XSmall" Class="aiko-card__row-body">
                                            <FlareStack Gap="FlareSpacing.None">
                                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                                    <span class="aiko-value">@OtherCardId(link)</span>
                                                    @* Which column the related card stands in, named the way the card's own
                                                       header names its stage. It is a different fact from the state badge
                                                       below: that one says where the column's run got to, this one says where
                                                       the card is - and a card the snapshot does not hold says neither. *@
                                                    @if (RelatedStageCaption(link) is { Length: > 0 } relatedStage)
                                                    {
                                                        <span class="aiko-tag aiko-tag--quiet">@relatedStage</span>
                                                    }
                                                    @if (RelationTag(link) is { Length: > 0 } tag)
                                                    {
                                                        <span class="aiko-tag aiko-tag--quiet">@tag</span>
                                                    }
                                                    @* Where the related card stands right now, drawn the one way a status is
                                                       drawn: the same badge the board and this card's own header use, so the
                                                       three cannot disagree about what a state looks like. Asked only for a
                                                       card the snapshot holds - a relation to a card nobody carries says
                                                       nothing, and "pending" would be an answer nobody gave. *@
                                                    @if (RelatedStageState(link) is { } relatedState)
                                                    {
                                                        <span class="aiko-tag @StageStateView.TagClass(relatedState)"
                                                              title="@Loc.Get(StageStateView.LabelKey(relatedState))">
                                                            @Loc.Get(StageStateView.LabelKey(relatedState))
                                                        </span>
                                                    }
                                                </FlareStack>
                                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                                    @OtherCardTitle(link)
                                                </FlareText>
                                            </FlareStack>
                                            <FlareIconView Value="@MaterialDesign3Icons.Regular.ChevronRight"
                                                           Color="FlareColor.OnSurfaceVariant2" />
                                        </FlareStack>
                                    </ChildContent>
                                </FlareNavLink>
                                <FlareIconButton Variant="ButtonVariant.Text"
                                                 Icon="@MaterialDesign3Icons.Regular.LinkOff"
                                                 AriaLabel="@Loc.Get("RemoveLink")"
                                                 Disabled="@_unlinking"
                                                 OnClick="@(() => UnlinkAsync(link))" />
                                </FlareStack>
                            }
                        </FlareStack>
                    }
                }
            </FlareStack>
        </FlarePaper>

        @* How far the stage's own definition of done has got: the artifacts it asks for, resolved. *@
        @if (Stage is { RequiredArtifacts.Count: > 0 } dod)
        {
            <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("DefinitionOfDone")
                        </FlareText>
                        <span class="aiko-value">@Loc.Format("ResolvedOf", ResolvedArtifacts, dod.RequiredArtifacts.Count)</span>
                    </FlareStack>
                    <span class="aiko-bar">
                        <span class="aiko-bar__fill" style="@($"width: {DodShare}%")"></span>
                    </span>
                    @foreach (var requirement in dod.RequiredArtifacts)
                    {
                        var item = requirement;
                        var present = HasArtifact(item.Path);
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@(present ? MaterialDesign3Icons.Regular.CheckCircle : MaterialDesign3Icons.Regular.RadioButtonUnchecked)"
                                           Color="@(present ? FlareColor.Tertiary : FlareColor.OnSurfaceVariant2)" />
                            <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@item.Path</FlareText>
                        </FlareStack>
                    }
                </FlareStack>
            </FlarePaper>
        }

        @* The skills the stage adds around its instruction, as the design's bridge chips. *@
        @if (Stage is { } bridge && (bridge.BeforeSkills.Count > 0 || bridge.AfterSkills.Count > 0))
        {
            <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("StageSkills")
                    </FlareText>
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                        @foreach (var skill in bridge.BeforeSkills)
                        {
                            <span class="aiko-tag aiko-tag--live">@skill</span>
                        }
                        @foreach (var skill in bridge.AfterSkills)
                        {
                            <span class="aiko-tag aiko-tag--accent">@skill</span>
                        }
                    </FlareStack>
                </FlareStack>
            </FlarePaper>
        }

    </FlareStack>
</div>

@* Editing the card's identity. The title is the one field that belongs in the banner rather than in a
   panel - the banner already prints it - so the design's "Edit card" action opens this drawer instead of
   a form living permanently in the sidebar. *@
<FlareDrawer Anchor="DrawerAnchor.Right"
             Open="EditOpen"
             OpenChanged="OnEditOpenChanged"
             Width="28rem"
             ContentPadding="FlareSpacing.Large"
             AriaLabel="@Loc.Get("EditCard")">
    <HeaderContent>
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                @Loc.Get("EditCard")
            </FlareText>
            <FlareText Element="h3" Mono="true" Typo="TypographyScale.TitleMedium">@($"#{Card.Reference.CardId}")</FlareText>
        </FlareStack>
    </HeaderContent>
    <ChildContent>
        <FlareStack Gap="FlareSpacing.Small">
            <AikoField Label="@Loc.Get("Title")"
                       Value="@_title"
                       ValueChanged="value => _title = value"
                       Placeholder="@Loc.Get("Title")" />
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                @Loc.Get("EditCardHint")
            </FlareText>
            <FlareButton FullWidth="true"
                         Loading="@_saving"
                         OnClick="SaveAsync">@Loc.Get("SaveCard")</FlareButton>
        </FlareStack>
    </ChildContent>
</FlareDrawer>

@code {
    [Parameter, EditorRequired] public Card Card { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectBoardSnapshot Board { get; set; } = null!;
    [Parameter] public int ExecutionRefreshTick { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Whether the identity editor is open. The card page owns the toolbar button that opens it, so the
    /// flag travels down as a parameter rather than a second copy of the card's form living here.
    /// </summary>
    [Parameter] public bool EditOpen { get; set; }

    /// <summary>Raised when the identity editor opens or closes.</summary>
    [Parameter] public EventCallback<bool> EditOpenChanged { get; set; }

    private Task OnEditOpenChanged(bool open)
    {
        // Closing the drawer without saving puts the title back: the drawer is where the title is edited, and
        // leaving it is the person's "never mind" - otherwise the abandoned title would go out with the next
        // save of some other field.
        if (!open && _baseline is not null)
        {
            _title = _baseline.Title;
        }

        return EditOpenChanged.InvokeAsync(open);
    }

    private string? _loadedCardKey;
    private int _lastRefreshTick;
    private string? _title;
    private decimal? _priority;
    private string? _size;
    private string? _scope;
    private string? _requirements;

    /// <summary>
    /// The original request as the form holds it: what the user asked for, in their own words. It is the third
    /// text of the card and the only one the daemon may refuse to store once the card has left the backlog.
    /// </summary>
    private string? _request;
    private string? _estimateAgent;
    private string? _estimateMessage;
    private bool _estimateError;
    private bool _sendingEstimate;
    private string? _commandAction = CommandStartValue;
    private string? _commandAgent;
    private string? _commandText;
    private string? _commandMessage;
    private bool _commandError;
    private bool _placingCommand;

    /// <summary>
    /// The actions a command can name, written as the queue's own wire values.
    /// </summary>
    /// <remarks>
    /// Held here rather than taken from the domain enum because the select's option values, the request and
    /// the domain's parsing all have to agree on the same strings, and a literal repeated in three places is
    /// where they would stop agreeing.
    /// </remarks>
    private const string CommandStartValue = "start";
    private const string CommandPauseValue = "pause";
    private const string CommandResumeValue = "resume";
    private const string CommandAnswerValue = "answer";
    private string? _priorityError;
    private string? _message;
    private bool _hasError;
    private bool _saving;
    private bool _loadingExecutions;
    private int _activeTab;

    /// <summary>The selected tab of the scope block, independent of the produced-work tabs below it.</summary>
    private int _scopeTab;

    /// <summary>
    /// The selected tab of the text block (request / requirements / scope). Kept like the other tab indices so a
    /// live board refresh does not send the reader back to the first tab.
    /// </summary>
    private int _textTab;
    private IReadOnlyList<StageExecution> _executions = [];
    private IReadOnlyList<CardArtifactSummary> _artifacts = [];
    private ReleaseView? _release;
    private GitCardDiff? _diff;
    private bool _loadingDiff;

    /// <summary>
    /// Which files of the code-changes block the reader opened. Keyed by path, so opening one file cannot close
    /// another and a live board refresh - which re-renders the tab - does not fold the patch being read.
    /// </summary>
    private readonly HashSet<string> _expandedFiles = new(StringComparer.Ordinal);
    private IReadOnlyList<CardComment> _discussion = [];

    /// <summary>The tab counts the bar was last rendered with, so the settle pass below runs once per change.</summary>
    private string _renderedTabCounts = string.Empty;
    private bool _loadingDiscussion;
    private bool _postingComment;
    private string? _commentBody;

    /// <summary>The agent the steering panel starts, resumes or hands a run to.</summary>
    private string? _stageAgent;

    /// <summary>True while a life-cycle action is in flight, so a button cannot be pressed twice.</summary>
    private bool _acting;
    private string? _executionMessage;
    private string? _relationMessage;
    private bool _unlinking;

    /// <summary>
    /// Takes a link back, after asking: the board is read again afterwards, so the link leaves the panel and the
    /// card it held back is free on the board at once. A link someone else already removed is not an error.
    /// </summary>
    private async Task UnlinkAsync(CardRelation relation)
    {
        if (_unlinking || !await Js.InvokeAsync<bool>("confirm", Loc.Format("UnlinkConfirm", OtherCardId(relation))))
        {
            return;
        }

        _unlinking = true;
        _relationMessage = null;
        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/relations/{Uri.EscapeDataString(relation.Id)}");
            if (response.StatusCode != System.Net.HttpStatusCode.NotFound)
            {
                response.EnsureSuccessStatusCode();
            }

            await State.LoadBoardAsync();
        }
        catch (Exception exception)
        {
            _relationMessage = Loc.Format("UnlinkFailed", FailureText.Describe(exception));
        }
        finally
        {
            _unlinking = false;
        }
    }
    private bool _executionError;

    /// <summary>The commands the console offers: the ones this product's agents answer to.</summary>
    private static readonly string[] PromptShortcuts = ["/benchmark", "/leak-check"];
    private readonly Dictionary<string, decimal?> _criterionValues = new(StringComparer.Ordinal);

    /// <summary>The agent adapters the daemon found, for the estimate picker.</summary>
    private IReadOnlyList<AgentAdapterOption> Agents => State.Agents;

    /// <summary>The command that runs this card's estimate in the chosen agent's terminal.</summary>
    private string EstimateCommand => $"/aiko-estimate {Card.Reference.CardId}";

    /// <summary>
    /// The commands that run this card in a terminal, with this card's own number already in them: what the
    /// block above places as a request, written as the thing a person types. Built the same way the
    /// estimate's command is, from the card's own reference.
    /// </summary>
    private IReadOnlyList<string> RunCommands =>
    [
        $"/aiko-run {Card.Reference.CardId}",
        $"/aiko-run {Card.Reference.CardId} --all"
    ];

    /// <summary>
    /// The stage the card sits in, from its own workflow: what it expects to be produced (the artifacts) and
    /// how the result is verified. What it asks the agent for is edited on the Workflow page, not here.
    /// </summary>
    private StageDefinition? Stage => StageAppearance.Find(Board.Workflows, Card.WorkflowId, Card.StageId);

    /// <summary>The most recent execution, which is the run whose outcomes the card reports.</summary>
    /// <summary>Where the card's current stage got to, from the runs the runs tab already loaded.</summary>
    private StageState CurrentStageState =>
        StageStateView.Of(_executions.Select(execution => execution.State));

    /// <summary>How many of the card's stages have a finished run.</summary>
    private int FinishedStages => StageStateView.FinishedStages(_executions);

    private StageExecution? LatestExecution => _executions
        .OrderByDescending(execution => execution.UpdatedAt)
        .FirstOrDefault();

    /// <summary>How the drawer header names the card: its kind and the revision it sits on.</summary>
    private string IdentityCaption => $"{Card.Kind} · {Loc.Format("RevisionTag", Card.Revision)}";

    /// <summary>Whether the card's latest run is still going, which is what the live paint marks.</summary>
    private bool IsRunning => LatestExecution is { State: StageExecutionState.Running };

    /// <summary>
    /// What the state row says: the latest run's own state, or the plain fact that this stage was never
    /// started. <c>Running</c> reads as the design's "In progress"; the other states keep the daemon's own
    /// words, because those are what the log, the CLI and the MCP tools use as well.
    /// </summary>
    private string RunStateCaption => LatestExecution is { } run
        ? run.State switch
        {
            StageExecutionState.Running => Loc.Get("InProgress"),
            _ => run.State.ToString()
        }
        : Loc.Get("NotStarted");

    /// <summary>
    /// Who has run this card: the agents its latest run passed through, or the stage's own default agent
    /// when nothing has started yet. A card with neither has nobody to name.
    /// </summary>
    private IReadOnlyList<string> Assignees
    {
        get
        {
            if (LatestExecution is { Attempts.Count: > 0 } run)
            {
                return run.Attempts
                    .Select(attempt => AgentName(attempt.AgentAdapterId))
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
            }

            return Stage?.DefaultAgentAdapterId is { Length: > 0 } adapterId ? [AgentName(adapterId)] : [];
        }
    }

    /// <summary>An adapter id as the cockpit names it, falling back to the id the daemon reported.</summary>
    private string AgentName(string adapterId) => State.Agents
        .FirstOrDefault(agent => StringComparer.Ordinal.Equals(agent.Id, adapterId))
        ?.DisplayName ?? adapterId;

    /// <summary>Whether the diff was read and has something to show.</summary>
    private bool DiffIsReady => _diff is { Available: true, Files.Count: > 0 };

    /// <summary>
    /// What the code-changes block says when there is no diff to draw: the git client's own reason
    /// ("Git client unavailable", "not a git repository"), or the fact that the card's files are unchanged.
    /// </summary>
    private string DiffStatusCaption => _diff switch
    {
        { Available: false, Failure: { Length: > 0 } failure } when
            string.Equals(failure, "Git client unavailable", StringComparison.Ordinal) =>
            Loc.Get("GitClientUnavailable"),
        { Available: false, Failure: { Length: > 0 } failure } => failure,
        _ => Loc.Get("DiffNoChanges")
    };

    /// <summary>
    /// Opens or closes one file of the code-changes block. The panel asks the page rather than keeping the state
    /// itself, because the page decides what stands inside it: a collapsed file renders no patch at all, which is
    /// the point of collapsing it.
    /// </summary>
    private void SetFileExpanded(string path, bool expanded)
    {
        if (expanded)
        {
            _expandedFiles.Add(path);
        }
        else
        {
            _expandedFiles.Remove(path);
        }
    }

    /// <summary>The patch as lines, so each one can carry the class its first character asks for.</summary>
    private static IEnumerable<string> PatchLines(string patch) => patch.Split('\n');

    /// <summary>
    /// How one patch line reads: an addition, a removal, a hunk or file header, or context. The class
    /// carries the design's colour, and the marker character stays in the text because it is what the
    /// reader scans for.
    /// </summary>
    private static string DiffLineKind(string line) => line switch
    {
        _ when line.StartsWith("diff ", StringComparison.Ordinal) ||
               line.StartsWith("index ", StringComparison.Ordinal) ||
               line.StartsWith("--- ", StringComparison.Ordinal) ||
               line.StartsWith("+++ ", StringComparison.Ordinal) ||
               line.StartsWith("@@", StringComparison.Ordinal) => "meta",
        ['+', ..] => "add",
        ['-', ..] => "remove",
        _ => "context"
    };

    /// <summary>The discussion tab's caption, with how much has been said - a zero as much as any number.</summary>
    private string DiscussionTabLabel =>
        DisplayFormat.Counted(Loc.Get("DiscussionTitle"), _discussion.Count);

    /// <summary>Whether a note came from an agent rather than a person, for its own icon.</summary>
    private static bool IsAgent(string author) =>
        author.Contains("agent", StringComparison.OrdinalIgnoreCase) ||
        author.Contains("code", StringComparison.OrdinalIgnoreCase) ||
        author.Contains("claude", StringComparison.OrdinalIgnoreCase);

    /// <summary>A note's age, in the words the design's comment header uses.</summary>
    private static string RelativeTime(DateTimeOffset moment)
    {
        var age = DateTimeOffset.UtcNow - moment.ToUniversalTime();
        return age switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 } => $"{(int)age.TotalMinutes} min ago",
            { TotalDays: < 1 } => $"{(int)age.TotalHours} h ago",
            _ => $"{(int)age.TotalDays} d ago"
        };
    }

    /// <summary>Adds a command to the note being written, on its own line.</summary>
    private static string? AppendPrompt(string? body, string command) =>
        string.IsNullOrWhiteSpace(body) ? command : $"{body.TrimEnd()}\n{command}";

    /// <summary>
    /// Posts the note and re-reads the discussion, so the feed shows exactly what was stored in the card's
    /// own file - not the copy the browser sent.
    /// </summary>
    private async Task PostCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_commentBody) || _postingComment)
        {
            return;
        }

        _postingComment = true;
        _message = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/discussion",
                new AddCommentRequest(null, _commentBody!),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            _commentBody = null;
            await LoadDiscussionAsync();
        }
        catch (Exception exception)
        {
            _message = FailureText.Describe(exception);
            _hasError = true;
        }
        finally
        {
            _postingComment = false;
        }
    }

    private async Task LoadDiscussionAsync()
    {
        _loadingDiscussion = true;
        try
        {
            _discussion = await Http.GetFromJsonAsync<IReadOnlyList<CardComment>>(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/discussion",
                PwaJson.Options) ?? [];
        }
        catch
        {
            _discussion = [];
        }
        finally
        {
            _loadingDiscussion = false;
        }
    }

    /// <summary>Whether the card already carries an artifact the stage asked for.</summary>
    private bool HasArtifact(string path) => _artifacts.Any(artifact =>
        string.Equals(artifact.Path, path, StringComparison.OrdinalIgnoreCase));

    /// <summary>How many of the card's changed files fall outside its declared scope.</summary>
    private int OutOfScopeCount => BoardSection.FindOutOfScopeFiles(Card).Count;

    /// <summary>How many of the artifacts the stage asks for the card already carries.</summary>
    private int ResolvedArtifacts => Stage is { } stage
        ? stage.RequiredArtifacts.Count(requirement => HasArtifact(requirement.Path))
        : 0;

    /// <summary>The share of the definition of done that is resolved, floored so an empty bar still shows.</summary>
    private int DodShare => Stage is { RequiredArtifacts.Count: > 0 } stage
        ? Math.Max(4, (int)Math.Round(ResolvedArtifacts * 100d / stage.RequiredArtifacts.Count))
        : 0;

    /// <summary>The stage's display title, or its id when the workflow is not loaded.</summary>
    private string StageCaption => StageAppearance.Caption(Stage, Card.StageId);

    /// <summary>A decimal as the cockpit prints it: two places at most, in the reader's culture.</summary>
    private static string Number(decimal value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);

    /// <summary>The priority the daemon computed for this card, blended with its parents.</summary>
    private string PriorityCaption
    {
        get
        {
            var effective = Board.CardPriorities
                .FirstOrDefault(priority => StringComparer.Ordinal.Equals(
                    priority.CardId, Card.Reference.CardId))
                ?.Snapshot.EffectivePriority;
            // The same 0..100 scale the board prints, so the card page and the board never disagree about
            // what a card is worth.
            return DisplayFormat.Priority(effective ?? PriorityCalculator.ManualScore(Card.OwnPriority));
        }
    }

    /// <summary>
    /// Where the card stands among the board's own cards, 1 being the highest effective priority. The rank
    /// is read off the same projection the board sorts by, so the sidebar and the board cannot disagree.
    /// </summary>
    private int? PriorityRank
    {
        get
        {
            var ranking = Board.CardPriorities
                .OrderByDescending(priority => priority.Snapshot.EffectivePriority)
                .Select(priority => priority.CardId)
                .ToArray();
            var index = Array.FindIndex(ranking, cardId =>
                StringComparer.Ordinal.Equals(cardId, Card.Reference.CardId));
            return index < 0 ? null : index + 1;
        }
    }

    /// <summary>A link to another card of the same project, for the related-cards graph.</summary>
    /// <remarks>
    /// The address is built from the open project's readable handle, not from the id the card's relations
    /// store: the relation carries the immutable id, and an address a person copies should not.
    /// </remarks>
    private string CardHref(string otherCardId) =>
        ProjectRoutes.Card(Board.Project.Handle, otherCardId);

    /// <summary>
    /// The project this card was reported from, or null when it came from nowhere and when the daemon does
    /// not know that project any more.
    /// </summary>
    /// <remarks>
    /// The card keeps the source project's immutable id, while everything the UI links to is addressed by
    /// the readable handle, so the two are matched here instead of in the markup.
    /// </remarks>
    private RegisteredProject? OriginProject => Card.Origin is { } origin
        ? State.Projects.FirstOrDefault(project => StringComparer.Ordinal.Equals(project.Id, origin.ProjectId))
        : null;

    /// <summary>
    /// The source project as it should be read: its name when it is registered, its id when it is not. An
    /// id is a poor caption but an honest one - a name the daemon cannot produce would be invented.
    /// </summary>
    private string OriginProjectCaption(CardOrigin origin) =>
        OriginProject is { } project ? project.Name : origin.ProjectId;

    /// <summary>
    /// A link to the card this one came from, or null when there is nowhere to go. Both halves are needed:
    /// the route is <c>/p/{handle}/cards/{id}</c>, and a project nobody registered has no handle, while a
    /// card reported without a source card has no id.
    /// </summary>
    private string? OriginCardHref =>
        Card.Origin is { CardId: { Length: > 0 } originCardId } && OriginProject is { } project
            ? ProjectRoutes.Card(project.Handle, originCardId)
            : null;

    /// <summary>
    /// Who filed the card and when, in the words the comment feed already uses for an age. The adapter is
    /// left out rather than printed as an empty gap when the reporting agent did not name itself.
    /// </summary>
    private static string OriginDetail(CardOrigin origin) => string.IsNullOrWhiteSpace(origin.AdapterId)
        ? RelativeTime(origin.CreatedAtUtc)
        : $"{origin.AdapterId} · {RelativeTime(origin.CreatedAtUtc)}";

    /// <summary>
    /// The state of the stage a related card sits in, or null when the snapshot does not carry that card.
    /// </summary>
    /// <remarks>
    /// The state comes from the one place that derives it (<see cref="StageStateView"/>), so this block and
    /// the board cannot show a different colour for the same card. Null is not "pending": a relation whose
    /// card the board does not hold says nothing about that card, and a badge reading "pending" would be an
    /// answer nobody gave.
    /// </remarks>
    private StageState? RelatedStageState(CardRelation relation)
    {
        var related = RelatedCard(relation);
        return related is null
            ? null
            : StageStateView.Of(Board.StageRuns, related.Reference.CardId, related.StageId);
    }

    /// <summary>
    /// The stage a related card stands in - backlog, in progress, done - as its own workflow names it, or
    /// null when the snapshot does not carry that card.
    /// </summary>
    /// <remarks>
    /// The words come from the card's workflow rather than from a translated constant, so a project that
    /// renames or reorders a stage reads differently here at once, exactly as the card's own header reads it.
    /// A stage the workflow no longer holds falls back to its id, which is what the header does as well.
    /// </remarks>
    private string? RelatedStageCaption(CardRelation relation)
    {
        if (RelatedCard(relation) is not { } related)
        {
            return null;
        }

        return Board.Workflows
            .FirstOrDefault(workflow => StringComparer.Ordinal.Equals(workflow.Id, related.WorkflowId))
            ?.Stages.FirstOrDefault(stage => StringComparer.Ordinal.Equals(stage.Id, related.StageId))
            ?.Title ?? related.StageId;
    }

    /// <summary>The card at the other end of a relation, as the board's snapshot carries it.</summary>
    private Card? RelatedCard(CardRelation relation)
    {
        var cardId = OtherCardId(relation);
        return Board.Cards.FirstOrDefault(item =>
            StringComparer.Ordinal.Equals(item.Reference.CardId, cardId));
    }

    /// <summary>The project's size grid: what the human may choose from, same ladder the agent reads.</summary>
    private IReadOnlyList<SizeDefinition> SizeGrid => State.SettingsView?.EffectivePriority.Grid ?? [];

    /// <summary>
    /// The project's scoring criteria: every criterion a card is scored against, in the project's order.
    /// The form shows all of them, because a card with no value for one is scored as if the criterion
    /// did not exist, and that is not something the person filling it in should have to guess.
    /// </summary>
    private IReadOnlyList<PriorityCriterion> Criteria => State.SettingsView?.EffectivePriority.Criteria ?? [];

    /// <summary>
    /// The criterion values as the form holds them. A criterion left empty means the card has no value
    /// for it, so it is left out rather than sent as zero - which the formula would read as a real score.
    /// </summary>
    private IReadOnlyDictionary<string, decimal> CriterionPayload => _criterionValues
        .Where(pair => pair.Value is not null)
        .ToDictionary(pair => pair.Key, pair => pair.Value!.Value, StringComparer.Ordinal);

    /// <summary>Stores one criterion's value as its field reports it; an empty field clears it.</summary>
    private void SetCriterion(string criterionId, decimal? value) => _criterionValues[criterionId] = value;

    /// <summary>
    /// The value the form holds for a criterion, or null when the card has none. Read through a method
    /// rather than indexed directly: a criterion added to the project after this page was loaded has no
    /// entry yet, and an empty field is the right answer for it.
    /// </summary>
    private decimal? CriterionValue(string criterionId) =>
        _criterionValues.TryGetValue(criterionId, out var value) ? value : null;

    /// <summary>The band a criterion's value is read against, which is what normalizes it into the score.</summary>
    private static string CriterionRange(PriorityCriterion criterion) =>
        $"{criterion.Minimum} - {criterion.Maximum}";

    /// <summary>Keeps the visible tab across the renders a live board refresh causes.</summary>
    private void OnActiveTabChanged(int index) => _activeTab = index;

    private void OnScopeTabChanged(int index) => _scopeTab = index;

    /// <summary>Keeps the visible text tab (request / requirements / scope) across live board refreshes.</summary>
    private void OnTextTabChanged(int index) => _textTab = index;

    /// <summary>Tab captions the counts belong in, the way the design's tab bar prints them.</summary>
    private string ArtifactsTabLabel =>
        DisplayFormat.Counted(Loc.Get("ArtifactsTitle"), _artifacts.Count);

    private string RunsTabLabel =>
        DisplayFormat.Counted(Loc.Get("RunsTitle"), _executions.Count);

    /// <summary>The chosen step, so the form can show what it does to the score.</summary>
    private SizeDefinition? SelectedSize => string.IsNullOrWhiteSpace(_size)
        ? null
        : SizeGrid.FirstOrDefault(step => StringComparer.Ordinal.Equals(step.Id, _size));

    /// <summary>
    /// What the size field says under itself: the coefficient the chosen step applies and what the step
    /// means, or the fact that a card without one is neutral in the formula.
    /// </summary>
    private string SizeHint => SelectedSize is { } selected
        ? $"x{selected.Coefficient} · {selected.Description}"
        : Loc.Get("SizeHintEmpty");

    /// <summary>A step as the select shows it.</summary>
    private static string SizeOption(SizeDefinition step) => $"{step.Id} (x{step.Coefficient})";

    /// <summary>Every relation this card is an end of, in either direction.</summary>
    private IReadOnlyList<CardRelation> Relations => Board.Relations
        .Where(relation => relation.Source.CardId == Card.Reference.CardId ||
                           relation.Target.CardId == Card.Reference.CardId)
        .ToArray();

    /// <summary>
    /// The card's relations, split the way the design's graph reads them: the cards above this one, the
    /// cards below it, and everything it is merely linked to. A parent-child edge is written from the
    /// parent to the child, so which end this card sits on is what separates the first two groups. An
    /// empty group is dropped rather than drawn as a heading with nothing under it.
    /// </summary>
    private IReadOnlyList<(string Label, FlareIcon Icon, FlareColor Color, IReadOnlyList<CardRelation> Relations)> RelationGroups
    {
        get
        {
            var parentChild = Relations
                .Where(relation => StringComparer.Ordinal.Equals(relation.Type, RelationTypes.ParentChild))
                .ToArray();
            var groups = new (string Label, FlareIcon Icon, FlareColor Color, IReadOnlyList<CardRelation> Relations)[]
            {
                (Loc.Get("RelatedParents"), MaterialDesign3Icons.Regular.AccountTree, FlareColor.Secondary, parentChild
                    .Where(relation => StringComparer.Ordinal.Equals(relation.Target.CardId, Card.Reference.CardId))
                    .ToArray()),
                (Loc.Get("RelatedChildren"), MaterialDesign3Icons.Regular.CallSplit, FlareColor.Tertiary, parentChild
                    .Where(relation => StringComparer.Ordinal.Equals(relation.Source.CardId, Card.Reference.CardId))
                    .ToArray()),
                (Loc.Get("RelatedLinks"), MaterialDesign3Icons.Regular.Hub, FlareColor.Primary, Relations
                    .Where(relation => !StringComparer.Ordinal.Equals(relation.Type, RelationTypes.ParentChild))
                    .ToArray())
            };
            return groups.Where(group => group.Relations.Count > 0).ToArray();
        }
    }

    /// <summary>
    /// How the other end of a relation reads from this card's side, which is what the row's tag says. A
    /// parent-child edge needs no tag of its own - the group heading already says which end this card is
    /// on - so only the other two types are named, and then by direction.
    /// </summary>
    private string RelationTag(CardRelation relation)
    {
        var thisCardIsSource = StringComparer.Ordinal.Equals(relation.Source.CardId, Card.Reference.CardId);
        return relation.Type switch
        {
            RelationTypes.Blocks => Loc.Get(thisCardIsSource ? "RelationBlockedBy" : "RelationBlocks"),
            RelationTypes.Implements => Loc.Get(thisCardIsSource ? "RelationImplementedBy" : "RelationImplements"),
            RelationTypes.RelatesTo => Loc.Get("RelationRelatesTo"),
            RelationTypes.ParentChild => string.Empty,
            _ => relation.Type
        };
    }

    /// <summary>
    /// The counts the tab captions are built from, as one value: a change here is a change to a caption.
    /// </summary>
    private string TabCountsSignature => $"{_artifacts.Count}/{_executions.Count}/{_discussion.Count}";

    /// <summary>
    /// Renders one more pass whenever the tab counts changed.
    /// </summary>
    /// <remarks>
    /// FlareTabs draws its tab bar from its children's <c>Label</c> parameters before it diffs them, so the bar
    /// it produces carries the captions of the previous pass - which is why the counts used to appear only
    /// after the user clicked a tab (that click re-renders the bar). The children were updated during the pass
    /// that just ended, so one more pass draws the bar with the counts it should show; that pass changes
    /// nothing, so the request stops there. This can go away if Flare ever draws the bar after its panels: the
    /// signatures would match on the first pass and no extra render would be asked for.
    /// </remarks>
    protected override void OnAfterRender(bool firstRender)
    {
        var signature = TabCountsSignature;
        if (string.Equals(_renderedTabCounts, signature, StringComparison.Ordinal))
        {
            return;
        }

        _renderedTabCounts = signature;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Card.Reference.ProjectId}/{Card.Reference.CardId}/{Card.Revision}";
        var identity = $"{Card.Reference.ProjectId}/{Card.Reference.CardId}";
        var cardChanged = _loadedCardKey != key;
        if (cardChanged)
        {
            _loadedCardKey = key;
            if (_loadedCardIdentity != identity)
            {
                // Another card: the form belongs to it now, whatever the previous one held.
                _loadedCardIdentity = identity;
                ResetFormToCard();
                _message = null;
                _hasError = false;
                _priorityError = null;
            }
            else
            {
                // The same card at a new revision - an agent wrote it, or a save of ours came back. What the
                // person has typed stays; see MergeNewRevision.
                MergeNewRevision();
            }
        }

        _estimateAgent ??= Agents.FirstOrDefault()?.Id;
        _stageAgent ??= Agents.FirstOrDefault()?.Id;
        _commandAgent ??= Agents.FirstOrDefault()?.Id;

        if (cardChanged || _lastRefreshTick != ExecutionRefreshTick)
        {
            _lastRefreshTick = ExecutionRefreshTick;
            // The diff costs a git process per card, so it is read when the card itself changed - not when a
            // pulse only refreshed the counters.
            await LoadExecutionsAsync(includeDiff: cardChanged);
        }
    }

    /// <summary>The card's editable values as they were last read, to tell an edit from the card itself.</summary>
    private sealed record FormValues(
        string? Title,
        decimal? Priority,
        string? Size,
        string? Scope,
        string? Requirements,
        string? Request,
        IReadOnlyDictionary<string, decimal?> Criteria);

    /// <summary>The values the form was filled from - the card as it stood before the person typed.</summary>
    private FormValues? _baseline;

    /// <summary>Which card the form belongs to, without its revision: a new revision is not a new card.</summary>
    private string? _loadedCardIdentity;

    /// <summary>Whether the card changed underneath edits the form still holds.</summary>
    private bool _changedWhileEditing;

    private FormValues CardValues() => new(
        Card.Title,
        Card.OwnPriority,
        Card.Size,
        string.Join(Environment.NewLine, Card.DeclaredScopeFiles),
        Card.Requirements,
        Card.Request,
        Criteria.ToDictionary(
            criterion => criterion.Id,
            criterion => Card.CriterionValues is { } values && values.TryGetValue(criterion.Id, out var value)
                ? (decimal?)value
                : null,
            StringComparer.Ordinal));

    /// <summary>Whether any field holds something other than what the card held when it was read.</summary>
    private bool IsDirty => _baseline is { } baseline &&
        (!string.Equals(_title, baseline.Title, StringComparison.Ordinal) ||
         _priority != baseline.Priority ||
         !string.Equals(_size, baseline.Size, StringComparison.Ordinal) ||
         !string.Equals(_scope, baseline.Scope, StringComparison.Ordinal) ||
         !string.Equals(_requirements, baseline.Requirements, StringComparison.Ordinal) ||
         !string.Equals(_request, baseline.Request, StringComparison.Ordinal) ||
         _criterionValues.Any(pair =>
             !baseline.Criteria.TryGetValue(pair.Key, out var value) || value != pair.Value));

    /// <summary>Fills every field from the card, dropping whatever the form held.</summary>
    private void ResetFormToCard()
    {
        _baseline = CardValues();
        _title = _baseline.Title;
        _priority = _baseline.Priority;
        _size = _baseline.Size;
        _scope = _baseline.Scope;
        _requirements = _baseline.Requirements;
        _request = _baseline.Request;
        LoadCriterionValues();
        _changedWhileEditing = false;
    }

    /// <summary>
    /// Takes a new revision of the card the form is showing without throwing edits away: a field the person
    /// left alone follows the card, a field they changed keeps their text, and the banner says the card moved
    /// underneath them. The message stays too - a conflict reported by a save is what brings this revision in,
    /// and wiping it would hide why the save did not go through.
    /// </summary>
    private void MergeNewRevision()
    {
        var incoming = CardValues();
        if (_baseline is not { } baseline)
        {
            ResetFormToCard();
            return;
        }

        var kept = false;
        _title = Merge(_title, baseline.Title, incoming.Title, ref kept);
        _requirements = Merge(_requirements, baseline.Requirements, incoming.Requirements, ref kept);
        _request = Merge(_request, baseline.Request, incoming.Request, ref kept);
        _size = Merge(_size, baseline.Size, incoming.Size, ref kept);
        _scope = Merge(_scope, baseline.Scope, incoming.Scope, ref kept);
        if (_priority == baseline.Priority)
        {
            _priority = incoming.Priority;
        }
        else
        {
            kept |= _priority != incoming.Priority;
        }

        foreach (var (id, value) in incoming.Criteria)
        {
            var edited = _criterionValues.TryGetValue(id, out var current) &&
                (!baseline.Criteria.TryGetValue(id, out var before) || before != current);
            if (!edited)
            {
                _criterionValues[id] = value;
            }
            else
            {
                kept |= current != value;
            }
        }

        _baseline = incoming;
        _changedWhileEditing |= kept;
    }

    private static string? Merge(string? current, string? before, string? incoming, ref bool kept)
    {
        if (string.Equals(current, before, StringComparison.Ordinal))
        {
            return incoming;
        }

        kept |= !string.Equals(current, incoming, StringComparison.Ordinal);
        return current;
    }

    /// <summary>Drops the person's edits for the card as it is now.</summary>
    private void DiscardEdits()
    {
        ResetFormToCard();
        _message = null;
        _hasError = false;
        _priorityError = null;
    }

    /// <summary>Asks before a click inside the app leaves a card with unsaved edits behind.</summary>
    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (IsDirty && !await Js.InvokeAsync<bool>("confirm", Loc.Get("LeaveWithUnsavedEdits")))
        {
            context.PreventNavigation();
        }
    }

    /// <summary>
    /// Fills the form with the card's own scores, one entry per project criterion. The dictionary is the
    /// form's model, not the card's: a criterion the card holds no value for stays empty until it is set.
    /// </summary>
    private void LoadCriterionValues()
    {
        _criterionValues.Clear();
        foreach (var criterion in Criteria)
        {
            _criterionValues[criterion.Id] = Card.CriterionValues is { } values &&
                values.TryGetValue(criterion.Id, out var value)
                ? value
                : null;
        }
    }

    /// <summary>
    /// Reads what the tab captions count and what the panels show: the runs, the artifacts and the discussion.
    /// </summary>
    /// <param name="includeDiff">
    /// Whether to read the card's diff as well. It runs the machine's git - a process per card - so a refresh
    /// that only needs the counters passes false.
    /// </param>
    private async Task LoadExecutionsAsync(bool includeDiff)
    {
        _loadingExecutions = true;
        try
        {
            _executions = await Http.GetFromJsonAsync<IReadOnlyList<StageExecution>>(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/executions",
                PwaJson.Options) ?? [];
            // The artifacts are what the definition-of-done checklist is checked against: the card either
            // carries the file the stage asked for or it does not.
            _artifacts = await Http.GetFromJsonAsync<IReadOnlyList<CardArtifactSummary>>(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/artifacts",
                PwaJson.Options) ?? [];
            if (includeDiff)
            {
                // The diff runs the machine's git, which is a process per card: read it with the runs rather
                // than on every render.
                _loadingDiff = true;
                _diff = await Http.GetFromJsonAsync<GitCardDiff>(
                    $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/diff",
                    PwaJson.Options);
                _loadingDiff = false;
            }

            await LoadDiscussionAsync();
            await LoadReleaseAsync();
        }
        catch (Exception exception)
        {
            _message = Loc.Format("HistoryUnavailable", exception.Message);
            _hasError = true;
        }
        finally
        {
            _loadingExecutions = false;
        }
    }

    /// <summary>
    /// Reads the release that named this card, or nothing at all.
    /// </summary>
    /// <remarks>
    /// The route answers 404 when no release named the card, and that is an answer rather than a failure: the
    /// page draws no line instead of an empty one. A read that fails for another reason leaves the line out
    /// too - the line is an addition to the card, and claiming "not in a release" is something this read
    /// cannot support. The cost is named: on a broken daemon the card looks like one that went into no
    /// release, which is why the line says nothing about failures rather than inventing a verdict.
    /// </remarks>
    private async Task LoadReleaseAsync()
    {
        _release = null;
        try
        {
            var response = await Http.GetAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/release");
            if (response.IsSuccessStatusCode)
            {
                _release = await response.Content.ReadFromJsonAsync<ReleaseView>(PwaJson.Options);
            }
        }
        catch (Exception)
        {
            _release = null;
        }
    }

    private async Task RequestEstimateAsync()
    {
        if (_sendingEstimate || string.IsNullOrWhiteSpace(_estimateAgent))
        {
            return;
        }

        _sendingEstimate = true;
        _estimateMessage = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/estimate",
                new EstimateCardRequest(_estimateAgent),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            _estimateMessage = Loc.Format("EstimateRequested", AgentName(_estimateAgent));
            _estimateError = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            _estimateMessage = Loc.Format("EstimateRequestFailed", exception.Message);
            _estimateError = true;
        }
        finally
        {
            _sendingEstimate = false;
        }
    }

    /// <summary>
    /// The commands of this card, as the project's queue reports them: the open ones first, then what
    /// already happened.
    /// </summary>
    /// <remarks>
    /// Read from <see cref="WorkspaceState.Commands"/> and not from anything this page keeps: the queue is
    /// the one place that knows whether an agent has taken the request, so a screen that remembered would be
    /// a second answer to the same question. The order says what a person needs: what is still waiting, then
    /// the outcome of what is done - because a request that failed and vanished reads exactly like one that
    /// was never placed.
    /// </remarks>
    private IReadOnlyList<CardCommand> CardCommands
    {
        get
        {
            var mine = State.Commands
                .Where(command => StringComparer.Ordinal.Equals(command.CardId, Card.Reference.CardId))
                .ToArray();
            return
            [
                .. mine.Where(command => command.IsOpen).OrderBy(command => command.CreatedAtUtc),
                .. mine.Where(command => !command.IsOpen)
                    .OrderByDescending(command => command.FinishedAtUtc ?? command.CreatedAtUtc)
            ];
        }
    }

    /// <summary>Whether the selected action carries something the person has to write.</summary>
    private bool CommandNeedsText =>
        _commandAction is CommandPauseValue or CommandAnswerValue;

    /// <summary>What the text field of the selected action is for.</summary>
    private string CommandTextHint => _commandAction is CommandPauseValue
        ? Loc.Get("CommandPauseHint")
        : Loc.Get("CommandAnswerHint");

    /// <summary>
    /// Whether the command can be placed: an agent to run it, the text its action needs, and - for the three
    /// actions that steer a run already in flight - a run to steer.
    /// </summary>
    private bool CanPlaceCommand =>
        !string.IsNullOrWhiteSpace(_commandAgent) &&
        (!CommandNeedsText || !string.IsNullOrWhiteSpace(_commandText)) &&
        (_commandAction == CommandStartValue || LatestExecution is not null);

    /// <summary>
    /// What the command will act on, so the button never has to be pressed to find out.
    /// </summary>
    private string CommandTargetHint => _commandAction == CommandStartValue
        ? Loc.Format("CommandStartHint", Card.StageId)
        : LatestExecution is { } run
            ? Loc.Format("CommandRunHint", run.Id)
            : Loc.Get("CommandNoRunHint");

    /// <summary>How the queue's state of a command reads on the card.</summary>
    private static string CommandStateCaption(CardCommand command) => command.State switch
    {
        CardCommandState.Queued => Loc.Get("CommandWaiting"),
        CardCommandState.Taken => Loc.Get("CommandTaken"),
        CardCommandState.Completed => Loc.Get("CommandDone"),
        CardCommandState.Failed => Loc.Get("CommandRefused"),
        _ => Loc.Get("CommandWithdrawn")
    };

    /// <summary>
    /// The badge tone of a command's state: waiting is quiet, taken is live work, done is the accent, and a
    /// command the agent could not carry out is the one that has to be noticed.
    /// </summary>
    private static string CommandBadgeClass(CardCommand command) => command.State switch
    {
        CardCommandState.Taken => "aiko-tag--live",
        CardCommandState.Completed => "aiko-tag--accent",
        CardCommandState.Failed => "aiko-tag--warn",
        _ => "aiko-tag--quiet"
    };

    /// <summary>The one line that says what a queued command asks for.</summary>
    private static string CommandCaption(CardCommand command) => command.Action switch
    {
        CardCommandAction.Start => Loc.Format("CommandStartCaption", command.StageId ?? string.Empty),
        CardCommandAction.Pause => Loc.Get("CommandCaptionPause"),
        CardCommandAction.Resume => Loc.Get("CommandCaptionResume"),
        CardCommandAction.Release => Loc.Get("CommandCaptionRelease"),
        _ => Loc.Get("CommandCaptionAnswer")
    };

    /// <summary>
    /// Places a command for an agent and shows what the queue says about it.
    /// </summary>
    /// <remarks>
    /// Nothing is started here: the daemon records the request and answers at once, and the agent carries it
    /// out the next time one runs. That is the whole difference from the execution buttons below this block,
    /// which record a run but cannot tell any agent that the run is waiting for it.
    /// </remarks>
    private async Task PlaceCommandAsync()
    {
        if (_placingCommand || !CanPlaceCommand)
        {
            return;
        }

        _placingCommand = true;
        _commandMessage = null;
        try
        {
            var action = _commandAction switch
            {
                CommandPauseValue => CardCommandAction.Pause,
                CommandResumeValue => CardCommandAction.Resume,
                CommandAnswerValue => CardCommandAction.Answer,
                _ => CardCommandAction.Start
            };
            // The stage is the card's own: a command is placed on the card the person is looking at, and
            // "the stage it is in" is the one stage this screen can name without asking.
            var request = new PlaceCommandRequest(
                Card.Reference.CardId,
                action,
                StageId: action is CardCommandAction.Start ? Card.StageId : null,
                ExecutionId: action is CardCommandAction.Start ? null : LatestExecution?.Id,
                AgentAdapterId: _commandAgent,
                Text: CommandNeedsText ? _commandText : null);

            var placed = await State.PlaceCommandAsync(request);
            _commandError = placed is null;
            _commandMessage = placed is null
                ? State.Error ?? Loc.Get("CommandFailed")
                : Loc.Format("CommandPlaced", placed.Id);
            if (placed is not null)
            {
                _commandText = null;
            }
        }
        finally
        {
            _placingCommand = false;
        }
    }

    /// <summary>
    /// The address of one life-cycle action on a run. Every control builds its URL here, so the paths are
    /// written once and a typo cannot hide in one of six buttons.
    /// </summary>
    private string ExecutionAction(string executionId, string action) =>
        $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/executions/{Uri.EscapeDataString(executionId)}/{action}";

    private Task StartStageAsync() =>
        ActOnExecutionAsync(
            $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/executions",
            new StartStageRequest(Card.StageId, _stageAgent ?? string.Empty));

    private Task ArchiveCardAsync() => SetArchivedAsync(archived: true);

    private Task RestoreCardAsync() => SetArchivedAsync(archived: false);

    /// <summary>
    /// Writes the archive mark and tells the page the card changed. The revision travels because the card may
    /// have been changed elsewhere while this panel was open: the answer to that is a refusal this panel shows,
    /// not a write that quietly overwrites somebody else's edit.
    /// </summary>
    private async Task SetArchivedAsync(bool archived)
    {
        if (_acting)
        {
            return;
        }

        _acting = true;
        _executionMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/archive",
                new ArchiveCardRequest(archived, Card.Revision),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
        }
        catch (Exception exception)
        {
            _executionMessage = Loc.Format("ArchiveFailed", Card.Reference.CardId, FailureText.Describe(exception));
            _executionError = true;
            return;
        }
        finally
        {
            _acting = false;
        }

        // The board is the snapshot the card page is drawn from, so it is read again before the page is told:
        // the card then comes back in the list it now belongs to, rather than in the one it just left.
        await State.LoadBoardAsync();
        await OnSaved.InvokeAsync();
    }

    /// <summary>
    /// Whether the card has reached the end of its own pipeline - the one condition the archive accepts, asked
    /// of the domain rather than restated here. A copy of the condition is exactly how a button ends up offering
    /// an action the daemon refuses; the run state comes from the board snapshot, which carries the latest run
    /// of every (card, stage) pair.
    /// </summary>
    private bool IsFinished
    {
        get
        {
            var workflow = (State.Board?.Workflows ?? [])
                .FirstOrDefault(candidate => StringComparer.Ordinal.Equals(candidate.Id, Card.WorkflowId));
            var stageRun = (State.Board?.StageRuns ?? [])
                .FirstOrDefault(candidate =>
                    StringComparer.Ordinal.Equals(candidate.CardId, Card.Reference.CardId) &&
                    StringComparer.Ordinal.Equals(candidate.StageId, Card.StageId));
            return CardCompletion.IsFinished(workflow, Card.StageId, stageRun?.StateValue);
        }
    }

    private Task PauseRunAsync() => RunActionAsync(
        "pause",
        _ => new PauseExecutionRequest("Paused from the card."));

    private Task ResumeRunAsync() => RunActionAsync(
        "resume",
        _ => new ResumeExecutionRequest(_stageAgent ?? string.Empty));

    private Task HandoffRunAsync() => RunActionAsync(
        "handoff",
        _ => new HandoffExecutionRequest(_stageAgent ?? string.Empty));

    private Task CompleteRunAsync() => RunActionAsync(
        "complete",
        // What the run itself reported: the page does not invent a file list the agent never gave.
        run => new CompleteStageExecutionRequest(
            run.ActualChangedFiles.ToArray(),
            run.Artifacts.ToArray()));

    private Task CancelRunAsync() => RunActionAsync(
        "cancel",
        _ => new CancelExecutionRequest("Cancelled from the card."));

    private Task ApproveScopeAsync() => RunActionAsync(
        "scope-response",
        _ => new ScopeResponseRequest(true, _stageAgent));

    private Task RefuseScopeAsync() => RunActionAsync(
        "scope-response",
        _ => new ScopeResponseRequest(false, null));

    private Task ApproveCommitAsync() => RunActionAsync(
        "commit-approval",
        _ => new CommitApprovalRequest(true));

    private Task RejectCommitAsync() => RunActionAsync(
        "commit-approval",
        _ => new CommitApprovalRequest(false));

    /// <summary>
    /// Runs one action against the latest run. The panel names that run above the buttons, so a person knows
    /// which execution a click touches.
    /// </summary>
    private Task RunActionAsync(string action, Func<StageExecution, object> body) =>
        LatestExecution is { } run
            ? ActOnExecutionAsync(ExecutionAction(run.Id, action), body(run))
            : Task.CompletedTask;

    /// <summary>
    /// Posts one life-cycle action and reads the card's runs again: the coordinator owns the state, so the
    /// panel shows what it says now rather than what the click hoped for.
    /// </summary>
    private async Task ActOnExecutionAsync(string url, object body)
    {
        if (_acting)
        {
            return;
        }

        _acting = true;
        _executionMessage = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(url, body, PwaJson.Options);
            response.EnsureSuccessStatusCode();
            await LoadExecutionsAsync(includeDiff: false);
        }
        catch (Exception exception)
        {
            _executionMessage = Loc.Format("ExecutionActionFailed", FailureText.Describe(exception));
            _executionError = true;
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task SaveAsync()
    {
        _priorityError = null;
        _message = null;
        if (_priority is not { } priority || priority < 0)
        {
            _priorityError = Loc.Get("InvalidPriority");
            return;
        }

        if (string.IsNullOrWhiteSpace(_title))
        {
            _message = Loc.Get("TitleRequired");
            _hasError = true;
            return;
        }

        var scopeFiles = (_scope ?? string.Empty)
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        _saving = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}",
                new UpdateCardRequest(_title, priority, scopeFiles, Card.Revision, _size, CriterionPayload, _requirements, _request),
                PwaJson.Options);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _message = Loc.Get("CardConflict");
                _hasError = true;
                await OnSaved.InvokeAsync();
                return;
            }

            response.EnsureSuccessStatusCode();
            _message = Loc.Get("ChangesSaved");
            _hasError = false;
            // The identity editor is done with this card: a successful save closes it.
            if (EditOpen)
            {
                await EditOpenChanged.InvokeAsync(false);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            _message = Loc.Format("SaveCardFailed", exception.Message);
            _hasError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private static FlareColor StateColor(StageExecutionState state) => state switch
    {
        StageExecutionState.Completed => FlareColor.Success,
        StageExecutionState.NeedsAttention => FlareColor.Warning,
        StageExecutionState.Cancelled => FlareColor.OnSurfaceVariant,
        StageExecutionState.Running => FlareColor.Primary,
        _ => FlareColor.Info
    };

    private string OtherCardId(CardRelation relation) =>
        relation.Source.CardId == Card.Reference.CardId
            ? relation.Target.CardId
            : relation.Source.CardId;

    /// <summary>
    /// The title of the card at the other end of a relation. A relation whose card is not on the board -
    /// a dangling edge, or one written by an agent for a card that was since deleted - shows its id.
    /// </summary>
    private string OtherCardTitle(CardRelation relation)
    {
        var otherId = OtherCardId(relation);
        return Board.Cards
            .FirstOrDefault(card => StringComparer.Ordinal.Equals(card.Reference.CardId, otherId))
            ?.Title ?? otherId;
    }
}
