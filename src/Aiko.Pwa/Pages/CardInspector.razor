@inject HttpClient Http
@inject WorkspaceState State

@* The card's own body, laid out the way the design lays a card out: two columns of panels - the work on
   the left (what the stage asks for, what the last run reported, where the diff will stand, the artifacts
   and the run history), and the card's state on the right (where it is, what it scores, what it is linked
   to, and what its own stage is still waiting for). One panel per block, the way the design draws them,
   instead of one surface split by dividers.

   The identity header is drawn only when a drawer hosts this component. On the card page the banner above
   already says what the card is and where it sits, and printing it twice is the screen talking to itself. *@
@if (OnClose.HasDelegate)
{
    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">@IdentityCaption</FlareText>
            <FlareText Element="h2" Mono="true" Typo="TypographyScale.TitleMedium">@Card.Reference.CardId</FlareText>
        </FlareStack>
        <FlareIconButton Variant="ButtonVariant.Text"
                         Icon="@FlareIcons.Close"
                         AriaLabel="@Loc.Get("Close")"
                         OnClick="() => OnClose.InvokeAsync()" />
    </FlareStack>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                Variant="AlertVariant.Outlined">@_message</FlareAlert>
}

<div class="aiko-settings">
    @* The work column is written first: the grid keeps the first item in the first row, so the aside lands
       beside it rather than pushing it to a second row, and a keyboard or screen reader meets the work
       before the state. *@
    @* The work column: the design's left side. *@
    <FlareStack Class="aiko-card__main" Gap="FlareSpacing.Medium">

        @* What the card declares and what it touched: its requirements and scope, the files, and the stage's
           acceptance criteria. What the stage asks the agent for belongs to the workflow and is edited
           there, so a card never repeats it. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        <span class="aiko-panel__icon aiko-panel__icon--primary">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Target" />
                        </span>
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("ScopeTitle")</FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("ScopePanelHint")
                            </FlareText>
                        </FlareStack>
                    </FlareStack>
                    @if (OutOfScopeCount > 0)
                    {
                        <span class="aiko-tag aiko-tag--warn">@Loc.Format("OutOfScopeCount", DisplayFormat.Number(OutOfScopeCount))</span>
                    }
                </FlareStack>

                @* The card's own long prose: what it must do, and what it declares it will touch. What the
                   stage asks the agent for belongs to the workflow and is edited on the Workflow page, so the
                   card page does not repeat it. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    @* What the card must do, in the words of whoever wrote it. It wears the same prompt
                       block as the scope below, because both are long prose about this one card. *@
                    <PromptField Name="@($"{Card.Reference.CardId}.requirements")"
                                 Title="@Loc.Get("Requirements")"
                                 Rows="4"
                                 Placeholder="@Loc.Get("RequirementsHelper")"
                                 Value="@_requirements"
                                 ValueChanged="value => _requirements = value" />
                    <PromptField Name="@($"{Card.Reference.CardId}.scope")"
                                 Title="@Loc.Get("DeclaredScope")"
                                 Rows="4"
                                 ShowMetrics="false"
                                 Placeholder="@Loc.Get("ScopeHelper")"
                                 Value="@_scope"
                                 ValueChanged="value => _scope = value" />
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("ScopeHelper")
                        </FlareText>
                        <FlareButton Variant="ButtonVariant.Tonal"
                                     Size="ButtonSize.Sm"
                                     Loading="@_saving"
                                     OnClick="SaveAsync">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" /></LeadingIcon>
                            <ChildContent>@Loc.Get("SaveCard")</ChildContent>
                        </FlareButton>
                    </FlareStack>
                </FlareStack>

                <FileGroup Title="@Loc.Get("FilesDeclared")" Files="Card.DeclaredScopeFiles" />
                <FileGroup Title="@Loc.Get("FilesActual")" Files="Card.ActualChangedFiles" />
                <FileGroup Title="@Loc.Get("OutOfScope")"
                           Files="@BoardSection.FindOutOfScopeFiles(Card)"
                           Warning="true" />

                @* The stage's acceptance criteria: the artifacts it expects, marked by whether the card
                   carries them, and the commands that verify the result. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("DefinitionOfDone")
                    </FlareText>
                    @if (Stage is not { } required || required.RequiredArtifacts.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoRequiredArtifacts")
                        </FlareText>
                    }
                    else
                    {
                        @foreach (var requirement in required.RequiredArtifacts)
                        {
                            var item = requirement;
                            var present = HasArtifact(item.Path);
                            <FlareStack Gap="FlareSpacing.None" Class="aiko-tile">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                    <FlareIconView Value="@(present ? MaterialDesign3Icons.Regular.CheckCircle : MaterialDesign3Icons.Regular.RadioButtonUnchecked)"
                                                   Color="@(present ? FlareColor.Tertiary : FlareColor.OnSurfaceVariant2)" />
                                    <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@item.Path</FlareText>
                                    <span class="aiko-tag aiko-tag--quiet">@item.MissingPolicy</span>
                                </FlareStack>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @(present ? Loc.Get("ArtifactPresent") : Loc.Get("ArtifactMissing"))
                                    @if (item.Description is { Length: > 0 } description)
                                    {
                                        @($" · {description}")
                                    }
                                </FlareText>
                            </FlareStack>
                        }
                    }
                    @if (Stage is { Commands.Count: > 0 } verified)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("ValidationCommands")
                        </FlareText>
                        @foreach (var command in verified.Commands)
                        {
                            <span class="aiko-value aiko-value--clip" title="@command">@command</span>
                        }
                    }
                </FlareStack>
            </FlareStack>
        </FlarePaper>

        @* Everything the card has produced, in one block: what the last run reported, where the commit diff
           will stand, the artifacts themselves and the run history. The design keeps them behind one tab
           bar instead of stacking four panels, and a card is read one question at a time. The tabs are not
           lazy: a document half-written in the artifacts tab has to survive a look at the run history. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
            <FlareTabs ActiveIndex="_activeTab" ActiveIndexChanged="OnActiveTabChanged">
                <FlareTab Label="@Loc.Get("CompletedOutcomes")">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.CheckCircle" /></LeadingIcon>
                    <ChildContent>
                            <FlareStack Gap="FlareSpacing.Medium">
                            @if (LatestExecution is { } run)
                            {
                                @* The agent's own report, drawn as the design's synthesis block. *@
                                <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" Color="FlareColor.Primary" />
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                            @Loc.Get("AgentReport")
                                        </FlareText>
                                        <span class="aiko-tag @(IsRunning ? "aiko-tag--live" : null)">@RunStateCaption</span>
                                    </FlareStack>
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                        @(run.ProgressSummary is { Length: > 0 } summary ? summary : Loc.Get("NoRunSummary"))
                                    </FlareText>
                                </FlareStack>

                                @* The run's own numbers: what it took, what it carried, what it left outside the scope. *@
                                <div class="aiko-tiles aiko-tiles--three">
                                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                            @Loc.Get("AttemptsLabel")
                                        </FlareText>
                                        <span class="aiko-value">@DisplayFormat.Number(run.Attempts.Count)</span>
                                    </FlareStack>
                                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                            @Loc.Get("ArtifactsLabel")
                                        </FlareText>
                                        <span class="aiko-value">@DisplayFormat.Number(_artifacts.Count)</span>
                                    </FlareStack>
                                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                            @Loc.Get("OutOfScope")
                                        </FlareText>
                                        <span class="aiko-value @(OutOfScopeCount > 0 ? "aiko-value--warn" : null)">
                                            @DisplayFormat.Number(OutOfScopeCount)
                                        </span>
                                    </FlareStack>
                                </div>

                                @foreach (var step in run.CompletedSteps)
                                {
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.CheckCircle" Color="FlareColor.Tertiary" />
                                        <FlareText Element="span" Typo="TypographyScale.LabelMedium">@step</FlareText>
                                    </FlareStack>
                                }
                                @foreach (var step in run.RemainingSteps)
                                {
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.Pending" Color="FlareColor.OnSurfaceVariant2" />
                                        <FlareText Element="span" Typo="TypographyScale.LabelMedium">@step</FlareText>
                                    </FlareStack>
                                }
                                @if (run.Commits.Count > 0)
                                {
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                        @Loc.Get("ReportedCommits")
                                    </FlareText>
                                    @foreach (var commit in run.Commits)
                                    {
                                        var reported = commit;
                                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                            <span class="aiko-tag aiko-tag--accent">@(reported.Sha ?? Loc.Get("CommitPending"))</span>
                                            <FlareText Element="span" Typo="TypographyScale.LabelMedium">@reported.Message</FlareText>
                                        </FlareStack>
                                    }
                                }
                            }
                            else
                            {
                                <FlareEmptyState Compact="true" Title="@Loc.Get("NoExecutions")">
                                    <IconContent><FlareIconView Size="2rem" Value="@FlareIcons.PlayArrow" /></IconContent>
                                </FlareEmptyState>
                            }
                        </FlareStack>
                </ChildContent>
                </FlareTab>

                @* Where the design puts its code-diff viewer: the card's files, with the patch the git
                   client of this machine reports. Aiko does not reimplement git - the client is the
                   authority - so when there is none the block says exactly that. *@
                <FlareTab Label="@Loc.Get("CodeChanges")">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Difference" /></LeadingIcon>
                    <ChildContent>
                        @if (_loadingDiff)
                        {
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                <FlareProgressCircular Size="TrackSize.Xs" />
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    @Loc.Get("LoadingCodeChanges")
                                </FlareText>
                            </FlareStack>
                        }
                        else if (DiffIsReady)
                        {
                            <FlareStack Gap="FlareSpacing.Small">
                                @foreach (var file in _diff!.Files)
                                {
                                    var entry = file;
                                    <FlareStack Gap="FlareSpacing.XXSmall">
                                        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Description" Color="FlareColor.Secondary" />
                                                <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelMedium">@entry.Path</FlareText>
                                                @if (entry.Added > 0)
                                                {
                                                    <span class="aiko-tag aiko-tag--live">@($"+{entry.Added}")</span>
                                                }
                                                @if (entry.Removed > 0)
                                                {
                                                    <span class="aiko-tag aiko-tag--warn">@($"-{entry.Removed}")</span>
                                                }
                                            </FlareStack>
                                        </FlareStack>
                                        @if (entry.Patch is { Length: > 0 } patch)
                                        {
                                            <div class="aiko-diff__lines">
                                                @foreach (var line in PatchLines(patch))
                                                {
                                                    var text = line;
                                                    <span class="aiko-diff__line aiko-diff__line--@DiffLineKind(text)">@text</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                                @Loc.Get("DiffBinaryOrEmpty")
                                            </FlareText>
                                        }
                                    </FlareStack>
                                }
                            </FlareStack>
                        }
                        else
                        {
                            <div class="aiko-placeholder">
                                <span>@DiffStatusCaption</span>
                                <span>@Loc.Get("CodeChangesPlan")</span>
                            </div>
                        }
                    </ChildContent>
                </FlareTab>

                @* The artifacts the card owns, edited in place. *@
                <FlareTab Label="@ArtifactsTabLabel">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Description" /></LeadingIcon>
                    <ChildContent>
                        <ArtifactEditor Card="Card" Board="Board" Executions="_executions" ShowHeading="false" />
                    </ChildContent>
                </FlareTab>

                @* The card's discussion: what people and agents said about this card, and the box to add to
                   it. A note is authored content, so it is stored in the card's own folder - see the
                   discussion store - and it survives anything happening to the daemon. *@
                <FlareTab Label="@DiscussionTabLabel">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Forum" /></LeadingIcon>
                    <ChildContent>
                        <FlareStack Gap="FlareSpacing.Medium">
                            @if (_loadingDiscussion)
                            {
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareProgressCircular Size="TrackSize.Xs" />
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                        @Loc.Get("LoadingDiscussion")
                                    </FlareText>
                                </FlareStack>
                            }
                            else if (_discussion.Count == 0)
                            {
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    @Loc.Get("DiscussionNone")
                                </FlareText>
                            }
                            else
                            {
                                @foreach (var comment in _discussion.OrderByDescending(entry => entry.CreatedAtUtc))
                                {
                                    var note = comment;
                                    <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                                        <FlareStack Gap="FlareSpacing.XSmall">
                                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                                <span class="aiko-panel__icon aiko-panel__icon--primary">
                                                    <FlareIconView Value="@(IsAgent(note.Author) ? MaterialDesign3Icons.Regular.SmartToy : MaterialDesign3Icons.Regular.Person)" />
                                                </span>
                                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Weight="FontWeight.SemiBold">
                                                    @note.Author
                                                </FlareText>
                                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                                    @RelativeTime(note.CreatedAtUtc)
                                                </FlareText>
                                            </FlareStack>
                                            <span class="aiko-tile">@note.Body</span>
                                        </FlareStack>
                                    </FlarePaper>
                                }
                            }

                            @* The console: a note, and the commands an agent understands. Nothing is launched
                               from here - the daemon records work and the agent runs in the user's terminal -
                               so the chips fill the box instead of pretending to run something. *@
                            <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareIconView Value="@MaterialDesign3Icons.Regular.Terminal" Color="FlareColor.Primary" />
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                        @Loc.Get("LeaveTaskNote")
                                    </FlareText>
                                </FlareStack>
                                <AikoField Label="@Loc.Get("TaskNote")"
                                           Value="@_commentBody"
                                           ValueChanged="value => _commentBody = value"
                                           Rows="3"
                                           Hint="@Loc.Get("TaskNoteHint")" />
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                        @foreach (var command in PromptShortcuts)
                                        {
                                            var shortcut = command;
                                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                                         OnClick="() => _commentBody = AppendPrompt(_commentBody, shortcut)">
                                                <ChildContent>@shortcut</ChildContent>
                                            </FlareButton>
                                        }
                                    </FlareStack>
                                    <FlareButton Variant="ButtonVariant.Filled"
                                                 Size="ButtonSize.Sm"
                                                 Disabled="@(string.IsNullOrWhiteSpace(_commentBody))"
                                                 Loading="@_postingComment"
                                                 OnClick="PostCommentAsync">
                                        <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Send" /></LeadingIcon>
                                        <ChildContent>@Loc.Get("Comment")</ChildContent>
                                    </FlareButton>
                                </FlareStack>
                            </FlareStack>
                        </FlareStack>
                    </ChildContent>
                </FlareTab>

                @* Every run of this card, newest first. *@
                <FlareTab Label="@RunsTabLabel">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.History" /></LeadingIcon>
                    <ChildContent>
                            <FlareStack Gap="FlareSpacing.Medium">
                            @if (_loadingExecutions)
                            {
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareProgressCircular Size="TrackSize.Xs" />
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                        @Loc.Get("LoadingHistory")
                                    </FlareText>
                                </FlareStack>
                            }
                            else if (_executions.Count == 0)
                            {
                                <FlareEmptyState Compact="true" Title="@Loc.Get("NoExecutions")">
                                    <IconContent><FlareIconView Size="2rem" Value="@FlareIcons.PlayArrow" /></IconContent>
                                </FlareEmptyState>
                            }
                            else
                            {
                                <FlareTimeline>
                                    @foreach (var execution in _executions.OrderByDescending(item => item.UpdatedAt))
                                    {
                                        <FlareTimelineItem Title="@execution.StageId" Color="@StateColor(execution.State)">
                                            <FlareStack Gap="FlareSpacing.XXSmall">
                                                <FlareBadge Standalone="true"
                                                            Text="@execution.State.ToString()"
                                                            Color="@StateColor(execution.State)" />
                                                @if (!string.IsNullOrWhiteSpace(execution.ProgressSummary))
                                                {
                                                    <FlareText Element="span" Typo="TypographyScale.BodySmall">@execution.ProgressSummary</FlareText>
                                                }
                                                @foreach (var attempt in execution.Attempts)
                                                {
                                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall">@attempt.AgentAdapterId</FlareText>
                                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                                                            @attempt.State
                                                        </FlareText>
                                                    </FlareStack>
                                                }
                                                @if (execution.Artifacts.Count > 0)
                                                {
                                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                                                        @Loc.Format("ArtifactsLabel", string.Join(", ", execution.Artifacts))
                                                    </FlareText>
                                                }
                                            </FlareStack>
                                        </FlareTimelineItem>
                                    }
                                </FlareTimeline>
                            }
                        </FlareStack>
                    </ChildContent>
                </FlareTab>
            </FlareTabs>
        </FlarePaper>

    </FlareStack>

    @* The state column: the design's inspector aside. *@
    <FlareStack Class="aiko-card__side" Gap="FlareSpacing.Medium">

        @* Where the card is and who has run it: the stage it sits in, the state of its latest run, and the
           agents that run passed through. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                    @Loc.Get("ExecutionState")
                </FlareText>

                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("WorkflowStatus")
                    </FlareText>
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween"
                                Gap="FlareSpacing.XSmall" Class="aiko-tile">
                        <span class="aiko-tag @(IsRunning ? "aiko-tag--live" : null)">
                            @if (IsRunning)
                            {
                                <span class="aiko-dot aiko-dot--pulse"></span>
                            }
                            @RunStateCaption
                        </span>
                        <span class="aiko-tag aiko-tag--quiet">@StageCaption</span>
                    </FlareStack>
                </FlareStack>

                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("ActiveAssignees")
                    </FlareText>
                    @if (Assignees.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoActiveAssignees")
                        </FlareText>
                    }
                    else
                    {
                        @foreach (var assignee in Assignees)
                        {
                            var agent = assignee;
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween"
                                        Gap="FlareSpacing.XSmall" Class="aiko-tile">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareAvatar Text="@DisplayFormat.Initials(agent)"
                                                 Size="AvatarSize.Xs"
                                                 Shape="AvatarShape.Square" />
                                    <FlareText Element="span" Typo="TypographyScale.BodySmall">@agent</FlareText>
                                </FlareStack>
                                <span class="aiko-tag aiko-tag--accent">@Loc.Get("RoleAgent")</span>
                            </FlareStack>
                        }
                    }
                </FlareStack>
            </FlareStack>
        </FlarePaper>

        @* What the daemon computed for this card, and what a person can change about it: the effective
           priority, the rank it earns among the board's cards, the size step from the project's grid and
           the values behind the score. The size and the criteria live here rather than in a panel of their
           own, because this is the block that reads the number they produce. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("TriageScore")
                    </FlareText>
                    @if (PriorityRank is { } rank)
                    {
                        <span class="aiko-tag aiko-tag--accent">@Loc.Format("RankOf", DisplayFormat.Number(rank))</span>
                    }
                </FlareStack>

                <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.End" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("EffectivePriority")
                        </FlareText>
                        <span class="aiko-value aiko-value--big">@PriorityCaption</span>
                    </FlareStack>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Format("PriorityOf", Number(Card.OwnPriority))
                    </FlareText>
                    <span class="aiko-value aiko-value--formula">@Loc.Get("PriorityFormulaExpression")</span>
                </FlareStack>

                <div class="aiko-tiles">
                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("CardKind")
                        </FlareText>
                        <span class="aiko-value">@Card.Kind</span>
                    </FlareStack>
                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("FilesActual")
                        </FlareText>
                        <span class="aiko-value">@DisplayFormat.Number(Card.ActualChangedFiles.Count)</span>
                    </FlareStack>
                </div>

                @* The size step the agent assigns from the project's grid, and what it does to the score. *@
                <AikoSelectField Label="@Loc.Get("SizeIdLabel")"
                                 Value="@_size"
                                 ValueChanged="value => _size = value"
                                 Hint="@SizeHint">
                    <option value="">@Loc.Get("NoSize")</option>
                    @foreach (var step in SizeGrid)
                    {
                        var option = step;
                        <option value="@option.Id">@SizeOption(option)</option>
                    }
                </AikoSelectField>

                @* Every criterion the project scores by, in the project's order: a card with no value for one
                   is scored as if that criterion did not exist, so the person editing the card sees them all,
                   each with the band its value is read against. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("ScoringCriteria")
                        </FlareText>
                        <span class="aiko-tag aiko-tag--quiet">@DisplayFormat.Number(Criteria.Count)</span>
                    </FlareStack>
                    @if (Criteria.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoCriteria")
                        </FlareText>
                    }
                    else
                    {
                        @foreach (var criterion in Criteria)
                        {
                            var item = criterion;
                            <AikoNumberField Label="@item.Title"
                                             Hint="@CriterionRange(item)"
                                             Value="@CriterionValue(item.Id)"
                                             ValueChanged="value => SetCriterion(item.Id, value)" />
                        }
                    }
                </FlareStack>

                @* The estimate the person left to the machine: pick the agent, and Aiko records the request
                   and shows the command to run. Nothing is launched from here - the daemon cannot start an
                   agent yet - so the block says exactly what to run in that agent's terminal. *@
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("EstimateTitle")
                    </FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("EstimateHint")
                    </FlareText>
                    @if (Agents.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("NoAgentsDiscovered")
                        </FlareText>
                    }
                    else
                    {
                        <AikoSelectField Label="@Loc.Get("EstimateAgent")"
                                         Value="@_estimateAgent"
                                         ValueChanged="value => _estimateAgent = value">
                            @foreach (var agent in Agents)
                            {
                                var option = agent;
                                <option value="@option.Id">@option.DisplayName</option>
                            }
                        </AikoSelectField>
                        <FlareButton Variant="ButtonVariant.Tonal"
                                     FullWidth="true"
                                     Disabled="@(string.IsNullOrWhiteSpace(_estimateAgent))"
                                     Loading="@_sendingEstimate"
                                     OnClick="RequestEstimateAsync">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" /></LeadingIcon>
                            <ChildContent>@Loc.Get("EstimateCard")</ChildContent>
                        </FlareButton>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Format("EstimateCommandHint", EstimateCommand)
                        </FlareText>
                    }
                    @if (_estimateMessage is { Length: > 0 } estimateMessage)
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall"
                                   Color="@(_estimateError ? FlareColor.Error : FlareColor.Tertiary)">
                            @estimateMessage
                        </FlareText>
                    }
                </FlareStack>

                <FlareButton FullWidth="true"
                             Loading="@_saving"
                             OnClick="SaveAsync">@Loc.Get("SaveCard")</FlareButton>
            </FlareStack>
        </FlarePaper>

        @* What this card is linked to. A parent-child edge is written from the parent to the child, so the
           end this card sits on is what separates its parents from its children; everything else - a story
           a task implements, a card that blocks another, a plain relation - is one list. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Small">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("RelatedCards")
                    </FlareText>
                    <span class="aiko-tag aiko-tag--quiet">@DisplayFormat.Number(Relations.Count)</span>
                </FlareStack>
                @if (Relations.Count == 0)
                {
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("NoRelations")
                    </FlareText>
                }
                else
                {
                    @foreach (var group in RelationGroups)
                    {
                        var bucket = group;
                        <FlareStack Gap="FlareSpacing.XXSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                <FlareIconView Value="@bucket.Icon" Color="@bucket.Color" />
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @bucket.Label
                                </FlareText>
                            </FlareStack>
                            @foreach (var relation in bucket.Relations)
                            {
                                var link = relation;
                                <FlareNavLink Href="@CardHref(OtherCardId(link))" Class="aiko-card__row">
                                    <IconContent>
                                        <FlareIconView Value="@bucket.Icon" Color="@bucket.Color" />
                                    </IconContent>
                                    <ChildContent>
                                        <FlareStack Row="true" Align="FlareAlignItems.Center"
                                                    Justify="FlareJustifyContent.SpaceBetween"
                                                    Gap="FlareSpacing.XSmall" Class="aiko-card__row-body">
                                            <FlareStack Gap="FlareSpacing.None">
                                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                                    <span class="aiko-value">@OtherCardId(link)</span>
                                                    @if (RelationTag(link) is { Length: > 0 } tag)
                                                    {
                                                        <span class="aiko-tag aiko-tag--quiet">@tag</span>
                                                    }
                                                </FlareStack>
                                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                                    @OtherCardTitle(link)
                                                </FlareText>
                                            </FlareStack>
                                            <FlareIconView Value="@MaterialDesign3Icons.Regular.ChevronRight"
                                                           Color="FlareColor.OnSurfaceVariant2" />
                                        </FlareStack>
                                    </ChildContent>
                                </FlareNavLink>
                            }
                        </FlareStack>
                    }
                }
            </FlareStack>
        </FlarePaper>

        @* How far the stage's own definition of done has got: the artifacts it asks for, resolved. *@
        @if (Stage is { RequiredArtifacts.Count: > 0 } dod)
        {
            <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("DefinitionOfDone")
                        </FlareText>
                        <span class="aiko-value">@Loc.Format("ResolvedOf", ResolvedArtifacts, dod.RequiredArtifacts.Count)</span>
                    </FlareStack>
                    <span class="aiko-bar">
                        <span class="aiko-bar__fill" style="@($"width: {DodShare}%")"></span>
                    </span>
                    @foreach (var requirement in dod.RequiredArtifacts)
                    {
                        var item = requirement;
                        var present = HasArtifact(item.Path);
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@(present ? MaterialDesign3Icons.Regular.CheckCircle : MaterialDesign3Icons.Regular.RadioButtonUnchecked)"
                                           Color="@(present ? FlareColor.Tertiary : FlareColor.OnSurfaceVariant2)" />
                            <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@item.Path</FlareText>
                        </FlareStack>
                    }
                </FlareStack>
            </FlarePaper>
        }

        @* The skills the stage adds around its instruction, as the design's bridge chips. *@
        @if (Stage is { } bridge && (bridge.BeforeSkills.Count > 0 || bridge.AfterSkills.Count > 0))
        {
            <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("StageSkills")
                    </FlareText>
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                        @foreach (var skill in bridge.BeforeSkills)
                        {
                            <span class="aiko-tag aiko-tag--live">@skill</span>
                        }
                        @foreach (var skill in bridge.AfterSkills)
                        {
                            <span class="aiko-tag aiko-tag--accent">@skill</span>
                        }
                    </FlareStack>
                </FlareStack>
            </FlarePaper>
        }

    </FlareStack>
</div>

@* Editing the card's identity. The title is the one field that belongs in the banner rather than in a
   panel - the banner already prints it - so the design's "Edit card" action opens this drawer instead of
   a form living permanently in the sidebar. *@
<FlareDrawer Anchor="DrawerAnchor.Right"
             Open="EditOpen"
             OpenChanged="OnEditOpenChanged"
             Width="28rem"
             ContentPadding="FlareSpacing.Large"
             AriaLabel="@Loc.Get("EditCard")">
    <HeaderContent>
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                @Loc.Get("EditCard")
            </FlareText>
            <FlareText Element="h3" Mono="true" Typo="TypographyScale.TitleMedium">@($"#{Card.Reference.CardId}")</FlareText>
        </FlareStack>
    </HeaderContent>
    <ChildContent>
        <FlareStack Gap="FlareSpacing.Small">
            <AikoField Label="@Loc.Get("Title")"
                       Value="@_title"
                       ValueChanged="value => _title = value"
                       Placeholder="@Loc.Get("Title")" />
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                @Loc.Get("EditCardHint")
            </FlareText>
            <FlareButton FullWidth="true"
                         Loading="@_saving"
                         OnClick="SaveAsync">@Loc.Get("SaveCard")</FlareButton>
        </FlareStack>
    </ChildContent>
</FlareDrawer>

@code {
    [Parameter, EditorRequired] public Card Card { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectBoardSnapshot Board { get; set; } = null!;
    [Parameter] public int ExecutionRefreshTick { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Whether the identity editor is open. The card page owns the toolbar button that opens it, so the
    /// flag travels down as a parameter rather than a second copy of the card's form living here.
    /// </summary>
    [Parameter] public bool EditOpen { get; set; }

    /// <summary>Raised when the identity editor opens or closes.</summary>
    [Parameter] public EventCallback<bool> EditOpenChanged { get; set; }

    private Task OnEditOpenChanged(bool open) => EditOpenChanged.InvokeAsync(open);

    private string? _loadedCardKey;
    private int _lastRefreshTick;
    private string? _title;
    private decimal? _priority;
    private string? _size;
    private string? _scope;
    private string? _requirements;
    private string? _estimateAgent;
    private string? _estimateMessage;
    private bool _estimateError;
    private bool _sendingEstimate;
    private string? _priorityError;
    private string? _message;
    private bool _hasError;
    private bool _saving;
    private bool _loadingExecutions;
    private int _activeTab;
    private IReadOnlyList<StageExecution> _executions = [];
    private IReadOnlyList<CardArtifactSummary> _artifacts = [];
    private GitCardDiff? _diff;
    private bool _loadingDiff;
    private IReadOnlyList<CardComment> _discussion = [];
    private bool _loadingDiscussion;
    private bool _postingComment;
    private string? _commentBody;

    /// <summary>The commands the console offers: the ones this product's agents answer to.</summary>
    private static readonly string[] PromptShortcuts = ["/benchmark", "/leak-check"];
    private readonly Dictionary<string, decimal?> _criterionValues = new(StringComparer.Ordinal);

    /// <summary>The agent adapters the daemon found, for the estimate picker.</summary>
    private IReadOnlyList<AgentAdapterOption> Agents => State.Agents;

    /// <summary>The command that runs this card's estimate in the chosen agent's terminal.</summary>
    private string EstimateCommand => $"/aiko-estimate {Card.Reference.CardId}";

    /// <summary>
    /// The stage the card sits in, from its own workflow: what it expects to be produced (the artifacts) and
    /// how the result is verified. What it asks the agent for is edited on the Workflow page, not here.
    /// </summary>
    private StageDefinition? Stage => Board.Workflows
        .FirstOrDefault(workflow => StringComparer.Ordinal.Equals(workflow.Id, Card.WorkflowId))
        ?.Stages.FirstOrDefault(stage => StringComparer.Ordinal.Equals(stage.Id, Card.StageId));

    /// <summary>The most recent execution, which is the run whose outcomes the card reports.</summary>
    private StageExecution? LatestExecution => _executions
        .OrderByDescending(execution => execution.UpdatedAt)
        .FirstOrDefault();

    /// <summary>How the drawer header names the card: its kind and the revision it sits on.</summary>
    private string IdentityCaption => $"{Card.Kind} · {Loc.Format("RevisionTag", Card.Revision)}";

    /// <summary>Whether the card's latest run is still going, which is what the live paint marks.</summary>
    private bool IsRunning => LatestExecution is { State: StageExecutionState.Running };

    /// <summary>
    /// What the state row says: the latest run's own state, or the plain fact that this stage was never
    /// started. <c>Running</c> reads as the design's "In progress"; the other states keep the daemon's own
    /// words, because those are what the log, the CLI and the MCP tools use as well.
    /// </summary>
    private string RunStateCaption => LatestExecution is { } run
        ? run.State switch
        {
            StageExecutionState.Running => Loc.Get("InProgress"),
            _ => run.State.ToString()
        }
        : Loc.Get("NotStarted");

    /// <summary>
    /// Who has run this card: the agents its latest run passed through, or the stage's own default agent
    /// when nothing has started yet. A card with neither has nobody to name.
    /// </summary>
    private IReadOnlyList<string> Assignees
    {
        get
        {
            if (LatestExecution is { Attempts.Count: > 0 } run)
            {
                return run.Attempts
                    .Select(attempt => AgentName(attempt.AgentAdapterId))
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
            }

            return Stage?.DefaultAgentAdapterId is { Length: > 0 } adapterId ? [AgentName(adapterId)] : [];
        }
    }

    /// <summary>An adapter id as the cockpit names it, falling back to the id the daemon reported.</summary>
    private string AgentName(string adapterId) => State.Agents
        .FirstOrDefault(agent => StringComparer.Ordinal.Equals(agent.Id, adapterId))
        ?.DisplayName ?? adapterId;

    /// <summary>Whether the diff was read and has something to show.</summary>
    private bool DiffIsReady => _diff is { Available: true, Files.Count: > 0 };

    /// <summary>
    /// What the code-changes block says when there is no diff to draw: the git client's own reason
    /// ("Git client unavailable", "not a git repository"), or the fact that the card's files are unchanged.
    /// </summary>
    private string DiffStatusCaption => _diff switch
    {
        { Available: false, Failure: { Length: > 0 } failure } when
            string.Equals(failure, "Git client unavailable", StringComparison.Ordinal) =>
            Loc.Get("GitClientUnavailable"),
        { Available: false, Failure: { Length: > 0 } failure } => failure,
        _ => Loc.Get("DiffNoChanges")
    };

    /// <summary>The patch as lines, so each one can carry the class its first character asks for.</summary>
    private static IEnumerable<string> PatchLines(string patch) => patch.Split('\n');

    /// <summary>
    /// How one patch line reads: an addition, a removal, a hunk or file header, or context. The class
    /// carries the design's colour, and the marker character stays in the text because it is what the
    /// reader scans for.
    /// </summary>
    private static string DiffLineKind(string line) => line switch
    {
        _ when line.StartsWith("diff ", StringComparison.Ordinal) ||
               line.StartsWith("index ", StringComparison.Ordinal) ||
               line.StartsWith("--- ", StringComparison.Ordinal) ||
               line.StartsWith("+++ ", StringComparison.Ordinal) ||
               line.StartsWith("@@", StringComparison.Ordinal) => "meta",
        ['+', ..] => "add",
        ['-', ..] => "remove",
        _ => "context"
    };

    /// <summary>The discussion tab's caption, with how much has been said.</summary>
    private string DiscussionTabLabel => _discussion.Count == 0
        ? Loc.Get("DiscussionTitle")
        : $"{Loc.Get("DiscussionTitle")} ({_discussion.Count})";

    /// <summary>Whether a note came from an agent rather than a person, for its own icon.</summary>
    private static bool IsAgent(string author) =>
        author.Contains("agent", StringComparison.OrdinalIgnoreCase) ||
        author.Contains("code", StringComparison.OrdinalIgnoreCase) ||
        author.Contains("claude", StringComparison.OrdinalIgnoreCase);

    /// <summary>A note's age, in the words the design's comment header uses.</summary>
    private static string RelativeTime(DateTimeOffset moment)
    {
        var age = DateTimeOffset.UtcNow - moment.ToUniversalTime();
        return age switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 } => $"{(int)age.TotalMinutes} min ago",
            { TotalDays: < 1 } => $"{(int)age.TotalHours} h ago",
            _ => $"{(int)age.TotalDays} d ago"
        };
    }

    /// <summary>Adds a command to the note being written, on its own line.</summary>
    private static string? AppendPrompt(string? body, string command) =>
        string.IsNullOrWhiteSpace(body) ? command : $"{body.TrimEnd()}\n{command}";

    /// <summary>
    /// Posts the note and re-reads the discussion, so the feed shows exactly what was stored in the card's
    /// own file - not the copy the browser sent.
    /// </summary>
    private async Task PostCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_commentBody) || _postingComment)
        {
            return;
        }

        _postingComment = true;
        _message = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/discussion",
                new AddCommentRequest(null, _commentBody!),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            _commentBody = null;
            await LoadDiscussionAsync();
        }
        catch (Exception exception)
        {
            _message = FailureText.Describe(exception);
            _hasError = true;
        }
        finally
        {
            _postingComment = false;
        }
    }

    private async Task LoadDiscussionAsync()
    {
        _loadingDiscussion = true;
        try
        {
            _discussion = await Http.GetFromJsonAsync<IReadOnlyList<CardComment>>(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/discussion",
                PwaJson.Options) ?? [];
        }
        catch
        {
            _discussion = [];
        }
        finally
        {
            _loadingDiscussion = false;
        }
    }

    /// <summary>Whether the card already carries an artifact the stage asked for.</summary>
    private bool HasArtifact(string path) => _artifacts.Any(artifact =>
        string.Equals(artifact.Path, path, StringComparison.OrdinalIgnoreCase));

    /// <summary>How many of the card's changed files fall outside its declared scope.</summary>
    private int OutOfScopeCount => BoardSection.FindOutOfScopeFiles(Card).Count;

    /// <summary>How many of the artifacts the stage asks for the card already carries.</summary>
    private int ResolvedArtifacts => Stage is { } stage
        ? stage.RequiredArtifacts.Count(requirement => HasArtifact(requirement.Path))
        : 0;

    /// <summary>The share of the definition of done that is resolved, floored so an empty bar still shows.</summary>
    private int DodShare => Stage is { RequiredArtifacts.Count: > 0 } stage
        ? Math.Max(4, (int)Math.Round(ResolvedArtifacts * 100d / stage.RequiredArtifacts.Count))
        : 0;

    /// <summary>The stage's display title, or its id when the workflow is not loaded.</summary>
    private string StageCaption => Stage?.Title ?? Card.StageId;

    /// <summary>A decimal as the cockpit prints it: two places at most, in the reader's culture.</summary>
    private static string Number(decimal value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);

    /// <summary>The priority the daemon computed for this card, blended with its parents.</summary>
    private string PriorityCaption
    {
        get
        {
            var effective = Board.CardPriorities
                .FirstOrDefault(priority => StringComparer.Ordinal.Equals(
                    priority.CardId, Card.Reference.CardId))
                ?.Snapshot.EffectivePriority;
            return Number(effective ?? Card.OwnPriority);
        }
    }

    /// <summary>
    /// Where the card stands among the board's own cards, 1 being the highest effective priority. The rank
    /// is read off the same projection the board sorts by, so the sidebar and the board cannot disagree.
    /// </summary>
    private int? PriorityRank
    {
        get
        {
            var ranking = Board.CardPriorities
                .OrderByDescending(priority => priority.Snapshot.EffectivePriority)
                .Select(priority => priority.CardId)
                .ToArray();
            var index = Array.FindIndex(ranking, cardId =>
                StringComparer.Ordinal.Equals(cardId, Card.Reference.CardId));
            return index < 0 ? null : index + 1;
        }
    }

    /// <summary>A link to another card of the same project, for the related-cards graph.</summary>
    private string CardHref(string otherCardId) =>
        $"/p/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(otherCardId)}";

    /// <summary>The project's size grid: what the human may choose from, same ladder the agent reads.</summary>
    private IReadOnlyList<SizeDefinition> SizeGrid => State.SettingsView?.EffectivePriority.Grid ?? [];

    /// <summary>
    /// The project's scoring criteria: every criterion a card is scored against, in the project's order.
    /// The form shows all of them, because a card with no value for one is scored as if the criterion
    /// did not exist, and that is not something the person filling it in should have to guess.
    /// </summary>
    private IReadOnlyList<PriorityCriterion> Criteria => State.SettingsView?.EffectivePriority.Criteria ?? [];

    /// <summary>
    /// The criterion values as the form holds them. A criterion left empty means the card has no value
    /// for it, so it is left out rather than sent as zero - which the formula would read as a real score.
    /// </summary>
    private IReadOnlyDictionary<string, decimal> CriterionPayload => _criterionValues
        .Where(pair => pair.Value is not null)
        .ToDictionary(pair => pair.Key, pair => pair.Value!.Value, StringComparer.Ordinal);

    /// <summary>Stores one criterion's value as its field reports it; an empty field clears it.</summary>
    private void SetCriterion(string criterionId, decimal? value) => _criterionValues[criterionId] = value;

    /// <summary>
    /// The value the form holds for a criterion, or null when the card has none. Read through a method
    /// rather than indexed directly: a criterion added to the project after this page was loaded has no
    /// entry yet, and an empty field is the right answer for it.
    /// </summary>
    private decimal? CriterionValue(string criterionId) =>
        _criterionValues.TryGetValue(criterionId, out var value) ? value : null;

    /// <summary>The band a criterion's value is read against, which is what normalizes it into the score.</summary>
    private static string CriterionRange(PriorityCriterion criterion) =>
        $"{criterion.Minimum} - {criterion.Maximum}";

    /// <summary>Keeps the visible tab across the renders a live board refresh causes.</summary>
    private void OnActiveTabChanged(int index) => _activeTab = index;

    /// <summary>Tab captions the counts belong in, the way the design's tab bar prints them.</summary>
    private string ArtifactsTabLabel => $"{Loc.Get("ArtifactsTitle")} ({_artifacts.Count})";

    private string RunsTabLabel => $"{Loc.Get("RunsTitle")} ({_executions.Count})";

    /// <summary>The chosen step, so the form can show what it does to the score.</summary>
    private SizeDefinition? SelectedSize => string.IsNullOrWhiteSpace(_size)
        ? null
        : SizeGrid.FirstOrDefault(step => StringComparer.Ordinal.Equals(step.Id, _size));

    /// <summary>
    /// What the size field says under itself: the coefficient the chosen step applies and what the step
    /// means, or the fact that a card without one is neutral in the formula.
    /// </summary>
    private string SizeHint => SelectedSize is { } selected
        ? $"x{selected.Coefficient} · {selected.Description}"
        : Loc.Get("SizeHintEmpty");

    /// <summary>A step as the select shows it.</summary>
    private static string SizeOption(SizeDefinition step) => $"{step.Id} (x{step.Coefficient})";

    /// <summary>Every relation this card is an end of, in either direction.</summary>
    private IReadOnlyList<CardRelation> Relations => Board.Relations
        .Where(relation => relation.Source.CardId == Card.Reference.CardId ||
                           relation.Target.CardId == Card.Reference.CardId)
        .ToArray();

    /// <summary>
    /// The card's relations, split the way the design's graph reads them: the cards above this one, the
    /// cards below it, and everything it is merely linked to. A parent-child edge is written from the
    /// parent to the child, so which end this card sits on is what separates the first two groups. An
    /// empty group is dropped rather than drawn as a heading with nothing under it.
    /// </summary>
    private IReadOnlyList<(string Label, FlareIcon Icon, FlareColor Color, IReadOnlyList<CardRelation> Relations)> RelationGroups
    {
        get
        {
            var parentChild = Relations
                .Where(relation => StringComparer.Ordinal.Equals(relation.Type, RelationTypes.ParentChild))
                .ToArray();
            var groups = new (string Label, FlareIcon Icon, FlareColor Color, IReadOnlyList<CardRelation> Relations)[]
            {
                (Loc.Get("RelatedParents"), MaterialDesign3Icons.Regular.AccountTree, FlareColor.Secondary, parentChild
                    .Where(relation => StringComparer.Ordinal.Equals(relation.Target.CardId, Card.Reference.CardId))
                    .ToArray()),
                (Loc.Get("RelatedChildren"), MaterialDesign3Icons.Regular.CallSplit, FlareColor.Tertiary, parentChild
                    .Where(relation => StringComparer.Ordinal.Equals(relation.Source.CardId, Card.Reference.CardId))
                    .ToArray()),
                (Loc.Get("RelatedLinks"), MaterialDesign3Icons.Regular.Hub, FlareColor.Primary, Relations
                    .Where(relation => !StringComparer.Ordinal.Equals(relation.Type, RelationTypes.ParentChild))
                    .ToArray())
            };
            return groups.Where(group => group.Relations.Count > 0).ToArray();
        }
    }

    /// <summary>
    /// How the other end of a relation reads from this card's side, which is what the row's tag says. A
    /// parent-child edge needs no tag of its own - the group heading already says which end this card is
    /// on - so only the other two types are named, and then by direction.
    /// </summary>
    private string RelationTag(CardRelation relation)
    {
        var thisCardIsSource = StringComparer.Ordinal.Equals(relation.Source.CardId, Card.Reference.CardId);
        return relation.Type switch
        {
            RelationTypes.Blocks => Loc.Get(thisCardIsSource ? "RelationBlockedBy" : "RelationBlocks"),
            RelationTypes.Implements => Loc.Get(thisCardIsSource ? "RelationImplementedBy" : "RelationImplements"),
            RelationTypes.RelatesTo => Loc.Get("RelationRelatesTo"),
            RelationTypes.ParentChild => string.Empty,
            _ => relation.Type
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Card.Reference.ProjectId}/{Card.Reference.CardId}/{Card.Revision}";
        var cardChanged = _loadedCardKey != key;
        if (cardChanged)
        {
            _loadedCardKey = key;
            _title = Card.Title;
            _priority = Card.OwnPriority;
            _size = Card.Size;
            _scope = string.Join(Environment.NewLine, Card.DeclaredScopeFiles);
            _requirements = Card.Requirements;
            LoadCriterionValues();
            _message = null;
            _hasError = false;
            _priorityError = null;
        }

        _estimateAgent ??= Agents.FirstOrDefault()?.Id;

        if (cardChanged || _lastRefreshTick != ExecutionRefreshTick)
        {
            _lastRefreshTick = ExecutionRefreshTick;
            await LoadExecutionsAsync();
        }
    }

    /// <summary>
    /// Fills the form with the card's own scores, one entry per project criterion. The dictionary is the
    /// form's model, not the card's: a criterion the card holds no value for stays empty until it is set.
    /// </summary>
    private void LoadCriterionValues()
    {
        _criterionValues.Clear();
        foreach (var criterion in Criteria)
        {
            _criterionValues[criterion.Id] = Card.CriterionValues is { } values &&
                values.TryGetValue(criterion.Id, out var value)
                ? value
                : null;
        }
    }

    private async Task LoadExecutionsAsync()
    {
        _loadingExecutions = true;
        try
        {
            _executions = await Http.GetFromJsonAsync<IReadOnlyList<StageExecution>>(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/executions",
                PwaJson.Options) ?? [];
            // The artifacts are what the definition-of-done checklist is checked against: the card either
            // carries the file the stage asked for or it does not.
            _artifacts = await Http.GetFromJsonAsync<IReadOnlyList<CardArtifactSummary>>(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/artifacts",
                PwaJson.Options) ?? [];
            // The diff runs the machine's git, which is a process per card: read it with the runs rather
            // than on every render.
            _loadingDiff = true;
            _diff = await Http.GetFromJsonAsync<GitCardDiff>(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/diff",
                PwaJson.Options);
            _loadingDiff = false;
            await LoadDiscussionAsync();
        }
        catch (Exception exception)
        {
            _message = Loc.Format("HistoryUnavailable", exception.Message);
            _hasError = true;
        }
        finally
        {
            _loadingExecutions = false;
        }
    }

    private async Task RequestEstimateAsync()
    {
        if (_sendingEstimate || string.IsNullOrWhiteSpace(_estimateAgent))
        {
            return;
        }

        _sendingEstimate = true;
        _estimateMessage = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}/estimate",
                new EstimateCardRequest(_estimateAgent),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            _estimateMessage = Loc.Format("EstimateRequested", AgentName(_estimateAgent));
            _estimateError = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            _estimateMessage = Loc.Format("EstimateRequestFailed", exception.Message);
            _estimateError = true;
        }
        finally
        {
            _sendingEstimate = false;
        }
    }

    private async Task SaveAsync()
    {
        _priorityError = null;
        _message = null;
        if (_priority is not { } priority || priority < 0)
        {
            _priorityError = Loc.Get("InvalidPriority");
            return;
        }

        if (string.IsNullOrWhiteSpace(_title))
        {
            _message = Loc.Get("TitleRequired");
            _hasError = true;
            return;
        }

        var scopeFiles = (_scope ?? string.Empty)
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        _saving = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(Card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(Card.Reference.CardId)}",
                new UpdateCardRequest(_title, priority, scopeFiles, Card.Revision, _size, CriterionPayload, _requirements),
                PwaJson.Options);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _message = Loc.Get("CardConflict");
                _hasError = true;
                await OnSaved.InvokeAsync();
                return;
            }

            response.EnsureSuccessStatusCode();
            _message = Loc.Get("ChangesSaved");
            _hasError = false;
            // The identity editor is done with this card: a successful save closes it.
            if (EditOpen)
            {
                await EditOpenChanged.InvokeAsync(false);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            _message = Loc.Format("SaveCardFailed", exception.Message);
            _hasError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private static FlareColor StateColor(StageExecutionState state) => state switch
    {
        StageExecutionState.Completed => FlareColor.Success,
        StageExecutionState.NeedsAttention => FlareColor.Warning,
        StageExecutionState.Cancelled => FlareColor.OnSurfaceVariant,
        StageExecutionState.Running => FlareColor.Primary,
        _ => FlareColor.Info
    };

    private string OtherCardId(CardRelation relation) =>
        relation.Source.CardId == Card.Reference.CardId
            ? relation.Target.CardId
            : relation.Source.CardId;

    /// <summary>
    /// The title of the card at the other end of a relation. A relation whose card is not on the board -
    /// a dangling edge, or one written by an agent for a card that was since deleted - shows its id.
    /// </summary>
    private string OtherCardTitle(CardRelation relation)
    {
        var otherId = OtherCardId(relation);
        return Board.Cards
            .FirstOrDefault(card => StringComparer.Ordinal.Equals(card.Reference.CardId, otherId))
            ?.Title ?? otherId;
    }
}
