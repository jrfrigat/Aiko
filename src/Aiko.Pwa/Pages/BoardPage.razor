@page "/p/{ProjectId}/board"

@* The board: every card type the project defines, one section each, with a type filter that narrows the
   page in place. A card opens as its own page. *@
<PageTitle>@Loc.Get("KanbanBoard")</PageTitle>

<BoardView ProjectId="@ProjectId" />

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
}
