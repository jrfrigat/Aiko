@* One board projection, drawn in the cockpit language: a column per workflow stage with the design's
   three-row header (stage + WIP, agents, DoD) and cards carrying the design's anatomy (mono id, kind
   and priority tags, title, mono metadata line, related-card tags, DoD/assignee footer).

   The board is composed from Flare's drag primitives - FlareDragContext, FlareDropZone, FlareDraggable
   - rather than from FlareKanban itself, whose KanbanColumn/KanbanCard records carry four fields and
   offer no card or column template, so the component cannot express this card. The drag model is
   otherwise the one FlareKanban uses internally; see kanban-card-template.md. *@
<FlareStack Class="aiko-board-section" Gap="FlareSpacing.Small">
    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        @if (KindIcon is { } kindIcon)
        {
            <FlareIconView Value="kindIcon" Color="@KindAccent" />
        }
        <FlareText Element="h2" Typo="TypographyScale.HeadlineMedium" Color="@KindAccent">@Title</FlareText>
        <span class="aiko-tag aiko-tag--pill">@_cards.Count</span>
        <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">@SummaryLine</FlareText>
    </FlareStack>

    @if (_workflow is null)
    {
        <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">
            @Loc.Format("WorkflowNotFound", Kind)
        </FlareAlert>
    }
    else
    {
        <FlareDragContext TPayload="BoardCardDrag" Group="@_dragGroup" OnDrop="OnDropAsync">
            <div class="aiko-board">
                @foreach (var stageItem in _stages)
                {
                    var stage = stageItem;
                    var stageCards = CardsIn(stage.Id);
                    var accent = StageAccent(stage);
                    <FlareDropZone Target="@stage.Id"
                                   Placement="DropPlacement.Between"
                                   Class="aiko-col">
                        <FlareStack Class="aiko-col__head" Gap="FlareSpacing.XXSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                    @if (StageIcon(stage) is { } stageIcon)
                                    {
                                        <FlareIconView Value="stageIcon" Color="@accent" />
                                    }
                                    <FlareText Element="span" Typo="TypographyScale.HeadlineMedium" Color="@accent">@stage.Title</FlareText>
                                </FlareStack>
                                <span class="aiko-tag aiko-tag--pill">@stageCards.Count</span>
                            </FlareStack>
                            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">
                                Agents: @Agents(stage) · WIP: @stageCards.Count
                            </FlareText>
                            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">
                                DoD: @Dod(stage)
                            </FlareText>
                        </FlareStack>

                        <FlareStack Class="aiko-col__body" Gap="FlareSpacing.XXSmall">
                            @foreach (var card in stageCards)
                            {
                                <FlareDraggable @key="card.Reference.CardId"
                                                Id="@card.Reference.CardId"
                                                Payload="@(new BoardCardDrag(card.Reference.CardId, card.StageId))"
                                                Class="aiko-drag">
                                    @* The card opens its own page; only the handle icon drags it (see
                                       wwwroot/js/aiko-board.js). The plain wrapper carries the click
                                       rather than FlareCard itself, so the whole card body is one target. *@
                                    <div class="aiko-card__open" @onclick="() => OnCardSelected.InvokeAsync(card.Reference.CardId)">
                                    <FlareCard Variant="CardVariant.Filled" Size="CardSize.Sm" Class="aiko-card">
                                        <FlareStack Gap="FlareSpacing.XXSmall">
                                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                                    <FlareIconView Value="@FlareIcons.DragIndicator" Class="aiko-card__handle" />
                                                    <FlareText Element="span" Mono="true" Color="FlareColor.Secondary" Weight="FontWeight.SemiBold">
                                                        #@card.Reference.CardId
                                                    </FlareText>

                                                    @if (!string.IsNullOrWhiteSpace(card.Size))
                                                    {
                                                        <span class="aiko-tag @CardAppearance.SizeBadgeClass(card.Size, SizeGrid)">@card.Size</span>
                                                    }
                                                </FlareStack>
                                                <span class="aiko-tag aiko-tag--quiet" title="@PriorityTitle(card)">★ @Score(card)</span>
                                            </FlareStack>

                                            <FlareText Element="h3" Typo="TypographyScale.BodyMedium" Weight="FontWeight.Medium">
                                                @card.Title
                                            </FlareText>

                                            <span class="aiko-card__meta">
                                                <FlareText Element="span" Mono="true">@MetaLine(card)</FlareText>
                                            </span>

                                            @if (RelatedTags(card) is { Count: > 0 } tags)
                                            {
                                                <span class="aiko-card__tags">
                                                    @foreach (var tag in tags)
                                                    {
                                                        <span class="aiko-tag aiko-tag--accent">@tag</span>
                                                    }
                                                </span>
                                            }

                                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall" Class="aiko-card__dod">
                                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                                    <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@DodLine(card)</FlareText>
                                                </FlareStack>
                                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                                    <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">@Agents(stage)</FlareText>
                                                    <FlareSpacer />
                                                    <span class="aiko-tag @StageStateView.TagClass(StageStateOf(card))"
                                                            title="@Loc.Get(StageStateView.LabelKey(StageStateOf(card)))">
                                                        @Loc.Get(StageStateView.LabelKey(StageStateOf(card)))
                                                    </span>
                                                </FlareStack>
                                            </FlareStack>
                                        </FlareStack>
                                    </FlareCard>
                                    </div>
                                </FlareDraggable>
                            }

                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.Center" Class="aiko-col__drop">
                                <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@Loc.Get("DropHere") @stage.Title</FlareText>
                            </FlareStack>
                        </FlareStack>
                    </FlareDropZone>
                }
            </div>
        </FlareDragContext>
    }
</FlareStack>

@code {
    [Inject] private IJSRuntime Js { get; set; } = null!;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Kind { get; set; } = string.Empty;
    [Parameter, EditorRequired] public ProjectBoardSnapshot Board { get; set; } = null!;

    /// <summary>
    /// The project's size grid, so a card's size badge can carry the tone of the step it names.
    /// </summary>
    /// <remarks>
    /// The board snapshot carries cards and runs but not the grid, so the page that owns the workspace hands
    /// it down. An empty grid is honest: without a step there is no coefficient, and a badge with no tone
    /// stays quiet rather than borrowing one.
    /// </remarks>
    [Parameter] public IReadOnlyList<SizeDefinition> SizeGrid { get; set; } = [];

    /// <summary>Raised when a card lands in another stage; the page turns it into one request.</summary>
    [Parameter] public EventCallback<BoardCardMove> OnCardMoved { get; set; }

    /// <summary>Raised when a card is clicked; the page opens it as its own route.</summary>
    [Parameter] public EventCallback<string> OnCardSelected { get; set; }

    private WorkflowDefinition? _workflow;
    private IReadOnlyList<StageDefinition> _stages = [];
    private IReadOnlyList<Card> _cards = [];

    private string _dragGroup => $"aiko-board-{Kind}";

    /// <summary>
    /// The type's icon and accent, or nothing at all: an unset choice draws no icon and leaves the title to
    /// the theme, rather than inventing an icon by position. A project that never opened the appearance
    /// picker should not be shown iconography it did not ask for.
    /// </summary>
    private FlareIcon? KindIcon => CardAppearance.Icon(_workflow?.Icon);

    /// <summary>
    /// The type's accent, or <see cref="FlareColor.Default"/> when the project chose none - which is the
    /// theme's own colour, not an accent Aiko invented.
    /// </summary>
    private FlareColor KindAccent => CardAppearance.Color(_workflow?.Color) ?? FlareColor.Default;

    private string SummaryLine => Loc.Format("CardsStagesCount", _cards.Count, _stages.Count);

    protected override void OnParametersSet()
    {
        // A card type is the workflow of the same name, so the lookup is the type id lower-cased rather
        // than a mapping table: a project that adds an Epic type gets a board section for free.
        var workflowId = CardKind.ToWorkflowId(Kind);
        _workflow = Board.Workflows.FirstOrDefault(workflow =>
            StringComparer.Ordinal.Equals(workflow.Id, workflowId));
        _stages = _workflow?.Stages.OrderBy(stage => stage.Order).ToArray() ?? [];
        _cards = Board.Cards
            .Where(card => StringComparer.OrdinalIgnoreCase.Equals(card.Kind, Kind))
            // Ranked by the priority the formula computes, not by the manual field: with criteria configured
            // the score is the weighted criterion values times the size coefficient, and the manual value is
            // only what a project without criteria ranks by. The projector falls back that way itself, so the
            // board and the card page finally show the same number.
            .OrderByDescending(EffectivePriority)
            .ToArray();
    }

    /// <summary>
    /// Arms the board's drag handle. Flare starts a drag from anywhere inside a draggable card, which
    /// leaves a card impossible to click open, so the page hands the gesture to the handle icon alone -
    /// see wwwroot/js/aiko-board.js. Registered once for the document, so every re-render is a no-op.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("aikoDragHandle.enable");
        }
    }

    private IReadOnlyList<Card> CardsIn(string stageId) =>
        _cards.Where(card => StringComparer.Ordinal.Equals(card.StageId, stageId)).ToArray();

    /// <summary>Cards whose scope does not cover the files the agent actually touched.</summary>
    public static IReadOnlyList<string> FindOutOfScopeFiles(Card card)
    {
        if (card.ActualChangedFiles.Count == 0)
        {
            return [];
        }

        return card.ActualChangedFiles
            .Where(actual => !card.DeclaredScopeFiles.Any(pattern => ScopeMatcher.Matches(pattern, actual)))
            .ToArray();
    }

    private async Task OnDropAsync(FlareDropEventArgs<BoardCardDrag> e)
    {
        if (e.Payload is not { } payload ||
            StringComparer.Ordinal.Equals(payload.StageId, e.TargetId))
        {
            return;
        }

        await OnCardMoved.InvokeAsync(new BoardCardMove(payload.CardId, e.TargetId));
    }

    // A stage's icon and tint are exactly what the stage states, and nothing when it states nothing: the
    // design's five-step state machine is the default workflow, not a contract, so an icon invented by
    // position would be a claim about a column the project never made.
    private FlareIcon? StageIcon(StageDefinition stage) => CardAppearance.Icon(stage.Icon);

    /// <summary>
    /// The stage's accent, or <see cref="FlareColor.Default"/> when the project chose none: the column title
    /// and the icon then keep the theme's own colour instead of an accent invented by position.
    /// </summary>
    private FlareColor StageAccent(StageDefinition stage) =>
        CardAppearance.Color(stage.Color) ?? FlareColor.Default;

    private static string Agents(StageDefinition stage) =>
        string.IsNullOrWhiteSpace(stage.DefaultAgentAdapterId)
            ? Loc.Get("Unassigned")
            : stage.DefaultAgentAdapterId;

    private static string Dod(StageDefinition stage) =>
        stage.RequiredArtifacts.Count == 0
            ? "—"
            : string.Join(", ", stage.RequiredArtifacts.Select(artifact => artifact.Path));

    /// <summary>
    /// The card's effective priority as the daemon computed it: the criterion scores, blended with the
    /// parents' and multiplied by the size coefficient. A card the snapshot does not carry falls back to its
    /// own manual value, which is what a project without criteria ranks by.
    /// </summary>
    private decimal EffectivePriority(Card card) =>
        Board.CardPriorities
            .FirstOrDefault(priority => StringComparer.Ordinal.Equals(
                priority.CardId,
                card.Reference.CardId))
            ?.Snapshot.EffectivePriority ?? card.OwnPriority;

    /// <summary>
    /// The tag's figure: the effective priority on the 0..100 scale the card page prints too, so one glance
    /// compares two cards. The formula's score is a share of the maximum, and a bare "0,47" beside "1" reads
    /// as almost nothing next to everything.
    /// </summary>
    private string Score(Card card) => DisplayFormat.Priority(EffectivePriority(card));

    /// <summary>
    /// Where this card's current stage got to.
    /// </summary>
    /// <remarks>
    /// The answer comes from <see cref="StageStateView"/>, which this board and the card page both ask, so
    /// neither screen can end up deriving the state its own way. A snapshot that says nothing about runs
    /// leaves the stage reading as pending, which is what "nothing known" looks like here.
    /// </remarks>
    private StageState StageStateOf(Card card) =>
        StageStateView.Of(Board.StageRuns, card.Reference.CardId, card.StageId);

    private static string MetaLine(Card card) =>
        $"rev={card.Revision} · files={card.ActualChangedFiles.Count}/{card.DeclaredScopeFiles.Count}";

    private static string DodLine(Card card)
    {
        var deviations = FindOutOfScopeFiles(card).Count;
        if (deviations > 0)
        {
            return $"DoD: {Loc.Format("OutOfScopeCount", deviations)}";
        }

        return card.DeclaredScopeFiles.Count == 0
            ? $"DoD: {Loc.Get("ScopeNotSet")}"
            : $"DoD: {Loc.Format("FilesCount", card.ActualChangedFiles.Count, card.DeclaredScopeFiles.Count)}";
    }

    /// <summary>
    /// The computed priority with the criterion values that produced it, as a tooltip - so the tag explains
    /// the number instead of only repeating it.
    /// </summary>
    private string PriorityTitle(Card card)
    {
        if (card.CriterionValues is not { Count: > 0 } criteria)
        {
            return Score(card);
        }

        return $"{Score(card)} - " + string.Join(", ", criteria.Select(pair =>
            $"{pair.Key}={pair.Value.ToString("0.##", CultureInfo.InvariantCulture)}"));
    }

    /// <summary>
    /// The cards this one is linked to - a task's stories, a story's related items - drawn as the
    /// design's mono tags. Capped, so a hub card cannot push everything else off its own card.
    /// </summary>
    private IReadOnlyList<string> RelatedTags(Card card)
    {
        var id = card.Reference.CardId;
        return Board.Relations
            .Where(relation => StringComparer.Ordinal.Equals(relation.Source.CardId, id) ||
                               StringComparer.Ordinal.Equals(relation.Target.CardId, id))
            .Select(relation => StringComparer.Ordinal.Equals(relation.Source.CardId, id)
                ? relation.Target.CardId
                : relation.Source.CardId)
            .Distinct(StringComparer.Ordinal)
            .Take(3)
            .ToArray();
    }
}
