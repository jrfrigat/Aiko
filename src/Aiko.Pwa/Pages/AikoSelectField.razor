@* A choice in the design's field: the same label, hint and box rhythm as the text fields, drawn by
   FlareSelect so an option can carry more than text - an icon, a colour swatch, anything a template draws.
   FlareSelect brings its own control, which the stylesheet dresses as the cockpit's box; the caller writes
   native <option> elements as before, or Items with templates when the value itself needs a picture. *@
<div class="aiko-field @Class">
    @if (Label is { Length: > 0 } label)
    {
        <label class="aiko-field__label">@label</label>
    }
    @* ChildContent travels as a parameter, not as child markup. Blazor compiles markup children into a
       fragment even when they render nothing, and FlareSelect prefers that fragment over Items - so an
       Items-based field would silently lose its list and show only the "no value" row. Passed this way a
       field with no children hands over null and FlareSelect reads Items as intended. *@
    <FlareSelect TValue="string"
                 Value="@Value"
                 ValueChanged="OnValueChanged"
                 ComponentCssClass="@($"aiko-field__select{(ErrorText is { Length: > 0 } ? " aiko-field__select--error" : string.Empty)}")"
                 AriaLabel="@AriaLabel"
                 Disabled="@Disabled"
                 Items="@Items"
                 ItemLabel="@ItemLabel"
                 ItemTemplate="@ItemTemplate"
                 SelectedTemplate="@SelectedTemplate"
                 ChildContent="@ChildContent"
                 NullOption="@NullOption" />
    @if (ErrorText is { Length: > 0 } error)
    {
        <span class="aiko-field__error">@error</span>
    }
    else if (Hint is { Length: > 0 } hint)
    {
        <span class="aiko-field__hint">@hint</span>
    }
</div>

@code {
    /// <summary>The field's name, above it.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Extra classes for the field wrapper, for a field that needs its own width or spacing.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>What the choice means, under the field.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Why the choice is not acceptable; empty means it is.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>The selected value, or null for "nothing chosen".</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised when the reader picks another option.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// The <c>&lt;option&gt;</c> elements, written by the caller - the declarative form FlareSelect offers
    /// instead of <see cref="Items"/>. A list whose values need a picture uses the templates below instead.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The choices, when they are data the caller already holds.</summary>
    [Parameter] public IEnumerable<string>? Items { get; set; }

    /// <summary>How an item reads in the list and in the field; defaults to the item itself.</summary>
    [Parameter] public Func<string, string>? ItemLabel { get; set; }

    /// <summary>What one row of the list draws, for a value that needs an icon or a swatch.</summary>
    [Parameter] public RenderFragment<string>? ItemTemplate { get; set; }

    /// <summary>What the closed field draws, so the chosen value carries the same picture as the list.</summary>
    [Parameter] public RenderFragment<string>? SelectedTemplate { get; set; }

    /// <summary>
    /// A row meaning "no choice", prepended to the list and pinned there; picking it sets the value to null,
    /// which is how a project says "no icon" rather than an empty string that merely looks like it.
    /// </summary>
    [Parameter] public string? NullOption { get; set; }

    /// <summary>The field's name for a screen reader, when the label is not enough.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(value);
}
