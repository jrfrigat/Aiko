@page "/p/{ProjectId}/cards/new"
@inject HttpClient Http
@inject WorkspaceState State
@inject NavigationManager Navigation

@* Creating a card is a page of its own, not a form wedged into the board: it has several fields, a
   per-project priority formula, and it deserves a URL that can be linked and reloaded. *@
<PageTitle>@Loc.Get("CreateCardTitle")</PageTitle>

<FlareStack Gap="FlareSpacing.Small">
    @* The breadcrumb the card page opens with, so creating a card and reading it start the same way. *@
    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
            <span class="aiko-value">@(State.Board?.Project.Name ?? ProjectId)</span>
            <span class="aiko-tag aiko-tag--quiet">/</span>
            <FlareNavLink Href="@BoardHref"><ChildContent>@Loc.Get("KanbanBoard")</ChildContent></FlareNavLink>
            <span class="aiko-tag aiko-tag--quiet">/</span>
            <span class="aiko-tag aiko-tag--accent">@Loc.Get("CreateCardTitle")</span>
        </FlareStack>
        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="Cancel">
            <LeadingIcon><FlareIconView Value="@FlareIcons.Close" /></LeadingIcon>
            <ChildContent>@Loc.Get("Cancel")</ChildContent>
        </FlareButton>
    </FlareStack>

    @if (State.Board is not { } board)
    {
        <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("BoardUnavailable")</FlareAlert>
    }
    else
    {
        @* The same two columns the card page uses: what the card is on the left, where it starts and how it
           is scored on the right. Creating a card is the first step of the screen it opens into. *@
        <div class="aiko-settings">
            <FlareStack Class="aiko-card__main" Gap="FlareSpacing.Medium">
                <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Medium">
                        <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                <span class="aiko-panel__icon aiko-panel__icon--primary">
                                    <FlareIconView Value="@MaterialDesign3Icons.Regular.Description" />
                                </span>
                                <FlareStack Gap="FlareSpacing.None">
                                    <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("CardIdentityTitle")</FlareText>
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                        @Loc.Get("CardIdentityHint")
                                    </FlareText>
                                </FlareStack>
                            </FlareStack>
                            <span class="aiko-tag aiko-tag--accent">@board.Project.Name</span>
                        </FlareStack>

                        <div class="aiko-form-row">
                            <AikoField Label="@Loc.Get("CardId")"
                                       Hint="@Loc.Get("CardIdHelper")"
                                       Placeholder="FL-201"
                                       Value="@_newCardId"
                                       ValueChanged="value => _newCardId = value" />
                            <AikoField Label="@Loc.Get("Title")"
                                       Value="@_newCardTitle"
                                       ValueChanged="value => _newCardTitle = value" />
                        </div>
                    </FlareStack>
                </FlarePaper>

                <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Medium">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <span class="aiko-panel__icon aiko-panel__icon--secondary">
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Target" />
                            </span>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("ScopeTitle")</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("ScopeHelper")
                                </FlareText>
                            </FlareStack>
                        </FlareStack>
                        <AikoField Label="@Loc.Get("DeclaredScope")"
                                   Hint="@Loc.Get("ScopeHelper")"
                                   Placeholder="@Loc.Get("ScopeHelper")"
                                   Rows="5"
                                   Value="@_newCardScope"
                                   ValueChanged="value => _newCardScope = value" />
                        @if (ScopePreview is { Count: > 0 } preview)
                        {
                            <FlareStack Gap="FlareSpacing.XXSmall">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                    @Loc.Get("FilesDeclared")
                                </FlareText>
                                @foreach (var path in preview)
                                {
                                    var file = path;
                                    <span class="aiko-value aiko-value--clip" title="@file">@file</span>
                                }
                            </FlareStack>
                        }
                    </FlareStack>
                </FlarePaper>
            </FlareStack>
            <FlareStack Class="aiko-card__side" Gap="FlareSpacing.Medium">
                <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Medium">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("CardPlaceTitle")
                        </FlareText>
                        <AikoSelectField Label="@Loc.Get("CardKind")"
                                         Value="@_newCardKind"
                                         ValueChanged="OnKindChangedAsync">
                            <option value="Task">@Loc.Get("TaskKind")</option>
                            <option value="Story">@Loc.Get("StoryKind")</option>
                        </AikoSelectField>
                        @* The stage list is the chosen kind's own workflow: a task cannot join a story stage,
                           which is why the field is a select rather than free text. *@
                        <AikoSelectField Label="@Loc.Get("Stage")"
                                         Value="@_newCardStage"
                                         ValueChanged="value => _newCardStage = value"
                                         Hint="@Loc.Format("WorkflowStagesHint", StagesFor(SelectedKind).Count)">
                            @foreach (var stage in StagesFor(SelectedKind))
                            {
                                var option = stage;
                                <option value="@option.Id">@option.Title</option>
                            }
                        </AikoSelectField>
                        <AikoSelectField Label="@Loc.Get("SizeIdLabel")"
                                         Value="@_newCardSize"
                                         ValueChanged="value => _newCardSize = value"
                                         Hint="@SizeHint">
                            <option value="">@Loc.Get("NoSize")</option>
                            @foreach (var step in SizeGrid)
                            {
                                var option = step;
                                <option value="@option.Id">@SizeOption(option)</option>
                            }
                        </AikoSelectField>
                    </FlareStack>
                </FlarePaper>
                <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Medium">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                @Loc.Get("ScoringCriteria")
                            </FlareText>
                            @if (_priorityCriteria.Count > 0)
                            {
                                <span class="aiko-tag aiko-tag--quiet">@DisplayFormat.Number(_priorityCriteria.Count)</span>
                            }
                        </FlareStack>
                        @if (_priorityCriteria.Count > 0)
                        {
                            @foreach (var criterion in _priorityCriteria)
                            {
                                var item = criterion;
                                <AikoNumberField Label="@item.Title"
                                                 Hint="@($"{item.Minimum} - {item.Maximum}")"
                                                 Value="GetCriterionValue(item.Id)"
                                                 ValueChanged="value => SetCriterionValue(item.Id, value)" />
                            }
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("ScoringHint")
                            </FlareText>
                        }
                        else
                        {
                            @* No criteria: the project scores by hand, so the form asks for the number. *@
                            <AikoNumberField Label="@Loc.Get("Priority")"
                                             Hint="@Loc.Get("NoCriteria")"
                                             Value="@_newCardPriority"
                                             ValueChanged="value => _newCardPriority = value" />
                        }
                    </FlareStack>
                </FlarePaper>

                <FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareButton FullWidth="true" Loading="@_creating" OnClick="CreateAsync">
                            <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                            <ChildContent>@Loc.Get("Create")</ChildContent>
                        </FlareButton>
                        <FlareButton FullWidth="true" Variant="ButtonVariant.Text" OnClick="Cancel">
                            <ChildContent>@Loc.Get("Cancel")</ChildContent>
                        </FlareButton>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("CreateCardHint")
                        </FlareText>
                    </FlareStack>
                </FlarePaper>
            </FlareStack>
        </div>
    }
</FlareStack>

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    private string? _newCardId;
    private string? _newCardKind = "Task";
    private string? _newCardTitle;
    private string? _newCardStage;
    private string? _newCardSize;
    private decimal? _newCardPriority = 1m;
    private string? _newCardScope;
    private bool _creating;
    private IReadOnlyList<PriorityCriterion> _priorityCriteria = [];
    private readonly Dictionary<string, decimal?> _criterionValues = new(StringComparer.Ordinal);

    private string BoardHref => $"/p/{Uri.EscapeDataString(ProjectId)}/board";

    /// <summary>The kind the form is currently creating, which is what the stage list follows.</summary>
    private CardKind SelectedKind => _newCardKind == nameof(CardKind.Story) ? CardKind.Story : CardKind.Task;

    /// <summary>
    /// The stages a card of this kind can start in: the stages of its own workflow. A task cannot join a
    /// story stage, so the form offers the workflow's stages rather than a free-text id.
    /// </summary>
    private IReadOnlyList<StageDefinition> StagesFor(CardKind kind)
    {
        var workflowId = kind == CardKind.Story ? "story" : "task";
        return State.Board?.Workflows
            .FirstOrDefault(workflow => StringComparer.Ordinal.Equals(workflow.Id, workflowId))
            ?.Stages.OrderBy(stage => stage.Order)
            .ToArray() ?? [];
    }

    /// <summary>The project's size grid, the same ladder the agent assigns a card from.</summary>
    private IReadOnlyList<SizeDefinition> SizeGrid => State.Board is null ? [] : _sizeGrid;

    private IReadOnlyList<SizeDefinition> _sizeGrid = [];

    /// <summary>The chosen step, so the form can show what it does to the score.</summary>
    private SizeDefinition? SelectedSize => string.IsNullOrWhiteSpace(_newCardSize)
        ? null
        : _sizeGrid.FirstOrDefault(step => StringComparer.Ordinal.Equals(step.Id, _newCardSize));

    /// <summary>
    /// What the size field says under itself: the coefficient the chosen step applies and what the step
    /// means, or the fact that a card without one is neutral in the formula.
    /// </summary>
    private string SizeHint => SelectedSize is { } selected
        ? $"x{selected.Coefficient} · {selected.Description}"
        : Loc.Get("SizeHintEmpty");

    /// <summary>A step as the select shows it.</summary>
    private static string SizeOption(SizeDefinition step) => $"{step.Id} (x{step.Coefficient})";

    /// <summary>
    /// What the declared scope will become once saved: one pattern per line. Shown under the field so a
    /// comma-separated paste is visible as the list the card will carry.
    /// </summary>
    private IReadOnlyList<string> ScopePreview => (_newCardScope ?? string.Empty)
        .Split(['\r', '\n', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    /// <summary>Switching the kind switches the pipeline, so the stage follows it.</summary>
    private Task OnKindChangedAsync(string? kind)
    {
        _newCardKind = kind;
        _newCardStage = DefaultStage(SelectedKind);
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        await LoadCriteriaAsync();
        if (string.IsNullOrWhiteSpace(_newCardStage))
        {
            _newCardStage = DefaultStage(SelectedKind);
        }
    }

    /// <summary>The project's scoring criteria decide which fields the form asks for.</summary>
    private async Task LoadCriteriaAsync()
    {
        _priorityCriteria = [];
        _criterionValues.Clear();
        if (State.Board is not { } board)
        {
            return;
        }

        try
        {
            var view = await Http.GetFromJsonAsync<AppSettingsView>(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/settings", PwaJson.Options);
            _priorityCriteria = view?.EffectivePriority.Criteria ?? [];
            _sizeGrid = view?.EffectivePriority.Grid ?? [];
        }
        catch
        {
            _priorityCriteria = [];
            _sizeGrid = [];
        }
    }

    /// <summary>The first stage of the workflow a new card of this kind joins.</summary>
    private string DefaultStage(CardKind kind)
    {
        var workflowId = kind == CardKind.Story ? "story" : "task";
        return State.Board?.Workflows
            .FirstOrDefault(workflow => StringComparer.Ordinal.Equals(workflow.Id, workflowId))
            ?.Stages.OrderBy(stage => stage.Order).Select(stage => stage.Id).FirstOrDefault()
            ?? "backlog";
    }

    private decimal? GetCriterionValue(string id) =>
        _criterionValues.TryGetValue(id, out var value) ? value : null;

    private void SetCriterionValue(string id, decimal? value) => _criterionValues[id] = value;

    private Dictionary<string, decimal> BuildCriterionValues()
    {
        var result = new Dictionary<string, decimal>(StringComparer.Ordinal);
        foreach (var criterion in _priorityCriteria)
        {
            if (_criterionValues.TryGetValue(criterion.Id, out var value) && value is { } numeric)
            {
                result[criterion.Id] = numeric;
            }
        }

        return result;
    }

    private async Task CreateAsync()
    {
        if (State.Board is not { } board ||
            string.IsNullOrWhiteSpace(_newCardId) ||
            string.IsNullOrWhiteSpace(_newCardTitle) ||
            _creating)
        {
            await State.ReportErrorAsync(Loc.Get("IdTitleRequired"));
            return;
        }

        _creating = true;
        try
        {
            var kind = SelectedKind;
            var criterionValues = BuildCriterionValues();
            var ownPriority = criterionValues.Count > 0
                ? PriorityCalculator.CalculateOwnPriority(criterionValues, _priorityCriteria)
                : _newCardPriority ?? 0m;
            var request = new CreateCardRequest(
                _newCardId.Trim(),
                kind,
                _newCardTitle.Trim(),
                kind == CardKind.Story ? "story" : "task",
                string.IsNullOrWhiteSpace(_newCardStage) ? DefaultStage(kind) : _newCardStage.Trim(),
                ownPriority,
                ScopePreview.ToArray(),
                criterionValues.Count > 0 ? criterionValues : null,
                string.IsNullOrWhiteSpace(_newCardSize) ? null : _newCardSize.Trim());
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/cards",
                request,
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            await State.LoadBoardAsync();
            // Straight to the card: it exists now, and that is what the person came here to fill in.
            Navigation.NavigateTo(
                $"/p/{Uri.EscapeDataString(ProjectId)}/cards/{Uri.EscapeDataString(request.CardId)}");
        }
        catch (Exception exception)
        {
            await State.ReportErrorAsync(Loc.Format("CreateCardFailed", FailureText.Describe(exception)));
        }
        finally
        {
            _creating = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo(BoardHref);
}
