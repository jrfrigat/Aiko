@page "/"

@* The dashboard: the workshop at a glance. It is the landing page and the global screen, so it opens
   no project - the aggregate numbers are read straight from each registered project's board. *@
@implements IAsyncDisposable
@inject HttpClient Http
@inject WorkspaceState State
@inject NavigationManager Navigation

<PageTitle>@Loc.Get("Dashboard")</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    @if (_error is { Length: > 0 } error)
    {
        <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@error</FlareAlert>
    }

    <FlareStack Gap="FlareSpacing.XXSmall">
        <FlareText Element="h2" Typo="TypographyScale.HeadlineSmall">@Loc.Get("Dashboard")</FlareText>
        <FlareText Element="span" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
            @Loc.Get("DashboardCaption")
        </FlareText>
    </FlareStack>

    @if (_loading)
    {
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
            <FlareProgressCircular Size="TrackSize.Xs" />
            <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                @Loc.Get("LoadingContext")
            </FlareText>
        </FlareStack>
    }
    else
    {
        @* The metric cards: the design's five tiles, each with the number it counts and what that number
           is made of. They replace a one-line mono strip because a workshop's state is read at a glance
           here, not compared digit by digit. *@
        <div class="aiko-metric-grid">
            @foreach (var card in MetricCards)
            {
                var item = card;
                <FlareStack Class="aiko-metric" Gap="FlareSpacing.XXSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                            <FlareIconView Value="@item.Icon" Color="@item.Accent" />
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                @item.Label
                            </FlareText>
                        </FlareStack>
                        @if (item.Tag is { Length: > 0 } tag)
                        {
                            <span class="aiko-tag @(item.Warn ? "aiko-tag--warn" : "aiko-tag--quiet")">@tag</span>
                        }
                    </FlareStack>
                    <span class="aiko-value aiko-value--big @(item.Warn ? "aiko-value--warn" : null)">@item.Value</span>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @item.Caption
                    </FlareText>
                </FlareStack>
            }
        </div>

        <FlareCard Variant="CardVariant.Filled">
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                    <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ActivityTitle")</FlareText>
                    <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@Loc.Get("ActivityCaption")</FlareText>
                </FlareStack>

                @* The calendar and its empty state live in one component now: the project page draws the
                   same picture over its own days. *@
                <ActivityCalendar Days="_activity" />
            </FlareStack>
        </FlareCard>
    }

    <FlareDivider />

    <FlareGrid Columns="3" Gap="FlareSpacing.XSmall">
        <FlareCol Span="1">
            <FlareCard Variant="CardVariant.Filled">
                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("Daemon")</FlareText>
                    <FlareList TItem="string" Dense="true">
                        <FlareListItem Primary="@Loc.Get("Address")">
                            <Trailing><FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@(State.System?.BaseUrl ?? "-")</FlareText></Trailing>
                        </FlareListItem>
                        <FlareListItem Primary="@Loc.Get("Version")">
                            <Trailing><FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@(State.System?.Version ?? "-")</FlareText></Trailing>
                        </FlareListItem>
                        <FlareListItem Primary="PID">
                            <Trailing><FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@(State.System is null ? "-" : State.System.ProcessId.ToString(CultureInfo.InvariantCulture))</FlareText></Trailing>
                        </FlareListItem>
                    </FlareList>
                </FlareStack>
            </FlareCard>
        </FlareCol>

        <FlareCol Span="1">
            <FlareCard Variant="CardVariant.Filled">
                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("Agents")</FlareText>
                    <FlareList TItem="string" Dense="true">
                        @foreach (var adapter in State.Agents)
                        {
                            var item = adapter;
                            <AgentRow Adapter="item" OnToggle="ToggleAgentAsync" />
                        }
                    </FlareList>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("AgentsHint")
                    </FlareText>
                </FlareStack>
            </FlareCard>
        </FlareCol>

        <FlareCol Span="1">
            <FlareCard Variant="CardVariant.Filled">
                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("QuickStartTitle")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@Loc.Get("QuickStartStep1")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@Loc.Get("QuickStartStep2")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@Loc.Get("QuickStartStep3")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@Loc.Get("QuickStartStep4")</FlareText>
                </FlareStack>
            </FlareCard>
        </FlareCol>
    </FlareGrid>

    <FlareDivider />

    <FlareStack Gap="FlareSpacing.Small">
        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
            <FlareText Element="h3" Typo="TypographyScale.TitleSmall">
                @Loc.Get("ProjectsRegistered")
                <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@DisplayFormat.Number(State.Projects.Count)</FlareText>
            </FlareText>
            <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="OpenAddProject">
                <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                <ChildContent>@Loc.Get("AddProject")</ChildContent>
            </FlareButton>
        </FlareStack>

        @if (_showAddProject)
        {
            <FlareCard Variant="CardVariant.Outlined">
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("AddProject")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                        @Loc.Get("AddProjectHint")
                    </FlareText>
                    <FlareStack Row="true" Align="FlareAlignItems.End" Gap="FlareSpacing.XSmall" StretchFirst="true">
                        <AikoField Label="@Loc.Get("ProjectPath")"
                                   Placeholder="C:\work\project"
                                   Value="@_newProjectPath"
                                   ValueChanged="SetProjectPath" />
                        <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="OpenBrowserAsync">
                            <LeadingIcon><FlareIconView Value="@FlareIcons.FolderOpen" /></LeadingIcon>
                            <ChildContent>@Loc.Get("Browse")</ChildContent>
                        </FlareButton>
                    </FlareStack>
                    <FlareStack Row="true" Align="FlareAlignItems.End" Gap="FlareSpacing.XSmall" StretchFirst="true">
                        <AikoField Label="@Loc.Get("ProjectName")"
                                   Value="@_newProjectName"
                                   ValueChanged="value => _newProjectName = value" />
                        @* The id is what the address shows, so it is filled in from the folder as soon as a
                           path is chosen and stays editable: the derived value is a starting point, not a
                           rule. *@
                        <AikoField Label="@Loc.Get("ProjectIdLabel")"
                                   ErrorText="@ProjectIdError"
                                   Value="@_newProjectSlug"
                                   ValueChanged="value => _newProjectSlug = value" />
                    </FlareStack>
                    <AikoSelectField Label="@Loc.Get("GitPolicy")"
                                     Value="@_newGitPolicy"
                                     ValueChanged="value => _newGitPolicy = value">
                        <option value="LocalOnly">@Loc.Get("GitPolicyLocalOnly")</option>
                        <option value="TrackProjectKnowledge">@Loc.Get("GitPolicyTrackKnowledge")</option>
                        <option value="Custom">@Loc.Get("GitPolicyCustom")</option>
                    </AikoSelectField>
                    @* The template decides what the project starts with: stages, their artifacts, the board
                       projections, the starting memory and the default settings. It is copied in, so changing
                       it later never reaches a project that already exists. *@
                    @if (State.Templates.Count > 0)
                    {
                        <AikoSelectField Label="@Loc.Get("Template")"
                                         Hint="@Loc.Get("TemplateHint")"
                                         Value="@_newTemplateId"
                                         ValueChanged="value => _newTemplateId = value">
                            @foreach (var template in State.Templates)
                            {
                                var option = template;
                                <option value="@option.Id">@TemplateOption(option)</option>
                            }
                        </AikoSelectField>
                    }
                    else
                    {
                        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                            @Loc.Get("TemplateFirstProjectHint")
                        </FlareText>
                    }
                    @* Which agents this project is for. Only connected ones are offered: an agent that is not
                       connected for the user has no global skills to read, so connecting it here would look
                       like it worked while the agent stayed blind. *@
                    @if (ConnectableAgents.Count > 0)
                    {
                        <FlareStack Gap="FlareSpacing.XSmall">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                @Loc.Get("Agents")
                            </FlareText>
                            <FlareStack Row="true" Gap="FlareSpacing.XSmall" Wrap="true">
                                @foreach (var adapter in ConnectableAgents)
                                {
                                    var item = adapter;
                                    <FlareButton Variant="@(_newAgentIds.Contains(item.Id) ? ButtonVariant.Tonal : ButtonVariant.Text)"
                                                 Size="ButtonSize.Sm"
                                                 OnClick="() => ToggleNewAgent(item.Id)">
                                        <ChildContent>@item.DisplayName</ChildContent>
                                    </FlareButton>
                                }
                            </FlareStack>
                        </FlareStack>
                    }
                    <FlareStack Row="true" Gap="FlareSpacing.XSmall">
                        <FlareButton OnClick="AddProjectAsync">@Loc.Get("Add")</FlareButton>
                        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseAddProject">@Loc.Get("Cancel")</FlareButton>
                    </FlareStack>

                    @* The folder browser: the daemon lists directories, because the browser cannot hand an
                       absolute path to the page (File System Access API exposes only the folder's name). *@
                    @if (_browsing)
                    {
                        <FlareDivider />
                        <FlareStack Gap="FlareSpacing.Small">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                                <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ChooseFolder")</FlareText>
                                <FlareIconButton Variant="ButtonVariant.Text"
                                                 Icon="@FlareIcons.Close"
                                                 AriaLabel="@Loc.Get("Close")"
                                                 OnClick="CloseBrowser" />
                            </FlareStack>

                            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">
                                @(_browse?.Path ?? Loc.Get("Drives"))
                            </FlareText>

                            @if (_browseError is { Length: > 0 } browseError)
                            {
                                <FlareAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Outlined">@browseError</FlareAlert>
                            }

                            @if (_browse is { } listing)
                            {
                                @if (!listing.IsReadable)
                                {
                                    <FlareAlert Severity="AlertSeverity.Warning" Variant="AlertVariant.Text">@Loc.Get("FolderUnreadable")</FlareAlert>
                                }

                                <FlareStack Row="true" Gap="FlareSpacing.XXSmall" Wrap="true">
                                    @if (listing.Parent is not null)
                                    {
                                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                                     OnClick="() => BrowseAsync(listing.Parent)">
                                            <LeadingIcon><FlareIconView Value="@FlareIcons.ArrowUpward" /></LeadingIcon>
                                            <ChildContent>@Loc.Get("Up")</ChildContent>
                                        </FlareButton>
                                    }
                                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                                 OnClick="() => BrowseAsync(null)">@Loc.Get("Drives")</FlareButton>
                                    @if (listing.Path is not null)
                                    {
                                        <FlareButton Size="ButtonSize.Sm" OnClick="() => ChooseFolder(listing.Path)">
                                            <ChildContent>@Loc.Get("UseThisFolder")</ChildContent>
                                        </FlareButton>
                                    }
                                </FlareStack>

                                <FlareList TItem="DirectoryEntry" Dense="true">
                                    @foreach (var entry in listing.Entries)
                                    {
                                        var item = entry;
                                        <FlareListItem Primary="@item.Name" Secondary="@item.Path">
                                            <Leading>
                                                <FlareIconView Value="@(item.IsAikoProject ? FlareIcons.CheckCircle : FlareIcons.FolderOpen)" />
                                            </Leading>
                                            <Trailing>
                                                @if (item.IsAikoProject)
                                                {
                                                    <span class="aiko-tag aiko-tag--accent">@Loc.Get("ExistingProject")</span>
                                                }
                                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                                             Disabled="@(!item.IsReadable)"
                                                             OnClick="() => BrowseAsync(item.Path)">@Loc.Get("Open")</FlareButton>
                                            </Trailing>
                                        </FlareListItem>
                                    }
                                </FlareList>
                            }
                        </FlareStack>
                    }
                </FlareStack>
            </FlareCard>
        }

        @if (State.Projects.Count == 0)
        {
            <FlareEmptyState Compact="true"
                             Title="@Loc.Get("EmptyStateTitle")"
                             Description="@Loc.Get("EmptyStateHint")">
                <IconContent><FlareIconView Size="2rem" Value="@FlareIcons.FolderOpen" /></IconContent>
            </FlareEmptyState>
        }
        else
        {
            @* The registered workspaces as the design's table: one row per project, with the numbers the
               workshop reads it by and the two actions a project has here. The unregistering row turns
               into its own confirmation, because a project's board is a lot to lose by a mis-click. *@
            <div class="aiko-table">
                <div class="aiko-table__head">
                    <span>@Loc.Get("TableProject")</span>
                    <span>@Loc.Get("ProjectPath")</span>
                    <span>@Loc.Get("StatCards")</span>
                    <span>@Loc.Get("StatInProgress")</span>
                    <span>@Loc.Get("TableStatus")</span>
                    <span>@Loc.Get("GitBranch")</span>
                    <span>@Loc.Get("TableActions")</span>
                </div>
                @foreach (var project in State.Projects)
                {
                    var item = project;
                    var board = BoardOf(item.Id);
                    <div class="aiko-table__row">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareAvatar Text="@DisplayFormat.Initials(item.Name)" Size="AvatarSize.Xs" Shape="AvatarShape.Square" />
                            @* The name itself opens the project: it is the first thing a reader points at, and a
                               separate button for the same action is one control too many. *@
                            <a class="aiko-link" href="@ProjectLink(item.Handle)" title="@Loc.Get("OpenProject")">
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Weight="FontWeight.SemiBold">
                                    @item.Name
                                </FlareText>
                            </a>
                        </FlareStack>
                        <span class="aiko-value aiko-value--clip" title="@item.RootPath">@item.RootPath</span>
                        <span class="aiko-value">@DisplayFormat.Number(board?.Cards.Count ?? 0)</span>
                        <span class="aiko-value">@DisplayFormat.Number(BoardMetrics.InProgressCount(board))</span>
                        <span class="aiko-tag @(board is null ? "aiko-tag--warn" : "aiko-tag--live")">
                            @(board is null ? Loc.Get("NoBoardData") : Loc.Get("StatLive"))
                        </span>
                        @* The branch the project sits on, or why there is none: a missing git client and a
                           directory that is not a repository are different answers and read differently. *@
                        @{
                            var git = GitOf(item.Id);
                        }
                        @if (git is { IsRepository: true, Branch.Length: > 0 } onBranch)
                        {
                            <span class="aiko-tag aiko-tag--accent aiko-tag--clip" title="@onBranch.Branch">@onBranch.Branch</span>
                        }
                        else if (git is { Available: false })
                        {
                            <span class="aiko-tag aiko-tag--warn">@Loc.Get("GitClientUnavailable")</span>
                        }
                        else
                        {
                            <span class="aiko-tag aiko-tag--quiet">@Loc.Get("GitNoRepository")</span>
                        }
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                            @if (_removingProjectId == item.Id)
                            {
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.Warning">
                                    @Loc.Get("UnregisterConfirm")
                                </FlareText>
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                             OnClick="() => RemoveProjectAsync(item.Id)">@Loc.Get("Unregister")</FlareButton>
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                             OnClick="CancelRemoveProject">@Loc.Get("Cancel")</FlareButton>
                            }
                            else
                            {
                                <FlareIconButton Variant="ButtonVariant.Text"
                                                 Icon="@FlareIcons.Delete"
                                                 AriaLabel="@Loc.Get("Unregister")"
                                                 OnClick="() => BeginRemoveProject(item.Id)" />
                            }
                        </FlareStack>
                    </div>
                }
            </div>
        }
    </FlareStack>
</FlareStack>

@code {
    private IReadOnlyList<ProjectBoardSnapshot> _boards = [];

    /// <summary>What git says about each project, keyed by project id; read with the boards.</summary>
    private IReadOnlyDictionary<string, GitStatus> _git = new Dictionary<string, GitStatus>(StringComparer.Ordinal);
    private IReadOnlyList<ActivityDay> _activity = [];
    private int _activityTotal;
    private int _todayCount;
    private bool _loading = true;
    private string? _error;
    private bool _showAddProject;
    private string? _newTemplateId;
    private string? _removingProjectId;
    private bool _browsing;
    private DirectoryListing? _browse;
    private string? _browseError;
    private string? _newProjectPath;
    private string? _newProjectName;
    private string? _newProjectSlug;

    /// <summary>The agents ticked in the add-project form, by adapter id.</summary>
    private readonly HashSet<string> _newAgentIds = new(StringComparer.Ordinal);
    private string? _newGitPolicy = "LocalOnly";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        // The dashboard is the global screen: leaving a project open would put its board in the rail
        // while this page talks about all of them.
        await State.ClearProjectAsync();
        await LoadAsync();
    }

    private Task OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            // One board snapshot per project. A handful of loopback requests is the price of counting
            // cards the daemon does not aggregate anywhere else; the alternative would be another
            // endpoint duplicating what the board already answers.
            var boards = await Task.WhenAll(State.Projects.Select(LoadBoardAsync));
            _boards = boards.Where(board => board is not null).Select(board => board!).ToArray();
            // Git statuses are read with the boards, in parallel: the table shows a branch per row, and a
            // row must never spawn a process while rendering.
            var git = await Task.WhenAll(State.Projects.Select(LoadGitAsync));
            _git = State.Projects
                .Select((project, index) => (project.Id, Status: git[index]))
                .Where(entry => entry.Status is not null)
                .ToDictionary(entry => entry.Id, entry => entry.Status!, StringComparer.Ordinal);
            _activity = await Http.GetFromJsonAsync<IReadOnlyList<ActivityDay>>(
                $"api/v1/activity?days={ActivityHeatmap.WindowDays}", PwaJson.Options) ?? [];
            // The calendar builds its own rectangle; the shell only needs the two figures it shows
            // elsewhere - how much was recorded, and how much of it was today.
            _activityTotal = ActivityHeatmap.Total(_activity);
            _todayCount = ActivityHeatmap.TotalOn(_activity, DateOnly.FromDateTime(DateTime.UtcNow));
        }
        catch (Exception exception)
        {
            _error = FailureText.Describe(exception);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<ProjectBoardSnapshot?> LoadBoardAsync(RegisteredProject project)
    {
        try
        {
            return await Http.GetFromJsonAsync<ProjectBoardSnapshot>(
                $"api/v1/projects/{Uri.EscapeDataString(project.Id)}/board", PwaJson.Options);
        }
        catch
        {
            // A project that has gone missing must not blank the whole dashboard.
            return null;
        }
    }

    /// <summary>
    /// Reads what git says about one project. A failure is null rather than an error: a dashboard that
    /// cannot show a branch is still a dashboard.
    /// </summary>
    private async Task<GitStatus?> LoadGitAsync(RegisteredProject project)
    {
        try
        {
            var overview = await Http.GetFromJsonAsync<GitOverview>(
                $"api/v1/projects/{Uri.EscapeDataString(project.Id)}/git", PwaJson.Options);
            return overview?.Status;
        }
        catch
        {
            return null;
        }
    }

    private ProjectBoardSnapshot? BoardOf(string projectId) =>
        _boards.FirstOrDefault(board => StringComparer.Ordinal.Equals(board.Project.Id, projectId));

    /// <summary>
    /// What git says about one project, or null while it has not been read yet. The statuses are read once
    /// with the boards: a table row must not spawn a process per render.
    /// </summary>
    private GitStatus? GitOf(string projectId) =>
        _git.TryGetValue(projectId, out var status) ? status : null;

    /// <summary>
    /// The workshop's five numbers, as the design's tiles: what is on the boards, what is in flight, and
    /// what drifted. Each card carries the caption that says what its number is made of, because a total
    /// across projects means nothing without one.
    /// </summary>
    private IReadOnlyList<(string Label, string Value, string Caption, string? Tag, FlareIcon Icon, FlareColor Accent, bool Warn)> MetricCards
    {
        get
        {
            var cards = _boards.Sum(board => board.Cards.Count);
            // The two type tiles are read from the projects' own data: a type that rolls its score up into
            // its parents is the atomic work, and a type that keeps its own score is the container. No type
            // name is written down here.
            var tasks = _boards.Sum(BoardMetrics.BlendingCount);
            var stories = _boards.Sum(BoardMetrics.NonBlendingCount);
            var inProgress = _boards.Sum(BoardMetrics.InProgressCount);
            var outOfScope = _boards.Sum(BoardMetrics.OutOfScopeCount);
            return
            [
                (Loc.Get("StatCards"),
                    DisplayFormat.Number(cards),
                    Loc.Format("AcrossProjects", DisplayFormat.Number(State.Projects.Count)),
                    _todayCount > 0 ? Loc.Format("TodayDelta", DisplayFormat.Number(_todayCount)) : null,
                    MaterialDesign3Icons.Regular.Dashboard,
                    FlareColor.Primary,
                    false),
                (Loc.Get("StatTasks"),
                    DisplayFormat.Number(tasks),
                    Loc.Get("StatTasksCaption"),
                    null,
                    MaterialDesign3Icons.Regular.TaskAlt,
                    FlareColor.Secondary,
                    false),
                (Loc.Get("StatStories"),
                    DisplayFormat.Number(stories),
                    Loc.Get("StatStoriesCaption"),
                    null,
                    MaterialDesign3Icons.Regular.AccountTree,
                    FlareColor.Tertiary,
                    false),
                (Loc.Get("StatInProgress"),
                    DisplayFormat.Number(inProgress),
                    Loc.Format("StatInProgressCaption", DisplayFormat.Number(State.Agents.Count)),
                    null,
                    MaterialDesign3Icons.Regular.Hub,
                    FlareColor.Secondary,
                    false),
                (Loc.Get("StatOutOfScope"),
                    DisplayFormat.Number(outOfScope),
                    Loc.Get("StatOutOfScopeCaption"),
                    null,
                    MaterialDesign3Icons.Regular.Warning,
                    outOfScope > 0 ? FlareColor.Error : FlareColor.OnSurfaceVariant2,
                    outOfScope > 0)
            ];
        }
    }

    /// <summary>
    /// Unregistering is asked twice: the first press only marks the row, and the row turns into its own
    /// confirmation. A project's board is a lot to lose by a mis-click.
    /// </summary>
    private void BeginRemoveProject(string projectId) => _removingProjectId = projectId;

    private void CancelRemoveProject() => _removingProjectId = null;

    /// <summary>
    /// Unregisters a project: the daemon forgets it, its files on disk stay. The local board snapshot is
    /// dropped alongside, so the numbers above cannot keep counting a project the list no longer shows.
    /// </summary>
    private async Task RemoveProjectAsync(string projectId)
    {
        _removingProjectId = null;
        _error = null;
        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/projects/{Uri.EscapeDataString(projectId)}");
            response.EnsureSuccessStatusCode();
            _boards = _boards
                .Where(board => !StringComparer.Ordinal.Equals(board.Project.Id, projectId))
                .ToArray();
            await State.ReloadProjectsAsync();
        }
        catch (Exception exception)
        {
            _error = Loc.Format("UnregisterFailed", FailureText.Describe(exception));
        }
    }

    /// <summary>A template as the select shows it: the name, and the version it will be copied at.</summary>
    private static string TemplateOption(ProjectTemplateSummary template) =>
        $"{template.Name} v{template.Version}";

    /// <summary>
    /// The agents the add-project form offers: installed on this machine and connected for the user. An agent
    /// that is neither has nothing global to read, so offering it would look like it worked while the agent
    /// stayed blind.
    /// </summary>
    private IReadOnlyList<AgentAdapterOption> ConnectableAgents => State.Agents
        .Where(adapter => DisplayFormat.Classify(adapter) == DisplayFormat.AgentPresence.Connected)
        .ToArray();

    /// <summary>Adds or removes one agent from the add-project form's selection.</summary>
    private void ToggleNewAgent(string adapterId)
    {
        if (!_newAgentIds.Remove(adapterId))
        {
            _newAgentIds.Add(adapterId);
        }
    }

    private void OpenAddProject()
    {
        _showAddProject = true;
        _newAgentIds.Clear();
        // Preselect the template an init without a choice would use anyway, so the common case is one
        // click and the choice is still visible.
        _newTemplateId ??= State.Templates.FirstOrDefault(template => template.IsDefault)?.Id
            ?? State.Templates.FirstOrDefault()?.Id;
    }

    private void CloseAddProject()
    {
        _showAddProject = false;
        CloseBrowser();
    }

    /// <summary>
    /// Opens the folder browser at what is already typed, so a path that only needs one more segment
    /// does not have to be walked from the roots again.
    /// </summary>
    private async Task OpenBrowserAsync()
    {
        _browsing = true;
        await BrowseAsync(_newProjectPath);
        if (_browse is null && !string.IsNullOrWhiteSpace(_newProjectPath))
        {
            // A typed path that is not a directory (a typo, or a file) is exactly what the browser is
            // for: show the roots rather than an error the user cannot act on.
            await BrowseAsync(null);
        }
    }

    private void CloseBrowser()
    {
        _browsing = false;
        _browse = null;
        _browseError = null;
    }

    /// <summary>
    /// Lists one level of the filesystem through the daemon. The page cannot do it itself: the File
    /// System Access API hands out a handle whose name is only the last segment, and the daemon needs an
    /// absolute path.
    /// </summary>
    private async Task BrowseAsync(string? path)
    {
        _browseError = null;
        try
        {
            var query = string.IsNullOrWhiteSpace(path)
                ? "api/v1/fs/directories"
                : $"api/v1/fs/directories?path={Uri.EscapeDataString(path)}";
            _browse = await Http.GetFromJsonAsync<DirectoryListing>(query, PwaJson.Options);
        }
        catch (Exception exception)
        {
            _browse = null;
            _browseError = Loc.Format("BrowseFailed", FailureText.Describe(exception));
        }
    }

    private void ChooseFolder(string path)
    {
        SetProjectPath(path);
        CloseBrowser();
    }

    /// <summary>
    /// Takes the chosen or typed path and fills the name and the id in from it, so the common case is one
    /// action. Both stay editable afterwards: the derived values are a starting point, not a rule.
    /// </summary>
    private void SetProjectPath(string? path)
    {
        _newProjectPath = path;
        var folder = FolderName(path);
        _newProjectName = folder;
        _newProjectSlug = folder is { Length: > 0 } ? ProjectSlug.Derive(folder) : null;
    }

    /// <summary>
    /// The folder a path names, with its separators trimmed so a pasted <c>C:\work\aiko\</c> gives
    /// <c>aiko</c> rather than an empty name.
    /// </summary>
    private static string? FolderName(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        var trimmed = path.Trim().TrimEnd('\\', '/');
        var separator = trimmed.LastIndexOfAny(['\\', '/']);
        return separator >= 0 ? trimmed[(separator + 1)..] : trimmed;
    }

    /// <summary>The board a project's name links to: the same place the rail's board item goes.</summary>
    private static string ProjectLink(string projectHandle) =>
        ProjectRoutes.Board(projectHandle);

    /// <summary>
    /// Why the id as typed cannot be used, or null when it can.
    /// </summary>
    /// <remarks>
    /// The daemon is still the authority - it answers a conflict if the value was taken between this check
    /// and the request - but a form that waits for a round trip to say "that is not a valid id" is a form
    /// that lets a user submit an impossible value. An empty field is not an error: it means "derive one".
    /// </remarks>
    private string? ProjectIdError
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_newProjectSlug))
            {
                return null;
            }

            if (!ProjectSlug.IsValid(_newProjectSlug))
            {
                return Loc.Get("ProjectIdInvalid");
            }

            return State.Projects.Any(project =>
                StringComparer.Ordinal.Equals(project.Slug, _newProjectSlug))
                    ? Loc.Get("ProjectIdTaken")
                    : null;
        }
    }

    private async Task AddProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(_newProjectPath))
        {
            _error = Loc.Get("PathRequired");
            return;
        }

        if (ProjectIdError is { Length: > 0 } idError)
        {
            _error = idError;
            return;
        }

        var project = await State.InitializeProjectAsync(
            _newProjectPath.Trim(),
            string.IsNullOrWhiteSpace(_newProjectName) ? null : _newProjectName.Trim(),
            Enum.Parse<ProjectGitPolicy>(_newGitPolicy ?? nameof(ProjectGitPolicy.LocalOnly)),
            _newTemplateId,
            string.IsNullOrWhiteSpace(_newProjectSlug) ? null : _newProjectSlug.Trim(),
            _newAgentIds.Count == 0 ? null : _newAgentIds.ToArray());
        if (project is null)
        {
            _error = State.Error;
            return;
        }

        _showAddProject = false;
        _newProjectPath = null;
        _newProjectName = null;
        _newProjectSlug = null;
        _newTemplateId = null;
        // Land on the new project's board: registering a project is a step towards working in it, and the
        // link uses the readable handle, which is the whole point of having one.
        OpenProject(project.Handle);
        await Task.CompletedTask;
    }

    private void OpenProject(string projectHandle) =>
        Navigation.NavigateTo(ProjectRoutes.Board(projectHandle));

    /// <summary>
    /// Connects or disconnects one agent on this machine. Connecting writes Aiko's global skills and
    /// commands for that agent; a fully connected agent is disconnected instead, so one button covers the
    /// state it is in.
    /// </summary>
    private async Task ToggleAgentAsync(string adapterId)
    {
        var adapter = State.Agents.FirstOrDefault(item =>
            StringComparer.Ordinal.Equals(item.Id, adapterId));
        _error = null;

        if (adapter is not null &&
            DisplayFormat.Classify(adapter) == DisplayFormat.AgentPresence.Connected)
        {
            await State.DisconnectAgentAsync(adapterId);
        }
        else
        {
            await State.ConnectAgentAsync(adapterId);
        }

        _error = State.Error;
    }


    public ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        return ValueTask.CompletedTask;
    }
}
