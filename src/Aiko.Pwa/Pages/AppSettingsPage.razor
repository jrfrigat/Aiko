@page "/templates/{TemplateId}"
@inject HttpClient Http
@inject WorkspaceState State

@* The workflows every new project is created from, for one template. A template is the level this screen
   edits - its pipelines and its defaults - and changing it affects the projects created afterwards, never a
   project that already exists. The project's own settings are a different screen at /p/{projectId}/settings.
   There is no separate "global settings" screen: this one is reached from the Workflow list. *@
<PageTitle>@($"{Loc.Get("TemplatesHeading")} · {_template?.Name ?? string.Empty}")</PageTitle>

<SettingsEditor>
    <LeadingContent>
        @* What the template asks for beyond copying its files: the structure a project of this kind should
           have. It is copied into the project at init and the agent carries it out then, so it belongs with
           the defaults - and first, because everything below it is a default that document leans on. *@
        @if (_template is not null)
        {
            <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <span class="aiko-panel__icon aiko-panel__icon--primary">
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Layers" />
                            </span>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("InitializationTitle")</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("InitializationHint")
                                </FlareText>
                            </FlareStack>
                        </FlareStack>
                        <FlareButton Variant="ButtonVariant.Filled"
                                     Size="ButtonSize.Sm"
                                     Loading="@_savingTemplate"
                                     OnClick="SaveTemplateAsync">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" /></LeadingIcon>
                            <ChildContent>@Loc.Get("SaveTemplate")</ChildContent>
                        </FlareButton>
                    </FlareStack>
                    @* The block is named after the file it becomes in the project: what a person writes here is
                       what the agent reads as .aiko/initialization.md. *@
                    <PromptField Name="initialization.md"
                                 Title="@Loc.Get("InitializationTitle")"
                                 Rows="6"
                                 Value="@_initializationInstruction"
                                 ValueChanged="value => _initializationInstruction = value" />
                    @if (!string.IsNullOrWhiteSpace(_templateMessage))
                    {
                        <FlareAlert Severity="@(_templateHasError ? AlertSeverity.Error : AlertSeverity.Success)"
                                    Variant="AlertVariant.Outlined">@_templateMessage</FlareAlert>
                    }
                </FlareStack>
            </FlarePaper>
        }
    </LeadingContent>
    <ExtraNarrowContent>
        @if (_template is not { } template || template.Workflows.Count == 0)
        {
            <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">
                @Loc.Get("WorkflowUnavailable")
            </FlareAlert>
        }
        else
        {
            @* The same editor the project screen uses, pointed at the template's pipelines: they are the
               starting point of every project created from it. *@
            <WorkflowInspector Workflows="template.Workflows"
                               InitialWorkflowId="task"
                               Save="SaveWorkflowAsync"
                               Create="CreateWorkflowAsync"
                               Delete="DeleteWorkflowAsync" />
        }
    </ExtraNarrowContent>
</SettingsEditor>

@code {
    /// <summary>Template to edit, or null for the one an init without a choice uses.</summary>
    [Parameter] public string? TemplateId { get; set; }

    private ProjectTemplate? _template;
    private string? _initializationInstruction;
    private string? _templateMessage;
    private bool _templateHasError;
    private bool _savingTemplate;

    private string EditingTemplateId => string.IsNullOrWhiteSpace(TemplateId)
        ? ProjectTemplate.DefaultId
        : TemplateId;

    protected override async Task OnParametersSetAsync()
    {
        // The application scope has no project, so the board and the live stream are released.
        await State.ClearProjectAsync();
        try
        {
            await ReloadTemplateAsync();
        }
        catch (Exception exception)
        {
            await State.ReportErrorAsync(FailureText.Describe(exception));
        }
    }

    /// <summary>
    /// Writes one pipeline of the template and re-reads it, so the editor's revision and the version tag
    /// follow. Returns the failure text, or null when it was saved.
    /// </summary>
    private async Task<string?> SaveWorkflowAsync(WorkflowDefinition workflow)
    {
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/templates/{Uri.EscapeDataString(EditingTemplateId)}/workflows/{Uri.EscapeDataString(workflow.Id)}",
                new UpdateWorkflowRequest(
                    workflow.Title,
                    workflow.Stages,
                    workflow.Revision,
                    workflow.Description,
                    workflow.Icon,
                    workflow.Color),
                PwaJson.Options);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await ReloadTemplateAsync();
                return Loc.Get("WorkflowConflict");
            }

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await ReloadTemplateAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Creates one more card type in the template - a workflow every project created from it starts with.
    /// Returns the failure text, or null when it was created.
    /// </summary>
    private async Task<string?> CreateWorkflowAsync(WorkflowDefinition workflow)
    {
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/templates/{Uri.EscapeDataString(EditingTemplateId)}/workflows",
                new CreateWorkflowRequest(
                    workflow.Id,
                    workflow.Title,
                    workflow.Stages,
                    workflow.Description,
                    workflow.Icon,
                    workflow.Color),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await ReloadTemplateAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>Removes a card type from the template. Returns the failure text, or null when it was removed.</summary>
    private async Task<string?> DeleteWorkflowAsync(WorkflowDefinition workflow)
    {
        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/templates/{Uri.EscapeDataString(EditingTemplateId)}/workflows/{Uri.EscapeDataString(workflow.Id)}");
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await ReloadTemplateAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Writes what the template says about itself. An empty instruction travels as an empty string so that it
    /// clears the stored one: the route reads null as "leave it alone", and the two have to differ.
    /// </summary>
    private async Task SaveTemplateAsync()
    {
        _templateMessage = null;
        _templateHasError = false;
        _savingTemplate = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/templates/{Uri.EscapeDataString(EditingTemplateId)}",
                new UpdateTemplateRequest(
                    Name: null,
                    Description: null,
                    InitializationInstruction: _initializationInstruction ?? string.Empty),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                _templateHasError = true;
                _templateMessage = error?.Message ??
                    Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
                return;
            }

            await ReloadTemplateAsync();
            _templateMessage = Loc.Get("TemplateSaved");
        }
        catch (Exception exception)
        {
            _templateHasError = true;
            _templateMessage = Loc.Format("SaveWorkflowFailed", exception.Message);
        }
        finally
        {
            _savingTemplate = false;
        }
    }

    private async Task ReloadTemplateAsync()
    {
        _template = await Http.GetFromJsonAsync<ProjectTemplate>(
            $"api/v1/templates/{Uri.EscapeDataString(EditingTemplateId)}", PwaJson.Options);
        // The field starts from what the template says and is the working copy until it is saved.
        _initializationInstruction = _template?.InitializationInstruction;
    }
}
