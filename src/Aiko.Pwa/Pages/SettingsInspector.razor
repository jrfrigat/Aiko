@inject HttpClient Http

@* Settings body. Every fact list is a FlareList (label left, value right), the source tag is a
   FlareChip, the policies are FlareSelects and the run limits are FlareNumericFields, so the panel has
   no raw inputs and no hand-written field CSS. *@
<FlarePaper Elevation="0" Padding="FlareSpacing.Medium" Square="true">
    <FlareStack Gap="FlareSpacing.Medium">
        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
            <FlareStack Gap="FlareSpacing.None">
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                    @(Project?.Name ?? Loc.Get("GlobalSettings"))
                </FlareText>
                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("SettingsTitle")</FlareText>
            </FlareStack>
            <FlareIconButton Variant="ButtonVariant.Text"
                             Icon="@FlareIcons.Close"
                             AriaLabel="@Loc.Get("Close")"
                             OnClick="() => OnClose.InvokeAsync()" />
        </FlareStack>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                        Variant="AlertVariant.Outlined">@_message</FlareAlert>
        }

        @if (_loading)
        {
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                <FlareProgressCircular Size="TrackSize.Xs" />
                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                    @Loc.Get("LoadingSettings")
                </FlareText>
            </FlareStack>
        }
        else
        {
            <FlareStack Gap="FlareSpacing.Small">
                <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("Daemon")</FlareText>
                @if (_system is not null)
                {
                    <FlareList TItem="string" Dense="true">
                        <FlareListItem Primary="@Loc.Get("Version")">
                            <Trailing><FlareText Element="span" Typo="TypographyScale.LabelMedium">@_system.Version</FlareText></Trailing>
                        </FlareListItem>
                        <FlareListItem Primary="@Loc.Get("Address")">
                            <Trailing><FlareText Element="span" Typo="TypographyScale.LabelMedium">@_system.BaseUrl</FlareText></Trailing>
                        </FlareListItem>
                        <FlareListItem Primary="PID">
                            <Trailing><FlareText Element="span" Typo="TypographyScale.LabelMedium">@_system.ProcessId</FlareText></Trailing>
                        </FlareListItem>
                    </FlareList>
                }
            </FlareStack>

            <FlareDivider />

            <FlareStack Gap="FlareSpacing.Small">
                <FlareText Element="h3" Typo="TypographyScale.TitleSmall">
                    @Loc.Get("EffectiveConfig")
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                        @Loc.Get(Project is null ? "GlobalSettings" : "ProjectSettings")
                    </FlareText>
                </FlareText>
                @* Without a project the effective view is the global one; reading the project view here
                   left every row as "-" on the global settings screen. *@
                <FlareList TItem="string" Dense="true">
                    <FlareListItem Primary="@Loc.Get("Source")">
                        <Trailing><FlareChip Variant="ChipVariant.Filled" Label="@SourceCaption(EffectiveView?.ExecutionSource)" /></Trailing>
                    </FlareListItem>
                    <FlareListItem Primary="@Loc.Get("Workspace")">
                        <Trailing><FlareText Element="span" Typo="TypographyScale.LabelMedium">@Text(EffectiveView?.EffectiveExecution.WorkspaceMode)</FlareText></Trailing>
                    </FlareListItem>
                    <FlareListItem Primary="@Loc.Get("MaxRuns")">
                        <Trailing><FlareText Element="span" Typo="TypographyScale.LabelMedium">@Text(EffectiveView?.EffectiveExecution.MaxConcurrentRuns)</FlareText></Trailing>
                    </FlareListItem>
                    <FlareListItem Primary="@Loc.Get("ScopeOverlap")">
                        <Trailing><FlareText Element="span" Typo="TypographyScale.LabelMedium">@Text(EffectiveView?.EffectiveExecution.ScopeOverlapPolicy)</FlareText></Trailing>
                    </FlareListItem>
                    <FlareListItem Primary="@Loc.Get("CommitPolicy")">
                        <Trailing><FlareText Element="span" Typo="TypographyScale.LabelMedium">@Text(EffectiveView?.EffectiveExecution.SharedCheckoutCommitPolicy)</FlareText></Trailing>
                    </FlareListItem>
                </FlareList>
                @if (IsParallelShared(EffectiveView?.EffectiveExecution))
                {
                    <FlareAlert Severity="AlertSeverity.Warning"
                                Variant="AlertVariant.Outlined"
                                Title="@Loc.Get("ParallelSharedOn")">
                        @Loc.Get("ParallelSharedText")
                    </FlareAlert>
                }
            </FlareStack>

            <FlareDivider />

            <FlareStack Gap="FlareSpacing.Small">
                @if (Project is not null)
                {
                    <FlareText Element="h3" Typo="TypographyScale.TitleSmall">
                        @Loc.Get("ProjectSettings")
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">.aiko/settings.json</FlareText>
                    </FlareText>
                    <FlareSelect TValue="string"
                                 Label="@Loc.Get("Workspace")"
                                 Items="@WorkspaceOptions"
                                 ItemLabel="@WorkspaceLabel"
                                 ItemDisabled="@WorkspaceDisabled"
                                 @bind-Value="_projectWorkspace" />
                    <FlareNumericField TValue="int?"
                                       Label="@Loc.Get("MaxRunsLabel")"
                                       Min="1"
                                       ErrorText="@_projectMaxError"
                                       @bind-Value="_projectMaxRuns" />
                    <FlareSelect TValue="string" Label="@Loc.Get("ScopePolicy")" @bind-Value="_projectScopePolicy">
                        <option value="Ask">@Loc.Get("PolicyAsk")</option>
                        <option value="Allow">@Loc.Get("PolicyAllow")</option>
                        <option value="Deny">@Loc.Get("PolicyDeny")</option>
                    </FlareSelect>
                    <FlareSelect TValue="string" Label="@Loc.Get("CommitPolicy")" @bind-Value="_projectCommitPolicy">
                        <option value="Deny">@Loc.Get("PolicyDeny")</option>
                        <option value="Ask">@Loc.Get("PolicyAsk")</option>
                        <option value="Allow">@Loc.Get("PolicyAllow")</option>
                    </FlareSelect>

                    @* The priority section: the formula's two weights and the project's scoring
                       criteria, which is what a card's own priority is computed from. *@
                    <FlareDivider />
                    <FlareText Element="h4" Typo="TypographyScale.TitleSmall">@Loc.Get("PriorityFormula")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                        @Loc.Get("PriorityFormulaHint")
                    </FlareText>
                    <FlareNumericField TValue="decimal?" Label="@Loc.Get("OwnWeight")" Min="0"
                                       ErrorText="@_projectPriorityError"
                                       @bind-Value="_projectTaskWeight" />
                    <FlareNumericField TValue="decimal?" Label="@Loc.Get("ParentWeight")" Min="0"
                                       @bind-Value="_projectParentWeight" />

                    <FlareText Element="h4" Typo="TypographyScale.TitleSmall">@Loc.Get("Criteria")</FlareText>
                    @if (_projectCriteria.Count == 0)
                    {
                        <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("NoCriteria")</FlareAlert>
                    }
                    else
                    {
                        @foreach (var criterion in _projectCriteria)
                        {
                            var draft = criterion;
                            <FlareCard Variant="CardVariant.Outlined" Size="CardSize.Sm">
                                <FlareStack Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                                        <span class="aiko-tag">@draft.Id</span>
                                        <FlareIconButton Variant="ButtonVariant.Text"
                                                         Icon="@FlareIcons.Delete"
                                                         AriaLabel="@Loc.Get("Remove")"
                                                         OnClick="() => RemoveCriterion(_projectCriteria, draft)" />
                                    </FlareStack>
                                    <FlareTextField Label="@Loc.Get("Title")" @bind-Value="draft.Title" Immediate="true" />
                                    <FlareTextField Label="@Loc.Get("CriterionDescription")" @bind-Value="draft.Description" Immediate="true" />
                                    <FlareNumericField TValue="decimal?" Label="@Loc.Get("CriterionWeight")" Min="0" @bind-Value="draft.Weight" />
                                </FlareStack>
                            </FlareCard>
                        }
                    }
                    <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm"
                                 OnClick="() => AddCriterion(_projectCriteria)">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                        <ChildContent>@Loc.Get("AddCriterion")</ChildContent>
                    </FlareButton>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("CriterionIdHelper")
                    </FlareText>

                    <FlareButton FullWidth="true"
                                 Loading="@_savingProject"
                                 OnClick="SaveProjectAsync">@Loc.Get("SaveProjectSettings")</FlareButton>
                }
                else
                {
                    <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ProjectSettings")</FlareText>
                    <FlareAlert Severity="AlertSeverity.Info"
                                Variant="AlertVariant.Text">@Loc.Get("SelectProjectForLocalSettings")</FlareAlert>
                }
            </FlareStack>

            <FlareDivider />

            <FlareStack Gap="FlareSpacing.Small">
                <FlareText Element="h3" Typo="TypographyScale.TitleSmall">
                    @Loc.Get("GlobalSettings")
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@Loc.Get("SourceGlobal")</FlareText>
                </FlareText>
                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                    @Loc.Get("GlobalHint")
                </FlareText>
                <FlareNumericField TValue="int?"
                                   Label="@Loc.Get("MaxRunsLabel")"
                                   Min="1"
                                   ErrorText="@_globalMaxError"
                                   @bind-Value="_globalMaxRuns" />
                <FlareSelect TValue="string" Label="@Loc.Get("ScopePolicy")" @bind-Value="_globalScopePolicy">
                    <option value="Ask">@Loc.Get("PolicyAsk")</option>
                    <option value="Allow">@Loc.Get("PolicyAllow")</option>
                    <option value="Deny">@Loc.Get("PolicyDeny")</option>
                </FlareSelect>
                <FlareSelect TValue="string" Label="@Loc.Get("CommitPolicy")" @bind-Value="_globalCommitPolicy">
                    <option value="Deny">@Loc.Get("PolicyDeny")</option>
                    <option value="Ask">@Loc.Get("PolicyAsk")</option>
                    <option value="Allow">@Loc.Get("PolicyAllow")</option>
                </FlareSelect>

                @* The same priority editor as the project scope has: for the global level these are the
                   defaults a new project starts from. *@
                <FlareDivider />
                <FlareText Element="h4" Typo="TypographyScale.TitleSmall">@Loc.Get("PriorityFormula")</FlareText>
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                    @Loc.Get("PriorityFormulaHint")
                </FlareText>
                <FlareNumericField TValue="decimal?" Label="@Loc.Get("OwnWeight")" Min="0"
                                   ErrorText="@_globalPriorityError"
                                   @bind-Value="_globalTaskWeight" />
                <FlareNumericField TValue="decimal?" Label="@Loc.Get("ParentWeight")" Min="0"
                                   @bind-Value="_globalParentWeight" />

                <FlareText Element="h4" Typo="TypographyScale.TitleSmall">@Loc.Get("Criteria")</FlareText>
                @if (_globalCriteria.Count == 0)
                {
                    <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("NoCriteria")</FlareAlert>
                }
                else
                {
                    @foreach (var criterion in _globalCriteria)
                    {
                        var draft = criterion;
                        <FlareCard Variant="CardVariant.Outlined" Size="CardSize.Sm">
                            <FlareStack Gap="FlareSpacing.XXSmall">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                                    <span class="aiko-tag">@draft.Id</span>
                                    <FlareIconButton Variant="ButtonVariant.Text"
                                                     Icon="@FlareIcons.Delete"
                                                     AriaLabel="@Loc.Get("Remove")"
                                                     OnClick="() => RemoveCriterion(_globalCriteria, draft)" />
                                </FlareStack>
                                <FlareTextField Label="@Loc.Get("Title")" @bind-Value="draft.Title" Immediate="true" />
                                <FlareTextField Label="@Loc.Get("CriterionDescription")" @bind-Value="draft.Description" Immediate="true" />
                                <FlareNumericField TValue="decimal?" Label="@Loc.Get("CriterionWeight")" Min="0" @bind-Value="draft.Weight" />
                            </FlareStack>
                        </FlareCard>
                    }
                }
                <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm"
                             OnClick="() => AddCriterion(_globalCriteria)">
                    <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                    <ChildContent>@Loc.Get("AddCriterion")</ChildContent>
                </FlareButton>
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("CriterionIdHelper")
                </FlareText>

                <FlareButton FullWidth="true"
                             Variant="ButtonVariant.Outlined"
                             Loading="@_savingGlobal"
                             OnClick="SaveGlobalAsync">@Loc.Get("SaveGlobalSettings")</FlareButton>
            </FlareStack>
        }
    </FlareStack>
</FlarePaper>

@code {
    [Parameter] public RegisteredProject? Project { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Shared worktree is the only selectable workspace; Worktree stays visible but disabled.</summary>
    private static readonly IReadOnlyList<string> WorkspaceOptions = ["Shared", "Worktree"];

    private AppSettingsView? _view;
    private AppSettingsView? _globalView;
    private SystemInfo? _system;
    private string? _message;
    private bool _hasError;
    private bool _loading = true;
    private bool _savingProject;
    private bool _savingGlobal;

    private string? _projectWorkspace = "Shared";
    private int? _projectMaxRuns = 1;
    private string? _projectMaxError;
    private string? _projectScopePolicy = "Ask";
    private string? _projectCommitPolicy = "Deny";
    private decimal? _projectTaskWeight;
    private decimal? _projectParentWeight;
    private List<CriterionDraft> _projectCriteria = [];
    private string? _projectPriorityError;

    private int? _globalMaxRuns = 1;
    private string? _globalMaxError;
    private string? _globalScopePolicy = "Ask";
    private string? _globalCommitPolicy = "Deny";
    private decimal? _globalTaskWeight;
    private decimal? _globalParentWeight;
    private List<CriterionDraft> _globalCriteria = [];
    private string? _globalPriorityError;

    private static string WorkspaceLabel(string? value) =>
        value == "Worktree" ? Loc.Get("WorktreeOption") : Loc.Get("WorkspaceOption");

    private static bool WorkspaceDisabled(string? value) => value == "Worktree";

    /// <summary>Renders a nullable value with an explicit placeholder - Nullable&lt;T&gt;.ToString() returns "" for null.</summary>
    private static string Text<T>(T? value) where T : struct => value?.ToString() ?? "-";

    /// <summary>
    /// The view whose resolved values the panel reports: the project's when one is selected, the
    /// global one otherwise (both are resolved project → global → safe default by the daemon).
    /// </summary>
    private AppSettingsView? EffectiveView => Project is not null ? _view : _globalView;

    protected override async Task OnParametersSetAsync()
    {
        if (_view is not null)
        {
            return;
        }

        try
        {
            // The inspector also opens without a project, where only global settings apply.
            var projectView = Project is null
                ? null
                : await Http.GetFromJsonAsync<AppSettingsView>(
                    $"api/v1/projects/{Uri.EscapeDataString(Project.Id)}/settings", PwaJson.Options);
            var globalView = await Http.GetFromJsonAsync<AppSettingsView>(
                "api/v1/settings", PwaJson.Options);
            _system = await Http.GetFromJsonAsync<SystemInfo>("api/v1/system", PwaJson.Options);
            ApplyView(projectView, globalView);
        }
        catch (Exception exception)
        {
            _message = Loc.Format("LoadSettingsFailed", FailureText.Describe(exception));
            _hasError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyView(AppSettingsView? projectView, AppSettingsView? globalView)
    {
        _view = projectView;
        _globalView = globalView;
        var projectExecution = projectView?.Project?.Execution ?? projectView?.EffectiveExecution;
        _projectWorkspace = projectExecution?.WorkspaceMode.ToString() ?? "Shared";
        _projectMaxRuns = projectExecution?.MaxConcurrentRuns ?? 1;
        _projectScopePolicy = projectExecution?.ScopeOverlapPolicy.ToString() ?? "Ask";
        _projectCommitPolicy = projectExecution?.SharedCheckoutCommitPolicy.ToString() ?? "Deny";

        var globalExecution = globalView?.Global?.Execution ?? globalView?.EffectiveExecution;
        _globalMaxRuns = globalExecution?.MaxConcurrentRuns ?? 1;
        _globalScopePolicy = globalExecution?.ScopeOverlapPolicy.ToString() ?? "Ask";
        _globalCommitPolicy = globalExecution?.SharedCheckoutCommitPolicy.ToString() ?? "Deny";

        // The priority drafts come from the level's OWN snapshot, not from the resolved view: the
        // resolved values are what is in force, and showing them keeps the form meaningful on a level
        // that has never been configured - saving then makes them explicit.
        var projectPriority = projectView?.Project?.Priority ?? projectView?.EffectivePriority;
        _projectTaskWeight = projectPriority?.Weights.TaskWeight;
        _projectParentWeight = projectPriority?.Weights.ParentWeight;
        _projectCriteria = (projectPriority?.Criteria ?? [])
            .Select(CriterionDraft.From)
            .ToList();
        _projectPriorityError = null;

        var globalPriority = globalView?.Global?.Priority ?? globalView?.EffectivePriority;
        _globalTaskWeight = globalPriority?.Weights.TaskWeight;
        _globalParentWeight = globalPriority?.Weights.ParentWeight;
        _globalCriteria = (globalPriority?.Criteria ?? [])
            .Select(CriterionDraft.From)
            .ToList();
        _globalPriorityError = null;
    }

    private async Task SaveProjectAsync()
    {
        if (!TryBuildExecution(
                _projectMaxRuns,
                _projectWorkspace,
                _projectScopePolicy,
                _projectCommitPolicy,
                out var execution,
                out _projectMaxError) ||
            !TryBuildPriority(
                _projectCriteria,
                _projectTaskWeight,
                _projectParentWeight,
                out var priority,
                out _projectPriorityError))
        {
            return;
        }

        await SaveAsync(
            $"api/v1/projects/{Uri.EscapeDataString(Project!.Id)}/settings",
            execution,
            priority,
            isProject: true);
    }

    private async Task SaveGlobalAsync()
    {
        if (!TryBuildExecution(
                _globalMaxRuns,
                nameof(WorkspaceMode.Shared),
                _globalScopePolicy,
                _globalCommitPolicy,
                out var execution,
                out _globalMaxError) ||
            !TryBuildPriority(
                _globalCriteria,
                _globalTaskWeight,
                _globalParentWeight,
                out var priority,
                out _globalPriorityError))
        {
            return;
        }

        await SaveAsync("api/v1/settings", execution, priority, isProject: false);
    }

    /// <summary>
    /// Builds the priority section from the form. Both weights must be non-negative with at least one
    /// above zero (the domain constructor refuses anything else), every criterion needs a title, and
    /// the criteria must stay uniquely identified - the id is what cards report their values against.
    /// </summary>
    private static bool TryBuildPriority(
        IReadOnlyList<CriterionDraft> criteria,
        decimal? taskWeight,
        decimal? parentWeight,
        out PrioritySettings priority,
        out string? error)
    {
        priority = PrioritySettings.SafeDefault;
        error = null;

        if (taskWeight is not { } own || parentWeight is not { } parent || own < 0 || parent < 0 || own + parent == 0)
        {
            error = Loc.Get("InvalidWeights");
            return false;
        }

        var built = new List<PriorityCriterion>(criteria.Count);
        foreach (var draft in criteria)
        {
            var title = (draft.Title ?? string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(title))
            {
                error = Loc.Get("CriterionTitleRequired");
                return false;
            }

            if (built.Any(item => StringComparer.Ordinal.Equals(item.Id, draft.Id)))
            {
                error = Loc.Format("StageIdUnique", draft.Id);
                return false;
            }

            built.Add(new PriorityCriterion(
                draft.Id,
                title,
                (draft.Description ?? string.Empty).Trim(),
                draft.Weight is { } weight && weight >= 0 ? weight : 0m));
        }

        priority = new PrioritySettings(new PriorityWeights(own, parent), built);
        return true;
    }

    /// <summary>
    /// Appends a criterion. Its id is derived from the title once and then frozen: cards store their
    /// values under that id, so renaming a criterion must not orphan what was already reported.
    /// </summary>
    private static void AddCriterion(List<CriterionDraft> criteria) =>
        criteria.Add(new CriterionDraft
        {
            Id = NewCriterionId(criteria),
            Title = string.Empty,
            Description = string.Empty,
            Weight = 1m
        });

    private static void RemoveCriterion(List<CriterionDraft> criteria, CriterionDraft draft) =>
        criteria.Remove(draft);

    private static string NewCriterionId(IReadOnlyList<CriterionDraft> existing)
    {
        var stem = new string(
            (existing.Count == 0 ? "criterion" : existing[^1].Title ?? string.Empty)
                .ToLowerInvariant()
                .Select(character => char.IsAsciiLetterOrDigit(character) ? character : '-')
                .ToArray())
            .Trim('-');
        if (string.IsNullOrWhiteSpace(stem))
        {
            stem = "criterion";
        }

        var id = stem;
        var suffix = 2;
        while (existing.Any(item => StringComparer.Ordinal.Equals(item.Id, id)))
        {
            id = $"{stem}-{suffix++}";
        }

        return id;
    }

    /// <summary>A criterion as the form holds it, before it becomes a <see cref="PriorityCriterion"/>.</summary>
    private sealed class CriterionDraft
    {
        public required string Id { get; init; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public decimal? Weight { get; set; }

        public static CriterionDraft From(PriorityCriterion criterion) => new()
        {
            Id = criterion.Id,
            Title = criterion.Title,
            Description = criterion.Description,
            Weight = criterion.Weight
        };
    }

    private async Task SaveAsync(string url, ExecutionSettings execution, PrioritySettings priority, bool isProject)
    {
        _message = null;
        _hasError = false;
        if (isProject)
        {
            _savingProject = true;
        }
        else
        {
            _savingGlobal = true;
        }

        try
        {
            // Both sections travel together: the settings document is replaced as a whole, so sending
            // only the execution section would silently drop the level's priority story.
            using var response = await Http.PutAsJsonAsync(
                url,
                new AppSettings(AppSettings.CurrentSchemaVersion, execution, priority),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                _message = Loc.Format("SaveSettingsFailed", error);
                _hasError = true;
                return;
            }

            var projectView = await Http.GetFromJsonAsync<AppSettingsView>(
                $"api/v1/projects/{Uri.EscapeDataString(Project!.Id)}/settings", PwaJson.Options);
            var globalView = await Http.GetFromJsonAsync<AppSettingsView>(
                "api/v1/settings", PwaJson.Options);
            ApplyView(projectView, globalView);
            _message = Loc.Get("SettingsSaved");
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            _message = Loc.Format("SaveSettingsFailed", FailureText.Describe(exception));
            _hasError = true;
        }
        finally
        {
            _savingProject = false;
            _savingGlobal = false;
        }
    }

    private static bool TryBuildExecution(
        int? maxRuns,
        string? workspace,
        string? scopePolicy,
        string? commitPolicy,
        out ExecutionSettings execution,
        out string? error)
    {
        error = null;
        if (maxRuns is not { } runs || runs < 1)
        {
            execution = ExecutionSettings.SafeDefault;
            error = Loc.Get("InvalidMaxRuns");
            return false;
        }

        try
        {
            execution = new ExecutionSettings(
                Enum.Parse<WorkspaceMode>(workspace ?? nameof(WorkspaceMode.Shared)),
                runs,
                Enum.Parse<ActionPolicy>(scopePolicy ?? nameof(ActionPolicy.Ask)),
                Enum.Parse<ActionPolicy>(commitPolicy ?? nameof(ActionPolicy.Deny)));
            return true;
        }
        catch (ArgumentException)
        {
            execution = ExecutionSettings.SafeDefault;
            error = Loc.Get("InvalidSettingValue");
            return false;
        }
    }

    internal static bool IsParallelShared(ExecutionSettings? settings) =>
        settings is not null &&
        settings.WorkspaceMode == WorkspaceMode.Shared &&
        settings.MaxConcurrentRuns > 1;

    private static string SourceCaption(string? source) => source switch
    {
        AppSettingsSources.Project => Loc.Get("SourceProject"),
        AppSettingsSources.Global => Loc.Get("SourceGlobal"),
        _ => Loc.Get("SourceDefault")
    };
}
