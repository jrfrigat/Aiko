@page "/p/{ProjectId}/cards/{CardId}"
@inject HttpClient Http
@inject WorkspaceState State
@implements IAsyncDisposable

@* A card as its own page: the board is where you work across cards, this is where you work inside one -
   and unlike a drawer it has a URL that can be linked, reloaded and shared. The header states what the card
   is (kind, stage, size, revision) and where it sits, so the screen says as much as the board does. *@
<PageTitle>@CardId</PageTitle>

@if (Card is null || State.Board is not { } board)
{
    <FlareStack Gap="FlareSpacing.Small">
        <FlareNavLink Href="@BoardHref">
            <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.ViewKanban" /></IconContent>
            <ChildContent>@Loc.Get("KanbanBoard")</ChildContent>
        </FlareNavLink>
        <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("CardNotFound")</FlareAlert>
    </FlareStack>
}
else
{
    <FlareStack Gap="FlareSpacing.Medium">
        @* The breadcrumb the design opens a card with: where the card sits, and the two actions that
           belong to a card - editing its identity, and sending it to the last stage of its own pipeline. *@
        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
            <nav class="aiko-crumb" aria-label="@Loc.Get("KanbanBoard")">
                <span class="aiko-value aiko-crumb__project">@board.Project.Name</span>
                <span class="aiko-crumb__sep">/</span>
                <FlareNavLink Href="@BoardHref">
                    <ChildContent>@Loc.Get("KanbanBoard")</ChildContent>
                </FlareNavLink>
                <span class="aiko-crumb__sep">/</span>
                <span class="aiko-crumb__here">@ProjectionCaption</span>
                <span class="aiko-crumb__sep">/</span>
                <span class="aiko-crumb__id">@($"#{Card.Reference.CardId}")</span>
            </nav>
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                <FlareButton Variant="ButtonVariant.Tonal"
                             Size="ButtonSize.Sm"
                             OnClick="() => _editOpen = true">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Edit" /></LeadingIcon>
                    <ChildContent>@Loc.Get("EditCard")</ChildContent>
                </FlareButton>
                @if (LastStage is { } last && !string.Equals(last.Id, Card.StageId, StringComparison.Ordinal))
                {
                    <FlareButton Variant="ButtonVariant.Filled"
                                 Size="ButtonSize.Sm"
                                 Loading="@_closing"
                                 OnClick="CloseCardAsync">
                        <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.TaskAlt" /></LeadingIcon>
                        <ChildContent>@Loc.Get("CloseTask")</ChildContent>
                    </FlareButton>
                }
            </FlareStack>
        </FlareStack>
        @* The card's own banner, as the design leads every card page with it: what the card is, where it is
           in the pipeline, who is on it, and the counts that matter before any detail. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel aiko-banner">
            <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Medium" Wrap="true">
                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
                        @* The number a command names this card by, and pressing it copies exactly that - the id
                           without the "#", which is only how the screen writes it. The copy control is Flare's,
                           the one thing in this product that copies, and it confirms by swapping its content,
                           so the feed of what was copied is visible without the screen keeping its own words. *@
                        <span class="aiko-copy">
                            <FlareClipboard Text="@Card.Reference.CardId"
                                            Variant="ButtonVariant.Text"
                                            Size="ButtonSize.Sm">
                                <ChildContent>
                                    <span class="aiko-tag aiko-tag--accent">@($"#{Card.Reference.CardId}")</span>
                                </ChildContent>
                                <FeedbackContent>
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                        <span class="aiko-tag aiko-tag--accent">@($"#{Card.Reference.CardId}")</span>
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.Check" Color="FlareColor.Primary" />
                                    </FlareStack>
                                </FeedbackContent>
                            </FlareClipboard>
                        </span>
                        <FlareText Element="h1" Typo="TypographyScale.HeadlineLarge">@Card.Title</FlareText>
                    </FlareStack>
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
                        <span class="aiko-tag aiko-tag--live">
                            <span class="aiko-dot aiko-dot--pulse"></span>@StageCaption
                        </span>
                        <span class="aiko-tag aiko-tag--quiet">@Card.Kind · @Card.WorkflowId</span>
                        @if (Card.Size is { Length: > 0 } bannerSize)
                        {
                            <span class="aiko-tag @CardAppearance.SizeBadgeClass(bannerSize, SizeGrid)">@bannerSize</span>
                        }
                        <span class="aiko-tag aiko-tag--quiet">@Loc.Format("RevisionTag", Card.Revision)</span>
                        @if (DefaultAgent is { Length: > 0 } agent)
                        {
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" Color="FlareColor.Primary" />
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    @Loc.Format("AssignedTo", agent)
                                </FlareText>
                            </FlareStack>
                        }
                    </FlareStack>
                </FlareStack>

                @* The quick counters: the same facts the board card shows, in the design's recessed strip. *@
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Class="aiko-banner__counters">
                    @foreach (var counter in Counters)
                    {
                        var item = counter;
                        <FlareStack Class="aiko-banner__counter" Gap="FlareSpacing.None">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                @item.Label
                            </FlareText>
                            <span class="aiko-value @(item.Warn ? "aiko-value--warn" : null)">@item.Value</span>
                        </FlareStack>
                    }
                </FlareStack>
            </FlareStack>
        </FlarePaper>

        <CardInspector Card="Card"
                       Board="board"
                       ExecutionRefreshTick="State.ExecutionPulse"
                       EditOpen="_editOpen"
                       EditOpenChanged="open => _editOpen = open"
                       OnSaved="State.LoadBoardAsync" />
    </FlareStack>
}

@code {
    /// <summary>
    /// The project's size grid, so the card's size badge can carry the tone of the step it names.
    /// </summary>
    /// <remarks>
    /// The board snapshot carries cards but not the grid; the workspace does. An empty grid is honest: without
    /// a step there is no coefficient, so the badge stays quiet.
    /// </remarks>
    private IReadOnlyList<SizeDefinition> SizeGrid => State.SettingsView?.EffectivePriority.Grid ?? [];

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private Task OnStateChanged() => InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        return ValueTask.CompletedTask;
    }

    [Parameter] public string ProjectId { get; set; } = string.Empty;
    [Parameter] public string CardId { get; set; } = string.Empty;

    private string BoardHref => ProjectRoutes.Board(ProjectId);

    /// <summary>
    /// The projection this card belongs to, named as the board's own views are: the trail says where the
    /// reader came from - a story card lives under Stories - rather than repeating the card's kind.
    /// </summary>
    private string ProjectionCaption =>
        State.Board?.Workflows
            .FirstOrDefault(workflow => Card is not null &&
                StringComparer.Ordinal.Equals(workflow.Id, Card.WorkflowId))
            ?.Title
        ?? Card?.Kind
        ?? Loc.Get("Workflow");

    /// <summary>The last stage of the card's own workflow: where closing a card sends it.</summary>
    private StageDefinition? LastStage => State.Board?.Workflows
        .FirstOrDefault(workflow => Card is not null &&
            StringComparer.Ordinal.Equals(workflow.Id, Card.WorkflowId))
        ?.Stages.OrderBy(stage => stage.Order).LastOrDefault();

    /// <summary>
    /// Moves the card to the last stage of its pipeline, which is what "close" means here: the workflow's
    /// own end, not a state the UI invents.
    /// </summary>
    private async Task CloseCardAsync()
    {
        if (Card is not { } card || LastStage is not { } last || _closing)
        {
            return;
        }

        _closing = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(card.Reference.ProjectId)}/cards/{Uri.EscapeDataString(card.Reference.CardId)}/stage",
                new MoveCardRequest(last.Id, card.Revision),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
        }
        catch (Exception exception)
        {
            await State.ReportErrorAsync(FailureText.Describe(exception));
        }
        finally
        {
            _closing = false;
            await State.LoadBoardAsync();
        }
    }

    private Card? Card => State.Board?.Cards.FirstOrDefault(card =>
        StringComparer.Ordinal.Equals(card.Reference.CardId, CardId));

    /// <summary>The card's stage, named as the pipeline does, so the banner reads as a workflow position.</summary>
    private string StageCaption
    {
        get
        {
            var stage = State.Board?.Workflows
                .FirstOrDefault(workflow => Card is not null &&
                    StringComparer.Ordinal.Equals(workflow.Id, Card.WorkflowId))
                ?.Stages.FirstOrDefault(item => Card is not null &&
                    StringComparer.Ordinal.Equals(item.Id, Card.StageId));
            return stage is null ? Card?.StageId ?? string.Empty : stage.Title;
        }
    }

    /// <summary>
    /// The agent the stage starts with. It is what the pipeline says about who works this card, not who is
    /// working right now - that lives on the execution the card's own body reports.
    /// </summary>
    private string? DefaultAgent
    {
        get
        {
            var adapterId = State.Board?.Workflows
                .FirstOrDefault(workflow => Card is not null &&
                    StringComparer.Ordinal.Equals(workflow.Id, Card.WorkflowId))
                ?.Stages.FirstOrDefault(item => Card is not null &&
                    StringComparer.Ordinal.Equals(item.Id, Card.StageId))
                ?.DefaultAgentAdapterId;
            return adapterId is null
                ? null
                : State.Agents.FirstOrDefault(agent => StringComparer.Ordinal.Equals(agent.Id, adapterId))
                    ?.DisplayName ?? adapterId;
        }
    }

    /// <summary>
    /// The figures the banner reports: what the card declares, what it touched, what it left outside the
    /// scope, how many cards it is linked to and what the board's formula makes of it. All five are about
    /// this card, because that is what the banner is about - the board's own totals belong to the board.
    /// <para>
    /// The score is the card's effective priority, read exactly the way the card's own panel reads it: the
    /// same snapshot entry, the same fallback and the same formatter, so one page cannot state one figure
    /// in two ways.
    /// </para>
    /// </summary>
    private IReadOnlyList<(string Label, string Value, bool Warn)> Counters
    {
        get
        {
            if (Card is not { } card)
            {
                return [];
            }

            var outOfScope = BoardSection.FindOutOfScopeFiles(card).Count;
            var relations = (State.Board?.Relations ?? [])
                .Count(relation =>
                    StringComparer.Ordinal.Equals(relation.Source.CardId, card.Reference.CardId) ||
                    StringComparer.Ordinal.Equals(relation.Target.CardId, card.Reference.CardId));

            // The card's effective priority, or its own number while the board carries no computed entry for
            // it: the fallback is the panel's own, so the two cannot disagree about which figure they show.
            var effective = State.Board?.CardPriorities
                .FirstOrDefault(priority => StringComparer.Ordinal.Equals(
                    priority.CardId, card.Reference.CardId))
                ?.Snapshot.EffectivePriority ?? PriorityCalculator.ManualScore(card.OwnPriority);

            return
            [
                (Loc.Get("FilesDeclared"), DisplayFormat.Number(card.DeclaredScopeFiles.Count), false),
                (Loc.Get("FilesActual"), DisplayFormat.Number(card.ActualChangedFiles.Count), false),
                (Loc.Get("OutOfScope"), DisplayFormat.Number(outOfScope), outOfScope > 0),
                (Loc.Get("Relations"), DisplayFormat.Number(relations), false),
                (Loc.Get("EstimateTitle"), DisplayFormat.Priority(effective), false)
            ];
        }
    }

    private bool _closing;
    private bool _editOpen;

    protected override async Task OnParametersSetAsync() => await State.EnsureProjectAsync(ProjectId);
}
