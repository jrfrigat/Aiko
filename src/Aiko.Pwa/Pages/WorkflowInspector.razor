@inject WorkspaceState State

@* Workflow editor body. The pipeline is a grid of stage cards - each one naming its role, its executors,
   the artifacts it must produce and the commands that verify it - and the stage being edited fills the form
   below, so the shape of the pipeline and the fields of one stage are visible at the same time. The fields
   are Flare fields and results are reported through FlareAlert rather than hand-written message divs. *@
<!-- The workflow editor is a panel of the project's settings screen, so it dresses as one. -->
<FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
    <FlareStack Gap="FlareSpacing.Medium">
        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
            <FlareStack Gap="FlareSpacing.None">
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                    @Loc.Format("CardTypeRevision", SelectedWorkflow.Revision)
                </FlareText>
                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@SelectedWorkflow.Title</FlareText>
            </FlareStack>
            @if (OnClose.HasDelegate)
            {
                <FlareIconButton Variant="ButtonVariant.Text"
                                 Icon="@FlareIcons.Close"
                                 AriaLabel="@Loc.Get("Close")"
                                 OnClick="() => OnClose.InvokeAsync()" />
            }
        </FlareStack>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                        Variant="AlertVariant.Outlined">@_message</FlareAlert>
        }

        <FlareDivider />

        @* The card types of the project as tabs, with the "+" at the end for a new one: a type is a whole
           pipeline, so switching between them is switching what this panel edits rather than picking a field
           value from a list. *@
        <FlareTabs ActiveIndex="@ActiveTypeIndex" ActiveIndexChanged="OnTypeTabChanged">
            <ChildContent>
                @foreach (var type in Workflows)
                {
                    var tab = type;
                    <FlareTab Label="@tab.Title" LeadingIcon="@TabIcon(tab)" />
                }
                @if (_newTypePanelOpen)
                {
                    @* The draft is a tab from the moment "+" is pressed. The fields it needs are the ones
                       the editor already shows, so it is filled in place rather than in a form of its own. *@
                    <FlareTab Label="@Loc.Get("NewCardTypeTitle")" LeadingIcon="@DraftTabIcon" />
                }
            </ChildContent>
            <HeaderEnd>
                @if (Create is not null)
                {
                    <FlareIconButton Variant="ButtonVariant.Text"
                                     Icon="@(_newTypePanelOpen ? FlareIcons.Close : MaterialDesign3Icons.Regular.Add)"
                                     AriaLabel="@Loc.Get("NewCardTypeTitle")"
                                     OnClick="ToggleNewType" />
                }
            </HeaderEnd>
        </FlareTabs>

        @if (_newTypePanelOpen)
        {
            @* The draft type, in the editor the tab opened: what it is called, what it is for, and how it is
               drawn. Nothing is written until the type is created. *@
            <div class="aiko-form-row">
                <AikoField Label="@Loc.Get("StableId")"
                           Hint="@Loc.Get("CardTypeIdHelper")"
                           Placeholder="@Loc.Get("CardTypeIdHelper")"
                           Value="@_newTypeId"
                           ValueChanged="value => _newTypeId = value" />
                <AikoField Label="@Loc.Get("CardTypeName")"
                           Value="@_newTypeTitle"
                           ValueChanged="value => _newTypeTitle = value" />
            </div>
            <AikoField Label="@Loc.Get("CardTypeDescription")"
                       Value="@_newTypeDescription"
                       ValueChanged="value => _newTypeDescription = value" />
        }
        else
        {
            @* The type being edited: its id is what every card and board section is filed under, its name is
               what the board shows, and the icon and the colour are how it is drawn. *@
            <div class="aiko-form-row">
                <AikoField Label="@Loc.Get("StableId")"
                           Hint="@Loc.Get("CardTypeIdHint")"
                           ReadOnly="@(!CanRenameId)"
                           Value="@_workflowIdDraft"
                           ValueChanged="value => _workflowIdDraft = value" />
                <AikoField Label="@Loc.Get("WorkflowTitle")"
                           Value="@_workflowTitle"
                           ValueChanged="value => _workflowTitle = value" />
            </div>
            <AikoField Label="@Loc.Get("CardTypeDescription")"
                       Value="@_workflowDescription"
                       ValueChanged="value => _workflowDescription = value" />
        }

        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall" Wrap="true">
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                @* Each picker draws the icon or the swatch it is offering, so the pair needs no separate
                   preview beside them. While the draft tab is open the pair edits the draft; otherwise it
                   edits the type on screen. *@
                <AikoSelectField Label="@Loc.Get("CardTypeIcon")"
                                 Class="aiko-field--wide"
                                 Value="@PickedIcon"
                                 ValueChanged="OnIconPicked"
                                 Items="@IconChoices"
                                 NullOption="@Loc.Get("AppearanceDefault")"
                                 ItemTemplate="@IconOption"
                                 SelectedTemplate="@IconValue(ColorOf(PickedColor))" />
                <AikoSelectField Label="@Loc.Get("CardTypeColor")"
                                 Class="aiko-field--wide"
                                 Value="@PickedColor"
                                 ValueChanged="OnColorPicked"
                                 Items="@ColorChoices"
                                 NullOption="@Loc.Get("AppearanceDefault")"
                                 ItemTemplate="@ColorOption"
                                 SelectedTemplate="@ColorOption" />
            </FlareStack>

            @* The type's behaviour, declared as data: this flag is what makes a type the atomic work whose
               score rolls up into its parents, without the engine knowing the type by name. *@
            <FlareStack Gap="FlareSpacing.XXSmall">
                <label class="aiko-check-chip">
                    <input type="checkbox" @bind="BlendsWithParent" />
                    @Loc.Get("TypeBlendsWithParent")
                </label>
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("TypeBlendsWithParentHint")
                </FlareText>
            </FlareStack>

            @if (_newTypePanelOpen)
            {
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                    <FlareButton Variant="ButtonVariant.Filled"
                                 Size="ButtonSize.Sm"
                                 Loading="@_creatingType"
                                 OnClick="CreateCardTypeAsync">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                        <ChildContent>@Loc.Get("AddCardType")</ChildContent>
                    </FlareButton>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ToggleNewType">
                        <ChildContent>@Loc.Get("Cancel")</ChildContent>
                    </FlareButton>
                </FlareStack>
            }
            else
            {
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                    @* The fields above edit the type in place, so the type needs its own save: the one in
                       the stage drawer writes the pipeline, this one writes what the type is. *@
                    <FlareButton Variant="ButtonVariant.Filled"
                                 Size="ButtonSize.Sm"
                                 Loading="@_saving"
                                 OnClick="SaveTypeAsync">
                        <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" /></LeadingIcon>
                        <ChildContent>@Loc.Get("SaveCardType")</ChildContent>
                    </FlareButton>
                    @if (Delete is not null && _deleteTypeConfirm)
                    {
                        @* The one destructive action asks twice, and says what it will not touch. *@
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.Warning">
                            @Loc.Get("DeleteCardTypeConfirm")
                        </FlareText>
                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="DeleteCardTypeAsync">
                            <ChildContent>@Loc.Get("Delete")</ChildContent>
                        </FlareButton>
                        <FlareButton Variant="ButtonVariant.Text"
                                     Size="ButtonSize.Sm"
                                     OnClick="() => _deleteTypeConfirm = false">
                            <ChildContent>@Loc.Get("Cancel")</ChildContent>
                        </FlareButton>
                    }
                    else if (Delete is not null)
                    {
                        <FlareButton Variant="ButtonVariant.Text"
                                     Size="ButtonSize.Sm"
                                     Disabled="@SelectedTypeHasCards"
                                     OnClick="() => _deleteTypeConfirm = true">
                            <LeadingIcon><FlareIconView Value="@FlareIcons.Delete" /></LeadingIcon>
                            <ChildContent>@Loc.Get("RemoveCardType")</ChildContent>
                        </FlareButton>
                    }
                </FlareStack>
            }
        </FlareStack>

        @if (!_newTypePanelOpen && Delete is not null && SelectedTypeHasCards)
        {
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                @Loc.Get("DeleteCardTypeHasCards")
            </FlareText>
        }

        @if (!_newTypePanelOpen)
        {
            <FlareDivider />

            <FlareStack Gap="FlareSpacing.Small">
            @* The statuses belong to the type, so they read as its section rather than as a peer of the tab
               strip: a small mono label and a count, not a heading bigger than the tab it belongs to. *@
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                    @Loc.Get("StagesTitle")
                </FlareText>
                <span class="aiko-tag aiko-tag--quiet">@DisplayFormat.Number(_stages.Count)</span>
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("BacklogStageFirst")
                </FlareText>
            </FlareStack>
            @* The pipeline as the design draws it: one card per stage, saying what the stage is (its role in
               the pipeline), who may run it, what it must produce and how it is verified. Clicking a card
               opens it for editing below. *@
            <div class="aiko-stages">
                @foreach (var stageItem in _stages)
                {
                    var card = stageItem;
                    <div class="aiko-stage @(ReferenceEquals(card, SelectedStage) ? "aiko-stage--on" : null)">
                        <button type="button" class="aiko-stage__open" @onclick="() => OpenStageDrawer(card)">
                        <span class="aiko-stage__head">
                            <FlareIconView Value="@IconOf(card.Icon)" Color="@ColorOf(card.Color)" />
                            <FlareText Element="span" Typo="TypographyScale.BodySmall" Weight="FontWeight.SemiBold">
                                @StageLabel(card)
                            </FlareText>
                            @if (StageRole(card) is { Length: > 0 } role)
                            {
                                <span class="aiko-tag">@role</span>
                            }
                        </span>
                        <span class="aiko-stage__facts">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("AllowedExecutors")
                            </FlareText>
                            @if (card.AllowedAgentAdapterIds.Count == 0)
                            {
                                <span class="aiko-tag aiko-tag--quiet">@Loc.Get("AnyAgent")</span>
                            }
                            else
                            {
                                @foreach (var agentId in card.AllowedAgentAdapterIds)
                                {
                                    <span class="aiko-tag aiko-tag--accent">@AgentName(agentId)</span>
                                }
                            }
                        </span>
                        @if (ArtifactPaths(card) is { Count: > 0 } artifacts)
                        {
                            <span class="aiko-stage__facts">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("RequiredArtifacts")
                                </FlareText>
                                @foreach (var artifact in artifacts)
                                {
                                    <span class="aiko-tag">@artifact</span>
                                }
                            </span>
                        }
                        @if (ParseCommands(card.CommandLines) is { Count: > 0 } commands)
                        {
                            <span class="aiko-stage__facts">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("ValidationCommands")
                                </FlareText>
                                @foreach (var command in commands)
                                {
                                    <span class="aiko-tag aiko-tag--quiet aiko-tag--clip" title="@command">@command</span>
                                }
                            </span>
                        }
                            @if (ParseCommands(card.BeforeSkillLines) is { Count: > 0 } beforeSkills)
                        {
                            <span class="aiko-stage__facts">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("SkillsBefore")
                                </FlareText>
                                @foreach (var skill in beforeSkills)
                                {
                                    <span class="aiko-tag aiko-tag--quiet aiko-tag--clip" title="@skill">@skill</span>
                                }
                            </span>
                        }
                        @if (ParseCommands(card.AfterSkillLines) is { Count: > 0 } afterSkills)
                        {
                            <span class="aiko-stage__facts">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("SkillsAfter")
                                </FlareText>
                                @foreach (var skill in afterSkills)
                                {
                                    <span class="aiko-tag aiko-tag--quiet aiko-tag--clip" title="@skill">@skill</span>
                                }
                            </span>
                        }
                    </button>
                        <span class="aiko-stage__move">
                            <FlareIconButton Icon="@FlareIcons.ArrowUpward"
                                             Variant="ButtonVariant.Text"
                                             AriaLabel="@Loc.Get("MoveUp")"
                                             Disabled="@(!CanMoveUp(card))"
                                             OnClick="() => MoveStageTo(card, -1)" />
                            <FlareIconButton Icon="@FlareIcons.ArrowDownward"
                                             Variant="ButtonVariant.Text"
                                             AriaLabel="@Loc.Get("MoveDown")"
                                             Disabled="@(!CanMoveDown(card))"
                                             OnClick="() => MoveStageTo(card, 1)" />
                        </span>
                    </div>
                }
            </div>
            <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="AddStage">
                <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                <ChildContent>@Loc.Get("AddStage")</ChildContent>
            </FlareButton>
            </FlareStack>
        }

    </FlareStack>
</FlarePaper>

@* Editing one stage happens in a drawer: the panel keeps the pipeline visible while the fields of the stage
   being edited get the room a form needs. *@
<FlareDrawer Anchor="DrawerAnchor.Right"
             Open="_stageDrawerOpen"
             OpenChanged="SetStageDrawer"
             Width="48rem"
             ContentPadding="FlareSpacing.Large"
             AriaLabel="@Loc.Get("SelectedStage")">
    <HeaderContent>
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                @Loc.Get("SelectedStage")
            </FlareText>
            <FlareText Element="h3" Typo="TypographyScale.TitleMedium">
                @(SelectedStage is { } head ? StageLabel(head) : string.Empty)
            </FlareText>
        </FlareStack>
    </HeaderContent>
    <ChildContent>
        @if (SelectedStage is { } stage)
        {
            <FlareStack Gap="FlareSpacing.Small">
                @* The stage id is an identifier, so it wears the design's identifier row. *@
                <div class="aiko-form-row">
                    <div class="aiko-code-row" title="@Loc.Get("StableIdHelper")">
                        <FlareIconView Value="@MaterialDesign3Icons.Regular.Tag" Color="FlareColor.OnSurfaceVariant2" />
                        <input type="text"
                               aria-label="@Loc.Get("StableId")"
                               placeholder="@Loc.Get("StableIdHelper")"
                               readonly="@(!stage.IsNew)"
                               @bind="stage.Id" />
                    </div>
                        <AikoField Label="@Loc.Get("Title")"
                               Value="@stage.Title"
                               ValueChanged="value => stage.Title = value" />
                </div>
                @* The instruction and the two skill lists as the design's prompt block - the same component
                   the card page uses for the same text - with the character and token foot the mock draws. *@
                <PromptField Name="@($"{stage.Id}.instruction")"
                             Title="@Loc.Get("Instruction")"
                             Rows="7"
                             Value="@stage.Instruction"
                             ValueChanged="value => stage.Instruction = value" />

                @* The two skill lists side by side: the wide drawer has the room, and the pair is read
                   together - what the agent reads before the instruction and what it reports after it. *@
                <div class="aiko-form-row">
                    <PromptField Name="@($"{stage.Id}.skills-before")"
                                 Title="@Loc.Get("SkillsBefore")"
                                 Rows="3"
                                 AccentDot="tertiary"
                                 ShowMetrics="false"
                                 Placeholder="@Loc.Get("SkillsBeforeHelper")"
                                 Value="@stage.BeforeSkillLines"
                                 ValueChanged="value => stage.BeforeSkillLines = value" />

                    <PromptField Name="@($"{stage.Id}.skills-after")"
                                 Title="@Loc.Get("SkillsAfter")"
                                 Rows="3"
                                 AccentDot="primary"
                                 ShowMetrics="false"
                                 Placeholder="@Loc.Get("SkillsAfterHelper")"
                                 Value="@stage.AfterSkillLines"
                                 ValueChanged="value => stage.AfterSkillLines = value" />
                </div>
                @* Who may run the stage, and who it starts with: the two belong together, so the select
                   sits beside the chip list rather than under it. *@
                <div class="aiko-form-row">
                    <FlareStack Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                            @Loc.Get("AllowedExecutors")
                        </FlareText>
                        @if (State.Agents.Count == 0)
                        {
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("NoAgentsDiscovered")
                            </FlareText>
                        }
                        else
                        {
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                @foreach (var agent in State.Agents)
                                {
                                    var option = agent;
                                    <label class="aiko-check-chip">
                                        <input type="checkbox"
                                               checked="@stage.AllowedAgentAdapterIds.Contains(option.Id)"
                                               @onchange="() => ToggleExecutor(stage, option.Id)" />
                                        @option.DisplayName
                                    </label>
                                }
                            </FlareStack>
                        }
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("AllowedExecutorsHint")
                        </FlareText>
                    </FlareStack>
                    <AikoSelectField Label="@Loc.Get("DefaultAgent")"
                                     Value="@stage.DefaultAgentAdapterId"
                                     ValueChanged="value => stage.DefaultAgentAdapterId = value">
                        <option value="">@Loc.Get("AnyAgent")</option>
                        @foreach (var agent in State.Agents)
                        {
                            var option = agent;
                            <option value="@option.Id">@option.DisplayName</option>
                        }
                    </AikoSelectField>
                </div>
                @* How the column is drawn: the icon and the colour the board paints on this stage. Both are
                   optional - an unset stage keeps the positional default - so a project that never touches
                   them looks exactly as it did before the choice existed. *@
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
                    <AikoSelectField Label="@Loc.Get("StageIcon")"
                                     Class="aiko-field--wide"
                                     Value="@stage.Icon"
                                     ValueChanged="value => OnStageIconPicked(stage, value)"
                                     Items="@IconChoices"
                                     NullOption="@Loc.Get("AppearanceDefault")"
                                     ItemTemplate="@IconOption"
                                     SelectedTemplate="@IconValue(ColorOf(stage.Color))" />
                    <AikoSelectField Label="@Loc.Get("StageColor")"
                                     Class="aiko-field--wide"
                                     Value="@stage.Color"
                                     ValueChanged="value => OnStageColorPicked(stage, value)"
                                     Items="@ColorChoices"
                                     NullOption="@Loc.Get("AppearanceDefault")"
                                     ItemTemplate="@ColorOption"
                                     SelectedTemplate="@ColorOption" />
                </FlareStack>
                @* What the stage must produce and the commands that verify it, side by side: on the wide
                   drawer the two read as one contract. *@
                <div class="aiko-form-row">
                    <PromptField Name="@($"{stage.Id}.artifacts")"
                                 Title="@Loc.Get("RequiredArtifacts")"
                                 Rows="4"
                                 AccentDot="secondary"
                                 ShowMetrics="false"
                                 Placeholder="@Loc.Get("ArtifactsHelper")"
                                 Value="@stage.ArtifactLines"
                                 ValueChanged="value => stage.ArtifactLines = value" />

                    <PromptField Name="@($"{stage.Id}.validate")"
                                 Title="@Loc.Get("ValidationCommands")"
                                 Rows="4"
                                 AccentDot="warning"
                                 ShowMetrics="false"
                                 Placeholder="@Loc.Get("ValidationCommandsHelper")"
                                 Value="@stage.CommandLines"
                                 ValueChanged="value => stage.CommandLines = value" />
                </div>
            </FlareStack>
        }

        <FlareDivider />

        @* The fields edit one stage, but the API saves the pipeline: one button therefore writes the whole
           workflow, and the hint says so. *@
        <FlareStack Gap="FlareSpacing.Small">
            <FlareButton FullWidth="true" Loading="@_saving" OnClick="SaveAsync">@Loc.Get("SaveWorkflow")</FlareButton>
            <FlareButton FullWidth="true"
                         Variant="ButtonVariant.Text"
                         Disabled="@(_stages.Count <= 1 || IsBacklogStage(SelectedStage) || IsDoneStage(SelectedStage))"
                         OnClick="RemoveStage">@Loc.Get("RemoveStage")</FlareButton>
            <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                @Loc.Get("WorkflowHint")
            </FlareText>
        </FlareStack>
    </ChildContent>
</FlareDrawer>

@code {
    /// <summary>The pipelines to edit: a project's own copy, or the ones a template ships.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<WorkflowDefinition> Workflows { get; set; } = [];

    /// <summary>
    /// The cards of the board, or an empty list for a template. They are what stops a stage that still
    /// holds work from being removed; a template has no work on it.
    /// </summary>
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];

    /// <summary>Which pipeline to open first.</summary>
    [Parameter] public string? InitialWorkflowId { get; set; }

    /// <summary>
    /// Writes the pipeline the form built and returns the failure text, or null when it was saved. The
    /// editor does not know where a pipeline lives - a project's own file or the template it came from -
    /// so the screen owns the call.
    /// </summary>
    [Parameter, EditorRequired] public Func<WorkflowDefinition, Task<string?>> Save { get; set; } =
        _ => Task.FromResult<string?>(null);

    /// <summary>Raised when the screen should close the editor, if it was opened as a drawer.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Creates a card type - a workflow the project does not have yet - and returns the failure text, or null
    /// when it was created. Optional: a screen that only edits existing pipelines omits it.
    /// </summary>
    [Parameter] public Func<WorkflowDefinition, Task<string?>>? Create { get; set; }

    /// <summary>
    /// Removes a card type and returns the failure text, or null when it was removed. Optional, like
    /// <see cref="Create"/>.
    /// </summary>
    [Parameter] public Func<WorkflowDefinition, Task<string?>>? Delete { get; set; }

    /// <summary>
    /// Renames a card type - its id, which is what its cards and board section are filed under - and
    /// returns the failure text, or null when it was renamed. Optional: a screen that cannot carry the
    /// change out (a template, or a type that still has cards) omits it, and the id field turns read-only.
    /// </summary>
    [Parameter] public Func<string, string, Task<string?>>? Rename { get; set; }

    /// <summary>The icon ids a stage or a card type may choose from.</summary>
    private static IReadOnlyList<string> IconChoices => AppearanceCatalog.Icons;

    /// <summary>The colour ids a stage or a card type may choose from.</summary>
    private static IReadOnlyList<string> ColorChoices => AppearanceCatalog.Colors;

    /// <summary>
    /// One icon choice, drawn as the icon itself: the list shows what it is offering rather than a name the
    /// reader has to translate in their head.
    /// </summary>
    private static RenderFragment<string> IconOption => icon => @<FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
        <FlareIconView Value="@IconOf(icon)" Color="@FlareColor.OnSurfaceVariant" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall">@icon</FlareText>
    </FlareStack>;

    /// <summary>
    /// The chosen icon in the closed field, tinted by the colour the same picker sits beside - so the value
    /// reads as the pair an editor is choosing, not as two independent settings.
    /// </summary>
    /// <param name="tint">The accent of the surrounding picker.</param>
    private static RenderFragment<string> IconValue(FlareColor tint) => icon => @<FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
        <FlareIconView Value="@IconOf(icon)" Color="@tint" />
        <FlareText Element="span" Typo="TypographyScale.BodySmall">@icon</FlareText>
    </FlareStack>;

    /// <summary>One colour choice, drawn as the colour itself, with its name beside it.</summary>
    private static RenderFragment<string> ColorOption => color => @<FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
        <span class="aiko-swatch" style="@($"background-color: {ColorOf(color).CssValue}")"></span>
        <FlareText Element="span" Typo="TypographyScale.BodySmall">@color</FlareText>
    </FlareStack>;

    /// <summary>
    /// The icon a choice draws, so a picker can show what it is choosing. The fallback makes the result
    /// non-null, which is what the icon control needs: it has no "draw nothing" state.
    /// </summary>
    private static FlareIcon IconOf(string? icon) =>
        CardAppearance.Icon(icon, MaterialDesign3Icons.Regular.Pending)!;

    /// <summary>The colour a choice draws, so a picker can show what it is choosing.</summary>
    private static FlareColor ColorOf(string? color) =>
        CardAppearance.Color(color) ?? FlareColor.OnSurfaceVariant;

    private static string? TrimOrNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private string? _loadedWorkflowsKey;
    private string _workflowId = string.Empty;
    private string? _workflowIdDraft;
    private string? _workflowTitle;
    private string? _workflowDescription;
    private string? _workflowIcon;
    private string? _workflowColor;
    private bool _workflowBlendsWithParent;
    private string? _newTypeId;
    private string? _newTypeTitle;
    private string? _newTypeDescription;
    private string? _newTypeIcon;
    private string? _newTypeColor;
    private bool _newTypeBlendsWithParent;
    private bool _creatingType;
    private bool _deleteTypeConfirm;

    /// <summary>
    /// Whether the "new card type" form is open. It is behind the tabs' "+" rather than always on screen: a
    /// form for adding something should not take the room of the thing being edited.
    /// </summary>
    private bool _newTypePanelOpen;

    /// <summary>
    /// The pipeline to open after the next reload. Creating a type rebuilds the list, and without this the
    /// editor would jump back to the first pipeline instead of following the type that was just added.
    /// </summary>
    private string? _pendingWorkflowId;
    private StageDraft? _selectedStage;
    private List<StageDraft> _stages = [];
    private string? _message;
    private bool _hasError;
    private bool _saving;
    private bool _stageDrawerOpen;

    private WorkflowDefinition SelectedWorkflow =>
        Workflows.First(workflow => workflow.Id == _workflowId);

    /// <summary>
    /// Whether the type's id may be edited here. The id names the folder a type's cards are filed in and
    /// the board section that shows them, so it is only offered where the screen can carry the rename out:
    /// a project's own pipeline, with no card filed under the type yet.
    /// </summary>
    private bool CanRenameId => Rename is not null && !SelectedTypeHasCards;

    /// <summary>The icon the pickers edit: the draft's while the draft tab is open, the type's otherwise.</summary>
    private string? PickedIcon => _newTypePanelOpen ? _newTypeIcon : _workflowIcon;

    /// <summary>The colour the pickers edit, chosen the same way as <see cref="PickedIcon"/>.</summary>
    private string? PickedColor => _newTypePanelOpen ? _newTypeColor : _workflowColor;

    /// <summary>
    /// Whether a card of the type being edited blends its score with its parents, chosen the same way as
    /// <see cref="PickedIcon"/>: the draft's flag while the draft tab is open, the type's otherwise.
    /// </summary>
    private bool BlendsWithParent
    {
        get => _newTypePanelOpen ? _newTypeBlendsWithParent : _workflowBlendsWithParent;
        set
        {
            if (_newTypePanelOpen)
            {
                _newTypeBlendsWithParent = value;
            }
            else
            {
                _workflowBlendsWithParent = value;
            }
        }
    }

    private void OnIconPicked(string? value)
    {
        if (_newTypePanelOpen)
        {
            _newTypeIcon = value;
        }
        else
        {
            _workflowIcon = value;
        }
    }

    private void OnColorPicked(string? value)
    {
        if (_newTypePanelOpen)
        {
            _newTypeColor = value;
        }
        else
        {
            _workflowColor = value;
        }
    }

    /// <summary>What the draft tab draws: the type does not exist yet, so it wears the add glyph.</summary>
    private static RenderFragment DraftTabIcon => @<FlareIconView Value="@MaterialDesign3Icons.Regular.Add" />;

    /// <summary>
    /// Opens a draft type as a tab of its own, or closes it again. Opening starts from empty fields;
    /// closing throws the draft away and leaves the type that was on screen selected.
    /// </summary>
    private void ToggleNewType()
    {
        _message = null;
        _hasError = false;
        _deleteTypeConfirm = false;
        if (!_newTypePanelOpen && Create is null)
        {
            return;
        }

        _newTypePanelOpen = !_newTypePanelOpen;
        _newTypeId = null;
        _newTypeTitle = null;
        _newTypeDescription = null;
        _newTypeIcon = null;
        _newTypeColor = null;
        _newTypeBlendsWithParent = false;
    }

    private StageDraft? SelectedStage => _selectedStage ?? _stages.FirstOrDefault();

    protected override void OnParametersSet()
    {
        var workflowsKey = $"{InitialWorkflowId}|{string.Join('|', Workflows.Select(workflow =>
            $"{workflow.Id}:{workflow.Revision}"))}";
        if (_loadedWorkflowsKey == workflowsKey)
        {
            return;
        }

        _loadedWorkflowsKey = workflowsKey;
        if (Workflows.Count == 0)
        {
            return;
        }

        // A freshly created type wins over the screen's initial choice: the reload happens because of the
        // creation, so the editor should land on what was created.
        var preferredId = _pendingWorkflowId ?? InitialWorkflowId;
        var requested = preferredId is not null
            ? Workflows.FirstOrDefault(workflow => workflow.Id == preferredId)
            : null;
        _pendingWorkflowId = null;
        LoadWorkflow(requested ?? Workflows[0]);
    }

    /// <summary>
    /// The tab of the type this panel edits: the tabs and the editor are one selection, so the tab that is
    /// open and the pipeline on screen can never disagree.
    /// </summary>
    private int ActiveTypeIndex
    {
        get
        {
            // The draft is the last tab, past the types that exist.
            if (_newTypePanelOpen)
            {
                return Workflows.Count;
            }

            for (var index = 0; index < Workflows.Count; index++)
            {
                if (StringComparer.Ordinal.Equals(Workflows[index].Id, _workflowId))
                {
                    return index;
                }
            }

            return 0;
        }
    }

    /// <summary>
    /// The type's icon as its tab draws it, or null when the type chose none. FlareTab takes a fragment rather
    /// than an icon, so the icon is wrapped here - and only when there is one, because a type without an icon
    /// has none on the board either.
    /// </summary>
    private static RenderFragment? TabIcon(WorkflowDefinition type)
    {
        if (CardAppearance.Icon(type.Icon) is not { } icon)
        {
            return null;
        }

        return @<FlareIconView Value="icon" />;
    }

    /// <summary>Switching tabs switches the pipeline, so the stages follow the type that was picked.</summary>
    private void OnTypeTabChanged(int index)
    {
        // The draft is not a workflow yet, so its tab only keeps the draft open.
        if (_newTypePanelOpen && index == Workflows.Count)
        {
            return;
        }

        if (index < 0 || index >= Workflows.Count)
        {
            return;
        }

        // Picking a real type closes the draft: the fields below are about to be someone else's.
        if (_newTypePanelOpen)
        {
            ToggleNewType();
        }

        var picked = Workflows[index];
        if (!StringComparer.Ordinal.Equals(picked.Id, _workflowId))
        {
            LoadWorkflow(picked);
        }
    }

    private static string StageLabel(StageDraft stage) => $"{stage.Order}. {stage.Title}";

    private void LoadWorkflow(WorkflowDefinition workflow)
    {
        _workflowId = workflow.Id;
        _workflowIdDraft = workflow.Id;
        _workflowTitle = workflow.Title;
        _workflowDescription = workflow.Description;
        _workflowIcon = workflow.Icon;
        _workflowColor = workflow.Color;
        _workflowBlendsWithParent = workflow.BlendsWithParent;
        _stages = workflow.Stages
            .OrderBy(stage => stage.Order)
            .Select(StageDraft.FromDefinition)
            .ToList();
        // The pipeline invariant, applied to what was read: a file that put something before the backlog
        // would otherwise be drawn that way and then refused on save.
        NormalizeOrder();
        _selectedStage = _stages.FirstOrDefault();
        _message = null;
        _hasError = false;
        // The confirmation belongs to the type that was on screen, not to the one that replaces it.
        _deleteTypeConfirm = false;
    }

    private void AddStage()
    {
        var stem = "new-stage";
        var id = stem;
        var suffix = 2;
        while (_stages.Any(stage => stage.Id == id))
        {
            id = $"{stem}-{suffix++}";
        }

        var kinds = SelectedWorkflow.Stages.FirstOrDefault()?.AllowedCardKinds ?? [SelectedWorkflow.CardType];
        var added = new StageDraft
        {
            Id = id,
            Title = Loc.Get("NewStage"),
            Order = 0,
            Instruction = Loc.Get("NewStageInstruction"),
            AllowedCardKinds = kinds,
            ActionPolicies = new Dictionary<string, ActionPolicy>(StringComparer.Ordinal),
            IsNew = true
        };
        // A new stage is a working stage, so it lands before the reserved done stage rather than after it:
        // the end of the pipeline has to stay the end. NormalizeOrder does the numbering.
        var done = _stages.FindIndex(IsDoneStage);
        _stages.Insert(done < 0 ? _stages.Count : done, added);
        NormalizeOrder();
        _selectedStage = added;
    }

    private void RemoveStage()
    {
        var stage = SelectedStage;
        if (stage is null || _stages.Count == 1)
        {
            ShowError(Loc.Get("OneStageRequired"));
            return;
        }

        if (StringComparer.Ordinal.Equals(stage.Id, WorkflowDefinition.BacklogStageId))
        {
            ShowError(Loc.Get("BacklogStageReserved"));
            return;
        }

        // The done stage is the end of the pipeline for the same reason the backlog is its beginning: the engine
        // reads "finished" from that id, so a pipeline without it would have no card that could ever be finished,
        // archived or stop blocking another one.
        if (StringComparer.Ordinal.Equals(stage.Id, WorkflowDefinition.DoneStageId))
        {
            ShowError(Loc.Get("DoneStageReserved"));
            return;
        }

        var occupied = Cards.FirstOrDefault(card =>
            card.WorkflowId == _workflowId && card.StageId == stage.Id);
        if (occupied is not null)
        {
            ShowError(Loc.Format("MoveCardFirst", occupied.Reference.CardId));
            return;
        }

        var index = _stages.IndexOf(stage);
        _stages.RemoveAt(index);
        NormalizeOrder();
        _selectedStage = _stages[Math.Min(index, _stages.Count - 1)];
        // The drawer was editing the stage that no longer exists, so it closes with it.
        _stageDrawerOpen = false;
    }

    /// <summary>
    /// Saves the type itself: the name, description, icon and colour the tab and the board draw, and the
    /// id when it was changed. The pipeline is saved by <see cref="SaveAsync"/>, so each button writes the
    /// part of the document it stands next to.
    /// </summary>
    private async Task SaveTypeAsync()
    {
        _message = null;
        _hasError = false;
        if (_newTypePanelOpen)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_workflowTitle))
        {
            ShowError(Loc.Get("WorkflowTitleRequired"));
            return;
        }

        _saving = true;
        try
        {
            var failure = await Save(SelectedWorkflow with
            {
                Title = _workflowTitle!,
                Description = TrimOrNull(_workflowDescription),
                Icon = AppearanceCatalog.NormalizeIcon(_workflowIcon),
                Color = AppearanceCatalog.NormalizeColor(_workflowColor),
                BlendsWithParent = _workflowBlendsWithParent
            });
            if (failure is not null)
            {
                ShowError(failure);
                return;
            }

            if (await RenameCardTypeAsync() is { } renameFailure)
            {
                ShowError(renameFailure);
                return;
            }

            _message = Loc.Get("CardTypeSaved");
        }
        catch (Exception exception)
        {
            ShowError(Loc.Format("SaveWorkflowFailed", exception.Message));
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Renames the type when its id field was changed, and returns the failure text or null. The daemon
    /// refuses a rename that would leave a card outside its pipeline, which is why the field is read-only
    /// once the type has cards.
    /// </summary>
    private async Task<string?> RenameCardTypeAsync()
    {
        var requested = TrimOrNull(_workflowIdDraft);
        if (requested is null || StringComparer.Ordinal.Equals(requested, _workflowId))
        {
            return null;
        }

        if (Rename is null)
        {
            return Loc.Get("CardTypeIdFixed");
        }

        var failure = await Rename(_workflowId, requested);
        if (failure is null)
        {
            // The reload carries the new id, so the editor follows the type rather than the old name.
            _pendingWorkflowId = requested;
            _workflowIdDraft = requested;
        }

        return failure;
    }

    private async Task SaveAsync()
    {
        _message = null;
        _hasError = false;
        if (string.IsNullOrWhiteSpace(_workflowTitle))
        {
            ShowError(Loc.Get("WorkflowTitleRequired"));
            return;
        }

        var duplicateId = _stages.GroupBy(stage => stage.Id, StringComparer.Ordinal)
            .FirstOrDefault(group => group.Count() > 1)?.Key;
        if (duplicateId is not null || _stages.Any(stage =>
                string.IsNullOrWhiteSpace(stage.Id) || string.IsNullOrWhiteSpace(stage.Title)))
        {
            ShowError(duplicateId is null
                ? Loc.Get("StageIdTitleRequired")
                : Loc.Format("StageIdUnique", duplicateId));
            return;
        }

        // The pipeline is pinned before it is written, so the editor cannot save one the engine would refuse:
        // the backlog is first and the done stage is last, whatever the arrows and the drafts were left in.
        NormalizeOrder();

        var stages = new List<StageDefinition>();
        foreach (var draft in _stages)
        {
            if (!TryParseArtifacts(draft.ArtifactLines, out var artifacts, out var error))
            {
                _selectedStage = draft;
                ShowError($"{draft.Title}: {error}");
                return;
            }

            stages.Add(draft.ToDefinition(artifacts));
        }

        var workflow = SelectedWorkflow;
        _saving = true;
        try
        {
            // The screen owns the call, so the editor never has to know whether it is editing a project's
            // file or the template those files came from.
            var failure = await Save(workflow with
            {
                Title = _workflowTitle!,
                Stages = stages,
                Description = TrimOrNull(_workflowDescription),
                Icon = AppearanceCatalog.NormalizeIcon(_workflowIcon),
                Color = AppearanceCatalog.NormalizeColor(_workflowColor),
                BlendsWithParent = _workflowBlendsWithParent
            });
            if (failure is not null)
            {
                ShowError(failure);
                return;
            }

            // An id changed in the fields at the top is carried out here too, so saving the pipeline
            // cannot quietly drop the rename.
            if (await RenameCardTypeAsync() is { } renameFailure)
            {
                ShowError(renameFailure);
                return;
            }

            _message = Loc.Get("WorkflowSaved");
        }
        catch (Exception exception)
        {
            ShowError(Loc.Format("SaveWorkflowFailed", exception.Message));
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool TryParseArtifacts(
        string? lines,
        out IReadOnlyList<ArtifactRequirement> artifacts,
        out string? error)
    {
        var result = new List<ArtifactRequirement>();
        foreach (var line in (lines ?? string.Empty).Split(
                     ['\r', '\n'],
                     StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var parts = line.Split('|', 3, StringSplitOptions.TrimEntries);
            if (parts.Length < 2 || string.IsNullOrWhiteSpace(parts[0]) ||
                !Enum.TryParse<MissingArtifactPolicy>(parts[1], true, out var policy))
            {
                artifacts = [];
                error = Loc.Format("ArtifactLineInvalid", line);
                return false;
            }

            result.Add(new ArtifactRequirement(
                parts[0],
                parts.Length == 3 ? parts[2] : string.Empty,
                policy));
        }

        artifacts = result;
        error = null;
        return true;
    }

    /// <summary>
    /// Renumbers the stages by their place in the list - and pins the reserved stages: the backlog to the front
    /// and the done stage to the back. It is the pipeline invariant rather than a preference: a card enters its
    /// workflow in the backlog and is finished in the done stage, so nothing may be placed before or after them.
    /// </summary>
    private void NormalizeOrder()
    {
        var backlog = _stages.FirstOrDefault(IsBacklogStage);
        if (backlog is not null && !ReferenceEquals(_stages[0], backlog))
        {
            _stages.Remove(backlog);
            _stages.Insert(0, backlog);
        }

        var done = _stages.FirstOrDefault(IsDoneStage);
        if (done is not null && !ReferenceEquals(_stages[^1], done))
        {
            _stages.Remove(done);
            _stages.Add(done);
        }

        for (var index = 0; index < _stages.Count; index++)
        {
            _stages[index].Order = (index + 1) * 10;
        }
    }

    /// <summary>
    /// Adds a card type: a workflow of its own, starting with the reserved backlog stage and two working
    /// stages, so the type is usable the moment it is created and the pipeline can be shaped afterwards.
    /// </summary>
    private async Task CreateCardTypeAsync()
    {
        _message = null;
        _hasError = false;
        if (Create is null)
        {
            return;
        }

        var id = _newTypeId?.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(id) || !System.Text.RegularExpressions.Regex.IsMatch(
                id, "^[a-z0-9][a-z0-9-]*$"))
        {
            ShowError(Loc.Get("CardTypeIdInvalid"));
            return;
        }

        if (string.IsNullOrWhiteSpace(_newTypeTitle))
        {
            ShowError(Loc.Get("CardTypeIdTitleRequired"));
            return;
        }

        if (Workflows.Any(workflow => StringComparer.Ordinal.Equals(workflow.Id, id)))
        {
            ShowError(Loc.Format("CardTypeExists", id));
            return;
        }

        var cardType = CardKind.FromWorkflowId(id);
        var policies = new Dictionary<string, ActionPolicy>(StringComparer.Ordinal);
        var workflow = new WorkflowDefinition(
            id,
            _newTypeTitle.Trim(),
            [
                new StageDefinition(
                    WorkflowDefinition.BacklogStageId,
                    Loc.Get("StageTitleBacklog"),
                    10,
                    Loc.Get("NewTypeBacklogInstruction"),
                    [cardType],
                    null,
                    [],
                    policies,
                    Icon: "inbox",
                    Color: "secondary"),
                new StageDefinition(
                    "in-progress",
                    Loc.Get("StageTitleInProgress"),
                    20,
                    Loc.Get("NewTypeWorkInstruction"),
                    [cardType],
                    null,
                    [],
                    policies,
                    Icon: "code",
                    Color: "warning"),
                new StageDefinition(
                    "done",
                    Loc.Get("StageTitleDone"),
                    30,
                    Loc.Get("NewTypeDoneInstruction"),
                    [cardType],
                    null,
                    [],
                    policies,
                    Icon: "done-all",
                    Color: "success")
            ],
            1,
            TrimOrNull(_newTypeDescription),
            AppearanceCatalog.NormalizeIcon(_newTypeIcon),
            AppearanceCatalog.NormalizeColor(_newTypeColor),
            _newTypeBlendsWithParent);

        _creatingType = true;
        try
        {
            var failure = await Create(workflow);
            if (failure is not null)
            {
                ShowError(failure);
                return;
            }

            _message = Loc.Format("CardTypeCreated", workflow.Title);
            _pendingWorkflowId = workflow.Id;
            _newTypePanelOpen = false;
            _newTypeId = null;
            _newTypeTitle = null;
            _newTypeDescription = null;
            _newTypeIcon = null;
            _newTypeColor = null;
        }
        catch (Exception exception)
        {
            ShowError(Loc.Format("SaveWorkflowFailed", exception.Message));
        }
        finally
        {
            _creatingType = false;
        }
    }

    /// <summary>
    /// Removes the card type being edited. The daemon refuses while cards of that type exist, and the screen
    /// says so rather than stranding them.
    /// </summary>
    private async Task DeleteCardTypeAsync()
    {
        _message = null;
        _hasError = false;
        if (Delete is null)
        {
            return;
        }

        try
        {
            var failure = await Delete(SelectedWorkflow);
            if (failure is not null)
            {
                ShowError(failure);
            }
        }
        catch (Exception exception)
        {
            ShowError(Loc.Format("SaveWorkflowFailed", exception.Message));
        }
    }

    /// <summary>
    /// Whether the type being edited still holds cards. Removing it would strand them, so the action is not
    /// offered; the daemon refuses it as well, and this is the screen saying so before the request.
    /// </summary>
    private bool SelectedTypeHasCards => Cards.Any(card =>
        StringComparer.Ordinal.Equals(card.WorkflowId, _workflowId));

    private static void OnStageIconPicked(StageDraft stage, string? value) =>
        stage.Icon = TrimOrNull(value);

    private static void OnStageColorPicked(StageDraft stage, string? value) =>
        stage.Color = TrimOrNull(value);

    /// <summary>
    /// Whether the stage is the reserved backlog column. It is the list of cards not taken into work yet,
    /// so it is not a column the editor may remove or reorder away.
    /// </summary>
    private static bool IsBacklogStage(StageDraft? stage) =>
        stage is not null && StringComparer.Ordinal.Equals(stage.Id, WorkflowDefinition.BacklogStageId);

    /// <summary>
    /// Whether the stage is the reserved done column. The engine reads the end of a pipeline from that id, so
    /// it is not a column the editor may remove or reorder away either.
    /// </summary>
    private static bool IsDoneStage(StageDraft? stage) =>
        stage is not null && StringComparer.Ordinal.Equals(stage.Id, WorkflowDefinition.DoneStageId);

    private void ShowError(string message)
    {
        _message = message;
        _hasError = true;
    }

    /// <summary>Opens one stage in the drawer: the card's click, and where the fields live.</summary>
    private void OpenStageDrawer(StageDraft stage)
    {
        _selectedStage = stage;
        _stageDrawerOpen = true;
    }

    private void SetStageDrawer(bool open) => _stageDrawerOpen = open;

    /// <summary>
    /// Moves one stage in the pipeline. Reordering is the panel's own operation - it needs no drawer,
    /// because it changes the list rather than the stage. The arrows that would break the pipeline's own
    /// rule are disabled, and the move is refused here as well so a stray click cannot either.
    /// </summary>
    private void MoveStageTo(StageDraft stage, int offset)
    {
        var current = _stages.IndexOf(stage);
        var target = current + offset;
        if (current < 0 || target < 0 || target >= _stages.Count ||
            (offset < 0 ? !CanMoveUp(stage) : !CanMoveDown(stage)))
        {
            return;
        }

        _stages.RemoveAt(current);
        _stages.Insert(target, stage);
        NormalizeOrder();
        _selectedStage = stage;
    }

    /// <summary>The backlog's place in the list, which is where a card enters the pipeline.</summary>
    private int IndexOfBacklog => _stages.FindIndex(IsBacklogStage);

    /// <summary>
    /// Whether a stage may move towards the top. The reserved backlog is first by construction, so the stage
    /// directly below it has nowhere to go, and the reserved done stage is the end of the pipeline: it never
    /// moves.
    /// </summary>
    private bool CanMoveUp(StageDraft stage) =>
        !IsDoneStage(stage) && _stages.IndexOf(stage) > IndexOfBacklog + 1;

    /// <summary>
    /// Whether a stage may move towards the bottom. The backlog never moves down - nothing may be placed
    /// before it - the reserved done stage is the end, and the stage directly above it has nowhere to go
    /// either, because the end has to stay the end.
    /// </summary>
    private bool CanMoveDown(StageDraft stage)
    {
        var index = _stages.IndexOf(stage);
        return !IsBacklogStage(stage) &&
               !IsDoneStage(stage) &&
               index >= 0 &&
               index < _stages.Count - 1 &&
               !IsDoneStage(_stages[index + 1]);
    }

    /// <summary>
    /// A stage's place in the pipeline, read from the reserved ids rather than from the order: the backlog is
    /// where a card enters and the done stage is where it leaves, and a second field saying so would be a
    /// second truth.
    /// </summary>
    private string StageRole(StageDraft stage)
    {
        if (IsBacklogStage(stage))
        {
            return Loc.Get("StageRoleInitial");
        }

        return IsDoneStage(stage) ? Loc.Get("StageRoleTerminal") : string.Empty;
    }

    /// <summary>The display name of an adapter id, falling back to the id when it was not discovered.</summary>
    private string AgentName(string agentAdapterId) =>
        State.Agents
            .FirstOrDefault(agent => StringComparer.Ordinal.Equals(agent.Id, agentAdapterId))?.DisplayName
        ?? agentAdapterId;

    /// <summary>
    /// The artifact paths of a stage, as its card lists them: the first field of each artifact line, so the
    /// card reads as paths while the editor keeps the policy and the description.
    /// </summary>
    private static IReadOnlyList<string> ArtifactPaths(StageDraft stage) =>
        (stage.ArtifactLines ?? string.Empty)
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line => line.Split('|', 2, StringSplitOptions.TrimEntries)[0])
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .ToArray();

    /// <summary>
    /// Adds or removes one adapter from a stage's executor list. The list is a plain set of adapter ids:
    /// empty means "every adapter may run this stage", which is what the screen says next to it.
    /// </summary>
    private static void ToggleExecutor(StageDraft stage, string agentAdapterId)
    {
        if (!stage.AllowedAgentAdapterIds.Remove(agentAdapterId))
        {
            stage.AllowedAgentAdapterIds.Add(agentAdapterId);
        }
    }

    /// <summary>
    /// One verification command per line (ТЗ §11). Blank lines are dropped rather than rejected: a
    /// trailing newline is what a textarea hands back.
    /// </summary>
    private static IReadOnlyList<string> ParseCommands(string? lines) =>
        (lines ?? string.Empty)
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToArray();

    private sealed class StageDraft
    {
        public required string Id { get; set; }
        public required string Title { get; set; }
        public int Order { get; set; }
        public required string Instruction { get; set; }
        public string? DefaultAgentAdapterId { get; set; }
        public string? Icon { get; set; }
        public string? Color { get; set; }
        public string? ArtifactLines { get; set; }
        public string? CommandLines { get; set; }
        public string? BeforeSkillLines { get; set; }
        public string? AfterSkillLines { get; set; }
        public List<string> AllowedAgentAdapterIds { get; init; } = [];
        public required IReadOnlyList<string> AllowedCardKinds { get; init; }
        public required IReadOnlyDictionary<string, ActionPolicy> ActionPolicies { get; init; }
        public bool IsNew { get; init; }

        public static StageDraft FromDefinition(StageDefinition stage) => new()
        {
            Id = stage.Id,
            Title = stage.Title,
            Order = stage.Order,
            Instruction = stage.Instruction,
            DefaultAgentAdapterId = stage.DefaultAgentAdapterId,
            Icon = stage.Icon,
            Color = stage.Color,
            ArtifactLines = string.Join(Environment.NewLine, stage.RequiredArtifacts.Select(artifact =>
                $"{artifact.Path} | {artifact.MissingPolicy} | {artifact.Description}")),
            CommandLines = string.Join(Environment.NewLine, stage.Commands),
            BeforeSkillLines = string.Join(Environment.NewLine, stage.BeforeSkills),
            AfterSkillLines = string.Join(Environment.NewLine, stage.AfterSkills),
            AllowedAgentAdapterIds = [.. stage.AllowedAgents],
            AllowedCardKinds = stage.AllowedCardKinds,
            ActionPolicies = stage.ActionPolicies
        };

        public StageDefinition ToDefinition(IReadOnlyList<ArtifactRequirement> artifacts) => new(
            Id.Trim(),
            Title.Trim(),
            Order,
            Instruction?.Trim() ?? string.Empty,
            AllowedCardKinds,
            string.IsNullOrWhiteSpace(DefaultAgentAdapterId) ? null : DefaultAgentAdapterId.Trim(),
            artifacts,
            ActionPolicies,
            // An empty list travels as an empty list, not null: "no executors chosen" means every adapter,
            // and null would say the same thing through a second representation.
            AllowedAgentAdapterIds,
            ParseCommands(CommandLines),
            ParseCommands(BeforeSkillLines),
            ParseCommands(AfterSkillLines),
            AppearanceCatalog.NormalizeIcon(Icon),
            AppearanceCatalog.NormalizeColor(Color));
    }
}
