@* One board screen, shared by the three board routes: the projection switch, the metric strip, the
   create form and one section per card kind the mode asks for. The routes differ only by Mode. *@
@inject HttpClient Http
@inject WorkspaceState State
@inject NavigationManager Navigation

@if (State.Board is not { } board)
{
    <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("BoardUnavailable")</FlareAlert>
}
else
{
    <FlareStack Gap="FlareSpacing.Medium">
        @* Which cards the board shows, as the design's filter row does it: one control, three projections,
           and the route follows the choice so the rail, the back button and the address bar agree. *@
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
            <FlareToggleGroup TValue="BoardViewMode"
                              Size="ButtonSize.Sm"
                              Value="Mode"
                              ValueChanged="ChangeModeAsync">
                @* Value is object-typed, so the enum member must be an expression - a bare literal would
                   arrive at the group as the string "BoardViewMode.Combined". *@
                <FlareToggleButton Variant="ButtonVariant.Filled" Value="@BoardViewMode.Combined">@Loc.Get("CombinedNav")</FlareToggleButton>
                <FlareToggleButton Variant="ButtonVariant.Filled" Value="@BoardViewMode.Stories">@Loc.Get("StoriesNav")</FlareToggleButton>
                <FlareToggleButton Variant="ButtonVariant.Filled" Value="@BoardViewMode.Tasks">@Loc.Get("TasksNav")</FlareToggleButton>
            </FlareToggleGroup>
            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@ProjectionCaption</FlareText>
        </FlareStack>

        @* The design's metric strip: a mono summary line, not a row of tiles. *@
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true" Class="aiko-metrics">
            @foreach (var tile in SummaryTiles)
            {
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">@tile.Label</FlareText>
                    <FlareText Element="span" Mono="true"
                               Color="@(tile.Warn ? FlareColor.Error : FlareColor.Tertiary)"
                               Weight="FontWeight.SemiBold">@tile.Value</FlareText>
                </FlareStack>
            }
        </FlareStack>

        @if (BoardMetrics.IsParallelShared(State.SettingsView?.EffectiveExecution))
        {
            <FlareAlert Severity="AlertSeverity.Warning"
                        Variant="AlertVariant.Outlined"
                        Title="@Loc.Get("ParallelSharedTitle")">@Loc.Get("ParallelSharedText")</FlareAlert>
        }

        <FlareStack Row="true" Gap="FlareSpacing.XSmall">
            <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm" OnClick="OpenNewCard">
                <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                <ChildContent>@Loc.Get("CreateCard")</ChildContent>
            </FlareButton>
        </FlareStack>

        <FlareDivider />

        @if (Mode is BoardViewMode.Stories or BoardViewMode.Combined)
        {
            <BoardSection Title="@Loc.Get("StoryFlow")"
                          Kind="CardKind.Story"
                          Board="board"
                          OnCardSelected="OpenCard"
                          OnCardMoved="move => MoveCardAsync(CardKind.Story, move)" />
        }

        @if (Mode == BoardViewMode.Combined)
        {
            <FlareDivider Text="@Loc.Get("Implementation")" />
        }

        @if (Mode is BoardViewMode.Tasks or BoardViewMode.Combined)
        {
            <BoardSection Title="@Loc.Get("TaskFlow")"
                          Kind="CardKind.Task"
                          Board="board"
                          OnCardSelected="OpenCard"
                          OnCardMoved="move => MoveCardAsync(CardKind.Task, move)" />
        }
    </FlareStack>
}

@code {
    /// <summary>Which card kinds this board draws.</summary>
    [Parameter] public BoardViewMode Mode { get; set; } = BoardViewMode.Combined;

    /// <summary>The project id from the route.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = string.Empty;

    /// <summary>The route opens the project; the board itself has no other state of its own.</summary>
    protected override async Task OnParametersSetAsync() => await State.EnsureProjectAsync(ProjectId);

    /// <summary>Creating a card is its own page: the board only links to it.</summary>
    private void OpenNewCard() => Navigation.NavigateTo($"{ProjectHref}/cards/new");

    /// <summary>A card is its own page too, so a card can be linked, reloaded and shared.</summary>
    private void OpenCard(string cardId) =>
        Navigation.NavigateTo($"{ProjectHref}/cards/{Uri.EscapeDataString(cardId)}");

    private string ProjectHref => $"/p/{Uri.EscapeDataString(ProjectId)}";

    /// <summary>
    /// The projection switch is a navigation, not local state: the choice becomes the route, so the rail,
    /// the address bar and the back button all agree on which projection is showing.
    /// </summary>
    private void ChangeModeAsync(BoardViewMode mode)
    {
        if (mode == Mode)
        {
            return;
        }

        var section = mode switch
        {
            BoardViewMode.Stories => "stories",
            BoardViewMode.Tasks => "tasks",
            _ => "board"
        };
        Navigation.NavigateTo($"{ProjectHref}/{section}");
    }

    private IReadOnlyList<Card> VisibleCards => Mode switch
    {
        BoardViewMode.Stories => State.Board?.Cards.Where(card => card.Kind == CardKind.Story).ToArray() ?? [],
        BoardViewMode.Tasks => State.Board?.Cards.Where(card => card.Kind == CardKind.Task).ToArray() ?? [],
        _ => State.Board?.Cards ?? []
    };

    /// <summary>The four board metrics, as the design's mono summary line.</summary>
    private IReadOnlyList<(string Label, string Value, bool Warn)> SummaryTiles
    {
        get
        {
            var board = State.Board;
            var outOfScope = BoardMetrics.OutOfScopeCount(board);
            return
            [
                (Loc.Get("Cards"), DisplayFormat.Number(VisibleCards.Count), false),
                (Loc.Get("InProgress"), DisplayFormat.Number(BoardMetrics.InProgressCount(board)), false),
                (Loc.Get("Relations"), DisplayFormat.Number(board?.Relations.Count ?? 0), false),
                (Loc.Get("OutOfScope"), DisplayFormat.Number(outOfScope), outOfScope > 0)
            ];
        }
    }

    private string ProjectionCaption => Mode switch
    {
        BoardViewMode.Stories => Loc.Get("StoriesCaption"),
        BoardViewMode.Tasks => Loc.Get("TasksCaption"),
        _ => Loc.Get("CombinedCaption")
    };

    /// <summary>
    /// Applies one board drop: the board reports the card and the stage it landed in, so exactly one
    /// request goes out and the optimistic revision comes from the current snapshot.
    /// </summary>
    private async Task MoveCardAsync(CardKind kind, BoardCardMove move)
    {
        if (State.Board is not { } board)
        {
            return;
        }

        var card = board.Cards.FirstOrDefault(item =>
            item.Kind == kind && StringComparer.Ordinal.Equals(item.Reference.CardId, move.CardId));
        if (card is null)
        {
            return;
        }

        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/cards/{Uri.EscapeDataString(card.Reference.CardId)}/stage",
                new MoveCardRequest(move.StageId, card.Revision),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            await State.LoadBoardAsync();
        }
        catch (Exception exception)
        {
            await State.ReportErrorAsync(
                Loc.Format("MoveFailed", card.Reference.CardId, FailureText.Describe(exception)));
            await State.LoadBoardAsync();
        }
    }
}
