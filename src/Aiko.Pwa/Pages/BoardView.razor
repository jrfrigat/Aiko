@* The board: the type filter, the metric strip, the create form and one section per card type in scope.
   The sections are derived from the project's workflows, so a type the user adds appears here without a
   code change, and the filter narrows the same page instead of being a route of its own. *@
@using Aiko.Domain.Execution
@inject HttpClient Http
@inject WorkspaceState State
@implements IAsyncDisposable
@inject NavigationManager Navigation

@if (State.Board is not { } board)
{
    <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("BoardUnavailable")</FlareAlert>
}
else
{
    <FlareStack Gap="FlareSpacing.Medium">
        @* The board's two filters, as groups of toggle buttons rather than a menu with a caption: every type
           is one press away, and the answer filter sits beside them. Pressing nothing in the type group shows
           every type - the absence of a filter is the board's own combined view - while the answer group
           always has one of its two options on. FlareButtonGroup takes no AriaLabel of its own, so each
           group's accessible name rides on the group's element. *@
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
            <FlareButtonGroup Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Text"
                              Collapsible="true"
                              Class="aiko-segment"
                              AdditionalAttributes="@TypeFilterAttributes">
                @foreach (var workflow in TypeChoices)
                {
                    var option = workflow;
                    <FlareToggleButton Toggled="@IsPicked(option)"
                                       ToggledChanged="@(toggled => SetKindAsync(option, toggled))"
                                       AriaLabel="@option.Title">
                        @* The count sits beside the name as v3 draws it, in the design's mono chip. It is not
                           part of the accessible name: the button still announces the type alone. *@
                        <ChildContent>
                            <span class="aiko-filter__count">
                                @option.Title
                                <span class="aiko-tag aiko-tag--quiet">@CountFor(option)</span>
                            </span>
                        </ChildContent>
                    </FlareToggleButton>
                }
            </FlareButtonGroup>
            @* The view the board is in: the work, or the history beside it. The answer filter belongs to the
               work and steps aside in the archive, while the type filter stays - it asks about a card's type,
               which the archive has as much as the board does. *@
            @if (!ArchiveOnly)
            {
                <FlareButtonGroup Connected="true"
                                  Size="ButtonSize.Sm"
                                  Variant="ButtonVariant.Text"
                                  Class="aiko-segment"
                                  AdditionalAttributes="@WaitingFilterAttributes">
                    <FlareToggleButton Toggled="@(!WaitingOnly)"
                                       ToggledChanged="@(_ => SelectWaitingAsync(waitingOnly: false))"
                                       AriaLabel="@Loc.Get("BoardWaitingFilterAll")">
                        <ChildContent>@Loc.Get("BoardWaitingFilterAll")</ChildContent>
                    </FlareToggleButton>
                    <FlareToggleButton Toggled="@WaitingOnly"
                                       ToggledChanged="@(_ => SelectWaitingAsync(waitingOnly: true))"
                                       AriaLabel="@Loc.Get("BoardWaitingFilterWaiting")">
                        <ChildContent>@Loc.Get("BoardWaitingFilterWaiting")</ChildContent>
                    </FlareToggleButton>
                </FlareButtonGroup>
            }
            <FlareButtonGroup Connected="true"
                              Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Text"
                              Class="aiko-segment"
                              AdditionalAttributes="@ModeFilterAttributes">
                <FlareToggleButton Toggled="@(!ArchiveOnly)"
                                   ToggledChanged="@(_ => SelectArchiveAsync(archiveOnly: false))"
                                   AriaLabel="@Loc.Get("BoardModeBoard")">
                    <ChildContent>@Loc.Get("BoardModeBoard")</ChildContent>
                </FlareToggleButton>
                <FlareToggleButton Toggled="@ArchiveOnly"
                                   ToggledChanged="@(_ => SelectArchiveAsync(archiveOnly: true))"
                                   AriaLabel="@Loc.Get("BoardModeArchive")">
                    <ChildContent>@Loc.Get("BoardModeArchive")</ChildContent>
                </FlareToggleButton>
            </FlareButtonGroup>
            @* The size the board is narrowed to, as the design's own segment of mono pills: one press per step, the
               first one meaning every size. It stands beside the view it narrows. *@
            <FlareButtonGroup Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Text"
                              Collapsible="true"
                              Class="aiko-segment"
                              AdditionalAttributes="@SizeFilterAttributes">
                <FlareToggleButton Toggled="@(_sizeFilter is null)"
                                   ToggledChanged="@(toggled => OnAllSizes(toggled))"
                                   AriaLabel="@Loc.Get("BoardWaitingFilterAll")">
                    <ChildContent>@Loc.Get("BoardWaitingFilterAll")</ChildContent>
                </FlareToggleButton>
                @foreach (var size in SizeChoices)
                {
                    var choice = size;
                    <FlareToggleButton Toggled="@IsSizePicked(choice)"
                                       ToggledChanged="@(toggled => OnSizePicked(choice, toggled))"
                                       AriaLabel="@choice">
                        <ChildContent>@choice</ChildContent>
                    </FlareToggleButton>
                }
            </FlareButtonGroup>
            @* The order the cards inside a column run in: one dropdown that names the order it holds and takes it
               from the same state the columns are drawn with. *@
            <AikoSelectField Class="aiko-sort"
                             Value="@SortChoice"
                             ValueChanged="@(choice => _sortAscending = string.Equals(choice, SortAscendingChoice, StringComparison.Ordinal))"
                             Items="@SortChoices"
                             ItemLabel="@SortOptionLabel"
                             SelectedTemplate="@SortSelected"
                             AriaLabel="@Loc.Get("BoardSort")" />
        </FlareStack>

        @* Everything below this line describes the work: the numbers, the request to run the board, the runs in
           flight and the columns themselves. None of it belongs to the archive, so the whole block steps aside
           when the archive is what is being looked at - a counter of work above a list of finished cards would
           be a number nobody asked about. *@
        @if (!ArchiveOnly)
        {

        @* The design's metric strip: a mono summary line, not a row of tiles. A tile may carry one slice of
           its own number underneath - the backlog is a reading of the card count, not a metric of its own -
           which is also why the strip aligns on the top edge: the numbers stay on one line while a slice
           hangs below its own. *@
        <FlareStack Row="true" Align="FlareAlignItems.Start" Gap="FlareSpacing.XSmall" Wrap="true" Class="aiko-metrics">
            @foreach (var tile in SummaryTiles)
            {
                <FlareStack Gap="FlareSpacing.XXSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">@tile.Label</FlareText>
                        <FlareText Element="span" Mono="true"
                                   Color="@(tile.Warn ? FlareColor.Error : FlareColor.Tertiary)"
                                   Weight="FontWeight.SemiBold">@tile.Value</FlareText>
                    </FlareStack>
                    @if (tile.Slice is { Length: > 0 } slice)
                    {
                        <FlareText Element="span" Mono="true"
                                   Typo="TypographyScale.LabelSmall"
                                   Color="FlareColor.OnSurfaceVariant2">@slice</FlareText>
                    }
                </FlareStack>
            }
        </FlareStack>

        <FlareStack Row="true" Gap="FlareSpacing.XSmall" Class="aiko-actions">
            <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm" OnClick="OpenNewCard">
                <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                <ChildContent>@Loc.Get("CreateCard")</ChildContent>
            </FlareButton>
            @* The board's own button: Aiko cannot start an agent, so this places the request in the project's
               command queue and the state below says what became of it. An agent that runs takes it and walks
               the board by the /aiko-run-all procedure. *@
            <FlareButton Variant="ButtonVariant.Text"
                         Size="ButtonSize.Sm"
                         Disabled="@(BoardCommand is not null || _placingBoardRun)"
                         Loading="@_placingBoardRun"
                         OnClick="RunBoardAsync">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.PlayArrow" /></LeadingIcon>
                <ChildContent>@Loc.Get("RunBoard")</ChildContent>
            </FlareButton>
        </FlareStack>

        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
            @Loc.Get("RunBoardHint")
        </FlareText>

        @if (BoardCommand is { } boardPass)
        {
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                <FlareText Element="span" Mono="true" Typo="TypographyScale.BodySmall">@boardPass.Id</FlareText>
                <span class="aiko-tag @BoardCommandBadgeClass(boardPass)">@BoardCommandStateCaption(boardPass)</span>
                @if (boardPass.Message is { Length: > 0 } boardPassMessage)
                {
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @boardPassMessage
                    </FlareText>
                }
            </FlareStack>
        }
        else if (_boardMessage is { Length: > 0 } boardMessage)
        {
            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                @boardMessage
            </FlareText>
        }

        @* What the project is working on right now. The board's own stage runs say which (card, stage) pairs
           are unfinished, so the panel finds them without walking the cards; a card is asked for the details
           of its active run alone. A row opens the card, so the address stays shareable. *@
        <FlarePaper Class="aiko-tile">
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Element="span" Typo="TypographyScale.TitleSmall">@Loc.Get("ActiveRunsTitle")</FlareText>
                @if (_activeRuns.Count == 0)
                {
                    <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("ActiveRunsNone")
                    </FlareText>
                }
                else
                {
                    @foreach (var run in _activeRuns)
                    {
                        var row = run;
                        // Resolved on every render, so a stage whose icon or colour was just edited shows it at once.
                        var rowStage = StageAppearance.Find(State.Board?.Workflows, row.WorkflowId, row.StageId);
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                            <FlareButton Variant="ButtonVariant.Text" OnClick="() => OpenCard(row.CardId)">
                                <ChildContent>@row.Title</ChildContent>
                            </FlareButton>
                            <FlareBadge Standalone="true" Text="@row.State" Color="FlareColor.Tertiary" />
                            @* The stage as the card page names and draws it: its title, its icon and its colour. *@
                            <span class="aiko-tag aiko-tag--quiet" style="@StageAppearance.TagStyle(rowStage)">
                                @if (StageAppearance.Icon(rowStage) is { } runStageIcon)
                                {
                                    <FlareIconView Value="runStageIcon" Size="1em" />
                                }
                                @StageAppearance.Caption(rowStage, row.StageId)
                            </span>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @($"{row.Agent} · {row.UpdatedAt:yyyy-MM-dd HH:mm}")
                            </FlareText>
                        </FlareStack>
                    }
                }
            </FlareStack>
        </FlarePaper>

        <FlareDivider />

        // Inside the view block above these are statements, not Razor transitions.
        var rendered = false;
        foreach (var section in Sections)
        {
            var current = section;
            if (rendered)
            {
                <FlareDivider />
            }
            rendered = true;
            <BoardSection Title="@current.Title"
                          Kind="@current.CardType"
                          Board="board"
                          VisibleCardIds="@VisibleCardIds"
                          SizeGrid="@(State.SettingsView?.EffectivePriority.Grid ?? [])"
                          SortAscending="@_sortAscending"
                          OnCardMoved="move => MoveCardAsync(current.CardType, move)" />
        }

        }

        @* The archive: what the board no longer counts, drawn so a person can see what is in it and take a card
           back. The list is the snapshot's own second collection, so nothing is asked for twice, and the type
           filter above narrows it exactly as it narrows the columns. *@
        @if (ArchiveOnly)
        {
            <FlarePaper Class="aiko-tile">
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                        <FlareText Element="span" Typo="TypographyScale.TitleSmall">@Loc.Get("ArchiveTitle")</FlareText>
                        <span class="aiko-tag aiko-tag--pill">@ArchivedCards.Count</span>
                    </FlareStack>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("ArchiveHint")
                    </FlareText>
                    @if (ArchivedCards.Count == 0)
                    {
                        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("ArchiveEmpty")
                        </FlareText>
                    }
                    else
                    {
                        @foreach (var archived in ArchivedCards)
                        {
                            var row = archived;
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap="true">
                                <FlareNavLink Href="@ProjectRoutes.Card(ProjectId, row.Reference.CardId)">
                                    <ChildContent>
                                        <FlareText Element="span" Mono="true" Color="FlareColor.Secondary" Weight="FontWeight.SemiBold">
                                            @row.Reference.CardId
                                        </FlareText>
                                    </ChildContent>
                                </FlareNavLink>
                                <span class="aiko-tag aiko-tag--quiet">@row.Kind</span>
                                <FlareText Element="span" Typo="TypographyScale.BodyMedium">@row.Title</FlareText>
                                <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">
                                    @ArchiveMeta(row)
                                </FlareText>
                                <FlareButton Variant="ButtonVariant.Text"
                                             Size="ButtonSize.Sm"
                                             Disabled="@_restoring"
                                             OnClick="() => RestoreCardAsync(row)">
                                    <ChildContent>@Loc.Get("ArchiveRestore")</ChildContent>
                                </FlareButton>
                            </FlareStack>
                        }
                    }
                </FlareStack>
            </FlarePaper>
        }
    </FlareStack>
}

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private async Task OnStateChanged()
    {
        // The active panel is part of the live picture too: a card that starts or finishes while the board is
        // open must appear in it or leave it without a reload.
        await EnsureActiveRunsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private bool _placingBoardRun;
    private string? _boardMessage;

    /// <summary>
    /// The project's most recent request to work the board, open or closed: what the button placed and what
    /// became of it.
    /// </summary>
    /// <remarks>
    /// Read from the queue rather than remembered here, for the same reason the card page does it: the queue
    /// is the one place that knows whether an agent took the request, so a screen that kept its own answer
    /// would be a second one. The queue arrives oldest first, so the last board pass is the newest.
    /// </remarks>
    private CardCommand? BoardCommand => State.Commands
        .LastOrDefault(command => command.Action is CardCommandAction.RunBoard);

    /// <summary>How the queue's state of the pass reads on the board.</summary>
    private static string BoardCommandStateCaption(CardCommand command) => command.State switch
    {
        CardCommandState.Queued => Loc.Get("CommandWaiting"),
        CardCommandState.Taken => Loc.Get("CommandTaken"),
        CardCommandState.Completed => Loc.Get("CommandDone"),
        CardCommandState.Failed => Loc.Get("CommandRefused"),
        _ => Loc.Get("CommandWithdrawn")
    };

    /// <summary>Tone of the pass's badge: the same reading as the card page gives a command.</summary>
    private static string BoardCommandBadgeClass(CardCommand command) => command.State switch
    {
        CardCommandState.Taken => "aiko-tag--live",
        CardCommandState.Completed => "aiko-tag--accent",
        CardCommandState.Failed => "aiko-tag--warn",
        _ => "aiko-tag--quiet"
    };

    /// <summary>
    /// Asks an agent to work the board.
    /// </summary>
    /// <remarks>
    /// No card and no agent are named: this is a request for the project, and any agent that runs may take
    /// it. Nothing is started here - Aiko does not run agents - so the screen's job ends at placing the
    /// command and showing what the queue says about it.
    /// </remarks>
    private async Task RunBoardAsync()
    {
        if (_placingBoardRun || BoardCommand is not null)
        {
            return;
        }

        _placingBoardRun = true;
        _boardMessage = null;
        try
        {
            var placed = await State.PlaceCommandAsync(
                new PlaceCommandRequest(null, CardCommandAction.RunBoard));
            _boardMessage = placed is null
                ? State.Error ?? Loc.Get("CommandFailed")
                : Loc.Format("CommandPlaced", placed.Id);
        }
        finally
        {
            _placingBoardRun = false;
        }
    }

    public ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        return ValueTask.CompletedTask;
    }

    /// <summary>The project id from the route.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = string.Empty;

    /// <summary>
    /// The card types the board is filtered to. Empty means no filter at all - every type is drawn, which is
    /// what pressing nothing in the group says.
    /// </summary>
    private readonly HashSet<string> _pickedKinds = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Whether the board shows only the cards that wait for an answer from the person.</summary>
    private bool WaitingOnly { get; set; }

    /// <summary>The size the board is narrowed to, or null for every size.</summary>
    private string? _sizeFilter;

    /// <summary>Whether the tool row asks for the lowest priority first.</summary>
    private bool _sortAscending;

    /// <summary>The direction the sort dropdown holds when it asks for the lowest priority first.</summary>
    private const string SortAscendingChoice = "asc";

    /// <summary>The other direction, which is what an untouched board asks for.</summary>
    private const string SortDescendingChoice = "desc";

    /// <summary>The two directions the dropdown offers, in the order it draws them.</summary>
    private IReadOnlyList<string> SortChoices => [SortDescendingChoice, SortAscendingChoice];

    /// <summary>The direction the control shows, mirrored from the one the columns are drawn with.</summary>
    private string SortChoice => _sortAscending ? SortAscendingChoice : SortDescendingChoice;

    /// <summary>How one direction reads, in the list and in the closed control.</summary>
    private string SortOptionLabel(string choice) =>
        Loc.Get(StringComparer.Ordinal.Equals(choice, SortAscendingChoice)
            ? "BoardSortAscending"
            : "BoardSortDescending");

    /// <summary>Whether the size segment currently holds this step.</summary>
    private bool IsSizePicked(string size) =>
        StringComparer.OrdinalIgnoreCase.Equals(_sizeFilter, size);

    /// <summary>
    /// Picks a size. A collapsible group reports the clearing of the previous choice and the taking of the new one
    /// as two calls, and their order is not ours to decide - so a step clears the filter only when that filter is
    /// its own, and never clears a choice another step has just made.
    /// </summary>
    private void OnSizePicked(string size, bool toggled)
    {
        if (toggled)
        {
            _sizeFilter = size;
        }
        else if (IsSizePicked(size))
        {
            _sizeFilter = null;
        }
    }

    /// <summary>
    /// Whether every size is shown again. Only taking this choice means it: its clearing is another step taking
    /// the segment, not a reason to widen the board back.
    /// </summary>
    private void OnAllSizes(bool toggled)
    {
        if (toggled)
        {
            _sizeFilter = null;
        }
    }

    /// <summary>
    /// What the closed dropdown draws: the design's sort sign and the order it holds, so the reader sees the
    /// axis and its direction without opening anything.
    /// </summary>
    private RenderFragment<string> SortSelected => choice => @<span class="aiko-sort__value">
        <FlareIconView Value="@MaterialDesign3Icons.Regular.Sort" />
        @Loc.Get("BoardSort"): @SortOptionLabel(choice)
    </span>;

    /// <summary>
    /// The size codes the tool row offers: the project's own grid, so a project that reshapes its ladder gets
    /// the new steps without the board learning their names.
    /// </summary>
    private IReadOnlyList<string> SizeChoices =>
        (State.SettingsView?.EffectivePriority.Grid ?? [])
            .Select(step => step.Id)
            .OfType<string>()
            .Where(id => id.Length > 0)
            .ToArray();

    /// <summary>
    /// The cards the answer filter leaves: the ones whose latest run waits for a user and whose feed's last
    /// word is an agent's. Rebuilt from the runs and feeds the board reads, never guessed.
    /// </summary>
    private HashSet<string> _waitingCards = new(StringComparer.Ordinal);

    /// <summary>Whether the board is showing a subset of the project's card types.</summary>
    private bool IsFiltered => _pickedKinds.Count > 0;

    /// <summary>
    /// The card types the board may show, from the project's own workflows: a type is a workflow, so a
    /// type the user adds gets its own button without the board knowing its name.
    /// </summary>
    private IReadOnlyList<WorkflowDefinition> TypeChoices =>
        State.Board?.Workflows.OrderBy(workflow => workflow.Title, StringComparer.Ordinal).ToArray() ?? [];

    private bool IsPicked(WorkflowDefinition type) => _pickedKinds.Contains(type.CardType);

    /// <summary>
    /// Sets one type's place in the filter from what the button reports rather than flipping it: the button
    /// says whether it is on, so a click arriving twice cannot leave the two out of step.
    /// </summary>
    private Task SetKindAsync(WorkflowDefinition type, bool picked)
    {
        if (picked)
        {
            _pickedKinds.Add(type.CardType);
        }
        else
        {
            _pickedKinds.Remove(type.CardType);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The answer filter's choice. The group is a pair of options, so the pressed one decides: a press cannot
    /// turn the pair off, which is what keeps the board from having a third, unnamed state.
    /// </summary>
    private Task SelectWaitingAsync(bool waitingOnly)
    {
        WaitingOnly = waitingOnly;
        return Task.CompletedTask;
    }

    /// <summary>The type group's accessible name, on the group's own element: Flare takes no AriaLabel here.</summary>
    private IReadOnlyDictionary<string, object> TypeFilterAttributes =>
        new Dictionary<string, object>(StringComparer.Ordinal) { ["aria-label"] = Loc.Get("BoardTypesFilter") };

    /// <summary>The answer group's accessible name.</summary>
    private IReadOnlyDictionary<string, object> WaitingFilterAttributes =>
        new Dictionary<string, object>(StringComparer.Ordinal) { ["aria-label"] = Loc.Get("BoardWaitingFilter") };

    /// <summary>The mode group's accessible name.</summary>
    private IReadOnlyDictionary<string, object> ModeFilterAttributes =>
        new Dictionary<string, object>(StringComparer.Ordinal) { ["aria-label"] = Loc.Get("BoardModeFilter") };

    /// <summary>The size segment's accessible name, on the group's own element.</summary>
    private IReadOnlyDictionary<string, object> SizeFilterAttributes =>
        new Dictionary<string, object>(StringComparer.Ordinal) { ["aria-label"] = Loc.Get("BoardFilterSize") };

    /// <summary>Whether the board is showing the archive instead of the work.</summary>
    private bool ArchiveOnly { get; set; }

    /// <summary>Whether a card is being brought back, so the button that asked cannot be pressed twice.</summary>
    private bool _restoring;

    /// <summary>
    /// The view's choice. Switching to the archive drops the answer filter, which is a fact about work: a card
    /// in the archive is finished, so it is waiting for nobody.
    /// </summary>
    private Task SelectArchiveAsync(bool archiveOnly)
    {
        ArchiveOnly = archiveOnly;
        if (archiveOnly)
        {
            WaitingOnly = false;
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The archive as the board shows it: the snapshot's own second collection, narrowed by the type filter when
    /// one is on, so the two views answer the same question about types. A snapshot that says nothing about the
    /// archive - an older daemon - reads as an empty one.
    /// </summary>
    private IReadOnlyList<Card> ArchivedCards =>
        (State.Board?.ArchivedCards ?? [])
        .Where(card => !IsFiltered || _pickedKinds.Contains(card.Kind))
        .OrderBy(card => card.Reference.CardId, StringComparer.Ordinal)
        .ToArray();

    /// <summary>
    /// What the archive row says about where the card came from: the stage it was put away in, by its own
    /// workflow's name for it, and when that was.
    /// </summary>
    private string ArchiveMeta(Card card) =>
        $"{StageTitle(card)} · {Loc.Format("ArchiveWhen", ArchivedAtText(card))}";

    /// <summary>A stage's own title, or its id when the project no longer has that workflow or stage.</summary>
    private string StageTitle(Card card)
    {
        var workflow = (State.Board?.Workflows ?? [])
            .FirstOrDefault(candidate => StringComparer.Ordinal.Equals(candidate.Id, card.WorkflowId));
        return workflow?.Stages
            .FirstOrDefault(stage => StringComparer.Ordinal.Equals(stage.Id, card.StageId))
            ?.Title ?? card.StageId;
    }

    /// <summary>
    /// When the card was put away. An unreadable mark still means the card is in the archive, so the row says
    /// that rather than leaving an empty place where a moment should be.
    /// </summary>
    private string ArchivedAtText(Card card) =>
        card.ArchivedAt is { } at
            ? at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : Loc.Get("ArchiveWhenUnknown");

    /// <summary>
    /// Brings a card back from the archive: one request, with the revision the snapshot carries, and then the
    /// board is read again. A failure is reported the way a failed move is, and the board is reloaded either
    /// way, so the screen never claims something the daemon refused.
    /// </summary>
    private async Task RestoreCardAsync(Card card)
    {
        if (State.Board is not { } board || _restoring)
        {
            return;
        }

        _restoring = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/cards/{Uri.EscapeDataString(card.Reference.CardId)}/archive",
                new ArchiveCardRequest(Archived: false, card.Revision),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
        }
        catch (Exception exception)
        {
            await State.ReportErrorAsync(
                Loc.Format("ArchiveFailed", card.Reference.CardId, FailureText.Describe(exception)));
        }
        finally
        {
            _restoring = false;
            await State.LoadBoardAsync();
        }
    }

    /// <summary>The route opens the project; the board itself has no other state of its own.</summary>
    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        await EnsureActiveRunsAsync();
    }

    /// <summary>The states that mean a run is not finished, which is what the active panel lists.</summary>
    private static readonly HashSet<string> ActiveRunStates =
        new(StringComparer.OrdinalIgnoreCase) { "Running", "Paused", "WaitingForUser", "NeedsAttention" };

    /// <summary>One row of the active panel: where the project is working right now.</summary>
    private sealed record ActiveRun(
        string CardId,
        string Title,
        string StageId,
        string? WorkflowId,
        string State,
        string Agent,
        DateTimeOffset UpdatedAt);

    private IReadOnlyList<ActiveRun> _activeRuns = [];

    /// <summary>The active set the panel was last built from, so a refresh that changed nothing reads nothing.</summary>
    private string _activeRunsSignature = string.Empty;

    /// <summary>
    /// Reads which runs the project is working on and what each one is doing. The board's own stage runs say
    /// which (card, stage) pairs are unfinished, so nothing is asked about the cards that are not; a card is
    /// read only when it carries one of those runs.
    /// </summary>
    private async Task EnsureActiveRunsAsync()
    {
        if (State.Board is not { } board)
        {
            _activeRuns = [];
            _activeRunsSignature = string.Empty;
            _waitingCards = [];
            return;
        }

        var active = (board.StageRuns ?? [])
            .Where(run => ActiveRunStates.Contains(run.State))
            .OrderBy(run => run.CardId, StringComparer.Ordinal)
            .ToArray();
        var signature = string.Join('|', active.Select(run => $"{run.CardId}:{run.StageId}:{run.State}"));
        if (!string.Equals(signature, _activeRunsSignature, StringComparison.Ordinal))
        {
            // The signature is remembered before the reads: a refresh arriving while the panel is loading must
            // not start a second round of the same requests.
            _activeRunsSignature = signature;
            var rows = new List<ActiveRun>();
            foreach (var run in active)
            {
                var execution = await FindExecutionAsync(run.CardId, run.StageId);
                if (execution is null)
                {
                    continue;
                }

                var card = board.Cards.FirstOrDefault(item =>
                    StringComparer.Ordinal.Equals(item.Reference.CardId, run.CardId));
                rows.Add(new ActiveRun(
                    run.CardId,
                    card?.Title ?? run.CardId,
                    run.StageId,
                    card?.WorkflowId,
                    execution.State.ToString(),
                    execution.Attempts.LastOrDefault()?.AgentAdapterId ?? Loc.Get("ActiveRunsNoAgent"),
                    execution.UpdatedAt));
            }

            _activeRuns = rows;
        }

        // The answer filter is read on every pass rather than only when the runs changed: its other half is
        // the feed, whose last word can change without any run changing.
        await RefreshWaitingCardsAsync();
    }

    /// <summary>
    /// Rebuilds the set the answer filter shows: the cards whose latest run waits for a user and whose feed's
    /// last word is an agent's.
    /// </summary>
    /// <remarks>
    /// Only those cards' feeds are read, so the cost follows the number of cards waiting for a person rather
    /// than the size of the board. A card whose notes cannot be read is left out of the selection instead of
    /// breaking the screen.
    /// </remarks>
    private async Task RefreshWaitingCardsAsync()
    {
        var waiting = new HashSet<string>(StringComparer.Ordinal);
        foreach (var run in _activeRuns.Where(run => BoardWaiting.IsWaitingForUser(run.State)))
        {
            if (BoardWaiting.AwaitsAnswer(run.State, await LoadDiscussionAsync(run.CardId)))
            {
                waiting.Add(run.CardId);
            }
        }

        _waitingCards = waiting;
    }

    /// <summary>One card's feed, or null when it cannot be read.</summary>
    private async Task<IReadOnlyList<CardComment>?> LoadDiscussionAsync(string cardId)
    {
        try
        {
            return await Http.GetFromJsonAsync<IReadOnlyList<CardComment>>(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/cards/{Uri.EscapeDataString(cardId)}/discussion",
                PwaJson.Options);
        }
        catch (Exception)
        {
            return null;
        }
    }

    /// <summary>
    /// The latest run of one stage of one card. A card whose history cannot be read is left out rather than
    /// breaking the panel: the board is still usable when one card's runs are not.
    /// </summary>
    private async Task<StageExecution?> FindExecutionAsync(string cardId, string stageId)
    {
        try
        {
            var executions = await Http.GetFromJsonAsync<IReadOnlyList<StageExecution>>(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/cards/{Uri.EscapeDataString(cardId)}/executions",
                PwaJson.Options);
            return executions?
                .Where(item => StringComparer.Ordinal.Equals(item.StageId, stageId))
                .OrderByDescending(item => item.UpdatedAt)
                .FirstOrDefault();
        }
        catch (Exception)
        {
            return null;
        }
    }

    /// <summary>Creating a card is its own page: the board only links to it.</summary>
    private void OpenNewCard() => Navigation.NavigateTo(ProjectRoutes.NewCard(ProjectId));

    /// <summary>A card is its own page too, so a card can be linked, reloaded and shared.</summary>
    private void OpenCard(string cardId) =>
        Navigation.NavigateTo(ProjectRoutes.Card(ProjectId, cardId));

    /// <summary>
    /// The card types in scope, taken from the project's own workflows: a section exists because a workflow
    /// exists, so a type the user adds is drawn here without the board knowing its name.
    /// </summary>
    private IReadOnlyList<WorkflowDefinition> Sections => TypeChoices
        .Where(type => !IsFiltered || IsPicked(type))
        .ToArray();

    /// <summary>
    /// The cards the board is showing: the types the filter picked, the size it is narrowed to, and - when the
    /// answer filter is on - only those that wait for the person.
    /// </summary>
    private IReadOnlyList<Card> VisibleCards => State.Board?.Cards
        .Where(card => (!IsFiltered || _pickedKinds.Contains(card.Kind)) &&
                       (!WaitingOnly || _waitingCards.Contains(card.Reference.CardId)) &&
                       (_sizeFilter is null ||
                        StringComparer.OrdinalIgnoreCase.Equals(card.Size, _sizeFilter)))
        .ToArray() ?? [];

    /// <summary>
    /// The cards the sections may draw, or null when nothing is filtered: a section reads the board itself, so
    /// it has to be told which of its cards the board is showing. Every filter that narrows the columns counts
    /// here - the size one included, or the columns would draw cards the rest of the screen has left out.
    /// </summary>
    private IReadOnlySet<string>? VisibleCardIds =>
        IsFiltered || WaitingOnly || _sizeFilter is not null
            ? VisibleCards.Select(card => card.Reference.CardId).ToHashSet(StringComparer.Ordinal)
            : null;

    /// <summary>
    /// How much of one type the board is showing - the number v3 draws beside a type's name.
    /// </summary>
    /// <remarks>
    /// Counted over <see cref="VisibleCards"/>, the same set the metric strip counts, so a counter can never
    /// contradict the total beside it. A type the filter left out therefore reads as zero, which is the honest
    /// answer to "how much of this type is on the board now"; counting the unfiltered board instead would put a
    /// number on a filter that shows none of it.
    /// </remarks>
    private int CountFor(WorkflowDefinition type) =>
        VisibleCards.Count(card => StringComparer.OrdinalIgnoreCase.Equals(card.Kind, type.Id));

    /// <summary>
    /// The four board metrics, as the design's mono summary line. A tile carries at most one slice of its
    /// own number: the card count says how many cards the board is showing and how many of those are still
    /// waiting in the backlog - the same set, read twice.
    /// </summary>
    private IReadOnlyList<(string Label, string Value, bool Warn, string? Slice)> SummaryTiles
    {
        get
        {
            var board = State.Board;
            var outOfScope = BoardMetrics.OutOfScopeCount(board);
            var visible = VisibleCards;
            return
            [
                (Loc.Get("Cards"), DisplayFormat.Number(visible.Count), false,
                    Loc.Format("BacklogSlice", DisplayFormat.Number(BoardMetrics.BacklogCount(visible)))),
                (Loc.Get("InProgress"), DisplayFormat.Number(BoardMetrics.InProgressCount(board)), false, null),
                (Loc.Get("Relations"), DisplayFormat.Number(board?.Relations.Count ?? 0), false, null),
                (Loc.Get("OutOfScope"), DisplayFormat.Number(outOfScope), outOfScope > 0, null)
            ];
        }
    }

    /// <summary>
    /// Applies one board drop: the board reports the card and the stage it landed in, so exactly one
    /// request goes out and the optimistic revision comes from the current snapshot.
    /// </summary>
    private async Task MoveCardAsync(string kind, BoardCardMove move)
    {
        if (State.Board is not { } board)
        {
            return;
        }

        var card = board.Cards.FirstOrDefault(item =>
            StringComparer.OrdinalIgnoreCase.Equals(item.Kind, kind) &&
            StringComparer.Ordinal.Equals(item.Reference.CardId, move.CardId));
        if (card is null)
        {
            return;
        }

        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/cards/{Uri.EscapeDataString(card.Reference.CardId)}/stage",
                new MoveCardRequest(move.StageId, card.Revision),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            await State.LoadBoardAsync();
        }
        catch (Exception exception)
        {
            await State.ReportErrorAsync(
                Loc.Format("MoveFailed", card.Reference.CardId, FailureText.Describe(exception)));
            await State.LoadBoardAsync();
        }
    }
}
