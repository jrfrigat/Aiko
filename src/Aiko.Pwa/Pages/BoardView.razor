@* One board screen, shared by every card-type route: the projection switch, the metric strip, the create
   form and one section per card type in scope. The routes differ only by KindFilter, and the sections are
   derived from the project's workflows, so a type the user adds appears here without a code change. *@
@inject HttpClient Http
@inject WorkspaceState State
@inject NavigationManager Navigation

@if (State.Board is not { } board)
{
    <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("BoardUnavailable")</FlareAlert>
}
else
{
    <FlareStack Gap="FlareSpacing.Medium">
        @* Which cards the board shows, as the design's filter row does it: one control, a projection per
           card type, and the route follows the choice so the rail, the back button and the address bar
           agree. *@
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
            <FlareToggleGroup TValue="string"
                              Size="ButtonSize.Sm"
                              Value="@ProjectionKey"
                              ValueChanged="ChangeProjectionAsync">
                <FlareToggleButton Variant="ButtonVariant.Filled" Value="@string.Empty">@Loc.Get("CombinedNav")</FlareToggleButton>
                @foreach (var workflow in board.Workflows.OrderBy(item => item.Title, StringComparer.Ordinal))
                {
                    var option = workflow;
                    <FlareToggleButton Variant="ButtonVariant.Filled" Value="@option.Id">@option.Title</FlareToggleButton>
                }
            </FlareToggleGroup>
            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@ProjectionCaption</FlareText>
        </FlareStack>

        @* The design's metric strip: a mono summary line, not a row of tiles. *@
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true" Class="aiko-metrics">
            @foreach (var tile in SummaryTiles)
            {
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">@tile.Label</FlareText>
                    <FlareText Element="span" Mono="true"
                               Color="@(tile.Warn ? FlareColor.Error : FlareColor.Tertiary)"
                               Weight="FontWeight.SemiBold">@tile.Value</FlareText>
                </FlareStack>
            }
        </FlareStack>

        @if (BoardMetrics.IsParallelShared(State.SettingsView?.EffectiveExecution))
        {
            <FlareAlert Severity="AlertSeverity.Warning"
                        Variant="AlertVariant.Outlined"
                        Title="@Loc.Get("ParallelSharedTitle")">@Loc.Get("ParallelSharedText")</FlareAlert>
        }

        <FlareStack Row="true" Gap="FlareSpacing.XSmall">
            <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm" OnClick="OpenNewCard">
                <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                <ChildContent>@Loc.Get("CreateCard")</ChildContent>
            </FlareButton>
        </FlareStack>

        <FlareDivider />

        @{
            var rendered = false;
        }
        @foreach (var section in Sections)
        {
            var current = section;
            if (rendered)
            {
                <FlareDivider />
            }
            rendered = true;
            <BoardSection Title="@current.Title"
                          Kind="@current.CardType"
                          Board="board"
                          OnCardSelected="OpenCard"
                          OnCardMoved="move => MoveCardAsync(current.CardType, move)" />
        }
    </FlareStack>
}

@code {
    /// <summary>
    /// The card type this board draws, or null for every type the project defines.
    /// </summary>
    [Parameter] public string? KindFilter { get; set; }

    /// <summary>
    /// The card types in scope, taken from the project's own workflows: a section exists because a workflow
    /// exists, so a type the user adds is drawn here without the board knowing its name.
    /// </summary>
    private IReadOnlyList<WorkflowDefinition> Sections =>
        State.Board is not { } board
            ? []
            : board.Workflows
                .Where(workflow => KindFilter is null ||
                    StringComparer.OrdinalIgnoreCase.Equals(workflow.CardType, KindFilter))
                .OrderBy(workflow => workflow.Title, StringComparer.Ordinal)
                .ToArray();

    /// <summary>The workflow id the projection switch highlights: empty is "every type".</summary>
    private string ProjectionKey => KindFilter is null ? string.Empty : CardKind.ToWorkflowId(KindFilter);

    /// <summary>The project id from the route.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = string.Empty;

    /// <summary>The route opens the project; the board itself has no other state of its own.</summary>
    protected override async Task OnParametersSetAsync() => await State.EnsureProjectAsync(ProjectId);

    /// <summary>Creating a card is its own page: the board only links to it.</summary>
    private void OpenNewCard() => Navigation.NavigateTo($"{ProjectHref}/cards/new");

    /// <summary>A card is its own page too, so a card can be linked, reloaded and shared.</summary>
    private void OpenCard(string cardId) =>
        Navigation.NavigateTo($"{ProjectHref}/cards/{Uri.EscapeDataString(cardId)}");

    private string ProjectHref => $"/p/{Uri.EscapeDataString(ProjectId)}";

    /// <summary>
    /// The projection switch is a navigation, not local state: the choice becomes the route, so the rail,
    /// the address bar and the back button all agree on which projection is showing. The two built-in types
    /// keep their historical routes; any other type is addressed by its workflow id.
    /// </summary>
    private void ChangeProjectionAsync(string workflowId)
    {
        if (string.IsNullOrEmpty(workflowId))
        {
            Navigation.NavigateTo($"{ProjectHref}/board");
            return;
        }

        var section = workflowId switch
        {
            "story" => "stories",
            "task" => "tasks",
            _ => $"boards/{Uri.EscapeDataString(workflowId)}"
        };
        Navigation.NavigateTo($"{ProjectHref}/{section}");
    }

    private IReadOnlyList<Card> VisibleCards => KindFilter is null
        ? State.Board?.Cards ?? []
        : State.Board?.Cards
            .Where(card => StringComparer.OrdinalIgnoreCase.Equals(card.Kind, KindFilter))
            .ToArray() ?? [];

    /// <summary>The four board metrics, as the design's mono summary line.</summary>
    private IReadOnlyList<(string Label, string Value, bool Warn)> SummaryTiles
    {
        get
        {
            var board = State.Board;
            var outOfScope = BoardMetrics.OutOfScopeCount(board);
            return
            [
                (Loc.Get("Cards"), DisplayFormat.Number(VisibleCards.Count), false),
                (Loc.Get("InProgress"), DisplayFormat.Number(BoardMetrics.InProgressCount(board)), false),
                (Loc.Get("Relations"), DisplayFormat.Number(board?.Relations.Count ?? 0), false),
                (Loc.Get("OutOfScope"), DisplayFormat.Number(outOfScope), outOfScope > 0)
            ];
        }
    }

    /// <summary>
    /// The caption beside the switch: the built-in projections keep their own caption, and any other type
    /// says in the project's words what it is for - which is the description the user wrote when they added it.
    /// </summary>
    private string ProjectionCaption
    {
        get
        {
            if (KindFilter is null)
            {
                return Loc.Get("CombinedCaption");
            }

            if (StringComparer.OrdinalIgnoreCase.Equals(KindFilter, CardKind.Story))
            {
                return Loc.Get("StoriesCaption");
            }

            if (StringComparer.OrdinalIgnoreCase.Equals(KindFilter, CardKind.Task))
            {
                return Loc.Get("TasksCaption");
            }

            var workflow = State.Board?.Workflows.FirstOrDefault(item =>
                StringComparer.OrdinalIgnoreCase.Equals(item.CardType, KindFilter));
            return workflow is { Description.Length: > 0 } ? workflow.Description : workflow?.Title ?? KindFilter;
        }
    }

    /// <summary>
    /// Applies one board drop: the board reports the card and the stage it landed in, so exactly one
    /// request goes out and the optimistic revision comes from the current snapshot.
    /// </summary>
    private async Task MoveCardAsync(string kind, BoardCardMove move)
    {
        if (State.Board is not { } board)
        {
            return;
        }

        var card = board.Cards.FirstOrDefault(item =>
            StringComparer.OrdinalIgnoreCase.Equals(item.Kind, kind) &&
            StringComparer.Ordinal.Equals(item.Reference.CardId, move.CardId));
        if (card is null)
        {
            return;
        }

        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/cards/{Uri.EscapeDataString(card.Reference.CardId)}/stage",
                new MoveCardRequest(move.StageId, card.Revision),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            await State.LoadBoardAsync();
        }
        catch (Exception exception)
        {
            await State.ReportErrorAsync(
                Loc.Format("MoveFailed", card.Reference.CardId, FailureText.Describe(exception)));
            await State.LoadBoardAsync();
        }
    }
}
