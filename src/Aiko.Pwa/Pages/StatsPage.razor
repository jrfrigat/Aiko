@page "/p/{ProjectId}"
@page "/p/{ProjectId}/stats"
@inject HttpClient Http
@inject WorkspaceState State
@implements IAsyncDisposable

@* The project's own page: when it was worked, how fast its pipeline moves, what its board is made of, and
   how its cards are spread across its pipelines. The board snapshot comes from the daemon and the calendar
   and charts from its projections, so this screen cannot disagree with the board it summarises. It answers
   to both routes: the rail links the project root, and /stats keeps working for the deep links and the
   older screens that point at it. *@
<PageTitle>@Loc.Get("ProjectOverviewNav")</PageTitle>

@if (State.Board is not { } board)
{
    <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("BoardUnavailable")</FlareAlert>
}
else
{
    <FlareStack Gap="FlareSpacing.Medium">
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                        Variant="AlertVariant.Outlined">@_message</FlareAlert>
        }

        <FlareStack Row="true" Align="FlareAlignItems.End" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Medium" Wrap="true">
            <FlareStack Gap="FlareSpacing.XXSmall">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                    <span class="aiko-tag aiko-tag--accent">@Loc.Get("ProjectStats")</span>
                    <span class="aiko-tag aiko-tag--quiet" title="@board.Project.RootPath">
                        @board.Project.RootPath
                    </span>
                </FlareStack>
                <FlareText Element="h1" Typo="TypographyScale.HeadlineMedium">@board.Project.Name</FlareText>
                <FlareText Element="p" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                    @Loc.Get("ProjectOverviewHint")
                </FlareText>
            </FlareStack>
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                @* The index is a projection of the files the project owns, so rebuilding it is the one
                   action this screen owns: it re-reads .aiko and answers with what it found. *@
                <FlareButton Variant="ButtonVariant.Tonal"
                             Size="ButtonSize.Sm"
                             Loading="@_reindexing"
                             OnClick="ReindexAsync">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Refresh" /></LeadingIcon>
                    <ChildContent>@Loc.Get("ReindexProject")</ChildContent>
                </FlareButton>
                <FlareNavLink Href="@BoardHref">
                    <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.ViewKanban" /></IconContent>
                    <ChildContent>@Loc.Get("KanbanBoard")</ChildContent>
                </FlareNavLink>
            </FlareStack>
        </FlareStack>

        @* The project's own activity, the same calendar the dashboard draws: the days this project's runs
           and events happened on. It is the first block because it says when the project was worked, not
           just what is in it. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        <span class="aiko-panel__icon aiko-panel__icon--primary">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.CalendarMonth" />
                        </span>
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("ActivityTitle")</FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("ActivityCaption")
                            </FlareText>
                        </FlareStack>
                    </FlareStack>
                    <span class="aiko-tag aiko-tag--quiet">@Loc.Format("ActivityTotal", _activityTotal)</span>
                </FlareStack>
                <ActivityCalendar Days="_activity" />
            </FlareStack>
        </FlarePaper>

        @* The project's history, side by side: how fast the pipeline moves, and what the board is made of.
           Both are FlareChart drawings of the daemon's analytics - a bar per week, and a bar per card type
           and per size step. The category labels sit beside the bars, so a chart says which bar is which
           without a legend. *@
        <div class="aiko-panels--split">
            <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        <span class="aiko-panel__icon aiko-panel__icon--primary">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.TrendingUp" />
                        </span>
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("VelocityTitle")</FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Format("VelocityHint", AnalyticsWindow)
                            </FlareText>
                        </FlareStack>
                    </FlareStack>
                    @if (_analytics is { Weekly.Count: > 0 } velocity)
                    {
                        var weeks = velocity.Weekly.Select(bucket => bucket.Label).ToArray();
                        var closed = AnalyticsCharts.Closures(ClosingStageIds, velocity.Flow, weeks);
                        <FlareChart Type="ChartType.Line"
                                    Data="@AnalyticsCharts.Velocity(velocity.Weekly, closed)"
                                    Description="@Loc.Get("VelocityTitle")"
                                    Height="240"
                                    ShowLegend="true" />
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Format("VelocityTotal", velocity.Weekly.Sum(bucket => bucket.Count))
                            ·
                            @Loc.Format("VelocityClosedTotal", closed.Sum(bucket => bucket.Count))
                        </FlareText>
                    }
                    else
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("VelocityNone")
                        </FlareText>
                    }
                </FlareStack>
            </FlarePaper>

            <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        <span class="aiko-panel__icon aiko-panel__icon--tertiary">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.PieChart" />
                        </span>
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("TriageTitle")</FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("TriageHint")
                            </FlareText>
                        </FlareStack>
                    </FlareStack>
                    @if (_analytics is { ByKind.Count: > 0 } distribution)
                    {
                        <FlareStack Gap="FlareSpacing.XSmall">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">@Loc.Get("CardKind")</FlareText>
                            <FlareChart Type="ChartType.Bar"
                                        Data="@AnalyticsCharts.ByKind(distribution.ByKind, KindLabel)"
                                        Description="@Loc.Get("CardKind")"
                                        Height="@ChartHeight(distribution.ByKind.Count)"
                                        Horizontal="true"
                                        BarWidthRatio="0.55"
                                        ShowLegend="false" />
                        </FlareStack>
                        @if (distribution.BySize.Count > 0)
                        {
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">@Loc.Get("SizeIdLabel")</FlareText>
                                <FlareChart Type="ChartType.Bar"
                                            Data="@AnalyticsCharts.BySize(distribution.BySize, SizeLabel)"
                                            Description="@Loc.Get("SizeIdLabel")"
                                            Height="@ChartHeight(distribution.BySize.Count)"
                                            Horizontal="true"
                                            BarWidthRatio="0.55"
                                            ShowLegend="false" />
                            </FlareStack>
                        }
                    }
                    else
                    {
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("TriageNone")
                        </FlareText>
                    }
                </FlareStack>
            </FlarePaper>
        </div>

        @* The same history read as a stack: how many cards stood in each stage at the end of every week. The
           events say what changed and the board says what is true now, so the counts are walked backwards
           from the board's snapshot - the last week is exact, and older weeks get coarser the shorter the
           history the daemon has seen is. *@
        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Gap="FlareSpacing.None">
                    <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("CfdTitle")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("CfdHint")
                    </FlareText>
                </FlareStack>
                @if (CumulativeFlow is { } cumulative)
                {
                    <FlareChart Type="ChartType.StackedBar"
                                Data="@cumulative"
                                Description="@Loc.Get("CfdTitle")"
                                Height="260"
                                ShowLegend="true" />
                }
                else
                {
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("CfdNone")
                    </FlareText>
                }
            </FlareStack>
        </FlarePaper>

        <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <span class="aiko-panel__icon aiko-panel__icon--tertiary">
                        <FlareIconView Value="@MaterialDesign3Icons.Regular.AccountTree" />
                    </span>
                    <FlareStack Gap="FlareSpacing.None">
                        <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("StageLoad")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("StageLoadHint")
                        </FlareText>
                    </FlareStack>
                </FlareStack>
                @foreach (var workflow in StagesByWorkflow)
                {
                    <FlareStack Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">@workflow.Title</FlareText>
                        @foreach (var row in workflow.Rows)
                        {
                            var stage = row;
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                <span class="aiko-value aiko-value--clip aiko-stage__label">@stage.StageId</span>
                                <span class="aiko-bar"><span class="aiko-bar__fill" style="@($"width: {stage.Share}%")"></span></span>
                                <span class="aiko-tag @(stage.Count == 0 ? "aiko-tag--quiet" : "aiko-tag--accent")">
                                    @DisplayFormat.Number(stage.Count)
                                </span>
                            </FlareStack>
                        }
                    </FlareStack>
                }
            </FlareStack>
        </FlarePaper>

    </FlareStack>
}

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private Task OnStateChanged() => InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        return ValueTask.CompletedTask;
    }

    /// <summary>How many weeks the velocity chart covers.</summary>
    private const int AnalyticsWindow = 8;

    [Parameter] public string ProjectId { get; set; } = string.Empty;

    private ProjectAnalytics? _analytics;
    private IReadOnlyList<ActivityDay> _activity = [];
    private int _activityTotal;
    private bool _reindexing;
    private string? _message;
    private bool _hasError;

    private string BoardHref => ProjectRoutes.Board(ProjectId);

    /// <summary>
    /// Rebuilds the project's index from the files it owns. It is the one write this screen performs, and
    /// it is safe to repeat: the files are the source of truth, the index is what the daemon reads.
    /// </summary>
    private async Task ReindexAsync()
    {
        if (_reindexing)
        {
            return;
        }

        _reindexing = true;
        _message = null;
        try
        {
            using var response = await Http.PostAsync(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/reindex",
                content: null);
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<ReindexResult>(PwaJson.Options);
            _message = result is null
                ? Loc.Get("ReindexDone")
                : Loc.Format("ReindexDoneCounts", result.Cards, result.Relations, result.MemoryDocuments);
            _hasError = false;
            await State.LoadBoardAsync();
        }
        catch (Exception exception)
        {
            _message = Loc.Format("ReindexFailed", FailureText.Describe(exception));
            _hasError = true;
        }
        finally
        {
            _reindexing = false;
        }
    }

    /// <summary>
    /// Cards per stage, workflow by workflow, each stage's bar showing its share of the busiest stage - so
    /// the picture says where work bunches up rather than how large the project is. A stage nobody is in
    /// draws no bar at all.
    /// </summary>
    private IReadOnlyList<(string Title, IReadOnlyList<(string StageId, int Count, int Share)> Rows)> StagesByWorkflow
    {
        get
        {
            if (State.Board is not { } board)
            {
                return [];
            }

            var result = new List<(string, IReadOnlyList<(string, int, int)>)>();
            foreach (var workflow in board.Workflows)
            {
                var counts = workflow.Stages
                    .OrderBy(stage => stage.Order)
                    .Select(stage => (stage.Id, Count: board.Cards.Count(card =>
                        StringComparer.Ordinal.Equals(card.WorkflowId, workflow.Id) &&
                        StringComparer.Ordinal.Equals(card.StageId, stage.Id))))
                    .ToArray();
                var peak = counts.Length == 0 ? 0 : counts.Max(entry => entry.Count);
                result.Add((
                    workflow.Title,
                    counts.Select(entry => (
                        entry.Id,
                        entry.Count,
                        AnalyticsCharts.SharePercent(entry.Count, peak))).ToArray()));
            }

            return result;
        }
    }

    /// <summary>
    /// The last stage of every workflow on the board: entering it is what closes a card. Which stage that is
    /// comes from the workflow the project declares, never from a stage id spelled here.
    /// </summary>
    private IReadOnlyCollection<string> ClosingStageIds =>
        State.Board is { } board
            ? [.. board.Workflows
                .Where(workflow => workflow.Stages.Count > 0)
                .Select(workflow => workflow.Stages.OrderBy(stage => stage.Order).Last().Id)]
            : [];

    /// <summary>
    /// Cards in each stage right now, counted the way this page's own stage bars count them: the snapshot
    /// the cumulative flow is walked back from, which is why its last week is exact.
    /// </summary>
    private IReadOnlyList<AnalyticsBucket> StagesNow =>
        [.. StagesByWorkflow
            .SelectMany(workflow => workflow.Rows)
            .GroupBy(row => row.StageId, StringComparer.Ordinal)
            .Select(group => new AnalyticsBucket(group.Key, group.Sum(row => row.Count)))];

    /// <summary>
    /// The cumulative flow diagram's series, one per stage, or null when there is nothing to stack: no weeks
    /// in the window, or no cards on the board to walk the counts back from.
    /// </summary>
    private ChartData? CumulativeFlow =>
        _analytics is { Weekly.Count: > 0 } analytics && StagesNow.Count > 0
            ? AnalyticsCharts.CumulativeFlow(
                StagesNow,
                analytics.Flow,
                [.. analytics.Weekly.Select(bucket => bucket.Label)])
            : null;

    /// <summary>
    /// A horizontal chart's height: tall enough for one row per category, and never taller than the
    /// content needs, so a project with two types does not leave half a panel empty.
    /// </summary>
    private static int ChartHeight(int rows) => Math.Max(110, (rows * 32) + 48);

    /// <summary>
    /// A card type's own name, read from the project's workflows, falling back to the raw value the daemon
    /// stored when the project has no workflow for it.
    /// </summary>
    private string KindLabel(string kind) =>
        State.Board?.Workflows
            .FirstOrDefault(workflow => StringComparer.OrdinalIgnoreCase.Equals(workflow.CardType, kind))
            ?.Title
        ?? kind;

    /// <summary>A size step, or the fact that the card has none.</summary>
    private static string SizeLabel(string size) =>
        string.IsNullOrWhiteSpace(size) ? Loc.Get("NoSize") : size;

    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        await LoadAnalyticsAsync();
        await LoadActivityAsync();
    }

    /// <summary>
    /// Reads the project's charts. A failure leaves them empty rather than blanking the screen: everything
    /// else on the page is computed from the board, which is already loaded.
    /// </summary>
    private async Task LoadAnalyticsAsync()
    {
        try
        {
            _analytics = await Http.GetFromJsonAsync<ProjectAnalytics>(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/analytics?weeks={AnalyticsWindow}",
                PwaJson.Options);
        }
        catch
        {
            _analytics = null;
        }
    }

    /// <summary>
    /// Reads the project's own days for the calendar. The daemon filters the series by project, so this
    /// project's calendar cannot show another project's work.
    /// </summary>
    private async Task LoadActivityAsync()
    {
        try
        {
            _activity = await Http.GetFromJsonAsync<IReadOnlyList<ActivityDay>>(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/activity?days={ActivityHeatmap.WindowDays}",
                PwaJson.Options) ?? [];
            _activityTotal = ActivityHeatmap.Total(_activity);
        }
        catch
        {
            _activity = [];
            _activityTotal = 0;
        }
    }
}