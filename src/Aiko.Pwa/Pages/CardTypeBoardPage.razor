@page "/p/{ProjectId}/boards/{CardTypeId}"

@* One card type's board, addressed by its workflow id. The projection switch of the full board lands here
   for a type the project added itself, so the route needs no knowledge of its name. *@
<PageTitle>@Loc.Get("KanbanBoard")</PageTitle>

<BoardView KindFilter="@Kind" ProjectId="@ProjectId" />

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// <summary>The workflow id from the route, which is the card type id.</summary>
    [Parameter] public string CardTypeId { get; set; } = string.Empty;

    private string Kind => CardKind.FromWorkflowId(CardTypeId);
}
