@page "/daemon"
@inject WorkspaceState State

@* The daemon and the bridges to the agents: what is running, where it listens, and how each agent reaches
   it. These are the installation's own facts - one daemon serves every project - which is why they live in
   the Global group rather than under a project. *@
<PageTitle>@Loc.Get("DaemonMcpBridges")</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <span class="aiko-panel__icon aiko-panel__icon--secondary">
                        <FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" />
                    </span>
                    <FlareStack Gap="FlareSpacing.None">
                        <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("DaemonRuntime")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("DaemonRuntimeHint")
                        </FlareText>
                    </FlareStack>
                </FlareStack>
                <span class="aiko-tag aiko-tag--live">
                    <span class="aiko-dot aiko-dot--pulse"></span>
                    @(State.EventsConnected ? Loc.Get("SseLive") : Loc.Get("Online"))
                </span>
            </FlareStack>

            <div class="aiko-tiles">
                @if (State.System is { } system)
                {
                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                            @Loc.Get("Version")
                        </FlareText>
                        <span class="aiko-value">@($"v{system.Version}")</span>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @system.Runtime
                        </FlareText>
                    </FlareStack>

                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                            @Loc.Get("Address")
                        </FlareText>
                        <span class="aiko-value aiko-value--clip" title="@system.BaseUrl">@system.BaseUrl</span>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @($"PID {system.ProcessId} · {LatencyCaption}")
                        </FlareText>
                    </FlareStack>
                }

                <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                        @Loc.Get("McpEndpoint")
                    </FlareText>
                    <span class="aiko-value aiko-value--clip" title="@McpEndpoint">@McpEndpoint</span>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("McpEndpointHint")
                    </FlareText>
                </FlareStack>
            </div>
        </FlareStack>
    </FlarePaper>

    @* The bridges: one card per adapter, saying whether the agent exists on this machine and whether Aiko
       has written its configuration. The two are independent, which is the point of the card. *@
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <span class="aiko-panel__icon aiko-panel__icon--tertiary">
                        <FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" />
                    </span>
                    <FlareStack Gap="FlareSpacing.None">
                        <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("AgentBridges")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("AgentBridgesHint")
                        </FlareText>
                    </FlareStack>
                </FlareStack>
                <span class="aiko-tag aiko-tag--quiet">@BridgeSummary</span>
            </FlareStack>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                            Variant="AlertVariant.Outlined">@_message</FlareAlert>
            }

            @if (State.Agents.Count == 0)
            {
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("NoAgentsDiscovered")
                </FlareText>
            }
            else
            {
                <FlareStack Gap="FlareSpacing.Small">
                    @foreach (var agent in State.Agents)
                    {
                        var bridge = agent;
                        var presence = DisplayFormat.Classify(bridge);
                        <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                    <span class="aiko-panel__icon aiko-panel__icon--tertiary">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.SmartToy" />
                                    </span>
                                    <FlareText Element="span" Typo="TypographyScale.BodyMedium" Weight="FontWeight.SemiBold">
                                        @bridge.DisplayName
                                    </FlareText>
                                    <span class="aiko-tag @BridgeTagClass(presence)">@BridgeCaption(presence)</span>
                                </FlareStack>
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    @if (presence == DisplayFormat.AgentPresence.NotDetected)
                                    {
                                        @* Nothing to attach to: an agent that is not on PATH cannot be
                                           connected, and what helps is the command that installs it. *@
                                        <span class="aiko-value aiko-value--clip">aiko agent install</span>
                                    }
                                    else
                                    {
                                        <FlareButton Variant="@(presence == DisplayFormat.AgentPresence.Connected ? ButtonVariant.Tonal : ButtonVariant.Filled)"
                                                     Size="ButtonSize.Sm"
                                                     Loading="@(_busyAdapterId == bridge.Id)"
                                                     Disabled="@(_busyAdapterId is not null && _busyAdapterId != bridge.Id)"
                                                     OnClick="() => ToggleBridgeAsync(bridge.Id)">
                                            <LeadingIcon>
                                                <FlareIconView Value="@(presence == DisplayFormat.AgentPresence.Connected ? MaterialDesign3Icons.Regular.LinkOff : MaterialDesign3Icons.Regular.PlugConnect)" />
                                            </LeadingIcon>
                                            <ChildContent>
                                                @(presence == DisplayFormat.AgentPresence.Connected
                                                    ? Loc.Get("DisconnectAgent")
                                                    : Loc.Get("ConnectBridge"))
                                            </ChildContent>
                                        </FlareButton>
                                    }
                                </FlareStack>
                            </FlareStack>
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Wrap="true">
                                @if (bridge.Installations.FirstOrDefault() is { } installation)
                                {
                                    <span class="aiko-tag aiko-tag--clip" title="@installation.ExecutablePath">
                                        @installation.ExecutablePath
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(installation.Version))
                                    {
                                        <span class="aiko-tag aiko-tag--quiet">@installation.Version</span>
                                    }
                                }
                                else
                                {
                                    <span class="aiko-tag aiko-tag--quiet">@Loc.Get("BridgeNotInstalled")</span>
                                }
                                @if (bridge.UserScope is { ExpectedFiles: > 0 } scope)
                                {
                                    <span class="aiko-tag aiko-tag--quiet">
                                        @Loc.Format("BridgeFiles", scope.ConfiguredFiles, scope.ExpectedFiles)
                                    </span>
                                }
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @BridgeHint(presence)
                                </FlareText>
                            </FlareStack>
                        </FlareStack>
                    }
                </FlareStack>
            }
        </FlareStack>
    </FlarePaper>
</FlareStack>

@code {
    private string? _busyAdapterId;
    private string? _message;
    private bool _hasError;

    /// <summary>The MCP endpoint an agent connects to: the daemon plus the open project, when one is open.</summary>
    private string McpEndpoint => State.SelectedProjectId is { } projectId && State.HostCaption is { Length: > 0 } host
        ? $"http://{host}/mcp/projects/{projectId}"
        : Loc.Get("SelectProjectForLocalSettings");

    /// <summary>The measured round-trip to the daemon, or a dash before it has answered once.</summary>
    private string LatencyCaption => State.DaemonLatencyMs is { } milliseconds
        ? $"{milliseconds}ms"
        : "—";

    /// <summary>Whether an agent is reachable and configured, in the one word the card has room for.</summary>
    private static string BridgeCaption(DisplayFormat.AgentPresence presence) => presence switch
    {
        DisplayFormat.AgentPresence.Connected => Loc.Get("BridgeConnected"),
        DisplayFormat.AgentPresence.PartiallyConnected => Loc.Get("BridgePartial"),
        DisplayFormat.AgentPresence.NotConnected => Loc.Get("BridgeInstalled"),
        _ => Loc.Get("BridgeNotInstalled")
    };

    /// <summary>
    /// What the card says beside the agent's own facts: the state read as what it means, and what the one
    /// action next to it will do.
    /// </summary>
    private static string BridgeHint(DisplayFormat.AgentPresence presence) => presence switch
    {
        DisplayFormat.AgentPresence.Connected => Loc.Get("BridgeConnectedHint"),
        DisplayFormat.AgentPresence.PartiallyConnected => Loc.Get("BridgePartialHint"),
        DisplayFormat.AgentPresence.NotConnected => Loc.Get("BridgeInstalledHint"),
        _ => Loc.Get("BridgeNotInstalledHint")
    };

    /// <summary>The panel's own count: how many bridges are attached, incomplete and absent.</summary>
    private string BridgeSummary
    {
        get
        {
            var connected = 0;
            var incomplete = 0;
            var absent = 0;
            foreach (var adapter in State.Agents)
            {
                switch (DisplayFormat.Classify(adapter))
                {
                    case DisplayFormat.AgentPresence.Connected:
                        connected++;
                        break;
                    case DisplayFormat.AgentPresence.PartiallyConnected:
                    case DisplayFormat.AgentPresence.NotConnected:
                        incomplete++;
                        break;
                    default:
                        absent++;
                        break;
                }
            }

            return Loc.Format("BridgesSummary", connected, incomplete, absent);
        }
    }

    private static string BridgeTagClass(DisplayFormat.AgentPresence presence) => presence switch
    {
        DisplayFormat.AgentPresence.Connected => "aiko-tag--live",
        DisplayFormat.AgentPresence.PartiallyConnected => "aiko-tag--accent",
        _ => "aiko-tag--quiet"
    };

    /// <summary>
    /// Attaches or detaches one agent's bridge. Connecting writes Aiko's global skills and commands for that
    /// agent; disconnecting removes them. The card reports the outcome itself, because this screen is where
    /// the configuration is being changed.
    /// </summary>
    private async Task ToggleBridgeAsync(string adapterId)
    {
        if (_busyAdapterId is not null)
        {
            return;
        }

        var adapter = State.Agents.FirstOrDefault(item =>
            StringComparer.Ordinal.Equals(item.Id, adapterId));
        var name = adapter?.DisplayName ?? adapterId;
        _busyAdapterId = adapterId;
        _message = null;
        try
        {
            if (adapter is not null &&
                DisplayFormat.Classify(adapter) == DisplayFormat.AgentPresence.Connected)
            {
                await State.DisconnectAgentAsync(adapterId);
            }
            else
            {
                await State.ConnectAgentAsync(adapterId);
            }

            if (State.Error is { Length: > 0 } error)
            {
                _message = Loc.Format("AgentConnectFailed", name, error);
                _hasError = true;
            }
            else
            {
                _message = Loc.Format("AgentBridgeChanged", name);
                _hasError = false;
            }
        }
        finally
        {
            _busyAdapterId = null;
        }
    }
}
