@page "/p/{Handle}/release"
@using Aiko.Application.Contracts
@using Aiko.Domain.Execution
@using Aiko.Pwa.Contracts
@using Aiko.Pwa.Services
@implements IDisposable
@inject HttpClient Http
@inject WorkspaceState State

@* The release screen. Aiko never runs an agent and never touches the repository, so the most this page can
   do is show what the daemon knows and put a command in the queue for an agent to take. It promises no
   push and installs nothing: the steps below are commands a person runs, and the screen says so.

   "Unknown" is drawn as a value everywhere a fact is missing, with the reason the daemon gave - an empty
   place would read as "nothing to report" instead of "I could not find out". *@
<PageTitle>@($"{Loc.Get("ReleaseTitle")} · {ProjectName}")</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
        <FlareStack Gap="FlareSpacing.XXSmall">
            <span class="aiko-tag aiko-tag--accent">@Loc.Get("ReleaseTag")</span>
            <FlareText Element="h1" Typo="TypographyScale.HeadlineMedium">@Loc.Get("ReleaseTitle")</FlareText>
            <FlareText Element="p" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                @Loc.Get("ReleaseHint")
            </FlareText>
        </FlareStack>

        @* The one action this screen offers. Aiko runs no agent, so the button releases nothing by itself: it
           opens the dialog that names the policy and the agent, and what it places is a request in the queue. *@
        <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Md" OnClick="() => _creating = true">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Publish" /></LeadingIcon>
            <ChildContent>@Loc.Get("ReleaseCreateButton")</ChildContent>
        </FlareButton>
    </FlareStack>

    @if (_message is { Length: > 0 } message)
    {
        <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                    Variant="AlertVariant.Outlined">@message</FlareAlert>
    }

    @if (OpenReleaseCommand is { } waiting)
    {
        <span class="aiko-tag">@Loc.Format("ReleaseCommandWaiting", waiting.Id)</span>
    }

    @* The history is the project's own record rather than a probe of the repository: what was released, newest
       first. A release is marked ordinary or preliminary by its tag's suffix - the same fact release.yml reads
       to decide whether the release becomes the latest one. *@
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <span class="aiko-panel__icon aiko-panel__icon--secondary">
                    <FlareIconView Value="@MaterialDesign3Icons.Regular.ListAlt" />
                </span>
                <FlareStack Gap="FlareSpacing.None">
                    <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("ReleaseHistoryTitle")</FlareText>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("ReleaseHistoryHint")
                    </FlareText>
                </FlareStack>
            </FlareStack>

            @if (_history.Count > 0)
            {
                <FlareStack Gap="FlareSpacing.XSmall">
                    @foreach (var record in _history)
                    {
                        var entry = record;
                        <FlareNavLink Href="@ProjectRoutes.ReleaseRecord(Handle, entry.Version)">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                                <span class="aiko-value">@entry.Version</span>
                                <span class="aiko-tag @(IsPreliminary(entry.Version) ? "aiko-tag--accent" : "aiko-tag--quiet")">
                                    @Loc.Get(IsPreliminary(entry.Version) ? "ReleaseKindPreliminary" : "ReleaseKindOrdinary")
                                </span>
                                <span class="aiko-tag aiko-tag--quiet">@entry.SchemeId</span>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Format("ReleaseHistoryCards", entry.Cards)
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @entry.ReleasedAt.ToLocalTime().ToString("d")
                                </FlareText>
                            </FlareStack>
                        </FlareNavLink>
                    }
                </FlareStack>
            }
            else
            {
                @* An empty history is a fact about the project, not a missing answer: it says nothing has been
                   recorded yet, which is what a project that has not released looks like. *@
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("ReleaseHistoryEmpty")
                </FlareText>
            }
        </FlareStack>
    </FlarePaper>

    @* Creating a release is one decision made of two: which policy the release follows, and which agent
       conducts it. The dialog is where both are named - the project stores no "current" scheme any more, a
       release names the one it follows - and a release that names no agent is one any agent may take. *@
    <FlareDialog Visible="@_creating"
                 VisibleChanged="value => _creating = value"
                 Title="@Loc.Get("ReleaseCreateTitle")">
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Small">
                <FlareText Element="p" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                    @Loc.Get("ReleaseCreateHint")
                </FlareText>

                <AikoSelectField Label="@Loc.Get("ReleasePolicyLabel")"
                                 Value="@_policyId"
                                 ValueChanged="value => _policyId = value">
                    @foreach (var scheme in _schemes)
                    {
                        var option = scheme;
                        <option value="@option.Id">@option.Name</option>
                    }
                </AikoSelectField>
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("ReleasePolicyHint")
                </FlareText>

                <AikoSelectField Label="@Loc.Get("ReleaseAgentLabel")"
                                 Value="@_agentId"
                                 ValueChanged="value => _agentId = value">
                    <option value="">@Loc.Get("ReleaseAgentAny")</option>
                    @foreach (var agent in State.Agents)
                    {
                        var option = agent;
                        <option value="@option.Id">@option.DisplayName</option>
                    }
                </AikoSelectField>
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("ReleaseAgentHint")
                </FlareText>
            </FlareStack>
        </ChildContent>
        <ActionsContent>
            <FlareButton Variant="ButtonVariant.Filled"
                         Size="ButtonSize.Sm"
                         Disabled="@(OpenReleaseCommand is not null || _placing)"
                         Loading="@_placing"
                         OnClick="PlaceReleaseAsync">
                <ChildContent>@Loc.Get("ReleaseCreateConfirm")</ChildContent>
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="() => _creating = false">
                <ChildContent>@Loc.Get("Cancel")</ChildContent>
            </FlareButton>
        </ActionsContent>
    </FlareDialog>
</FlareStack>

@code {
    /// <summary>The project's readable handle, taken from the route.</summary>
    [Parameter] public string Handle { get; set; } = string.Empty;

    private IReadOnlyList<ReleaseHistoryItem> _history = [];
    private IReadOnlyList<ReleaseScheme> _schemes = ReleaseSchemes.BuiltIn;
    private string? _policyId;
    private string? _agentId;
    private bool _creating;
    private string? _message;
    private bool _hasError;
    private bool _placing;

    private string ProjectName => State.SelectedProject?.Name ?? Handle;

    /// <summary>
    /// The release command still asking for work, or null. Read from the queue rather than remembered here:
    /// the daemon records what the person asked for, and the screen's job is to show that record.
    /// </summary>
    private CardCommand? OpenReleaseCommand => State.Commands.FirstOrDefault(command =>
        command.Action == CardCommandAction.Release && command.IsOpen);

    /// <summary>
    /// Whether a tag names a preliminary release. The suffix comes from the scheme it is declared in rather
    /// than being typed here, because three places read the same fact: the scheme's body, the workflow that
    /// decides whether a release becomes the latest one, and this screen.
    /// </summary>
    private static bool IsPreliminary(string version) =>
        version.EndsWith(ReleaseSchemes.PreReleaseSuffix, StringComparison.Ordinal);

    /// <summary>
    /// Subscribed once, when the component is created. Doing it while the parameters are set would add a
    /// handler on every navigation, and the page would then redraw as many times as it had been visited.
    /// </summary>
    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    /// <summary>
    /// Reads what this screen shows: the project's release history, and the schemes a release of this project
    /// can follow. Both are the project's own record rather than a probe of the repository, so a read that
    /// fails is a refused read and says so instead of drawing an empty place.
    /// </summary>
    private async Task ReloadAsync()
    {
        try
        {
            _history = await Http.GetFromJsonAsync<IReadOnlyList<ReleaseHistoryItem>>(
                $"api/v1/projects/{Uri.EscapeDataString(Handle)}/releases",
                PwaJson.Options) ?? [];
            // The schemes come from the settings document the rest of the cockpit already reads. A project
            // that states none follows the ones Aiko ships - that is what the model says, and the dialog has
            // to offer what a release would really follow.
            var settings = await Http.GetFromJsonAsync<AppSettingsView>(
                $"api/v1/projects/{Uri.EscapeDataString(Handle)}/settings",
                PwaJson.Options);
            _schemes = settings?.Snapshot?.Release?.EffectiveSchemes ?? ReleaseSchemes.BuiltIn;
            _policyId ??= _schemes[0].Id;
        }
        catch (Exception exception)
        {
            _message = Loc.Format("ReleaseLoadFailed", FailureText.Describe(exception));
            _hasError = true;
        }
    }

    /// <summary>
    /// Puts the release command in the queue with the policy it follows and the agent asked for it. Nothing is
    /// started here: Aiko does not run agents, and a release is the project's own, so the command carries no
    /// card - the scheme the person picked rides in the text, and the agent, when one was named, in the field
    /// the queue already has for it. A command that names no agent is one any agent may take.
    /// </summary>
    private async Task PlaceReleaseAsync()
    {
        if (_placing || OpenReleaseCommand is not null)
        {
            return;
        }

        _placing = true;
        _message = null;
        _hasError = false;
        try
        {
            var placed = await State.PlaceCommandAsync(new PlaceCommandRequest(
                CardId: null,
                Action: CardCommandAction.Release,
                AgentAdapterId: string.IsNullOrWhiteSpace(_agentId) ? null : _agentId,
                Text: _policyId));
            _hasError = placed is null;
            _message = placed is null
                ? State.Error ?? Loc.Get("CommandFailed")
                : Loc.Format("ReleaseCreated", placed.Id);
            // A refused request keeps the dialog where the choices are, rather than closing over a failure.
            _creating = placed is null;
        }
        finally
        {
            _placing = false;
        }
    }

    private Task OnStateChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose() => State.Changed -= OnStateChanged;
}
