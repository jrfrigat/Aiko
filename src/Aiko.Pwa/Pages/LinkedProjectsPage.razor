@page "/p/{ProjectId}/links"
@inject HttpClient Http
@inject WorkspaceState State

@* The projects this one hands work to. The registry is project data (`.aiko/links.json`) and a link is a
   sentence rather than an id: an agent reads the description before deciding that a piece of work belongs to
   the neighbour, so this screen shows those words back and lets them be corrected.

   It has a screen of its own, reached from the rail, because the panel that used to sit inside project
   settings could only add and remove - and because two editors of one file is how the two drift apart. *@
<PageTitle>@Loc.Get("LinkedProjects")</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Gap="FlareSpacing.XXSmall">
        <FlareText Element="h2" Typo="TypographyScale.HeadlineSmall">@Loc.Get("LinkedProjects")</FlareText>
        <FlareText Element="span" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
            @Loc.Get("LinkedProjectsHint")
        </FlareText>
    </FlareStack>

    @if (_message is { Length: > 0 } note)
    {
        <FlareAlert Severity="@(_error ? AlertSeverity.Error : AlertSeverity.Success)"
                    Variant="AlertVariant.Outlined">@note</FlareAlert>
    }

    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Small">
            @if (_links.Count == 0)
            {
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("LinkedProjectsNone")
                </FlareText>
            }
            else
            {
                @foreach (var link in _links)
                {
                    var item = link;
                    <FlareStack Row="true" Align="FlareAlignItems.Start"
                                Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Gap="FlareSpacing.XXSmall">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                @item.Handle
                            </FlareText>
                            @if (IsEditing(item))
                            {
                                <AikoField Label="@Loc.Get("LinkedProjectsDescription")"
                                           Rows="2"
                                           Placeholder="@Loc.Get("LinkedProjectsDescriptionPlaceholder")"
                                           Value="@_editingDescription"
                                           ValueChanged="value => _editingDescription = value" />
                                <AikoField Label="@Loc.Get("LinkedProjectsReference")"
                                           Rows="2"
                                           Placeholder="@Loc.Get("LinkedProjectsReferencePlaceholder")"
                                           Value="@_editingReference"
                                           ValueChanged="value => _editingReference = value" />
                                <AikoField Label="@Loc.Get("LinkedProjectsWhenToUse")"
                                           Rows="2"
                                           Placeholder="@Loc.Get("LinkedProjectsWhenToUsePlaceholder")"
                                           Value="@_editingWhenToUse"
                                           ValueChanged="value => _editingWhenToUse = value" />
                                <AikoField Label="@Loc.Get("LinkedProjectsWhenNotToUse")"
                                           Rows="2"
                                           Placeholder="@Loc.Get("LinkedProjectsWhenNotToUsePlaceholder")"
                                           Value="@_editingWhenNotToUse"
                                           ValueChanged="value => _editingWhenNotToUse = value" />
                            }
                            else
                            {
                                <FlareText Element="span" Typo="TypographyScale.BodySmall">
                                    @item.Description
                                </FlareText>
                                @* Only what the entry carries: a link written before these existed shows its
                                   description alone, which is exactly how it read before. *@
                                @foreach (var note in Notes(item))
                                {
                                    var line = note;
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                        @line
                                    </FlareText>
                                }
                            }
                        </FlareStack>
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                            @if (IsEditing(item))
                            {
                                <FlareButton Variant="ButtonVariant.Tonal"
                                             Size="ButtonSize.Sm"
                                             Disabled="@string.IsNullOrWhiteSpace(_editingDescription)"
                                             OnClick="() => SaveLinkAsync(item)">
                                    <ChildContent>@Loc.Get("LinkedProjectsSave")</ChildContent>
                                </FlareButton>
                                <FlareButton Variant="ButtonVariant.Text"
                                             Size="ButtonSize.Sm"
                                             OnClick="CancelEdit">
                                    <ChildContent>@Loc.Get("LinkedProjectsCancel")</ChildContent>
                                </FlareButton>
                            }
                            else
                            {
                                <FlareIconButton Variant="ButtonVariant.Text"
                                                 Icon="@MaterialDesign3Icons.Regular.Edit"
                                                 AriaLabel="@Loc.Get("LinkedProjectsEdit")"
                                                 OnClick="() => BeginEdit(item)" />
                                <FlareIconButton Variant="ButtonVariant.Text"
                                                 Icon="@FlareIcons.Close"
                                                 AriaLabel="@Loc.Get("LinkedProjectsRemove")"
                                                 OnClick="() => RemoveLinkAsync(item)" />
                            }
                        </FlareStack>
                    </FlareStack>
                }
            }

            @* A link is written, not derived: the picker offers the projects this daemon knows and nothing
               else, because a link to a project nobody registered is a relation no one can resolve. *@
            <AikoSelectField Label="@Loc.Get("LinkedProjectsPick")"
                             Value="@_linkTarget"
                             ValueChanged="value => _linkTarget = value"
                             Hint="@Loc.Get("LinkedProjectsPickHint")">
                <option value="">@Loc.Get("LinkedProjectsPickNone")</option>
                @foreach (var candidate in LinkCandidates())
                {
                    var item = candidate;
                    <option value="@item.Handle">@item.Name</option>
                }
            </AikoSelectField>
            <AikoField Label="@Loc.Get("LinkedProjectsDescription")"
                       Rows="2"
                       Placeholder="@Loc.Get("LinkedProjectsDescriptionPlaceholder")"
                       Value="@_linkDescription"
                       ValueChanged="value => _linkDescription = value" />
            <AikoField Label="@Loc.Get("LinkedProjectsReference")"
                       Rows="2"
                       Placeholder="@Loc.Get("LinkedProjectsReferencePlaceholder")"
                       Value="@_linkReference"
                       ValueChanged="value => _linkReference = value" />
            <AikoField Label="@Loc.Get("LinkedProjectsWhenToUse")"
                       Rows="2"
                       Placeholder="@Loc.Get("LinkedProjectsWhenToUsePlaceholder")"
                       Value="@_linkWhenToUse"
                       ValueChanged="value => _linkWhenToUse = value" />
            <AikoField Label="@Loc.Get("LinkedProjectsWhenNotToUse")"
                       Rows="2"
                       Placeholder="@Loc.Get("LinkedProjectsWhenNotToUsePlaceholder")"
                       Value="@_linkWhenNotToUse"
                       ValueChanged="value => _linkWhenNotToUse = value" />
            <FlareStack Row="true" Justify="FlareJustifyContent.End">
                <FlareButton Variant="ButtonVariant.Filled"
                             Size="ButtonSize.Sm"
                             Disabled="@(string.IsNullOrWhiteSpace(_linkTarget) || string.IsNullOrWhiteSpace(_linkDescription))"
                             OnClick="AddLinkAsync">
                    <ChildContent>@Loc.Get("LinkedProjectsAdd")</ChildContent>
                </FlareButton>
            </FlareStack>
        </FlareStack>
    </FlarePaper>
</FlareStack>

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// <summary>The projects this one is linked to, as the registry holds them.</summary>
    private IReadOnlyList<ProjectLink> _links = [];

    /// <summary>The handle chosen in the picker, or null when nothing is chosen yet.</summary>
    private string? _linkTarget;

    /// <summary>What the person said the chosen project is for, before it is stored.</summary>
    private string? _linkDescription;

    /// <summary>Where the chosen project's reference lives, before it is stored.</summary>
    private string? _linkReference;

    /// <summary>When work belongs to the chosen project, before it is stored.</summary>
    private string? _linkWhenToUse;

    /// <summary>When it belongs here instead, before it is stored.</summary>
    private string? _linkWhenNotToUse;

    /// <summary>The handle of the link being corrected, or null when no row is open for editing.</summary>
    private string? _editing;

    /// <summary>The description the open row holds, before it is saved.</summary>
    private string? _editingDescription;

    /// <summary>The reference the open row holds, before it is saved.</summary>
    private string? _editingReference;

    /// <summary>The "work goes there when" the open row holds, before it is saved.</summary>
    private string? _editingWhenToUse;

    /// <summary>The "it does not go there when" the open row holds, before it is saved.</summary>
    private string? _editingWhenNotToUse;

    private string? _message;
    private bool _error;

    /// <summary>
    /// The projects that can still be linked: the registered ones, without this project and without the
    /// projects already linked.
    /// </summary>
    /// <remarks>
    /// The open project is recognised by either of its names: this page is addressed by the route, which
    /// carries the readable handle, while the registry stores the immutable id.
    /// </remarks>
    private IEnumerable<RegisteredProject> LinkCandidates() =>
        State.Projects
            .Where(project =>
                !StringComparer.Ordinal.Equals(project.Id, ProjectId) &&
                !StringComparer.Ordinal.Equals(project.Handle, ProjectId))
            .Where(project => _links.All(link =>
                !StringComparer.Ordinal.Equals(link.ProjectId, project.Id)))
            .OrderBy(project => project.Name, StringComparer.Ordinal);

    private bool IsEditing(ProjectLink link) =>
        StringComparer.Ordinal.Equals(_editing, link.Handle);

    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        await LoadLinksAsync();
    }

    private async Task LoadLinksAsync()
    {
        try
        {
            _links = await Http.GetFromJsonAsync<IReadOnlyList<ProjectLink>>(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/links",
                PwaJson.Options) ?? [];
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    private async Task AddLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_linkTarget) || string.IsNullOrWhiteSpace(_linkDescription))
        {
            return;
        }

        if (await WriteAsync(
                _linkTarget,
                _linkDescription,
                _linkReference,
                _linkWhenToUse,
                _linkWhenNotToUse))
        {
            _linkTarget = null;
            _linkDescription = null;
            _linkReference = null;
            _linkWhenToUse = null;
            _linkWhenNotToUse = null;
        }
    }

    private void BeginEdit(ProjectLink link)
    {
        _message = null;
        _editing = link.Handle;
        _editingDescription = link.Description;
        _editingReference = link.Reference;
        _editingWhenToUse = link.WhenToUse;
        _editingWhenNotToUse = link.WhenNotToUse;
    }

    private void CancelEdit()
    {
        _editing = null;
        _editingDescription = null;
        _editingReference = null;
        _editingWhenToUse = null;
        _editingWhenNotToUse = null;
    }

    private async Task SaveLinkAsync(ProjectLink link)
    {
        if (string.IsNullOrWhiteSpace(_editingDescription))
        {
            return;
        }

        if (await WriteAsync(
                link.Handle,
                _editingDescription,
                _editingReference,
                _editingWhenToUse,
                _editingWhenNotToUse))
        {
            CancelEdit();
        }
    }

    /// <summary>
    /// Writes one link and reads the registry back. Adding a link and correcting it are the same PUT: the file
    /// holds one entry per project, so writing it again replaces the entry it carried - a text left empty in the
    /// form is a text the person cleared.
    /// </summary>
    private async Task<bool> WriteAsync(
        string target,
        string description,
        string? reference,
        string? whenToUse,
        string? whenNotToUse)
    {
        _message = null;
        _error = false;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/links/{Uri.EscapeDataString(target)}",
                new LinkProjectRequest(description, reference, whenToUse, whenNotToUse),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            await LoadLinksAsync();
            return !_error;
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
            return false;
        }
    }

    /// <summary>
    /// The optional texts a link carries, each with its label, in the order the context prints them.
    /// </summary>
    /// <remarks>
    /// A link that carries none - one written before these existed - shows nothing beyond its description,
    /// which is how every link used to read. The label is the same key the form uses, so a person reading a row
    /// and a person editing it read the same words.
    /// </remarks>
    private static IReadOnlyList<string> Notes(ProjectLink link)
    {
        var notes = new List<string>(3);
        Add(notes, "LinkedProjectsReference", link.Reference);
        Add(notes, "LinkedProjectsWhenToUse", link.WhenToUse);
        Add(notes, "LinkedProjectsWhenNotToUse", link.WhenNotToUse);
        return notes;

        static void Add(List<string> target, string key, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                target.Add($"{Loc.Get(key)}: {value}");
            }
        }
    }

    private async Task RemoveLinkAsync(ProjectLink link)
    {
        _message = null;
        _error = false;
        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/links/{Uri.EscapeDataString(link.Handle)}");
            response.EnsureSuccessStatusCode();
            await LoadLinksAsync();
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    private void Show(string text, bool error)
    {
        _message = text;
        _error = error;
    }
}
