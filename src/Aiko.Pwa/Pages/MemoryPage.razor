@page "/p/{ProjectId}/memory"
@using Aiko.Application.Contracts
@using Aiko.Pwa.Contracts
@using Aiko.Pwa.Services
@inject HttpClient Http
@inject WorkspaceState State
@inject IJSRuntime Js

@* Text that is not in the file yet is not left behind by a click: a click inside the page asks with the page's
   own dialog, and the app's own menu, the browser's back button and a closed tab ask the same way the card
   inspector and the artifact editor ask. *@
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="ConfirmNavigationAsync" />

@* The project's durable memory: the Markdown documents under `.aiko/memory` that an agent reads and
   writes with its tools. This screen is the same door a person can use - the list, the search, and the
   document itself - and it writes through the same store, so an agent and a screen never see two memories.

   Every call goes through the REST paths the MCP tools are built on; an error is the daemon's own
   sentence rather than a status code, because "no memory document 'notes.md' in this project" is a thing
   a person can act on and "404" is not. *@
<PageTitle>@Loc.Get("ProjectMemoryTitle")</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Gap="FlareSpacing.XXSmall">
        <FlareText Element="h2" Typo="TypographyScale.HeadlineSmall">@Loc.Get("ProjectMemoryTitle")</FlareText>
        <FlareText Element="span" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
            @Loc.Get("ProjectMemoryHint")
        </FlareText>
    </FlareStack>

    @if (_message is { Length: > 0 } note)
    {
        <FlareAlert Severity="@(_error ? AlertSeverity.Error : AlertSeverity.Success)"
                    Variant="AlertVariant.Outlined">@note</FlareAlert>
    }

    @* The search: the index is a projection of the files, so what comes back is the documents themselves. *@
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareStack Row="true" Align="FlareAlignItems.End" Gap="FlareSpacing.Small" Wrap="true">
                <AikoField Label="@Loc.Get("ProjectMemorySearchLabel")"
                           Placeholder="@Loc.Get("ProjectMemorySearchPlaceholder")"
                           Value="@_query"
                           ValueChanged="value => _query = value" />
                <FlareButton Variant="ButtonVariant.Filled"
                             Size="ButtonSize.Sm"
                             Disabled="@string.IsNullOrWhiteSpace(_query)"
                             OnClick="SearchAsync">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" /></LeadingIcon>
                    <ChildContent>@Loc.Get("ProjectMemorySearchAction")</ChildContent>
                </FlareButton>
            </FlareStack>

            @if (_searched)
            {
                @if (_results.Count == 0)
                {
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("ProjectMemorySearchEmpty")
                    </FlareText>
                }
                else
                {
                    <span class="aiko-tag">@Loc.Format("ProjectMemorySearchResults", _results.Count)</span>
                    @foreach (var hit in _results)
                    {
                        var result = hit;
                        <FlareStack Row="true" Align="FlareAlignItems.Start"
                                    Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                            <FlareStack Gap="FlareSpacing.XXSmall">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                        @result.Path
                                    </FlareText>
                                    @* The row says it is the one the editor holds: the editor sits below the
                                       whole list, so without a mark here the click leaves no trace where the
                                       reader is looking. *@
                                    @if (IsOpenPath(result.Path))
                                    {
                                        <span class="aiko-tag aiko-tag--pill">@Loc.Get("ProjectMemoryOpenNow")</span>
                                    }
                                </FlareStack>
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    @Excerpt(result.Content)
                                </FlareText>
                            </FlareStack>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="() => OpenAsync(result.Path)">
                                <ChildContent>@Loc.Get("ProjectMemoryOpen")</ChildContent>
                            </FlareButton>
                        </FlareStack>
                    }
                }
            }
        </FlareStack>
    </FlarePaper>

    @* Every document in the memory, read from the files: the size and the date say which one moved last. *@
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ProjectMemoryDocuments")</FlareText>

            @if (_documents.Count == 0)
            {
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("ProjectMemoryNone")
                </FlareText>
            }
            else
            {
                @foreach (var document in _documents)
                {
                    var item = document;
                    <FlareStack Row="true" Align="FlareAlignItems.Center"
                                Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Gap="FlareSpacing.XXSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @item.Path
                                </FlareText>
                                @* The open document is marked where it was opened: the editor is below this whole
                                   listing, and a click that only changes something off-screen reads as a button
                                   that did nothing. *@
                                @if (IsOpenPath(item.Path))
                                {
                                    <span class="aiko-tag aiko-tag--pill">@Loc.Get("ProjectMemoryOpenNow")</span>
                                }
                            </FlareStack>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Format("ProjectMemorySize", DisplayFormat.Number((int)item.Size))
                                ·
                                @item.LastModifiedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </FlareText>
                        </FlareStack>
                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="() => OpenAsync(item.Path)">
                            <ChildContent>@Loc.Get("ProjectMemoryOpen")</ChildContent>
                        </FlareButton>
                    </FlareStack>
                }
            }
        </FlareStack>
    </FlarePaper>

    @* The document itself: the one that is open, or a new one whose path is typed before it is saved. The
       anchor above it is what opening a document scrolls to: the editor sits below the whole document list,
       and in a real project that list is longer than the screen, so a document that opened out of sight
       reads as a button that did nothing. *@
    <div @ref="_editor"></div>
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareStack Row="true" Align="FlareAlignItems.Center"
                        Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ProjectMemoryEditor")</FlareText>
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    @* The editor says when its text is not in the file yet, so that leaving it behind is a
                       choice the reader can see rather than something that happens to them. *@
                    @if (IsDirty)
                    {
                        <span class="aiko-tag aiko-tag--pill">@Loc.Get("ProjectMemoryUnsaved")</span>
                    }
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="BeginNewAsync">
                        <ChildContent>@Loc.Get("ProjectMemoryNew")</ChildContent>
                    </FlareButton>
                    <FlareButton Variant="ButtonVariant.Filled"
                                 Size="ButtonSize.Sm"
                                 Disabled="@(!CanSave)"
                                 OnClick="SaveAsync">
                        <ChildContent>@Loc.Get("ProjectMemorySave")</ChildContent>
                    </FlareButton>
                    <FlareButton Variant="ButtonVariant.Outlined"
                                 Size="ButtonSize.Sm"
                                 Disabled="@(!IsOpen)"
                                 OnClick="AskDelete">
                        <ChildContent>@Loc.Get("ProjectMemoryDelete")</ChildContent>
                    </FlareButton>
                </FlareStack>
            </FlareStack>

            @if (IsOpen)
            {
                <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                    @_open!.Path
                </FlareText>
            }
            else
            {
                <AikoField Label="@Loc.Get("ProjectMemoryPathLabel")"
                           Hint="@Loc.Get("ProjectMemoryNewHint")"
                           Placeholder="@Loc.Get("ProjectMemoryPathPlaceholder")"
                           Value="@_newPath"
                           ValueChanged="value => _newPath = value" />
            }

            <PromptField Name="@DocumentName"
                         Title="@Loc.Get("ProjectMemoryContent")"
                         Placeholder="@Loc.Get("ProjectMemoryHint")"
                         Rows="16"
                         Value="@_content"
                         ValueChanged="value => _content = value" />
        </FlareStack>
    </FlarePaper>

    @* A click that would replace the text in the editor asks first, and the answer decides what happens:
       saving writes the text before the click goes on, discarding lets the click go on without it, and
       staying lets the click fall - the editor is left exactly as it was. The question is Flare's own dialog,
       so it is reachable by keyboard and dismissible with Escape. *@
    <FlareDialog Visible="@(_leaveAction is not null)"
                 VisibleChanged="value => { if (!value) { CancelLeave(); } }"
                 Title="@Loc.Get("ProjectMemoryLeaveTitle")">
        <ChildContent>
            <FlareText Element="p" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                @Loc.Get("ProjectMemoryLeaveHint")
            </FlareText>
        </ChildContent>
        <ActionsContent>
            <FlareButton Variant="ButtonVariant.Filled"
                         Size="ButtonSize.Sm"
                         Disabled="@(!CanSave)"
                         Loading="@_leaving"
                         OnClick="SaveAndLeaveAsync">
                <ChildContent>@Loc.Get("ProjectMemoryLeaveSave")</ChildContent>
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Outlined"
                         Size="ButtonSize.Sm"
                         Loading="@_leaving"
                         OnClick="DiscardAndLeaveAsync">
                <ChildContent>@Loc.Get("ProjectMemoryLeaveDiscard")</ChildContent>
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text"
                         Size="ButtonSize.Sm"
                         OnClick="CancelLeave">
                <ChildContent>@Loc.Get("ProjectMemoryLeaveStay")</ChildContent>
            </FlareButton>
        </ActionsContent>
    </FlareDialog>

    @* Deleting a document is asked about with the document's own path in the question: the file leaves the
       memory for good and nothing on this screen brings it back. The safe answer comes first, and Escape
       takes it too - the dialog closes without a word, and so does a click on the scrim. *@
    <FlareDialog Visible="@_deleteAsk"
                 VisibleChanged="value => _deleteAsk = value"
                 Title="@Loc.Get("ProjectMemoryDeleteTitle")">
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Small">
                <FlareAlert Severity="AlertSeverity.Warning" Variant="AlertVariant.Outlined">
                    @Loc.Get("ProjectMemoryDeleteWarning")
                </FlareAlert>
                <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelMedium" Weight="FontWeight.SemiBold">
                    @_open?.Path
                </FlareText>
            </FlareStack>
        </ChildContent>
        <ActionsContent>
            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="CancelDelete">
                <ChildContent>@Loc.Get("ProjectMemoryDeleteKeep")</ChildContent>
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm" OnClick="ConfirmDeleteAsync">
                <ChildContent>@Loc.Get("ProjectMemoryDeleteConfirm")</ChildContent>
            </FlareButton>
        </ActionsContent>
    </FlareDialog>
</FlareStack>

@code {
    /// <summary>The project in the route: its readable handle, or its id when a link was written by hand.</summary>
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// <summary>Every document of the memory, as the listing reports it.</summary>
    private IReadOnlyList<MemoryDocumentSummary> _documents = [];

    /// <summary>What the last search found. Empty after a search means it found nothing.</summary>
    private IReadOnlyList<MemoryDocument> _results = [];

    /// <summary>The text the search is looking for.</summary>
    private string? _query;

    /// <summary>Whether a search has run, so its empty answer is told from no search at all.</summary>
    private bool _searched;

    /// <summary>The document the editor holds, or null when the editor holds a new one.</summary>
    private MemoryDocument? _open;

    /// <summary>The text in the editor: what saving writes, which is not the file until the save lands.</summary>
    private string? _content;

    /// <summary>The path of the new document being written, before it exists in the memory.</summary>
    private string? _newPath;

    /// <summary>
    /// The text as the daemon last handed it over: what the editor held when the document was opened or
    /// written. Unsaved means the text differs from this and not that a field was touched, so typing a
    /// character and deleting it again leaves nothing to lose and the page asks about nothing.
    /// </summary>
    private string? _baseline;

    /// <summary>
    /// What a click asked for, held while the page asks whether the unsaved text may go. A null value is the
    /// question being closed, so one field answers both "is the question up" and "what happens next".
    /// </summary>
    private Func<Task>? _leaveAction;

    /// <summary>Whether an answer is being carried out, so the question's buttons say that they are busy.</summary>
    private bool _leaving;

    /// <summary>Whether the open document is being asked about before it is deleted.</summary>
    private bool _deleteAsk;

    /// <summary>
    /// The project the editor's document came from. Another project is another memory, so the document the
    /// editor holds is dropped when the route names a different one: one project's file is not another's draft.
    /// </summary>
    private string? _loadedProject;

    /// <summary>
    /// The spot just above the editor. Opening a document brings the reader here, because the editor sits below
    /// the whole document list and in a real project that list is longer than the screen.
    /// </summary>
    private ElementReference _editor;

    /// <summary>Whether the next render should bring the editor into view.</summary>
    private bool _landOnEditor;

    private string? _message;
    private bool _error;

    /// <summary>The memory of this project, under whichever of its names the route carries.</summary>
    private string BaseUrl => $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/memory";

    private bool IsOpen => _open is not null;

    /// <summary>
    /// Whether this path is the document the editor holds. It is what marks the row a reader just opened in the
    /// listing and in the search results alike.
    /// </summary>
    private bool IsOpenPath(string path) =>
        _open?.Path is { Length: > 0 } open && string.Equals(open, path, StringComparison.Ordinal);

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_content) &&
        (_open is not null || !string.IsNullOrWhiteSpace(_newPath));

    /// <summary>
    /// Whether the editor holds text the file does not. A document that was opened is measured against what was
    /// read or written; a new one has nothing to be compared with, so anything typed into it - its text or the
    /// path it is meant for - is unsaved by definition.
    /// </summary>
    private bool IsDirty => _open is not null
        ? !string.Equals(_content, _baseline, StringComparison.Ordinal)
        : !string.IsNullOrEmpty(_content) || !string.IsNullOrEmpty(_newPath);

    /// <summary>What the editor's header bar names the file: the open path, or the one being written.</summary>
    private string DocumentName => _open?.Path is { Length: > 0 } open ? open : _newPath ?? "memory.md";

    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        if (!string.Equals(_loadedProject, ProjectId, StringComparison.Ordinal))
        {
            _loadedProject = ProjectId;
            _open = null;
            _content = null;
            _baseline = null;
            _newPath = null;
            _results = [];
            _searched = false;
            _message = null;
            _error = false;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _documents = await Http.GetFromJsonAsync<IReadOnlyList<MemoryDocumentSummary>>(
                BaseUrl,
                PwaJson.Options) ?? [];
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _message = null;
        _error = false;
        try
        {
            _results = await Http.GetFromJsonAsync<IReadOnlyList<MemoryDocument>>(
                $"{BaseUrl}/search?q={Uri.EscapeDataString(_query)}",
                PwaJson.Options) ?? [];
            _searched = true;
        }
        catch (Exception exception)
        {
            _searched = true;
            _results = [];
            Show(exception.Message, error: true);
        }
    }

    /// <summary>
    /// Opens one document by path, once the editor's unsaved text has been answered for. A search result and a
    /// row of the listing take the same way in, so the editor shows what the file holds now rather than what a
    /// listing remembered.
    /// </summary>
    private Task OpenAsync(string path) => LeaveAsync(() => OpenDocumentAsync(path));

    private async Task OpenDocumentAsync(string path)
    {
        _message = null;
        _error = false;
        try
        {
            using var response = await Http.GetAsync($"{BaseUrl}/document?path={Uri.EscapeDataString(path)}");
            if (!response.IsSuccessStatusCode)
            {
                Show(await ReadErrorAsync(response), error: true);
                return;
            }

            var document = await response.Content.ReadFromJsonAsync<MemoryDocument>(PwaJson.Options);
            _open = document;
            _content = document?.Content;
            _baseline = _content;
            _newPath = null;
            // The editor is below the whole listing, so opening reports itself and brings the reader to the
            // document: a change nobody can see is a button that looks broken. Saving and deleting already
            // tell the reader what happened; opening is the third of the screen's actions and says so too.
            _landOnEditor = true;
            Show(Loc.Format("ProjectMemoryOpened", document?.Path ?? path), error: false);
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    /// <summary>
    /// Brings the editor into view once it has been redrawn with the document that was opened, and only when an
    /// open asked for it.
    /// </summary>
    /// <remarks>
    /// The jump is a convenience the screen asks the browser for: the document is open either way, so a JS
    /// runtime that cannot do it (a stale client, a disabled browser) must cost the scroll and nothing else.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_landOnEditor)
        {
            return;
        }

        _landOnEditor = false;
        try
        {
            await Js.InvokeVoidAsync("aikoScrollIntoView", _editor);
        }
        catch (JSException)
        {
            // No scroll, then: the page has already said the document is open.
        }
    }

    /// <summary>
    /// Empties the editor for a document that does not exist yet, once the text it held has been answered for.
    /// </summary>
    private Task BeginNewAsync() => LeaveAsync(StartNewDocumentAsync);

    private Task StartNewDocumentAsync()
    {
        _open = null;
        _content = string.Empty;
        _baseline = string.Empty;
        _newPath = string.Empty;
        _message = null;
        _error = false;
        return Task.CompletedTask;
    }

    /// <summary>
    /// What a click that changes what the editor holds goes through. With nothing unsaved it simply happens;
    /// with text the file does not have, the question is asked and the click waits for the answer.
    /// </summary>
    private async Task LeaveAsync(Func<Task> next)
    {
        if (!IsDirty)
        {
            await next();
            return;
        }

        _leaveAction = next;
    }

    /// <summary>Asks before the app's own menu, the back button or a closed tab leaves text behind.</summary>
    /// <remarks>
    /// The navigation is already on its way when this runs, so the question is the browser's own prompt - the
    /// one the card inspector and the artifact editor ask with - rather than a dialog the navigation would
    /// have to wait for. What the prompt cannot offer is saving: the text stays in the editor, and saving is
    /// the editor's own button.
    /// </remarks>
    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (IsDirty && !await Js.InvokeAsync<bool>("confirm", Loc.Get("LeaveWithUnsavedEdits")))
        {
            context.PreventNavigation();
        }
    }

    /// <summary>Writes the text and only then carries the click out; a refused save stays where it is.</summary>
    private async Task SaveAndLeaveAsync() => await AnswerLeaveAsync(save: true);

    /// <summary>Lets the click go on without the text, which is a decision the reader has just made.</summary>
    private async Task DiscardAndLeaveAsync() => await AnswerLeaveAsync(save: false);

    /// <summary>Closes the question, which is what staying is: the click falls and nothing is lost.</summary>
    private void CancelLeave() => _leaveAction = null;

    private async Task AnswerLeaveAsync(bool save)
    {
        var next = _leaveAction;
        _leaveAction = null;
        _leaving = true;
        try
        {
            if (save)
            {
                // A refused save closes the question too, so the daemon's own sentence is what the reader sees.
                // What it must not do is carry the click out: the text the save was meant to keep would go
                // with it.
                if (!await SaveCoreAsync())
                {
                    return;
                }
            }
            else
            {
                // Discarding is a decision and not an assumption: the text stops counting as unsaved, and the
                // click that follows replaces it. A discarded new document is not a document at all, so its
                // path goes with the text.
                _baseline = _content;
                if (_open is null)
                {
                    _newPath = string.Empty;
                }
            }

            if (next is not null)
            {
                await next();
            }
        }
        finally
        {
            _leaving = false;
        }
    }

    /// <summary>The Save button's own action: what came of the save is said on the page.</summary>
    private async Task SaveAsync() => await SaveCoreAsync();

    /// <summary>
    /// Writes the editor's text into the memory and says whether the daemon took it. The question the page
    /// asks before a click needs that answer: a save that was refused must not carry the click out, or the
    /// text the save was meant to keep goes with it.
    /// </summary>
    private async Task<bool> SaveCoreAsync()
    {
        var path = _open?.Path ?? _newPath;
        if (string.IsNullOrWhiteSpace(path) || _content is null)
        {
            return false;
        }

        _message = null;
        _error = false;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"{BaseUrl}/document",
                new StoreMemoryRequest(path, _content),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                Show(await ReadErrorAsync(response), error: true);
                return false;
            }

            var stored = await response.Content.ReadFromJsonAsync<MemoryDocument>(PwaJson.Options);
            _open = stored;
            _content = stored?.Content ?? _content;
            _baseline = _content;
            _newPath = null;
            await LoadAsync();
            Show(Loc.Format("ProjectMemorySaved", stored?.Path ?? path), error: false);
            return true;
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
            return false;
        }
    }

    /// <summary>
    /// Asks before the open document leaves the memory: one click is not enough any more, because the file is
    /// gone for good and nothing on this screen brings it back. What is being asked about is the path the
    /// editor holds, so the question names exactly the document that would go.
    /// </summary>
    private void AskDelete() => _deleteAsk = _open?.Path is { Length: > 0 };

    /// <summary>Closes the question, which is what keeping the document is: nothing is sent.</summary>
    private void CancelDelete() => _deleteAsk = false;

    /// <summary>Carries the answer out. The delete itself is unchanged - one place still sends it.</summary>
    private async Task ConfirmDeleteAsync()
    {
        _deleteAsk = false;
        await DeleteAsync();
    }

    private async Task DeleteAsync()
    {
        if (_open?.Path is not { Length: > 0 } path)
        {
            return;
        }

        _message = null;
        _error = false;
        try
        {
            using var response = await Http.DeleteAsync(
                $"{BaseUrl}/document?path={Uri.EscapeDataString(path)}");
            if (!response.IsSuccessStatusCode)
            {
                Show(await ReadErrorAsync(response), error: true);
                return;
            }

            _open = null;
            _content = null;
            _baseline = null;
            _newPath = null;
            _results = [];
            _searched = false;
            await LoadAsync();
            Show(Loc.Format("ProjectMemoryDeleted", path), error: false);
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    /// <summary>
    /// What the daemon said went wrong. A refused path or a missing document is answered with its own
    /// sentence in <c>ErrorResponse</c>, and that sentence is what a person can act on.
    /// </summary>
    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
            if (error?.Message is { Length: > 0 } message)
            {
                return message;
            }
        }
        catch (Exception)
        {
            // A body that is not the daemon's error shape is answered by the status line below.
        }

        return $"{response.StatusCode} {response.ReasonPhrase}";
    }

    /// <summary>The first words of a document, so a search result is not a wall of text.</summary>
    private static string Excerpt(string content)
    {
        var flattened = string.Join(' ', content.Split(
            ['\r', '\n'],
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return flattened.Length <= 180 ? flattened : $"{flattened[..180]}…";
    }

    private void Show(string text, bool error)
    {
        _message = text;
        _error = error;
    }
}





