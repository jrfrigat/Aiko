@page "/p/{ProjectId}/memory"
@using Aiko.Application.Contracts
@using Aiko.Pwa.Contracts
@using Aiko.Pwa.Services
@inject HttpClient Http
@inject WorkspaceState State

@* The project's durable memory: the Markdown documents under `.aiko/memory` that an agent reads and
   writes with its tools. This screen is the same door a person can use - the list, the search, and the
   document itself - and it writes through the same store, so an agent and a screen never see two memories.

   Every call goes through the REST paths the MCP tools are built on; an error is the daemon's own
   sentence rather than a status code, because "no memory document 'notes.md' in this project" is a thing
   a person can act on and "404" is not. *@
<PageTitle>@Loc.Get("ProjectMemoryTitle")</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Gap="FlareSpacing.XXSmall">
        <FlareText Element="h2" Typo="TypographyScale.HeadlineSmall">@Loc.Get("ProjectMemoryTitle")</FlareText>
        <FlareText Element="span" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
            @Loc.Get("ProjectMemoryHint")
        </FlareText>
    </FlareStack>

    @if (_message is { Length: > 0 } note)
    {
        <FlareAlert Severity="@(_error ? AlertSeverity.Error : AlertSeverity.Success)"
                    Variant="AlertVariant.Outlined">@note</FlareAlert>
    }

    @* The search: the index is a projection of the files, so what comes back is the documents themselves. *@
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareStack Row="true" Align="FlareAlignItems.End" Gap="FlareSpacing.Small" Wrap="true">
                <AikoField Label="@Loc.Get("ProjectMemorySearchLabel")"
                           Placeholder="@Loc.Get("ProjectMemorySearchPlaceholder")"
                           Value="@_query"
                           ValueChanged="value => _query = value" />
                <FlareButton Variant="ButtonVariant.Filled"
                             Size="ButtonSize.Sm"
                             Disabled="@string.IsNullOrWhiteSpace(_query)"
                             OnClick="SearchAsync">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" /></LeadingIcon>
                    <ChildContent>@Loc.Get("ProjectMemorySearchAction")</ChildContent>
                </FlareButton>
            </FlareStack>

            @if (_searched)
            {
                @if (_results.Count == 0)
                {
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                        @Loc.Get("ProjectMemorySearchEmpty")
                    </FlareText>
                }
                else
                {
                    <span class="aiko-tag">@Loc.Format("ProjectMemorySearchResults", _results.Count)</span>
                    @foreach (var hit in _results)
                    {
                        var result = hit;
                        <FlareStack Row="true" Align="FlareAlignItems.Start"
                                    Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                            <FlareStack Gap="FlareSpacing.XXSmall">
                                <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @result.Path
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                    @Excerpt(result.Content)
                                </FlareText>
                            </FlareStack>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="() => OpenAsync(result.Path)">
                                <ChildContent>@Loc.Get("ProjectMemoryOpen")</ChildContent>
                            </FlareButton>
                        </FlareStack>
                    }
                }
            }
        </FlareStack>
    </FlarePaper>

    @* Every document in the memory, read from the files: the size and the date say which one moved last. *@
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ProjectMemoryDocuments")</FlareText>

            @if (_documents.Count == 0)
            {
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                    @Loc.Get("ProjectMemoryNone")
                </FlareText>
            }
            else
            {
                @foreach (var document in _documents)
                {
                    var item = document;
                    <FlareStack Row="true" Align="FlareAlignItems.Center"
                                Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Gap="FlareSpacing.XXSmall">
                            <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                @item.Path
                            </FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Format("ProjectMemorySize", DisplayFormat.Number((int)item.Size))
                                ·
                                @item.LastModifiedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </FlareText>
                        </FlareStack>
                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="() => OpenAsync(item.Path)">
                            <ChildContent>@Loc.Get("ProjectMemoryOpen")</ChildContent>
                        </FlareButton>
                    </FlareStack>
                }
            }
        </FlareStack>
    </FlarePaper>

    @* The document itself: the one that is open, or a new one whose path is typed before it is saved. *@
    <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
        <FlareStack Gap="FlareSpacing.Small">
            <FlareStack Row="true" Align="FlareAlignItems.Center"
                        Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ProjectMemoryEditor")</FlareText>
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="BeginNew">
                        <ChildContent>@Loc.Get("ProjectMemoryNew")</ChildContent>
                    </FlareButton>
                    <FlareButton Variant="ButtonVariant.Filled"
                                 Size="ButtonSize.Sm"
                                 Disabled="@(!CanSave)"
                                 OnClick="SaveAsync">
                        <ChildContent>@Loc.Get("ProjectMemorySave")</ChildContent>
                    </FlareButton>
                    <FlareButton Variant="ButtonVariant.Outlined"
                                 Size="ButtonSize.Sm"
                                 Disabled="@(!IsOpen)"
                                 OnClick="DeleteAsync">
                        <ChildContent>@Loc.Get("ProjectMemoryDelete")</ChildContent>
                    </FlareButton>
                </FlareStack>
            </FlareStack>

            @if (IsOpen)
            {
                <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                    @_open!.Path
                </FlareText>
            }
            else
            {
                <AikoField Label="@Loc.Get("ProjectMemoryPathLabel")"
                           Hint="@Loc.Get("ProjectMemoryNewHint")"
                           Placeholder="@Loc.Get("ProjectMemoryPathPlaceholder")"
                           Value="@_newPath"
                           ValueChanged="value => _newPath = value" />
            }

            <PromptField Name="@DocumentName"
                         Title="@Loc.Get("ProjectMemoryContent")"
                         Placeholder="@Loc.Get("ProjectMemoryHint")"
                         Rows="16"
                         Value="@_content"
                         ValueChanged="value => _content = value" />
        </FlareStack>
    </FlarePaper>
</FlareStack>

@code {
    /// <summary>The project in the route: its readable handle, or its id when a link was written by hand.</summary>
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// <summary>Every document of the memory, as the listing reports it.</summary>
    private IReadOnlyList<MemoryDocumentSummary> _documents = [];

    /// <summary>What the last search found. Empty after a search means it found nothing.</summary>
    private IReadOnlyList<MemoryDocument> _results = [];

    /// <summary>The text the search is looking for.</summary>
    private string? _query;

    /// <summary>Whether a search has run, so its empty answer is told from no search at all.</summary>
    private bool _searched;

    /// <summary>The document the editor holds, or null when the editor holds a new one.</summary>
    private MemoryDocument? _open;

    /// <summary>The text in the editor: what saving writes, which is not the file until the save lands.</summary>
    private string? _content;

    /// <summary>The path of the new document being written, before it exists in the memory.</summary>
    private string? _newPath;

    private string? _message;
    private bool _error;

    /// <summary>The memory of this project, under whichever of its names the route carries.</summary>
    private string BaseUrl => $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/memory";

    private bool IsOpen => _open is not null;

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_content) &&
        (_open is not null || !string.IsNullOrWhiteSpace(_newPath));

    /// <summary>What the editor's header bar names the file: the open path, or the one being written.</summary>
    private string DocumentName => _open?.Path is { Length: > 0 } open ? open : _newPath ?? "memory.md";

    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _documents = await Http.GetFromJsonAsync<IReadOnlyList<MemoryDocumentSummary>>(
                BaseUrl,
                PwaJson.Options) ?? [];
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _message = null;
        _error = false;
        try
        {
            _results = await Http.GetFromJsonAsync<IReadOnlyList<MemoryDocument>>(
                $"{BaseUrl}/search?q={Uri.EscapeDataString(_query)}",
                PwaJson.Options) ?? [];
            _searched = true;
        }
        catch (Exception exception)
        {
            _searched = true;
            _results = [];
            Show(exception.Message, error: true);
        }
    }

    /// <summary>
    /// Opens one document by path. A search result and a row of the listing take the same way in, so the
    /// editor shows what the file holds now rather than what a listing remembered.
    /// </summary>
    private async Task OpenAsync(string path)
    {
        _message = null;
        _error = false;
        try
        {
            using var response = await Http.GetAsync($"{BaseUrl}/document?path={Uri.EscapeDataString(path)}");
            if (!response.IsSuccessStatusCode)
            {
                Show(await ReadErrorAsync(response), error: true);
                return;
            }

            var document = await response.Content.ReadFromJsonAsync<MemoryDocument>(PwaJson.Options);
            _open = document;
            _content = document?.Content;
            _newPath = null;
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    /// <summary>Empties the editor for a document that does not exist yet.</summary>
    private void BeginNew()
    {
        _open = null;
        _content = string.Empty;
        _newPath = string.Empty;
        _message = null;
        _error = false;
    }

    private async Task SaveAsync()
    {
        var path = _open?.Path ?? _newPath;
        if (string.IsNullOrWhiteSpace(path) || _content is null)
        {
            return;
        }

        _message = null;
        _error = false;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"{BaseUrl}/document",
                new StoreMemoryRequest(path, _content),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                Show(await ReadErrorAsync(response), error: true);
                return;
            }

            var stored = await response.Content.ReadFromJsonAsync<MemoryDocument>(PwaJson.Options);
            _open = stored;
            _content = stored?.Content ?? _content;
            _newPath = null;
            await LoadAsync();
            Show(Loc.Format("ProjectMemorySaved", stored?.Path ?? path), error: false);
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    private async Task DeleteAsync()
    {
        if (_open?.Path is not { Length: > 0 } path)
        {
            return;
        }

        _message = null;
        _error = false;
        try
        {
            using var response = await Http.DeleteAsync(
                $"{BaseUrl}/document?path={Uri.EscapeDataString(path)}");
            if (!response.IsSuccessStatusCode)
            {
                Show(await ReadErrorAsync(response), error: true);
                return;
            }

            _open = null;
            _content = null;
            _newPath = null;
            _results = [];
            _searched = false;
            await LoadAsync();
            Show(Loc.Format("ProjectMemoryDeleted", path), error: false);
        }
        catch (Exception exception)
        {
            Show(exception.Message, error: true);
        }
    }

    /// <summary>
    /// What the daemon said went wrong. A refused path or a missing document is answered with its own
    /// sentence in <c>ErrorResponse</c>, and that sentence is what a person can act on.
    /// </summary>
    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
            if (error?.Message is { Length: > 0 } message)
            {
                return message;
            }
        }
        catch (Exception)
        {
            // A body that is not the daemon's error shape is answered by the status line below.
        }

        return $"{response.StatusCode} {response.ReasonPhrase}";
    }

    /// <summary>The first words of a document, so a search result is not a wall of text.</summary>
    private static string Excerpt(string content)
    {
        var flattened = string.Join(' ', content.Split(
            ['\r', '\n'],
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return flattened.Length <= 180 ? flattened : $"{flattened[..180]}…";
    }

    private void Show(string text, bool error)
    {
        _message = text;
        _error = error;
    }
}





