@page "/p/{ProjectId}/settings"
@inject HttpClient Http
@inject WorkspaceState State
@implements IAsyncDisposable

@* One project's settings, in the order the question is asked: what the project actually runs with and
   where each value comes from, then the values themselves, then the pipelines a card moves through. The
   installation's defaults are a separate screen at /settings. *@
<PageTitle>@Loc.Get("ProjectSettings")</PageTitle>

@if (State.Board is not { } board)
{
    <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("BoardUnavailable")</FlareAlert>
}
else
{
    <FlareStack Gap="FlareSpacing.Medium">
        @* The pipelines sit in the narrow column under the defaults: they are project content, and the list
           of stages reads fine beside the scoring tables rather than above them. *@
        <SettingsEditor ProjectId="@board.Project.Id">
            <ExtraNarrowContent>
                @* Which agents this project has been connected to. The dashboard's Agents card answers the
                   machine-wide question - installed, and connected for the user - while this list answers the
                   project's, and the two differ for a project nobody has connected an agent to yet. *@
                <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("Agents")</FlareText>
                        @foreach (var connection in State.ProjectConnections)
                        {
                            var item = connection;
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall">@item.DisplayName</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall"
                                           Color="@(item.Connected ? FlareColor.Success : FlareColor.OnSurfaceVariant2)">
                                    @(item.Connected ? Loc.Get("AgentConnected") : Loc.Get("AgentNotConnected"))
                                </FlareText>
                            </FlareStack>
                        }
                    </FlareStack>
                </FlarePaper>
                @* The projects this one hands work to. A link is a sentence rather than an id: an agent reads the
                   description before deciding that a piece of work belongs to the neighbour, so the panel asks
                   for those words and shows them back with a way to take the link away. *@
                <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("LinkedProjects")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("LinkedProjectsHint")
                        </FlareText>

                        @if (_links.Count == 0)
                        {
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("LinkedProjectsNone")
                            </FlareText>
                        }
                        else
                        {
                            @foreach (var link in _links)
                            {
                                var item = link;
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                                    <FlareStack Gap="FlareSpacing.None">
                                        <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@item.Handle</FlareText>
                                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                                            @item.Description
                                        </FlareText>
                                    </FlareStack>
                                    <FlareIconButton Variant="ButtonVariant.Text"
                                                     Icon="@FlareIcons.Close"
                                                     AriaLabel="@Loc.Get("LinkedProjectsRemove")"
                                                     OnClick="() => RemoveLinkAsync(item)" />
                                </FlareStack>
                            }
                        }

                        @if (_linkMessage is { Length: > 0 } note)
                        {
                            <FlareAlert Severity="@(_linkError ? AlertSeverity.Error : AlertSeverity.Success)"
                                        Variant="AlertVariant.Text">@note</FlareAlert>
                        }

                        <AikoSelectField Label="@Loc.Get("LinkedProjectsPick")"
                                         Value="@_linkTarget"
                                         ValueChanged="value => _linkTarget = value"
                                         Hint="@Loc.Get("LinkedProjectsPickHint")">
                            <option value="">@Loc.Get("LinkedProjectsPickNone")</option>
                            @foreach (var candidate in LinkCandidates())
                            {
                                var item = candidate;
                                <option value="@item.Handle">@item.Name</option>
                            }
                        </AikoSelectField>
                        <AikoField Label="@Loc.Get("LinkedProjectsDescription")"
                                   Rows="2"
                                   Placeholder="@Loc.Get("LinkedProjectsDescriptionPlaceholder")"
                                   Value="@_linkDescription"
                                   ValueChanged="value => _linkDescription = value" />
                        <FlareStack Row="true" Justify="FlareJustifyContent.End">
                            <FlareButton Variant="ButtonVariant.Tonal"
                                         Size="ButtonSize.Sm"
                                         Disabled="@(string.IsNullOrWhiteSpace(_linkTarget) || string.IsNullOrWhiteSpace(_linkDescription))"
                                         OnClick="AddLinkAsync">
                                <ChildContent>@Loc.Get("LinkedProjectsAdd")</ChildContent>
                            </FlareButton>
                        </FlareStack>
                    </FlareStack>
                </FlarePaper>
                <WorkflowInspector Workflows="board.Workflows"
                                   Cards="board.Cards"
                                   InitialWorkflowId="@board.Workflows.FirstOrDefault()?.Id"
                                   Save="SaveWorkflowAsync"
                                   Create="CreateWorkflowAsync"
                                   Rename="RenameWorkflowAsync"
                                   Delete="DeleteWorkflowAsync" />
            </ExtraNarrowContent>
        </SettingsEditor>
    </FlareStack>
}

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private Task OnStateChanged() => InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        return ValueTask.CompletedTask;
    }

    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// <summary>The projects this one is linked to, as the registry holds them.</summary>
    private IReadOnlyList<ProjectLink> _links = [];

    /// <summary>The handle chosen in the picker, or null when nothing is chosen yet.</summary>
    private string? _linkTarget;

    /// <summary>What the person said the chosen project is for, before it is stored.</summary>
    private string? _linkDescription;

    private string? _linkMessage;
    private bool _linkError;

    /// <summary>
    /// The projects that can still be linked: the registered ones, without this project and without the
    /// projects already linked.
    /// </summary>
    private IEnumerable<RegisteredProject> LinkCandidates() =>
        State.Projects
            .Where(project => !StringComparer.Ordinal.Equals(project.Id, State.Board?.Project.Id))
            .Where(project => _links.All(link =>
                !StringComparer.Ordinal.Equals(link.ProjectId, project.Id)))
            .OrderBy(project => project.Name, StringComparer.Ordinal);

    private async Task LoadLinksAsync()
    {
        try
        {
            _links = await Http.GetFromJsonAsync<IReadOnlyList<ProjectLink>>(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/links",
                PwaJson.Options) ?? [];
        }
        catch (Exception exception)
        {
            _linkMessage = exception.Message;
            _linkError = true;
        }
    }

    private async Task AddLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_linkTarget) || string.IsNullOrWhiteSpace(_linkDescription))
        {
            return;
        }

        _linkMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/links/{Uri.EscapeDataString(_linkTarget)}",
                new LinkProjectRequest(_linkDescription),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            _linkTarget = null;
            _linkDescription = null;
            await LoadLinksAsync();
        }
        catch (Exception exception)
        {
            _linkMessage = exception.Message;
            _linkError = true;
        }
    }

    private async Task RemoveLinkAsync(ProjectLink link)
    {
        _linkMessage = null;
        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/links/{Uri.EscapeDataString(link.Handle)}");
            response.EnsureSuccessStatusCode();
            await LoadLinksAsync();
        }
        catch (Exception exception)
        {
            _linkMessage = exception.Message;
            _linkError = true;
        }
    }

    /// <summary>
    /// Writes one pipeline of this project and reloads the board, so the editor's revision follows. Returns
    /// the failure text, or null when it was saved.
    /// </summary>
    private async Task<string?> SaveWorkflowAsync(WorkflowDefinition workflow)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows/{Uri.EscapeDataString(workflow.Id)}",
                new UpdateWorkflowRequest(
                    workflow.Title,
                    workflow.Stages,
                    workflow.Revision,
                    workflow.Description,
                    workflow.Icon,
                    workflow.Color,
                    workflow.BlendsWithParent),
                PwaJson.Options);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await State.LoadBoardAsync();
                return Loc.Get("WorkflowConflict");
            }

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Creates one more card type: a workflow of its own. Returns the failure text, or null when it was
    /// created.
    /// </summary>
    private async Task<string?> CreateWorkflowAsync(WorkflowDefinition workflow)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows",
                new CreateWorkflowRequest(
                    workflow.Id,
                    workflow.Title,
                    workflow.Stages,
                    workflow.Description,
                    workflow.Icon,
                    workflow.Color,
                    workflow.BlendsWithParent),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Renames a card type: the workflow's id changes, and the daemon moves its board sections with it.
    /// Returns the failure text, or null when it was renamed.
    /// </summary>
    private async Task<string?> RenameWorkflowAsync(string currentId, string newId)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows/{Uri.EscapeDataString(currentId)}/rename",
                new RenameWorkflowRequest(newId),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Removes a card type. The daemon refuses while cards of that type exist. Returns the failure text, or
    /// null when it was removed.
    /// </summary>
    private async Task<string?> DeleteWorkflowAsync(WorkflowDefinition workflow)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows/{Uri.EscapeDataString(workflow.Id)}");
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Opens the project the page names and reads its link registry: the panel shows what the file says, and
    /// both reloads go together because the settings screen is where the project is read in full.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        await LoadLinksAsync();
    }
}
