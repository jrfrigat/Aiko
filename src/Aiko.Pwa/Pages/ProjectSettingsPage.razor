@page "/p/{ProjectId}/settings"
@inject HttpClient Http
@inject WorkspaceState State
@implements IAsyncDisposable

@* One project's settings, in the order the question is asked: what the project actually runs with and
   where each value comes from, then the values themselves, then the pipelines a card moves through. The
   installation's defaults are a separate screen at /settings. *@
<PageTitle>@Loc.Get("ProjectSettings")</PageTitle>

@if (State.BoardPending)
{
    @* The settings screen's own shape, drawn from the measured screen: the two columns it draws, the narrow one
       beside the wide one, each reserved to the fold - how long the scoring tables are depends on the project. *@
    <AikoSkeletonRegion>
        <div class="aiko-settings">
            <FlareStack Class="aiko-settings__narrow" Gap="FlareSpacing.Medium" Align="FlareAlignItems.Stretch">
                <AikoSkeletonPanel Lines="4" Height="var(--aiko-skeleton-panel-size)" />
                <AikoSkeletonPanel Lines="3" Height="var(--aiko-skeleton-fold-size)" />
            </FlareStack>
            <FlareStack Class="aiko-settings__wide" Gap="FlareSpacing.Medium" Align="FlareAlignItems.Stretch">
                <AikoSkeletonPanel Lines="6" Height="var(--aiko-skeleton-fold-size)" />
                <AikoSkeletonPanel Lines="5" Height="var(--aiko-skeleton-panel-size)" />
            </FlareStack>
        </div>
    </AikoSkeletonRegion>
}
else if (State.Board is not { } board)
{
    <FlareAlert Severity="AlertSeverity.Info" Variant="AlertVariant.Text">@Loc.Get("BoardUnavailable")</FlareAlert>
}
else
{
    <FlareStack Gap="FlareSpacing.Medium">
        @* The pipelines sit in the narrow column under the defaults: they are project content, and the list
           of stages reads fine beside the scoring tables rather than above them. *@
        <SettingsEditor ProjectId="@board.Project.Id">
            <ExtraNarrowContent>
                @* Which agents this project has been connected to. The dashboard's Agents card answers the
                   machine-wide question - installed, and connected for the user - while this list answers the
                   project's, and the two differ for a project nobody has connected an agent to yet. *@
                <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("Agents")</FlareText>
                        @foreach (var connection in State.ProjectConnections)
                        {
                            var item = connection;
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall">@item.DisplayName</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall"
                                           Color="@(item.Connected ? FlareColor.Success : FlareColor.OnSurfaceVariant2)">
                                    @(item.Connected ? Loc.Get("AgentConnected") : Loc.Get("AgentNotConnected"))
                                </FlareText>
                            </FlareStack>
                        }
                        @foreach (var agentConfig in State.AgentConfigs)
                        {
                            var item = agentConfig;
                            var editor = Editor(item);
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall">@InstanceTitle(item, editor)</FlareText>
                                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                        @(item.AdapterId ?? item.Id) · @CapabilitySource(item)
                                    </FlareText>
                                </FlareStack>
                                <AikoField Label="@Loc.Get("AgentDisplayName")"
                                           Value="@editor.DisplayName"
                                           ValueChanged="value => editor.DisplayName = value ?? string.Empty" />
                                <AikoSelectField Label="@Loc.Get("AgentTransport")"
                                                 Value="@editor.Transport.ToString()"
                                                 ValueChanged="value => SelectTransport(editor, value)">
                                    @foreach (var transport in item.SupportedTransports)
                                    {
                                        <option value="@transport.ToString()">@transport.ToString()</option>
                                    }
                                </AikoSelectField>
                                @if (editor.Transport == AgentTransport.Acp)
                                {
                                    <AikoField Label="@Loc.Get("AgentAcpExecutable")"
                                               Value="@editor.Executable"
                                               ValueChanged="value => editor.Executable = value ?? string.Empty" />
                                }
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                    @Loc.Get("AgentEnvironment")
                                </FlareText>
                                @foreach (var variable in editor.Environment.Entries)
                                {
                                    var entry = variable;
                                    <FlareStack Row="true" Align="FlareAlignItems.End" Gap="FlareSpacing.XSmall">
                                        <AikoField Label="@Loc.Get("AgentEnvironmentKey")"
                                                   Value="@entry.Key"
                                                   ValueChanged="value => entry.Key = value ?? string.Empty" />
                                        <AikoField Label="@Loc.Get("AgentEnvironmentValue")"
                                                   Value="@entry.Value"
                                                   ValueChanged="value => entry.Value = value ?? string.Empty" />
                                        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                                     OnClick="() => RemoveVariable(editor, entry)">
                                            @Loc.Get("Remove")
                                        </FlareButton>
                                    </FlareStack>
                                }
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                                             OnClick="() => AddVariable(editor)">
                                    @Loc.Get("AgentEnvironmentAdd")
                                </FlareButton>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("AgentEnvironmentHint")
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Capabilities(item)
                                </FlareText>
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="() => SaveAgentAsync(item)">
                                    @Loc.Get("SaveAgent")
                                </FlareButton>
                            </FlareStack>
                        }
                        @* One adapter can run as several configured instances - the same executable with another
                           endpoint, model or token. A new one starts from the default instance's transport and
                           launcher; its environment is filled here, because the API never sends secrets back. *@
                        <FlareStack Gap="FlareSpacing.XSmall">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                                @Loc.Get("AgentInstanceAdd")
                            </FlareText>
                            <AikoSelectField Label="@Loc.Get("AgentInstanceAdapter")"
                                             Value="@newInstanceAdapter"
                                             ValueChanged="value => newInstanceAdapter = value">
                                @foreach (var adapter in State.Agents)
                                {
                                    var option = adapter;
                                    <option value="@option.Id">@option.DisplayName</option>
                                }
                            </AikoSelectField>
                            <AikoField Label="@Loc.Get("AgentInstanceId")"
                                       Value="@newInstanceId"
                                       ValueChanged="value => newInstanceId = value" />
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddInstanceAsync">
                                @Loc.Get("AgentInstanceAdd")
                            </FlareButton>
                            @if (instanceMessage is { Length: > 0 } message)
                            {
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.Error">
                                    @message
                                </FlareText>
                            }
                        </FlareStack>
                    </FlareStack>
                </FlarePaper>
                @* The linked-projects registry has a screen of its own, reached from the rail: one place to
                   edit a link, with room for correcting a description rather than only adding and removing
                   one. This panel says where that screen is, so the settings page still answers the question
                   it used to. *@
                <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.XSmall">
                        <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("LinkedProjects")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("LinkedProjectsMovedHint")
                        </FlareText>
                        <FlareNavLink Href="@LinksHref(board.Project.Handle)">
                            <ChildContent>@Loc.Get("LinkedProjectsOpen")</ChildContent>
                        </FlareNavLink>
                    </FlareStack>
                </FlarePaper>
                @* How a release is conducted, in words. The order used to live in the workflow files and in
                   whoever remembered it; here it is where a person looks for it, and it says plainly what the
                   installation touches and what it leaves alone - the second half is the one people are
                   actually asking about. The screen itself is one link away rather than repeated here. *@
                <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                    <FlareStack Gap="FlareSpacing.XSmall">
                        <FlareText Element="h3" Typo="TypographyScale.TitleSmall">@Loc.Get("ReleaseProcedureTitle")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("ReleaseProcedureHint")
                        </FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall">@Loc.Get("ReleaseProcedureOrder")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("ReleaseProcedureTouches")
                        </FlareText>
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.Success">
                            @Loc.Get("ReleaseProcedureKeeps")
                        </FlareText>
                        <FlareNavLink Href="@ReleaseHref(board.Project.Handle)">
                            <ChildContent>@Loc.Get("ReleaseProcedureOpen")</ChildContent>
                        </FlareNavLink>
                    </FlareStack>
                </FlarePaper>
                <WorkflowInspector Workflows="board.Workflows"
                                   Cards="board.Cards"
                                   InitialWorkflowId="@board.Workflows.FirstOrDefault()?.Id"
                                   Save="SaveWorkflowAsync"
                                   Create="CreateWorkflowAsync"
                                   Rename="RenameWorkflowAsync"
                                   Delete="DeleteWorkflowAsync" />
            </ExtraNarrowContent>
        </SettingsEditor>
    </FlareStack>
}

@code {
    private readonly Dictionary<string, InstanceEditor> instanceEditors =
        new(StringComparer.OrdinalIgnoreCase);
    private string? loadedProjectId;
    private string? newInstanceAdapter;
    private string? newInstanceId;
    private string? instanceMessage;

    /// <summary>What one instance's form holds while it is being edited.</summary>
    private sealed class InstanceEditor
    {
        public string AdapterId { get; init; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public AgentTransport Transport { get; set; }
        public string Executable { get; set; } = string.Empty;
        public AgentEnvironmentEditor Environment { get; init; } = new();
    }

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private Task OnStateChanged() => InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        return ValueTask.CompletedTask;
    }

    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// <summary>
    /// Where a link is edited now. The registry has a screen of its own, reached from the rail, so this page
    /// points at it instead of carrying a second editor of the same file.
    /// </summary>
    private static string LinksHref(string projectHandle) =>
        ProjectRoutes.Section(projectHandle, "links");

    /// <summary>
    /// Where the release screen of this project lives. It goes through <c>ProjectRoutes.Release</c> so the
    /// section is named once - the page, the rail and this panel all follow the same helper.
    /// </summary>
    private static string ReleaseHref(string projectHandle) =>
        ProjectRoutes.Release(projectHandle);

    private InstanceEditor Editor(EffectiveAgentConfig config)
    {
        if (instanceEditors.TryGetValue(config.Id, out var existing))
        {
            return existing;
        }

        var editor = new InstanceEditor
        {
            AdapterId = config.AdapterId ?? config.Id,
            DisplayName = config.DisplayName ?? config.Id,
            Transport = config.Transport,
            Executable = config.Acp?.Executable ?? string.Empty,
            Environment = AgentEnvironmentEditor.Load(config.Acp?.Environment)
        };
        instanceEditors[config.Id] = editor;
        return editor;
    }

    private static string InstanceTitle(EffectiveAgentConfig config, InstanceEditor editor) =>
        string.IsNullOrWhiteSpace(editor.DisplayName) ? config.Id : editor.DisplayName;

    private static string CapabilitySource(EffectiveAgentConfig config) =>
        config.Sources.TryGetValue("transport", out var source) ? source.ToString() : "default";

    private static void SelectTransport(InstanceEditor editor, string? value)
    {
        if (Enum.TryParse<AgentTransport>(value, out var transport))
        {
            editor.Transport = transport;
        }
    }

    private static void AddVariable(InstanceEditor editor) => editor.Environment.Add();

    private static void RemoveVariable(InstanceEditor editor, AgentEnvironmentEntry entry) =>
        editor.Environment.Remove(entry);

    private string Capabilities(EffectiveAgentConfig config) =>
        $"{Loc.Get("AgentAikoAccess")}: {string.Join(", ", config.Capabilities.AikoAccess ?? [])}; " +
        $"{Loc.Get("AgentActions")}: {string.Join(", ", config.Capabilities.Actions ?? [])}; " +
        $"{Loc.Get("AgentStages")}: {string.Join(", ", config.Capabilities.Stages ?? [])}; " +
        $"{Loc.Get("AgentCardTypes")}: {string.Join(", ", config.Capabilities.CardTypes ?? [])}; " +
        $"{Loc.Get("AgentSessions")}: {config.Capabilities.MaxConcurrentSessions}";

    private async Task SaveAgentAsync(EffectiveAgentConfig config)
    {
        if (State.Board is not { } board ||
            !instanceEditors.TryGetValue(config.Id, out var editor))
        {
            return;
        }

        var acp = editor.Transport == AgentTransport.Acp
            ? new AgentAcpConfig(
                Executable: string.IsNullOrWhiteSpace(editor.Executable)
                    ? null
                    : editor.Executable.Trim(),
                Args: config.Acp?.Args,
                Environment: editor.Environment.ToEnvironment())
            : null;
        await State.SaveAgentConfigAsync(
            board.Project.Id,
            new AgentConfig(
                Id: config.Id,
                AdapterId: editor.AdapterId,
                DisplayName: string.IsNullOrWhiteSpace(editor.DisplayName)
                    ? null
                    : editor.DisplayName.Trim(),
                Transport: editor.Transport,
                Acp: acp));
    }

    /// <summary>
    /// Creates one more instance of an adapter from its default instance's transport and launcher. The
    /// environment is not copied: the API sends it masked, and the real values belong to the default
    /// instance alone.
    /// </summary>
    private async Task AddInstanceAsync()
    {
        if (State.Board is not { } board)
        {
            return;
        }

        instanceMessage = null;
        var id = newInstanceId?.Trim();
        if (string.IsNullOrWhiteSpace(id))
        {
            instanceMessage = Loc.Get("AgentInstanceNameRequired");
            return;
        }

        if (string.IsNullOrWhiteSpace(newInstanceAdapter))
        {
            return;
        }

        var adapterId = newInstanceAdapter;
        var defaultInstance = State.AgentConfigs.FirstOrDefault(config =>
            StringComparer.Ordinal.Equals(config.Id, adapterId));
        var saved = await State.SaveAgentConfigAsync(
            board.Project.Id,
            new AgentConfig(
                Id: id,
                AdapterId: adapterId,
                Transport: defaultInstance?.Transport,
                Acp: defaultInstance?.Acp is { } acp
                    ? new AgentAcpConfig(Executable: acp.Executable, Args: acp.Args)
                    : null));
        if (!saved)
        {
            return;
        }

        newInstanceId = null;
        await State.LoadAgentConfigsAsync(board.Project.Id);
    }

    /// <summary>
    /// Writes one pipeline of this project and reloads the board, so the editor's revision follows. Returns
    /// the failure text, or null when it was saved.
    /// </summary>
    private async Task<string?> SaveWorkflowAsync(WorkflowDefinition workflow)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows/{Uri.EscapeDataString(workflow.Id)}",
                new UpdateWorkflowRequest(
                    workflow.Title,
                    workflow.Stages,
                    workflow.Revision,
                    workflow.Description,
                    workflow.Icon,
                    workflow.Color,
                    workflow.BlendsWithParent),
                PwaJson.Options);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await State.LoadBoardAsync();
                return Loc.Get("WorkflowConflict");
            }

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Creates one more card type: a workflow of its own. Returns the failure text, or null when it was
    /// created.
    /// </summary>
    private async Task<string?> CreateWorkflowAsync(WorkflowDefinition workflow)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows",
                new CreateWorkflowRequest(
                    workflow.Id,
                    workflow.Title,
                    workflow.Stages,
                    workflow.Description,
                    workflow.Icon,
                    workflow.Color,
                    workflow.BlendsWithParent),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Renames a card type: the workflow's id changes, and the daemon moves its board sections with it.
    /// Returns the failure text, or null when it was renamed.
    /// </summary>
    private async Task<string?> RenameWorkflowAsync(string currentId, string newId)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows/{Uri.EscapeDataString(currentId)}/rename",
                new RenameWorkflowRequest(newId),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Removes a card type. The daemon refuses while cards of that type exist. Returns the failure text, or
    /// null when it was removed.
    /// </summary>
    private async Task<string?> DeleteWorkflowAsync(WorkflowDefinition workflow)
    {
        if (State.Board is not { } board)
        {
            return Loc.Get("BoardUnavailable");
        }

        try
        {
            using var response = await Http.DeleteAsync(
                $"api/v1/projects/{Uri.EscapeDataString(board.Project.Id)}/workflows/{Uri.EscapeDataString(workflow.Id)}");
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(PwaJson.Options);
                return error?.Message ?? Loc.Format("ServerRejectedChanges", (int)response.StatusCode);
            }

            await State.LoadBoardAsync();
            return null;
        }
        catch (Exception exception)
        {
            return Loc.Format("SaveWorkflowFailed", exception.Message);
        }
    }

    /// <summary>
    /// Opens the project the page names. The page carries the project's own panels; the linked-projects
    /// registry it used to hold has moved to its own screen.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await State.EnsureProjectAsync(ProjectId);
        if (State.Board is { } board &&
            !StringComparer.Ordinal.Equals(loadedProjectId, board.Project.Id))
        {
            loadedProjectId = board.Project.Id;
            instanceEditors.Clear();
            newInstanceAdapter = State.Agents.FirstOrDefault()?.Id;
            newInstanceId = null;
            instanceMessage = null;
            await State.LoadAgentConfigsAsync(board.Project.Id);
        }
    }
}
