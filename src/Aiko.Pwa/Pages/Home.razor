@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>Aiko</PageTitle>

@* The whole shell is a FlareLayout: the project rail is a persistent start drawer, the inspector is a
   persistent end drawer, and the board lives in the content area. Flare owns the grid, the app bar,
   the drawer tracks and the responsive switch to off-canvas overlays below the Md breakpoint, so the
   app carries no shell CSS of its own. *@
<FlareLayout>
    <FlareLayoutAppBar DrawerToggle="true">
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" StretchFirst="true">
            @* Brand: an icon tile, the app name, the daemon version and the AOT tag. *@
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlarePaper Elevation="0" Class="aiko-brand">
                    <FlareIconView Value="@FlareIcons.GridOn" Color="FlareColor.Primary" />
                </FlarePaper>
                <FlareStack Gap="FlareSpacing.None">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="h1" Typo="TypographyScale.HeadlineMedium">Aiko</FlareText>
                        @if (_system is not null)
                        {
                            <span class="aiko-tag aiko-tag--accent">v@_system.Version</span>
                        }
                        <span class="aiko-tag">@Loc.Get("NativeAot")</span>
                    </FlareStack>
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
                        @(_board?.Project.Name ?? Loc.Get("BoardCaption"))
                    </FlareText>
                </FlareStack>
            </FlareStack>

            @* Telemetry: daemon state and the local endpoint. *@
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Class="aiko-status">
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Class="aiko-pill">
                    <FlareBadge Dot="true"
                                Standalone="true"
                                Color="@(_eventsConnected ? FlareColor.Tertiary : FlareColor.Warning)" />
                    <FlareText Element="span" Mono="true" Color="@(_eventsConnected ? FlareColor.Tertiary : FlareColor.Warning)">
                        @(_eventsConnected ? "SSE LIVE" : "ONLINE")
                    </FlareText>
                </FlareStack>
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall" Class="aiko-pill">
                    <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@Loc.Get("Host")</FlareText>
                    <FlareText Element="span" Mono="true">@HostCaption</FlareText>
                </FlareStack>
            </FlareStack>

            @if (_board is not null)
            {
                <FlareSelect TValue="string"
                             Label="@Loc.Get("CardFilter")"
                             Size="FieldSize.Sm"
                             Value="@_selectedCardId"
                             ValueChanged="SelectCardAsync">
                    <option value="">@Loc.Get("Choose")</option>
                    @foreach (var card in VisibleCards)
                    {
                        <option value="@card.Reference.CardId">@card.Reference.CardId - @card.Title</option>
                    }
                </FlareSelect>

                @* The design's mode switch: a hairline container with an accent-filled segment. *@
                <FlareToggleGroup TValue="Projection"
                                  Size="ButtonSize.Sm"
                                  Value="_projection"
                                  ValueChanged="ChangeProjectionAsync">
                    @* Value is object-typed, so the enum member must be written as an expression - a bare
                       literal would arrive at the group as the string "Projection.Stories". *@
                    <FlareToggleButton Variant="ButtonVariant.Filled" Value="@Projection.Stories">Stories</FlareToggleButton>
                    <FlareToggleButton Variant="ButtonVariant.Filled" Value="@Projection.Tasks">Tasks</FlareToggleButton>
                    <FlareToggleButton Variant="ButtonVariant.Filled" Value="@Projection.Combined">Общая</FlareToggleButton>
                </FlareToggleGroup>
            }

            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                @if (_board is not null)
                {
                    <FlareButton Variant="ButtonVariant.Filled" Size="ButtonSize.Sm" OnClick="OpenCreateCard">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.Add" /></LeadingIcon>
                        <ChildContent>@Loc.Get("CreateCard")</ChildContent>
                    </FlareButton>
                    <FlareButton Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm" OnClick="OpenWorkflow">
                        <LeadingIcon><FlareIconView Value="@FlareIcons.Tune" /></LeadingIcon>
                        <ChildContent>@Loc.Get("Workflow")</ChildContent>
                    </FlareButton>
                }
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="OpenSettings">
                    <LeadingIcon><FlareIconView Value="@FlareIcons.Settings" /></LeadingIcon>
                    <ChildContent>@Loc.Get("Settings")</ChildContent>
                </FlareButton>
                <FlareIconButton Variant="ButtonVariant.Text"
                                 Icon="@FlareIcons.Refresh"
                                 AriaLabel="@Loc.Get("Refresh")"
                                 Loading="@_loading"
                                 OnClick="ReloadAsync" />
            </FlareStack>
        </FlareStack>
    </FlareLayoutAppBar>

    <FlareLayoutDrawer @bind-Open="_railOpen"
                       Variant="DrawerVariant.Persistent"
                       Width="16rem"
                       AriaLabel="Проекты Aiko">
        <FlareNavMenu>
            <HeaderContent>
                <FlareStack Class="aiko-rail__head" Gap="FlareSpacing.XXSmall">
                    <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                        @Loc.Get("WorkspaceFlow")
                    </FlareText>
                    <FlareNavLink Active="@(_projection == Projection.Combined)"
                                  OnClick="() => ShowProjectionAsync(Projection.Combined)">
                        <IconContent><FlareIconView Value="@FlareIcons.GridOn" /></IconContent>
                        <ChildContent>@Loc.Get("KanbanBoard")</ChildContent>
                        <BadgeContent><span class="aiko-tag aiko-tag--accent">@(_board?.Cards.Count ?? 0)</span></BadgeContent>
                    </FlareNavLink>
                    <FlareNavLink Active="@(_projection == Projection.Stories)"
                                  OnClick="() => ShowProjectionAsync(Projection.Stories)">
                        <IconContent><FlareIconView Value="@FlareIcons.FolderOpen" /></IconContent>
                        <ChildContent>Stories</ChildContent>
                        <BadgeContent><span class="aiko-tag">@StoryCount</span></BadgeContent>
                    </FlareNavLink>
                    <FlareNavLink Active="@(_projection == Projection.Tasks)"
                                  OnClick="() => ShowProjectionAsync(Projection.Tasks)">
                        <IconContent><FlareIconView Value="@FlareIcons.ViewColumn" /></IconContent>
                        <ChildContent>Tasks</ChildContent>
                        <BadgeContent><span class="aiko-tag">@TaskCount</span></BadgeContent>
                    </FlareNavLink>
                    <FlareNavLink Active="@_editingWorkflow" OnClick="OpenWorkflow">
                        <IconContent><FlareIconView Value="@FlareIcons.Tune" /></IconContent>
                        <ChildContent>@Loc.Get("Workflow")</ChildContent>
                        <BadgeContent><span class="aiko-tag">@(_board?.Workflows.Count ?? 0)</span></BadgeContent>
                    </FlareNavLink>
                    <FlareNavLink Active="@_editingSettings" OnClick="OpenSettings">
                        <IconContent><FlareIconView Value="@FlareIcons.Settings" /></IconContent>
                        <ChildContent>@Loc.Get("Settings")</ChildContent>
                        <BadgeContent><FlareIconView Value="@FlareIcons.ChevronRight" /></BadgeContent>
                    </FlareNavLink>
                </FlareStack>
            </HeaderContent>

            <FooterContent>
                <FlareStack Class="aiko-rail__foot" Gap="FlareSpacing.XXSmall">
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow">
                            @Loc.Get("OrchestrationLoad")
                        </FlareText>
                        <FlareText Element="span" Mono="true" Color="FlareColor.Tertiary">@LoadPercent%</FlareText>
                    </FlareStack>
                    <FlareProgressLinear Value="@LoadPercent" Size="TrackSize.Xs" Color="FlareColor.Tertiary" />
                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XXSmall">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                            <FlareBadge Dot="true"
                                        Standalone="true"
                                        Color="@(_eventsConnected ? FlareColor.Tertiary : FlareColor.Warning)" />
                            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">
                                @Loc.Get("ContextEngine")
                            </FlareText>
                        </FlareStack>
                        <FlareText Element="span" Mono="true" Color="FlareColor.Secondary">
                            @(_eventsConnected ? "SSE" : "online")
                        </FlareText>
                    </FlareStack>
                </FlareStack>
            </FooterContent>

            <ChildContent>
                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Class="aiko-eyebrow aiko-rail__group">
                    @Loc.Get("Projects")
                </FlareText>
                @foreach (var project in _projects)
                {
                    <FlareNavLink Active="@(project.Id == _selectedProjectId)"
                                  Tooltip="@project.RootPath"
                                  OnClick="() => SelectProjectAsync(project.Id)">
                        <IconContent>
                            <FlareAvatar Text="@Initials(project.Name)"
                                         Size="AvatarSize.Xs"
                                         Shape="AvatarShape.Square" />
                        </IconContent>
                        <ChildContent>@project.Name</ChildContent>
                        <BadgeContent>
                            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">
                                @ProjectPath(project.RootPath)
                            </FlareText>
                        </BadgeContent>
                    </FlareNavLink>
                }
            </ChildContent>
        </FlareNavMenu>
    </FlareLayoutDrawer>

    <FlareLayoutContent>
        <FlareStack Gap="FlareSpacing.Medium">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <FlareAlert Severity="AlertSeverity.Error"
                            Variant="AlertVariant.Outlined"
                            Title="@Loc.Get("BoardUpdateFailed")">@_error</FlareAlert>
            }

            @if (_loading && _board is null)
            {
                <FlareStack Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <FlareProgressCircular />
                    <FlareText Element="span" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                        @Loc.Get("LoadingContext")
                    </FlareText>
                </FlareStack>
            }
            else if (_projects.Count == 0)
            {
                <FlareEmptyState Title="@Loc.Get("EmptyStateTitle")"
                                 Description="Инициализируйте проект через Aiko, и он появится в этой панели.">
                    <IconContent><FlareIconView Size="3rem" Value="@FlareIcons.FolderOpen" /></IconContent>
                    <ActionContent>
                        <FlareButton OnClick="OpenAddProject">@Loc.Get("AddProject")</FlareButton>
                    </ActionContent>
                </FlareEmptyState>
            }
            else if (_board is not null)
            {
                @* The design's metric strip: a mono summary line, not a row of tiles. *@
                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true" Class="aiko-metrics">
                    @foreach (var tile in SummaryTiles)
                    {
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall">
                            <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant">@tile.Label</FlareText>
                            <FlareText Element="span" Mono="true"
                                       Color="@(tile.Warn ? FlareColor.Error : FlareColor.Tertiary)"
                                       Weight="FontWeight.SemiBold">@tile.Value</FlareText>
                        </FlareStack>
                    }
                    <FlareText Element="span" Mono="true" Color="FlareColor.OnSurfaceVariant2">@ProjectionCaption</FlareText>
                </FlareStack>

                @if (SettingsInspector.IsParallelShared(_settingsView?.EffectiveExecution))
                {
                    <FlareAlert Severity="AlertSeverity.Warning"
                                Variant="AlertVariant.Outlined"
                                Title="@Loc.Get("ParallelSharedTitle")">@Loc.Get("ParallelSharedText")</FlareAlert>
                }

                <FlareDivider />

                @if (_projection is Projection.Stories or Projection.Combined)
                {
                    <BoardSection Title="Story flow"
                                  Kind="CardKind.Story"
                                  Board="_board"
                                  OnCardMoved="move => MoveCardAsync(CardKind.Story, move)" />
                }

                @if (_projection == Projection.Combined)
                {
                    <FlareDivider Text="@Loc.Get("Implementation")" />
                }

                @if (_projection is Projection.Tasks or Projection.Combined)
                {
                    <BoardSection Title="Task flow"
                                  Kind="CardKind.Task"
                                  Board="_board"
                                  OnCardMoved="move => MoveCardAsync(CardKind.Task, move)" />
                }
            }

            @if (_showAddProject)
            {
                <FlareCard Variant="CardVariant.Outlined">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("AddProject")</FlareText>
                        <FlareText Element="span" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                            @Loc.Get("AddProjectHint")
                        </FlareText>
                        <FlareTextField Label="@Loc.Get("ProjectPath")"
                                        Immediate="true"
                                        @bind-Value="_newProjectPath" />
                        <FlareTextField Label="@Loc.Get("ProjectName")" @bind-Value="_newProjectName" />
                        <FlareSelect TValue="string" Label="@Loc.Get("GitPolicy")" @bind-Value="_newGitPolicy">
                            <option value="LocalOnly">@Loc.Get("GitPolicyLocalOnly")</option>
                            <option value="TrackProjectKnowledge">@Loc.Get("GitPolicyTrackKnowledge")</option>
                            <option value="Custom">@Loc.Get("GitPolicyCustom")</option>
                        </FlareSelect>
                        <FlareStack Row="true" Gap="FlareSpacing.XSmall">
                            <FlareButton OnClick="AddProjectAsync">@Loc.Get("Add")</FlareButton>
                            <FlareButton Variant="ButtonVariant.Text" OnClick="CloseAddProject">@Loc.Get("Cancel")</FlareButton>
                        </FlareStack>
                    </FlareStack>
                </FlareCard>
            }

            @if (_showCreateCard)
            {
                <FlareCard Variant="CardVariant.Outlined">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("CreateCardTitle")</FlareText>
                        <FlareTextField Label="@Loc.Get("CardId")" @bind-Value="_newCardId" />
                        <FlareSelect TValue="string" Label="@Loc.Get("CardKind")" @bind-Value="_newCardKind">
                            <option value="Task">@Loc.Get("TaskKind")</option>
                            <option value="Story">@Loc.Get("StoryKind")</option>
                        </FlareSelect>
                        <FlareTextField Label="@Loc.Get("Title")" @bind-Value="_newCardTitle" />
                        <FlareTextField Label="@Loc.Get("Stage")" @bind-Value="_newCardStage" />
                        @if (_priorityCriteria.Count > 0)
                        {
                            @foreach (var criterion in _priorityCriteria)
                            {
                                <FlareNumericField TValue="decimal?"
                                                   Min="0"
                                                   Label="@criterion.Title"
                                                   Value="GetCriterionValue(criterion.Id)"
                                                   ValueChanged="value => SetCriterionValue(criterion.Id, value)" />
                            }
                        }
                        else
                        {
                            <FlareNumericField TValue="decimal?" Label="@Loc.Get("Priority")" @bind-Value="_newCardPriority" />
                        }
                        <FlareTextField Label="@Loc.Get("Scope")" @bind-Value="_newCardScope" />
                        <FlareStack Row="true" Gap="FlareSpacing.XSmall">
                            <FlareButton OnClick="CreateCardAsync">@Loc.Get("Create")</FlareButton>
                            <FlareButton Variant="ButtonVariant.Text" OnClick="CloseCreateCard">@Loc.Get("Cancel")</FlareButton>
                        </FlareStack>
                    </FlareStack>
                </FlareCard>
            }
        </FlareStack>
    </FlareLayoutContent>

    @* The inspector is a push drawer rather than a fixed panel, so an open inspector narrows the board
       instead of covering it. It stays mounted while closed - the layout keeps a stable track count -
       and FlareLayout turns it into a modal overlay (with scrim and Escape) below the Md breakpoint. *@
    <FlareLayoutDrawer Anchor="DrawerAnchor.Right"
                       Variant="DrawerVariant.Persistent"
                       Width="26rem"
                       Open="InspectorOpen"
                       OpenChanged="OnInspectorOpenChanged"
                       AriaLabel="Инспектор Aiko">
        @if (SelectedCard is { } selectedCard && _board is { } cardBoard)
        {
            <CardInspector Card="selectedCard"
                           Board="cardBoard"
                           ExecutionRefreshTick="_executionPulse"
                           OnSaved="LoadBoardAsync"
                           OnClose="CloseCard" />
        }
        else if (_editingSettings)
        {
            <SettingsInspector Project="_board?.Project"
                               OnSaved="LoadBoardAsync"
                               OnClose="CloseSettings" />
        }
        else if (_editingWorkflow && _board is { } workflowBoard && workflowBoard.Workflows.Count > 0)
        {
            <WorkflowInspector Board="workflowBoard"
                               InitialWorkflowId="@CurrentWorkflowId"
                               OnSaved="LoadBoardAsync"
                               OnClose="CloseWorkflow" />
        }
    </FlareLayoutDrawer>
</FlareLayout>

@code {
    private enum Projection { Stories, Tasks, Combined }

    private IReadOnlyList<RegisteredProject> _projects = [];
    private ProjectBoardSnapshot? _board;
    private string? _selectedProjectId;
    private string? _selectedCardId;
    private bool _railOpen = true;
    private bool _editingWorkflow;
    private bool _editingSettings;
    private string? _error;
    private bool _loading = true;
    private Projection _projection = Projection.Tasks;
    private AppSettingsView? _settingsView;
    private SystemInfo? _system;
    private ProjectEventClient? _events;
    private CancellationTokenSource? _boardReloadDelay;
    private bool _eventsConnected;
    private int _executionPulse;

    private bool _showAddProject;
    private string? _newProjectPath;
    private string? _newProjectName;
    private string? _newGitPolicy = "LocalOnly";
    private bool _showCreateCard;
    private string? _newCardId;
    private string? _newCardKind = "Task";
    private string? _newCardTitle;
    private string? _newCardStage;
    private decimal? _newCardPriority = 1m;
    private string? _newCardScope;
    private IReadOnlyList<PriorityCriterion> _priorityCriteria = [];
    private readonly Dictionary<string, decimal?> _criterionValues = new(StringComparer.Ordinal);

    private IReadOnlyList<Card> VisibleCards => _board?.Cards
        .Where(card => _projection switch
        {
            Projection.Stories => card.Kind == CardKind.Story,
            Projection.Tasks => card.Kind == CardKind.Task,
            _ => true
        })
        .OrderBy(card => card.Reference.CardId, StringComparer.Ordinal)
        .ToArray() ?? [];

    private Card? SelectedCard => _board?.Cards.FirstOrDefault(card =>
        card.Reference.CardId == _selectedCardId);

    private int VisibleCardCount => _projection switch
    {
        Projection.Stories => _board?.Cards.Count(card => card.Kind == CardKind.Story) ?? 0,
        Projection.Tasks => _board?.Cards.Count(card => card.Kind == CardKind.Task) ?? 0,
        _ => _board?.Cards.Count ?? 0
    };

    private int InProgressCount => _board?.Cards.Count(IsInProgress) ?? 0;

    /// <summary>The four board metrics, rendered as FlareCard tiles in a FlareGrid.</summary>
    private IReadOnlyList<(string Label, string Value, bool Warn)> SummaryTiles =>
    [
        (Loc.Get("Cards"), VisibleCardCount.ToString(CultureInfo.InvariantCulture), false),
        (Loc.Get("InProgress"), InProgressCount.ToString(CultureInfo.InvariantCulture), false),
        (Loc.Get("Relations"), (_board?.Relations.Count ?? 0).ToString(CultureInfo.InvariantCulture), false),
        (Loc.Get("OutOfScope"), _scopeDeviationCount.ToString(CultureInfo.InvariantCulture), _scopeDeviationCount > 0)
    ];

    /// <summary>Whether the end drawer holds an inspector and should be pushed open.</summary>
    private bool InspectorOpen => SelectedCard is not null || _editingSettings || _editingWorkflow;

    /// <summary>The local endpoint the daemon serves, as the top bar's host pill.</summary>
    private string HostCaption => Http.BaseAddress is { } address
        ? $"{address.Host}:{address.Port}"
        : "—";

    private int StoryCount => _board?.Cards.Count(card => card.Kind == CardKind.Story) ?? 0;

    private int TaskCount => _board?.Cards.Count(card => card.Kind == CardKind.Task) ?? 0;

    private int TotalCount => _board?.Cards.Count ?? 0;

    /// <summary>
    /// The rail's orchestration load: the share of cards an agent is working right now. It is a real
    /// measurement (cards between the first and the last stage), not a decorative number.
    /// </summary>
    private double LoadPercent => TotalCount == 0
        ? 0
        : Math.Round(InProgressCount * 100d / TotalCount, MidpointRounding.AwayFromZero);

    private bool IsInProgress(Card card)
    {
        if (_board is null)
        {
            return false;
        }

        var workflow = _board.Workflows.FirstOrDefault(workflow =>
            StringComparer.Ordinal.Equals(workflow.Id, card.WorkflowId));
        if (workflow is null || workflow.Stages.Count < 3)
        {
            return false;
        }

        var stageIds = workflow.Stages.OrderBy(stage => stage.Order).Select(stage => stage.Id).ToArray();
        var index = Array.IndexOf(stageIds, card.StageId);
        return index > 0 && index < stageIds.Length - 1;
    }

    private string DefaultStage(CardKind kind)
    {
        var workflowId = kind == CardKind.Story ? "story" : "task";
        return _board?.Workflows
            .FirstOrDefault(workflow => StringComparer.Ordinal.Equals(workflow.Id, workflowId))
            ?.Stages.OrderBy(stage => stage.Order).Select(stage => stage.Id).FirstOrDefault()
            ?? "backlog";
    }

    private int _scopeDeviationCount => _board?.Cards.Sum(card =>
        BoardSection.FindOutOfScopeFiles(card).Count) ?? 0;

    private string ProjectionCaption => _projection switch
    {
        Projection.Stories => Loc.Get("StoriesCaption"),
        Projection.Tasks => Loc.Get("TasksCaption"),
        _ => Loc.Get("CombinedCaption")
    };

    private string CurrentWorkflowId =>
        _projection == Projection.Stories ? "story" : "task";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await Http.GetFromJsonAsync<IReadOnlyList<RegisteredProject>>(
                "api/v1/projects", PwaJson.Options) ?? [];
            // The top bar's version tag comes from the daemon itself, not from the client build.
            _system = await Http.GetFromJsonAsync<SystemInfo>("api/v1/system", PwaJson.Options);
            _selectedProjectId = ReadProjectFromQuery() is { } requested &&
                                 _projects.Any(project => project.Id == requested)
                ? requested
                : _projects.FirstOrDefault()?.Id;
            _selectedCardId = ReadQueryValue("card");
            var requestedWorkflow = ReadQueryValue("workflow");
            _editingWorkflow = requestedWorkflow is not null;
            _editingSettings = ReadQueryValue("settings") is not null;
            if (requestedWorkflow == "story")
            {
                _projection = Projection.Stories;
            }
            await LoadBoardAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ConnectEventsAsync();
        }
    }

    private async Task ConnectEventsAsync()
    {
        if (_selectedProjectId is null)
        {
            return;
        }

        try
        {
            _events ??= new ProjectEventClient(Js);
            _events.Received -= OnProjectEventAsync;
            _events.Received += OnProjectEventAsync;
            await _events.ConnectAsync(Http.BaseAddress!.ToString(), _selectedProjectId);
            _eventsConnected = true;
        }
        catch (JSDisconnectedException)
        {
            _eventsConnected = false;
        }
        catch (JSException)
        {
            _eventsConnected = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnProjectEventAsync(string projectId, AikoEvent @event)
    {
        if (projectId != _selectedProjectId)
        {
            return;
        }

        switch (@event.Type)
        {
            case AikoEventTypes.CardUpdated:
            case AikoEventTypes.RelationsUpdated:
                ScheduleBoardReload();
                break;
            case AikoEventTypes.ExecutionUpdated:
                _executionPulse++;
                await InvokeAsync(StateHasChanged);
                break;
        }
    }

    private void ScheduleBoardReload()
    {
        _boardReloadDelay?.Cancel();
        _boardReloadDelay?.Dispose();
        _boardReloadDelay = new CancellationTokenSource();
        var token = _boardReloadDelay.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                await InvokeAsync(LoadBoardAsync);
            }
            catch (OperationCanceledException)
            {
                // A newer event rescheduled the reload.
            }
        });
    }

    private async Task SelectProjectAsync(string projectId)
    {
        if (_selectedProjectId == projectId)
        {
            return;
        }

        _selectedProjectId = projectId;
        _selectedCardId = null;
        _editingWorkflow = false;
        _editingSettings = false;
        Navigation.NavigateTo($"?project={Uri.EscapeDataString(projectId)}", replace: true);
        await LoadBoardAsync();
        await ConnectEventsAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        await LoadBoardAsync();
        _loading = false;
    }

    private Task ChangeProjectionAsync(Projection projection)
    {
        _projection = projection;
        if (SelectedCard is not null && !VisibleCards.Contains(SelectedCard))
        {
            _selectedCardId = null;
        }
        if (_editingWorkflow)
        {
            NavigateToSelection();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The rail's view links: they switch the projection like the top bar's switch does, and they also
    /// leave the workflow or settings editor, because "show me the board" is a navigation.
    /// </summary>
    private Task ShowProjectionAsync(Projection projection)
    {
        _editingWorkflow = false;
        _editingSettings = false;
        return ChangeProjectionAsync(projection);
    }

    private Task SelectCardAsync(string? value)
    {
        _selectedCardId = string.IsNullOrWhiteSpace(value) ? null : value;
        _editingWorkflow = false;
        _editingSettings = false;
        NavigateToSelection();
        return Task.CompletedTask;
    }

    /// <summary>
    /// A scrim tap, Escape or a route change closed the end drawer: release whichever inspector asked
    /// for it, so the drawer's open state and the page state cannot drift apart.
    /// </summary>
    private void OnInspectorOpenChanged(bool open)
    {
        if (open)
        {
            return;
        }

        if (_selectedCardId is not null)
        {
            CloseCard();
        }
        else if (_editingWorkflow)
        {
            CloseWorkflow();
        }
        else if (_editingSettings)
        {
            CloseSettings();
        }
    }

    private void CloseCard()
    {
        _selectedCardId = null;
        NavigateToSelection();
    }

    private void OpenWorkflow()
    {
        _selectedCardId = null;
        _editingWorkflow = true;
        NavigateToSelection();
    }

    private void CloseWorkflow()
    {
        _editingWorkflow = false;
        NavigateToSelection();
    }

    private void OpenSettings()
    {
        _selectedCardId = null;
        _editingWorkflow = false;
        _editingSettings = true;
        if (_selectedProjectId is null)
        {
            // Global settings are reachable without a project: the inspector serves both scopes.
            Navigation.NavigateTo("?settings=1", replace: true);
            return;
        }

        NavigateToSelection();
    }

    private void CloseSettings()
    {
        _editingSettings = false;
        NavigateToSelection();
    }

    private async Task LoadBoardAsync()
    {
        _error = null;
        if (_selectedProjectId is null)
        {
            _board = null;
            return;
        }

        try
        {
            _board = await Http.GetFromJsonAsync<ProjectBoardSnapshot>(
                $"api/v1/projects/{Uri.EscapeDataString(_selectedProjectId)}/board",
                PwaJson.Options);
            _settingsView = await Http.GetFromJsonAsync<AppSettingsView>(
                $"api/v1/projects/{Uri.EscapeDataString(_selectedProjectId)}/settings",
                PwaJson.Options);
            if (_selectedCardId is not null &&
                !_board!.Cards.Any(card => card.Reference.CardId == _selectedCardId))
            {
                _selectedCardId = null;
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private void NavigateToSelection()
    {
        if (_selectedProjectId is null)
        {
            return;
        }

        var location = $"?project={Uri.EscapeDataString(_selectedProjectId)}";
        if (_selectedCardId is not null)
        {
            location += $"&card={Uri.EscapeDataString(_selectedCardId)}";
        }
        else if (_editingWorkflow)
        {
            location += $"&workflow={Uri.EscapeDataString(CurrentWorkflowId)}";
        }
        else if (_editingSettings)
        {
            location += "&settings=1";
        }

        Navigation.NavigateTo(location, replace: true);
    }

    /// <summary>
    /// Applies one board drop: the board reports the card and the stage it landed in, so exactly one
    /// request goes out and the optimistic revision comes from the current snapshot.
    /// </summary>
    private async Task MoveCardAsync(CardKind kind, BoardCardMove move)
    {
        if (_board is null)
        {
            return;
        }

        var card = _board.Cards.FirstOrDefault(item =>
            item.Kind == kind && StringComparer.Ordinal.Equals(item.Reference.CardId, move.CardId));
        if (card is null)
        {
            return;
        }

        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(_board.Project.Id)}/cards/{Uri.EscapeDataString(card.Reference.CardId)}/stage",
                new MoveCardRequest(move.StageId, card.Revision),
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            await LoadBoardAsync();
        }
        catch (Exception exception)
        {
            _error = Loc.Format("MoveFailed", card.Reference.CardId, exception.Message);
            await LoadBoardAsync();
        }
    }

    private string? ReadProjectFromQuery() => ReadQueryValue("project");

    private string? ReadQueryValue(string name)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        return query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(item => item.Split('=', 2))
            .Where(parts => parts.Length == 2 && parts[0] == name)
            .Select(parts => Uri.UnescapeDataString(parts[1]))
            .FirstOrDefault();
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private void OpenAddProject()
    {
        _showAddProject = true;
        _showCreateCard = false;
    }

    private void CloseAddProject() => _showAddProject = false;

    private async Task AddProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(_newProjectPath))
        {
            _error = Loc.Get("PathRequired");
            return;
        }

        try
        {
            var request = new InitializeProjectRequest(
                _newProjectPath.Trim(),
                string.IsNullOrWhiteSpace(_newProjectName) ? null : _newProjectName.Trim(),
                Enum.Parse<ProjectGitPolicy>(_newGitPolicy ?? nameof(ProjectGitPolicy.LocalOnly)));
            using var response = await Http.PostAsJsonAsync(
                "api/v1/projects/initialize",
                request,
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            _projects = await Http.GetFromJsonAsync<IReadOnlyList<RegisteredProject>>(
                "api/v1/projects", PwaJson.Options) ?? [];
            var project = await response.Content.ReadFromJsonAsync<RegisteredProject>(PwaJson.Options);
            _selectedProjectId = project?.Id ?? _projects.FirstOrDefault()?.Id;
            _showAddProject = false;
            _newProjectPath = null;
            _newProjectName = null;
            await LoadBoardAsync();
            await ConnectEventsAsync();
        }
        catch (Exception exception)
        {
            _error = Loc.Format("AddProjectFailed", exception.Message);
        }
    }

    private async Task OpenCreateCard()
    {
        _showCreateCard = true;
        _showAddProject = false;
        _priorityCriteria = [];
        _criterionValues.Clear();
        if (_board is not null)
        {
            try
            {
                var view = await Http.GetFromJsonAsync<AppSettingsView>(
                    $"api/v1/projects/{Uri.EscapeDataString(_board.Project.Id)}/settings", PwaJson.Options);
                _priorityCriteria = view?.EffectivePriority.Criteria ?? [];
            }
            catch
            {
                _priorityCriteria = [];
            }
        }
    }

    private void CloseCreateCard() => _showCreateCard = false;

    private decimal? GetCriterionValue(string id) =>
        _criterionValues.TryGetValue(id, out var value) ? value : null;

    private void SetCriterionValue(string id, decimal? value) => _criterionValues[id] = value;

    private Dictionary<string, decimal> BuildCriterionValues()
    {
        var result = new Dictionary<string, decimal>(StringComparer.Ordinal);
        foreach (var criterion in _priorityCriteria)
        {
            if (_criterionValues.TryGetValue(criterion.Id, out var value) && value is { } numeric)
            {
                result[criterion.Id] = numeric;
            }
        }

        return result;
    }

    private async Task CreateCardAsync()
    {
        if (_board is null || string.IsNullOrWhiteSpace(_newCardId) || string.IsNullOrWhiteSpace(_newCardTitle))
        {
            _error = Loc.Get("IdTitleRequired");
            return;
        }

        try
        {
            var kind = _newCardKind == nameof(CardKind.Story) ? CardKind.Story : CardKind.Task;
            var criterionValues = BuildCriterionValues();
            var ownPriority = criterionValues.Count > 0
                ? PriorityCalculator.CalculateOwnPriority(criterionValues, _priorityCriteria)
                : _newCardPriority ?? 0m;
            var request = new CreateCardRequest(
                _newCardId.Trim(),
                kind,
                _newCardTitle.Trim(),
                kind == CardKind.Story ? "story" : "task",
                string.IsNullOrWhiteSpace(_newCardStage) ? DefaultStage(kind) : _newCardStage.Trim(),
                ownPriority,
                (_newCardScope ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToArray(),
                criterionValues.Count > 0 ? criterionValues : null);
            using var response = await Http.PostAsJsonAsync(
                $"api/v1/projects/{Uri.EscapeDataString(_board.Project.Id)}/cards",
                request,
                PwaJson.Options);
            response.EnsureSuccessStatusCode();
            _showCreateCard = false;
            _newCardId = null;
            _newCardTitle = null;
            _newCardScope = null;
            _criterionValues.Clear();
            await LoadBoardAsync();
        }
        catch (Exception exception)
        {
            _error = Loc.Format("CreateCardFailed", exception.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _boardReloadDelay?.Cancel();
        _boardReloadDelay?.Dispose();
        if (_events is not null)
        {
            _events.Received -= OnProjectEventAsync;
            await _events.DisposeAsync();
        }
    }

    private static string ProjectPath(string path) =>
        path.Length <= 34 ? path : $"...{path[^33..]}";
}
