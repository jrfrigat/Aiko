@* A file group is a FlareStack with a FlareText heading, a FlareBadge count and a FlareList of paths.
   Paths stay monospace through FlareText's Mono switch, and the heading turns to the Error role when
   the group carries out-of-scope files. *@
<FlareStack Gap="FlareSpacing.XXSmall">
    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
        <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@Title</FlareText>
        <FlareBadge Standalone="true"
                    Text="@Files.Count.ToString(CultureInfo.InvariantCulture)"
                    Color="@(Warning && Files.Count > 0 ? FlareColor.Error : FlareColor.Info)" />
    </FlareStack>
    @if (Files.Count > 0)
    {
        <FlareList TItem="string" Dense="true">
            @foreach (var file in Files)
            {
                <FlareListItem>
                    <FlareText Element="span" Mono="true" Typo="TypographyScale.LabelSmall">@file</FlareText>
                </FlareListItem>
            }
        </FlareList>
    }
</FlareStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<string> Files { get; set; } = [];
    [Parameter] public bool Warning { get; set; }
}
