@inject HttpClient Http
@inject WorkspaceState State

@* Global settings, drawn as the v2 frame's four panels: the daemon's own transport and credentials,
   the defaults a new project starts from, the priority formula, and the installation's own health.

   Four of the mock's blocks are deliberately not drawn, because Aiko has no value behind them: the
   branch-naming pattern, the T-shirt size coefficients, the PWA offline toggle and the "update
   available" pill (that one needs an updater this product does not have yet). The mock's coefficient
   table instead carries the real coefficients - the project's scoring criteria. Everything else
   reports the daemon: the port it holds, the token it checks, the model it ranks the board with, and
   the same findings `aiko doctor` prints. *@
<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row="true" Align="FlareAlignItems.End" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Medium" Wrap="true">
        <FlareStack Gap="FlareSpacing.XXSmall">
            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall" Wrap="true">
                <span class="aiko-tag aiko-tag--accent">@ScopeCaption</span>
                <span class="aiko-tag aiko-tag--quiet">@SettingsFileCaption</span>
                @if (ProjectId is null)
                {
                    @* A template is versioned, and a project records the version it was created from. *@
                    <span class="aiko-tag aiko-tag--live">
                        <span class="aiko-dot"></span>@($"v{_template?.Version ?? 0}")
                    </span>
                }
                else
                {
                    @* A project's settings are read from its own file, so the live tag reports the stream the
                       screen is subscribed to rather than a synchronization it does not perform. *@
                    <span class="aiko-tag aiko-tag--live">
                        <span class="aiko-dot"></span>@(State.EventsConnected ? Loc.Get("SseLive") : Loc.Get("Online"))
                    </span>
                }
            </FlareStack>
            <FlareText Element="h1" Typo="TypographyScale.HeadlineMedium">@HeadingCaption</FlareText>
            <FlareText Element="p" Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">
                @HintCaption
            </FlareText>
        </FlareStack>
        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
            <FlareButton Variant="ButtonVariant.Tonal"
                         Size="ButtonSize.Sm"
                         Disabled="@_saving"
                         OnClick="ResetToDefaultsAsync">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.History" /></LeadingIcon>
                <ChildContent>@Loc.Get(ProjectId is null ? "ResetToDefaults" : "ResetToAppDefaults")</ChildContent>
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Filled"
                         Size="ButtonSize.Sm"
                         Loading="@_saving"
                         OnClick="SaveAsync">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" /></LeadingIcon>
                <ChildContent>@Loc.Get(ProjectId is null ? "SaveTemplateSettings" : "SaveProjectSettings")</ChildContent>
            </FlareButton>
        </FlareStack>
    </FlareStack>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <FlareAlert Severity="@(_hasError ? AlertSeverity.Error : AlertSeverity.Success)"
                    Variant="AlertVariant.Outlined">@_message</FlareAlert>
    }

    <div class="aiko-settings">
        <FlareStack Class="aiko-settings__narrow" Gap="FlareSpacing.Medium">
            @* Panel 1: the loopback transport and the credential every REST and MCP call is checked against. *@
            <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <span class="aiko-panel__icon aiko-panel__icon--secondary">
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Security" />
                            </span>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("DaemonHostSecurity")</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("DaemonHostSecurityHint")
                                </FlareText>
                            </FlareStack>
                        </FlareStack>
                        <span class="aiko-tag aiko-tag--live">
                            <span class="aiko-dot"></span>@Loc.Get("LoopbackSafe")
                        </span>
                    </FlareStack>

                    <div class="aiko-tiles">
                        <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @Loc.Get("LocalPortLabel")
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("LocalPortHint")
                                </FlareText>
                            </FlareStack>
                            <span class="aiko-value">@LocalPort</span>
                        </FlareStack>

                        <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @Loc.Get("ListenAddressLabel")
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("ListenAddressHint")
                                </FlareText>
                            </FlareStack>
                            <span class="aiko-value">127.0.0.1</span>
                        </FlareStack>
                    </div>

                    @* The credential itself never reaches the browser: the screen issues a one-time pairing
                       code instead, which is the same handshake `aiko pair` prints for another machine. *@
                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @Loc.Get("PairingTokenLabel")
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("PairingTokenHint")
                                </FlareText>
                            </FlareStack>
                            <FlareButton Variant="ButtonVariant.Tonal"
                                         Size="ButtonSize.Sm"
                                         Loading="@_pairing"
                                         OnClick="CreatePairingLinkAsync">
                                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Key" /></LeadingIcon>
                                <ChildContent>@Loc.Get("CreatePairingLink")</ChildContent>
                            </FlareButton>
                        </FlareStack>
                        @if (_pairingUrl is { Length: > 0 })
                        {
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                <span class="aiko-value aiko-value--clip" title="@_pairingUrl">@_pairingUrl</span>
                                <FlareClipboard Text="@_pairingUrl" Variant="ButtonVariant.Text" />
                            </FlareStack>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("PairingLinkHint")
                            </FlareText>
                        }
                    </FlareStack>
                </FlareStack>
            </FlarePaper>

            @* Panel 2: what a new project starts from. The workspace mode is stated rather than offered:
               Aiko implements the shared checkout only, and a control with one usable option is noise. *@
            <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <span class="aiko-panel__icon aiko-panel__icon--primary">
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Tune" />
                            </span>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("DefaultsForNewProjects")</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("DefaultsForNewProjectsHint")
                                </FlareText>
                            </FlareStack>
                        </FlareStack>
                        <span class="aiko-tag">@Loc.Get("SafeDefaultsTag")</span>
                    </FlareStack>

                    <div class="aiko-tiles">
                        <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                @Loc.Get("Workspace")
                            </FlareText>
                            <span class="aiko-value">@Loc.Get("WorkspaceOption")</span>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("WorktreeOption")
                            </FlareText>
                        </FlareStack>

                        <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                @Loc.Get("MaxRunsLabel")
                            </FlareText>
                            <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Class="aiko-stepper">
                                <FlareIconButton Variant="ButtonVariant.Text"
                                                 Icon="@MaterialDesign3Icons.Regular.Remove"
                                                 AriaLabel="@Loc.Get("MaxRunsLabel")"
                                                 Disabled="@(_maxRuns <= 1)"
                                                 OnClick="() => _maxRuns--" />
                                <span class="aiko-value">@_maxRuns</span>
                                <FlareIconButton Variant="ButtonVariant.Text"
                                                 Icon="@MaterialDesign3Icons.Regular.Add"
                                                 AriaLabel="@Loc.Get("MaxRunsLabel")"
                                                 OnClick="() => _maxRuns++" />
                            </FlareStack>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("ConcurrencyRecommended")
                            </FlareText>
                        </FlareStack>
                    </div>

                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                @Loc.Get("ScopeOverlap")
                            </FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("ScopeOverlapHint")
                            </FlareText>
                        </FlareStack>
                        <div class="aiko-choices">
                            @foreach (var option in ScopeOptions)
                            {
                                @Choice("scope", option, _scopePolicy, policy => _scopePolicy = policy)
                            }
                        </div>
                    </FlareStack>

                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                @Loc.Get("CommitPolicy")
                            </FlareText>
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("CommitPolicyHint")
                            </FlareText>
                        </FlareStack>
                        <div class="aiko-choices">
                            @foreach (var option in CommitOptions)
                            {
                                @Choice("commit", option, _commitPolicy, policy => _commitPolicy = policy)
                            }
                        </div>
                    </FlareStack>
                </FlareStack>
            </FlarePaper>
            @* A screen can add a panel to this column: the project screen puts the pipeline there, under the
               defaults it belongs with. The column is the narrow one on purpose - the scoring tables below
               need the room, and a stage list reads fine in a third of the page. *@
            @ExtraNarrowContent
        </FlareStack>

        <FlareStack Class="aiko-settings__wide" Gap="FlareSpacing.Medium">
            @* Panel 3: the model the board is actually ranked with, printed as the daemon computes it
               (a weighted average of the card's own value and the highest parent value). *@
            <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <span class="aiko-panel__icon aiko-panel__icon--tertiary">
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.Calculate" />
                            </span>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("PriorityFormulaTitle")</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("PriorityFormulaHint")
                                </FlareText>
                            </FlareStack>
                        </FlareStack>
                        <span class="aiko-tag aiko-tag--accent">@($"{Loc.Get("FormulaVersion")} {PriorityCalculator.CurrentFormulaVersion}")</span>
                    </FlareStack>

                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                            @Loc.Get("PriorityFormula")
                        </FlareText>
                        <span class="aiko-value aiko-value--formula">@Loc.Get("PriorityFormulaExpression")</span>
                    </FlareStack>

                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.Small">
                        <FlareSlider Label="@Loc.Get("OwnWeightLabel")"
                                     Min="0"
                                     Max="1"
                                     Step="0.05"
                                     Format="0.00"
                                     Value="@_ownWeight"
                                     ValueChanged="OnOwnWeightChanged" />
                        <FlareSlider Label="@Loc.Get("ParentWeightLabel")"
                                     Min="0"
                                     Max="1"
                                     Step="0.05"
                                     Format="0.00"
                                     Value="@_parentWeight"
                                     ValueChanged="OnParentWeightChanged" />
                    </FlareStack>

                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @Loc.Get("Criteria")
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("CriterionIdHelper")
                                </FlareText>
                            </FlareStack>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddCriterion">
                                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                                <ChildContent>@Loc.Get("AddCriterion")</ChildContent>
                            </FlareButton>
                        </FlareStack>

                        @if (_criteria.Count == 0)
                        {
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("NoCriteria")
                            </FlareText>
                        }
                        else
                        {
                            @foreach (var criterion in _criteria)
                            {
                                var draft = criterion;
                                <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                                        <span class="aiko-tag aiko-tag--quiet">@draft.Id</span>
                                        <FlareIconButton Variant="ButtonVariant.Text"
                                                         Icon="@MaterialDesign3Icons.Regular.Delete"
                                                         AriaLabel="@Loc.Get("Remove")"
                                                         OnClick="() => _criteria.Remove(draft)" />
                                    </FlareStack>
                                    <AikoField Label="@Loc.Get("CriterionTitle")"
                                               Value="@draft.Title"
                                               ValueChanged="value => draft.Title = value" />
                                    <AikoField Label="@Loc.Get("CriterionDescription")"
                                               Value="@draft.Description"
                                               ValueChanged="value => draft.Description = value" />
                                    <FlareStack Row="true" Align="FlareAlignItems.End" Gap="FlareSpacing.XSmall">
                                        <AikoNumberField Label="@Loc.Get("MinimumLabel")"
                                                         Value="@draft.Minimum"
                                                         ValueChanged="value => draft.Minimum = value ?? 0m" />
                                        <AikoNumberField Label="@Loc.Get("MaximumLabel")"
                                                         Value="@draft.Maximum"
                                                         ValueChanged="value => draft.Maximum = value ?? 0m" />
                                        <AikoNumberField Label="@Loc.Get("CriterionWeight")"
                                                         Value="@draft.Weight"
                                                         ValueChanged="value => draft.Weight = value ?? 0m" />
                                    </FlareStack>
                                    <AikoField Label="@Loc.Get("AiInstructionLabel")"
                                               Hint="@Loc.Get("AiInstructionHint")"
                                               Value="@draft.AiInstruction"
                                               ValueChanged="value => draft.AiInstruction = value" />
                                </FlareStack>
                            }
                        }
                    </FlareStack>

                    @* The size grid: the descriptions are what the agent reads to assign a card its step, and
                       the coefficient is what that step does to the score (ТЗ §10). A project that needs
                       another step adds one here. *@
                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XSmall">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Wrap="true">
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @Loc.Get("SizeGrid")
                                </FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("SizeGridHint")
                                </FlareText>
                            </FlareStack>
                            <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddSize">
                                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" /></LeadingIcon>
                                <ChildContent>@Loc.Get("AddSize")</ChildContent>
                            </FlareButton>
                        </FlareStack>

                        @if (_sizes.Count == 0)
                        {
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("NoSizes")
                            </FlareText>
                        }
                        else
                        {
                            @* The ladder as the design draws it: one tile per step, its coefficient under the
                               name. Every tile carries its step's colour - the direction the coefficient
                               points - so the ladder reads as a scale at a glance, and the open step is
                               outlined and lifted on top of that. *@
                            <div class="aiko-sizes">
                                @foreach (var step in _sizes)
                                {
                                    var tile = step;
                                    <button type="button"
                                            class="aiko-size @DirectionClass(tile.Coefficient) @(ReferenceEquals(tile, SelectedSize) ? "aiko-size--on" : null)"
                                            title="@tile.Description"
                                            @onclick="() => SelectSize(tile)">
                                        <span class="aiko-size__id">@tile.Id</span>
                                        <span class="aiko-size__coefficient">@CoefficientCaption(tile.Coefficient)</span>
                                    </button>
                                }
                            </div>

                            @* The fields of the chosen step, in the design's field language: identifiers on a
                               recessed row with an icon and mono accent text, prose in a prompt block. *@
                            @if (SelectedSize is { } size)
                            {
                                <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <div class="aiko-code-pair">
                                        <div class="aiko-code-row" title="@Loc.Get("SizeIdLabel")">
                                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Tag" Color="FlareColor.OnSurfaceVariant2" />
                                            <input type="text"
                                                   aria-label="@Loc.Get("SizeIdLabel")"
                                                   placeholder="@Loc.Get("SizeIdLabel")"
                                                   @bind="size.Id" />
                                        </div>
                                        <div class="aiko-code-row" title="@Loc.Get("SizeCoefficient")">
                                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Calculate" Color="FlareColor.OnSurfaceVariant2" />
                                            <input type="number"
                                                   step="0.01"
                                                   aria-label="@Loc.Get("SizeCoefficient")"
                                                   @bind="size.Coefficient" />
                                        </div>
                                    </div>
                                    <FlareIconButton Variant="ButtonVariant.Text"
                                                     Icon="@MaterialDesign3Icons.Regular.Delete"
                                                     AriaLabel="@Loc.Get("Remove")"
                                                     OnClick="RemoveSelectedSize" />
                                </FlareStack>

                                <div class="aiko-terminal">
                                    <div class="aiko-terminal__bar">
                                        <span class="aiko-terminal__dots">
                                            <span class="aiko-terminal__dot" style="background: var(--flare-color-tertiary)"></span>
                                            <span class="aiko-terminal__name">@($"{size.Id ?? "size"}.description")</span>
                                        </span>
                                        <span>@Loc.Get("SizeDescription")</span>
                                    </div>
                                    <textarea rows="3"
                                              aria-label="@Loc.Get("SizeDescription")"
                                              placeholder="@Loc.Get("SizeDescriptionHint")"
                                              @bind="size.Description"></textarea>
                                    <div class="aiko-terminal__foot">
                                        <span>@Loc.Format("CharactersCount", size.Description?.Length ?? 0)</span>
                                        <span>@Loc.Get("SizeDescriptionHint")</span>
                                    </div>
                                </div>
                            }

                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("SizeGridPickHint")
                            </FlareText>
                        }
                    </FlareStack>
                </FlareStack>
            </FlarePaper>

            @* Panel 4: the installation's own health - the same findings `aiko doctor` prints, read
               through /api/v1/system/diagnostics. There is no updater in Aiko yet, so the mock's
               "update available" pill and its button are not drawn. *@
            <FlarePaper Elevation="0" Padding="FlareSpacing.Large" Square="true" Class="aiko-panel">
                <FlareStack Gap="FlareSpacing.Medium">
                    <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <span class="aiko-panel__icon aiko-panel__icon--primary">
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.HealthAndSafety" />
                            </span>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@Loc.Get("SelfDiagnostic")</FlareText>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @Loc.Get("SelfDiagnosticHint")
                                </FlareText>
                            </FlareStack>
                        </FlareStack>
                        <FlareButton Variant="ButtonVariant.Text"
                                     Size="ButtonSize.Sm"
                                     Loading="@_diagnosing"
                                     OnClick="RunDiagnosticsAsync">
                            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Refresh" /></LeadingIcon>
                            <ChildContent>@Loc.Get("RunDoctor")</ChildContent>
                        </FlareButton>
                    </FlareStack>

                    <div class="aiko-tiles">
                        @if (State.System is { } system)
                        {
                            <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @Loc.Get("Version")
                                </FlareText>
                                <span class="aiko-value">@($"v{system.Version}")</span>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @system.Runtime
                                </FlareText>
                            </FlareStack>

                            <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                    @Loc.Get("Address")
                                </FlareText>
                                <span class="aiko-value aiko-value--clip" title="@system.BaseUrl">@system.BaseUrl</span>
                                <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                    @($"PID {system.ProcessId}")
                                </FlareText>
                            </FlareStack>
                        }
                    </div>

                    <FlareStack Class="aiko-tile" Gap="FlareSpacing.XXSmall">
                        <FlareStack Row="true" Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Weight="FontWeight.SemiBold">
                                @Loc.Get("DoctorChecklist")
                            </FlareText>
                            @if (_diagnostics is { } report)
                            {
                                <span class="aiko-tag @(report.HasProblems ? null : "aiko-tag--live")">
                                    @(report.HasProblems ? Loc.Get("DoctorHasProblems") : Loc.Get("DoctorAllNominal"))
                                </span>
                            }
                        </FlareStack>

                        @if (_diagnostics is null)
                        {
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("LoadingContext")
                            </FlareText>
                        }
                        else if (_findings.Count == 0)
                        {
                            <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant2">
                                @Loc.Get("DoctorAllNominal")
                            </FlareText>
                        }
                        else
                        {
                            <FlareStack Gap="FlareSpacing.XXSmall">
                                @foreach (var line in _findings)
                                {
                                    var finding = line;
                                    <FlareStack Row="true" Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small" Class="aiko-check">
                                        <FlareStack Row="true" Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                            <FlareIconView Value="@SeverityIcon(finding.Severity)" Color="@SeverityColor(finding.Severity)" />
                                            <FlareText Element="span" Typo="TypographyScale.LabelSmall">@finding.Summary</FlareText>
                                        </FlareStack>
                                        <span class="aiko-tag aiko-tag--quiet">@finding.Area</span>
                                    </FlareStack>
                                }
                            </FlareStack>
                        }
                    </FlareStack>
                </FlareStack>
            </FlarePaper>
        </FlareStack>
    </div>
</FlareStack>

@code {
    /// <summary>A policy option as the screen offers it: the enum name plus the two strings it shows.</summary>
    private sealed record PolicyOption(string Value, string TitleKey, string HintKey);

    private static readonly PolicyOption[] ScopeOptions =
    [
        new(nameof(ActionPolicy.Deny), "ScopeStrictTitle", "ScopeStrictHint"),
        new(nameof(ActionPolicy.Ask), "ScopeAskTitle", "ScopeAskHint"),
        new(nameof(ActionPolicy.Allow), "ScopeFreeTitle", "ScopeFreeHint"),
    ];

    private static readonly PolicyOption[] CommitOptions =
    [
        new(nameof(ActionPolicy.Deny), "CommitDenyTitle", "CommitDenyHint"),
        new(nameof(ActionPolicy.Ask), "CommitAskTitle", "CommitAskHint"),
        new(nameof(ActionPolicy.Allow), "CommitAllowTitle", "CommitAllowHint"),
    ];

    /// <summary>
    /// A panel rendered at the bottom of the narrow column. The project screen puts the pipeline there,
    /// under the defaults; the global screen passes nothing.
    /// </summary>
    [Parameter] public RenderFragment? ExtraNarrowContent { get; set; }

    /// <summary>
    /// The project whose settings are edited, or null for the installation's default template. It is one
    /// form at both levels: what differs is the file it reads and writes, and what the reset restores.
    /// </summary>
    [Parameter] public string? ProjectId { get; set; }

    /// <summary>The template whose defaults are edited when no project is open.</summary>
    [Parameter] public string TemplateId { get; set; } = ProjectTemplate.DefaultId;

    /// <summary>The endpoint the form reads and writes: a project's own file, or a template's.</summary>
    private string SettingsUrl => ProjectId is null
        ? $"api/v1/templates/{Uri.EscapeDataString(TemplateId)}/settings"
        : $"api/v1/projects/{Uri.EscapeDataString(ProjectId)}/settings";

    /// <summary>The endpoint the template itself is read from, defaults included.</summary>
    private string TemplateUrl => $"api/v1/templates/{Uri.EscapeDataString(TemplateId)}";

    /// <summary>What this level is, as the header's first tag.</summary>
    private string ScopeCaption => Loc.Get(ProjectId is null ? "TemplateScope" : "ProjectOverrideScope");

    /// <summary>The file this level lives in, shown beside the tag.</summary>
    private string SettingsFileCaption => ProjectId is null
        ? $"templates/{TemplateId}/template.json"
        : ".aiko/settings.json";

    /// <summary>The page heading of this level.</summary>
    private string HeadingCaption =>
        Loc.Get(ProjectId is null ? "TemplateSettingsHeading" : "ProjectSettingsHeading");

    /// <summary>What this level is for, under the heading.</summary>
    private string HintCaption => Loc.Get(ProjectId is null ? "TemplateSettingsHint" : "ProjectSettingsHint");

    private AppSettingsView? _view;
    private ProjectTemplate? _template;
    private WorkspaceMode _workspaceMode = WorkspaceMode.Shared;
    private int _maxRuns = 1;
    private ActionPolicy _scopePolicy = ActionPolicy.Ask;
    private ActionPolicy _commitPolicy = ActionPolicy.Deny;
    private List<CriterionDraft> _criteria = [];
    private List<SizeDraft> _sizes = [];
    private SizeDraft? _selectedSize;
    private double _ownWeight = 0.7d;
    private double _parentWeight = 0.3d;
    private WorkshopDiagnostics? _diagnostics;
    private IReadOnlyList<DiagnosticFinding> _findings = [];
    private string? _pairingUrl;
    private string? _message;
    private bool _hasError;
    private bool _saving;
    private bool _pairing;
    private bool _diagnosing;

    /// <summary>The port the daemon reports, taken from the endpoint it is actually listening on.</summary>
    private string LocalPort => State.System is { BaseUrl: { Length: > 0 } baseUrl } &&
        Uri.TryCreate(baseUrl, UriKind.Absolute, out var uri)
            ? uri.Port.ToString()
            : "-";

    /// <summary>
    /// The slider works in doubles and the model in decimals; the weight is rounded to two places,
    /// which is the step the control offers.
    /// </summary>
    private decimal OwnWeight => (decimal)Math.Round(_ownWeight, 2);

    private decimal ParentWeight => (decimal)Math.Round(_parentWeight, 2);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        await RunDiagnosticsAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            if (ProjectId is null)
            {
                // A template states its own defaults; whatever it leaves out is the built-in one, and the form
                // shows what a project created from this template would start with.
                _template = await Http.GetFromJsonAsync<ProjectTemplate>(TemplateUrl, PwaJson.Options);
                _view = new AppSettingsView(
                    _template?.Settings,
                    _template?.Settings?.Execution ?? ExecutionSettings.SafeDefault,
                    _template?.Settings?.Execution is null ? AppSettingsSources.Default : AppSettingsSources.Project,
                    _template?.Settings?.Priority ?? PrioritySettings.SafeDefault,
                    _template?.Settings?.Priority is null ? AppSettingsSources.Default : AppSettingsSources.Project);
            }
            else
            {
                _view = await Http.GetFromJsonAsync<AppSettingsView>(SettingsUrl, PwaJson.Options);
            }

            ApplyView(_view);
        }
        catch (Exception exception)
        {
            _message = Loc.Format("LoadSettingsFailed", FailureText.Describe(exception));
            _hasError = true;
        }
    }

    private void ApplyView(AppSettingsView? view)
    {
        if (view is null)
        {
            return;
        }

        // The level's own document, or the effective values when it states none: a project's file and a
        // template's settings are read the same way, and the effective view already carries what the daemon
        // would really use for a section the document leaves out.
        var own = view.Snapshot;
        var execution = own?.Execution ?? view.EffectiveExecution;
        _workspaceMode = execution.WorkspaceMode;
        _maxRuns = execution.MaxConcurrentRuns;
        _scopePolicy = execution.ScopeOverlapPolicy;
        _commitPolicy = execution.SharedCheckoutCommitPolicy;

        var priority = own?.Priority ?? view.EffectivePriority;
        _ownWeight = (double)priority.Weights.TaskWeight;
        _parentWeight = (double)priority.Weights.ParentWeight;
        _criteria = priority.Criteria.Select(CriterionDraft.From).ToList();
        // The effective view carries the standard grid when nothing is configured, so a fresh install
        // shows the ladder it would use rather than an empty table.
        _sizes = priority.Grid.Select(SizeDraft.From).ToList();
    }

    private void OnOwnWeightChanged(double value) => _ownWeight = value;

    private void OnParentWeightChanged(double value) => _parentWeight = value;

    private void AddCriterion() =>
        _criteria.Add(new CriterionDraft { Id = NewCriterionId(_criteria) });

    private void AddSize()
    {
        var step = new SizeDraft
        {
            Id = NewSizeId(_sizes),
            Description = string.Empty,
            Coefficient = 1m,
        };
        _sizes.Add(step);
        // The step just added is the one being worked on, so its fields open straight away.
        _selectedSize = step;
    }

    /// <summary>The step whose fields are open: the chosen one, or the first of the ladder.</summary>
    private SizeDraft? SelectedSize => _selectedSize ?? _sizes.FirstOrDefault();

    private void SelectSize(SizeDraft step) => _selectedSize = step;

    /// <summary>Removes the open step and opens whichever step takes its place in the ladder.</summary>
    private void RemoveSelectedSize()
    {
        if (SelectedSize is not { } step)
        {
            return;
        }

        var index = _sizes.IndexOf(step);
        _sizes.Remove(step);
        _selectedSize = _sizes.Count == 0 ? null : _sizes[Math.Min(index, _sizes.Count - 1)];
    }

    /// <summary>A coefficient as the tile prints it, with the two decimals the fields offer.</summary>
    private static string CoefficientCaption(decimal coefficient) =>
        coefficient.ToString("0.00", System.Globalization.CultureInfo.CurrentCulture);

    /// <summary>
    /// Which way a step leans, as a CSS class on the tile itself: above one the step rewards a card, below
    /// one it penalizes it, and exactly one is the neutral middle of the ladder. Derived from the number
    /// rather than stored per step, so a project that edits a coefficient sees the colour follow it.
    /// </summary>
    private static string DirectionClass(decimal coefficient) => coefficient switch
    {
        > 1m => "aiko-size--up",
        < 1m => "aiko-size--down",
        _ => "aiko-size--mid"
    };

    /// <summary>
    /// A rough token count for a prompt, so the editor can show what the model will be handed. It is an
    /// estimate - four characters per token is the usual rule of thumb - and it is labelled as one; Aiko
    /// does not call a tokenizer, because nothing it does depends on the exact figure.
    /// </summary>
    private static int EstimateTokens(string? text) => (text?.Length ?? 0) / 4;

    /// <summary>
    /// Builds and saves the global document. Both sections travel together: the settings file is
    /// replaced as a whole, so sending one section alone would drop the other.
    /// </summary>
    private async Task SaveAsync()
    {
        if (OwnWeight + ParentWeight == 0)
        {
            _message = Loc.Get("InvalidSettingValue");
            _hasError = true;
            return;
        }

        if (_criteria.Any(criterion => string.IsNullOrWhiteSpace(criterion.Title)))
        {
            _message = Loc.Get("CriterionTitleRequired");
            _hasError = true;
            return;
        }

        // An empty range would make the criterion meaningless, so it is refused here rather than silently
        // scoring nothing on every card.
        if (_criteria.Any(criterion => criterion.Maximum <= criterion.Minimum))
        {
            _message = Loc.Get("InvalidCriterionRange");
            _hasError = true;
            return;
        }

        if (_sizes.Any(size => string.IsNullOrWhiteSpace(size.Id)))
        {
            _message = Loc.Get("SizeIdRequired");
            _hasError = true;
            return;
        }

        if (_sizes.Any(size => size.Coefficient <= 0m))
        {
            _message = Loc.Get("InvalidSizeCoefficient");
            _hasError = true;
            return;
        }

        var duplicateSize = _sizes
            .GroupBy(size => size.Id!.Trim(), StringComparer.Ordinal)
            .FirstOrDefault(group => group.Count() > 1);
        if (duplicateSize is not null)
        {
            _message = Loc.Format("DuplicateSizeId", duplicateSize.Key);
            _hasError = true;
            return;
        }

        _saving = true;
        _message = null;
        _hasError = false;
        try
        {
            var execution = new ExecutionSettings(_workspaceMode, _maxRuns, _scopePolicy, _commitPolicy);
            var priority = new PrioritySettings(
                new PriorityWeights(OwnWeight, ParentWeight),
                _criteria.Select(criterion => new PriorityCriterion(
                    criterion.Id,
                    criterion.Title!.Trim(),
                    criterion.Description ?? string.Empty,
                    criterion.Weight,
                    criterion.Minimum,
                    criterion.Maximum,
                    string.IsNullOrWhiteSpace(criterion.AiInstruction)
                        ? null
                        : criterion.AiInstruction.Trim())).ToArray(),
                _sizes.Select(size => new SizeDefinition(
                    size.Id!.Trim(),
                    // The step's label is its id: the grid is a ladder of codes (S, M, XL) and a separate
                    // display title would be a second name for the same thing.
                    size.Id!.Trim(),
                    size.Description ?? string.Empty,
                    size.Coefficient)).ToArray());

            using var response = await Http.PutAsJsonAsync(
                SettingsUrl,
                new AppSettings(AppSettings.CurrentSchemaVersion, execution, priority),
                PwaJson.Options);
            if (!response.IsSuccessStatusCode)
            {
                _message = Loc.Format("SaveSettingsFailed", await response.Content.ReadAsStringAsync());
                _hasError = true;
                return;
            }

            _message = Loc.Get("SettingsSaved");
            await State.ReloadAsync();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _message = Loc.Format("SaveSettingsFailed", FailureText.Describe(exception));
            _hasError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Writes the defaults back into this level: the built-in values for a template, and the installation's
    /// own values for a project - which is what "reset to app defaults" means.
    /// </summary>
    private async Task ResetToDefaultsAsync()
    {
        if (ProjectId is null)
        {
            ApplyView(new AppSettingsView(
                null,
                ExecutionSettings.SafeDefault,
                AppSettingsSources.Default,
                PrioritySettings.SafeDefault,
                AppSettingsSources.Default));
        }
        else
        {
            // "App defaults" for a project means the base template: that is what a new project starts from,
            // and the project record says which template it came from but does not expose it yet.
            var template = await Http.GetFromJsonAsync<ProjectTemplate>(TemplateUrl, PwaJson.Options);
            ApplyView(new AppSettingsView(
                template?.Settings,
                template?.Settings?.Execution ?? ExecutionSettings.SafeDefault,
                template?.Settings?.Execution is null ? AppSettingsSources.Default : AppSettingsSources.Project,
                template?.Settings?.Priority ?? PrioritySettings.SafeDefault,
                template?.Settings?.Priority is null ? AppSettingsSources.Default : AppSettingsSources.Project));
        }

        await SaveAsync();
    }

    /// <summary>
    /// Issues a one-time pairing code and shows the self-pairing URL for it. The token itself stays in
    /// the daemon's data directory; this is the handshake that admits a browser, not the secret.
    /// </summary>
    private async Task CreatePairingLinkAsync()
    {
        _pairing = true;
        try
        {
            using var response = await Http.PostAsync("api/v1/auth/pair-request", content: null);
            response.EnsureSuccessStatusCode();
            var issued = await response.Content.ReadFromJsonAsync<PairCodeResponse>(PwaJson.Options);
            _pairingUrl = issued is null
                ? null
                : $"{Http.BaseAddress}#pair={Uri.EscapeDataString(issued.Code)}";
        }
        catch (Exception exception)
        {
            _message = Loc.Format("PairingLinkFailed", FailureText.Describe(exception));
            _hasError = true;
        }
        finally
        {
            _pairing = false;
        }
    }

    private async Task RunDiagnosticsAsync()
    {
        _diagnosing = true;
        try
        {
            _diagnostics = await Http.GetFromJsonAsync<WorkshopDiagnostics>(
                "api/v1/system/diagnostics", PwaJson.Options);
            _findings = _diagnostics?.Findings ?? [];
        }
        catch (Exception exception)
        {
            _diagnostics = new WorkshopDiagnostics([]);
            _findings = [];
            _message = Loc.Format("DiagnosticsFailed", FailureText.Describe(exception));
            _hasError = true;
        }
        finally
        {
            _diagnosing = false;
        }
    }

    private static FlareSvgIcon SeverityIcon(DiagnosticSeverity severity) => severity switch
    {
        DiagnosticSeverity.Ok => MaterialDesign3Icons.Regular.CheckCircle,
        DiagnosticSeverity.Warning => MaterialDesign3Icons.Regular.Warning,
        _ => MaterialDesign3Icons.Regular.Error,
    };

    private static FlareColor SeverityColor(DiagnosticSeverity severity) => severity switch
    {
        DiagnosticSeverity.Ok => FlareColor.Tertiary,
        DiagnosticSeverity.Warning => FlareColor.Warning,
        _ => FlareColor.Error,
    };

    /// <summary>
    /// One choice as a card: the design's policy picker is a grid of options carrying a title, a hint
    /// and the radio, which FlareRadio (a control plus a label on one line) does not draw. Filed as
    /// selectable-option-card.md; this markup goes away when Flare grows the component.
    /// </summary>
    private RenderFragment Choice(
        string group,
        PolicyOption option,
        ActionPolicy selected,
        Action<ActionPolicy> select) => @<label class="aiko-choice @(selected == Enum.Parse<ActionPolicy>(option.Value) ? "aiko-choice--on" : null)">
        <span class="aiko-choice__head">
            <FlareText Element="span" Typo="TypographyScale.BodySmall" Weight="FontWeight.SemiBold">
                @Loc.Get(option.TitleKey)
            </FlareText>
            <input type="radio"
                   name="@($"aiko-{group}")"
                   value="@option.Value"
                   checked="@(selected == Enum.Parse<ActionPolicy>(option.Value))"
                   @onchange="() => select(Enum.Parse<ActionPolicy>(option.Value))" />
        </span>
        <FlareText Element="span" Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">
            @Loc.Get(option.HintKey)
        </FlareText>
    </label>;

    /// <summary>A free step id, so a row the user has just added has something valid to be saved with.</summary>
    private static string NewSizeId(IReadOnlyList<SizeDraft> existing)
    {
        var suffix = existing.Count + 1;
        var id = $"S{suffix}";
        while (existing.Any(item => string.Equals(item.Id, id, StringComparison.Ordinal)))
        {
            id = $"S{++suffix}";
        }

        return id;
    }

    private static string NewCriterionId(IReadOnlyList<CriterionDraft> existing)
    {
        var id = "criterion";
        var suffix = existing.Count + 1;
        while (existing.Any(item => StringComparer.Ordinal.Equals(item.Id, id)))
        {
            id = $"criterion-{suffix++}";
        }

        return id;
    }

    /// <summary>A criterion as the form holds it, before it becomes a <see cref="PriorityCriterion"/>.</summary>
    private sealed class CriterionDraft
    {
        public required string Id { get; init; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public decimal Weight { get; set; } = 1m;
        public decimal Minimum { get; set; }
        public decimal Maximum { get; set; } = 1m;
        public string? AiInstruction { get; set; }

        public static CriterionDraft From(PriorityCriterion criterion) => new()
        {
            Id = criterion.Id,
            Title = criterion.Title,
            Description = criterion.Description,
            Weight = criterion.Weight,
            Minimum = criterion.Minimum,
            Maximum = criterion.Maximum,
            AiInstruction = criterion.AiInstruction,
        };
    }

    /// <summary>A size step as the form holds it, before it becomes a <see cref="SizeDefinition"/>.</summary>
    private sealed class SizeDraft
    {
        public string? Id { get; set; }
        public string? Description { get; set; }
        public decimal Coefficient { get; set; } = 1m;

        public static SizeDraft From(SizeDefinition size) => new()
        {
            Id = size.Id,
            Description = size.Description,
            Coefficient = size.Coefficient,
        };
    }
}
