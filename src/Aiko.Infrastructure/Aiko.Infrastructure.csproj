<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Aiko.Application/Aiko.Application.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- The project's first native dependency, and it is deliberate: an embedding model is an ONNX graph, so
         semantic search cannot be built without a runtime for one. It is brought in only here - the module
         stays off by default and nothing else links against it. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>
  <!-- The store's filing rules are internal helpers, and the specs are where they are checked: the card
       folder a type gets is not part of the public API but it is part of the observable behaviour. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aiko.Infrastructure.Specs" />
  </ItemGroup>
</Project>
