<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <ProjectReference Include="../Aiko.Application/Aiko.Application.csproj" />
    <ProjectReference Include="../Aiko.Infrastructure/Aiko.Infrastructure.csproj" />
    <ProjectReference Include="../Aiko.Pwa/Aiko.Pwa.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <!-- Hosted WASM does not propagate transitive Razor-class-library assets into the host's
         endpoint manifest. Keep only their build/static assets here; executable references live
         exclusively in Aiko.Pwa. -->
    <PackageReference Include="Flare.Blazor" Version="0.44.0" ExcludeAssets="compile;runtime" />
    <ProjectReference Include="../Aiko.Theme.StitchFlow/Aiko.Theme.StitchFlow.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The pairing code's window is internal, and the specs are where a rule like that is checked: PairingService
       already takes a TimeProvider so a spec can move the clock instead of waiting five minutes, and moving it
       needs to reach the type (TASK-346). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aiko.Mcp.Specs" />
  </ItemGroup>
</Project>
