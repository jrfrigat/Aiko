<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aiko-installer</AssemblyName>
  </PropertyGroup>

  <!-- The engine is embedded, not fetched at run time: the exe and the script it drives are then built from
       the same commit, so an exe pinned to a tag can never end up running the installer from a moving main.
       The logical name is fixed here rather than derived from the file's path, which would change with it. -->
  <ItemGroup>
    <EmbeddedResource Include="../install.ps1" LogicalName="install.ps1" />
  </ItemGroup>
</Project>
