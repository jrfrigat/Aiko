# Aiko project data is local by default.
/.aiko/

# .NET build output.
**/bin/
**/obj/
artifacts/

# IDE and user-specific files.
.vs/
.idea/
*.user
*.suo

# Local AI assistant and internal planning files (not part of the product).
.claude/
SkillsExample/

# Runtime and local logs.
*.log
TestResults/

# Local release staging (the release workflow publishes here).
/publish/
/.mcp.json
/.cursor/mcp.json
/.zcode/config.json

# Agent configuration Aiko projects into this repository. Every install and repair rewrites it, so it is
# generated rather than authored. AGENTS.md and CLAUDE.md are here for the same reason: Aiko only adds a
# marked block to them.
/.cline/
/.clinerules/
/.codex/
/.agents/
/AGENTS.md
/CLAUDE.md
